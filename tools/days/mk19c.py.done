# ---------------- hourly run 05:01 Oct 19 (ids 11993-12042): 1 new Oct 19 card + extensions ----------------
# Oct 19 front reports (MoD / TASS group summaries) and Samara airport restrictions lifted stay Russian-only (SKIPPED.md).

def rep(c, path, old, new):
    o = c
    for p in path[:-1]: o = o[p]
    assert old in o[path[-1]], (c['key'], path, old[:40])
    o[path[-1]] = o[path[-1]].replace(old, new)

card('1019-peskov-trilateral-meeting', [11920, 11983, 12032, 12042, 12041],
 'Песков в интервью WSJ: Россия, США и Китай допускают трехстороннюю встречу лидеров; РБК-Украина пишет о саммите без Зеленского', 'Москва', 'ukraine-wide',
 ['расхождение: формулировки', 'умолчание', 'одна из групп не освещает'],
 S('Пресс-секретарь Кремля Дмитрий Песков в интервью The Wall Street Journal заявил, что четкого понимания относительно самой встречи Путина, Трампа и Си Цзиньпина и ее повестки пока нет, «хотя все три стороны признают гипотетическую возможность такой встречи» (РИА Новости, ТАСС, «Интерфакс»). РИА напоминает слова помощника президента Юрия Ушакова о том, что инициировать встречу должен Пекин, если Трамп подтвердит участие в саммите АТЭС, который пройдет в Шэньчжэне 18–19 ноября; «Интерфакс» — что практическая проработка встречи еще не начиналась. ТАСС (англ.) приводит слова Путина на Валдае: возможность встречи во многом зависит от принимающей стороны. Об Украине и войне российские сообщения в выборке не упоминают.',
   (12042, 'Пока нет четкого понимания относительно самой встречи или ее потенциальной повестки, хотя все три стороны признают гипотетическую возможность такой встречи'),
   (11983, 'Песков: Россия, США и Китай допускают возможность трехсторонней встречи'),
   (11920, 'инициировать встречу трех лидеров должен Пекин, если Трамп подтвердит свое участие в саммите АТЭС'),
   (11920, 'Саммит АТЭС пройдет в китайском Шэньчжэне 18-19 ноября.'),
   (12042, 'практическая проработка трехсторонней встречи президентов РФ Владимира Путина, США Дональда Трампа и председателя КНР Си Цзиньпина еще не начиналась'),
   (12032, 'largely depended on the host party')),
 S('РБК-Украина со ссылкой на интервью Пескова WSJ пишет, что Россия предлагает провести в ноябре трехсторонний саммит с США и Китаем, чтобы договориться о завершении войны на выгодных для Москвы условиях, а президента Украины Владимира Зеленского на встречу звать не планируют. Издание приводит ту же цитату Пескова, называет Путина «российским диктатором» и пишет, что Трамп демонстративно избегает давления на Москву: он заморозил закон о санкциях против России и перекладывает ответственность за затягивание войны на Зеленского. Зеленский, по данным издания, считает, что шаги Вашингтона выглядят как попытка склонить Украину к капитуляции.',
   (12041, 'Росія пропонує провести в листопаді тристоронній саміт із США і Китаєм, щоб домовитися про завершення війни на вигідних для Москви умовах.'),
   (12041, 'Президента України Володимира Зеленського на зустріч кликати не планують.'),
   (12041, 'Тим часом Трамп демонстративно уникає тиску на Москву.'),
   (12041, 'кроки Вашингтона виглядають як спроба схилити Україну до капітуляції')),
 None,
 'Обе стороны одинаково цитируют Пескова: повестки встречи пока нет, но все три стороны допускают ее возможность. Российские агентства подают новость как обсуждение встречи на полях саммита АТЭС и не упоминают Украину, а РБК-Украина — как попытку Москвы договориться о завершении войны на своих условиях без участия Зеленского; в приведенной цитате Пескова о войне и об Украине не говорится. Независимых сообщений в выборке нет.',
 'medium', 'Утверждение РБК-Украина о цели саммита и о том, что Зеленского не позовут, в выборке не подкреплено цитатой; сам Песков говорит, что повестки пока нет.', False,
 ['Пєсков в інтерв’ю WSJ: Росія, США і Китай допускають тристоронню зустріч лідерів; РБК-Україна пише про саміт без Зеленського', 'Москва',
  'Обидві сторони однаково цитують Пєскова: порядку денного зустрічі поки немає, але всі три сторони допускають її можливість. Російські агентства подають новину як обговорення зустрічі на полях саміту АТЕС і не згадують Україну, а РБК-Україна — як спробу Москви домовитися про завершення війни на своїх умовах без участі Зеленського; у наведеній цитаті Пєскова про війну та Україну не йдеться. Незалежних повідомлень у вибірці немає.',
  'Речник Кремля Дмитро Пєсков в інтерв’ю The Wall Street Journal заявив, що чіткого розуміння щодо самої зустрічі Путіна, Трампа і Сі Цзіньпіна та її порядку денного поки немає, «хоча всі три сторони визнають гіпотетичну можливість такої зустрічі» (РИА Новости, ТАСС, «Интерфакс»). РИА нагадує слова помічника президента Юрія Ушакова про те, що ініціювати зустріч має Пекін, якщо Трамп підтвердить участь у саміті АТЕС, який відбудеться в Шеньчжені 18–19 листопада; «Интерфакс» — що практичне опрацювання зустрічі ще не починалося. ТАСС (англ.) наводить слова Путіна на Валдаї: можливість зустрічі значною мірою залежить від сторони, що приймає. Про Україну та війну російські повідомлення у вибірці не згадують.',
  'РБК-Україна з посиланням на інтерв’ю Пєскова WSJ пише, що Росія пропонує провести в листопаді тристоронній саміт із США і Китаєм, щоб домовитися про завершення війни на вигідних для Москви умовах, а президента України Володимира Зеленського на зустріч кликати не планують. Видання наводить ту саму цитату Пєскова, називає Путіна «російським диктатором» і пише, що Трамп демонстративно уникає тиску на Москву: він заморозив закон про санкції проти Росії і перекладає відповідальність за затягування війни на Зеленського. Зеленський, за даними видання, вважає, що кроки Вашингтона виглядають як спроба схилити Україну до капітуляції.',
  None],
 ["Peskov to the WSJ: Russia, the US and China allow for a trilateral leaders' meeting; RBC-Ukraine writes of a summit without Zelensky", 'Moscow',
  'Both sides quote Peskov in the same way: there is no agenda for the meeting yet, but all three parties acknowledge it is possible. Russian agencies present the news as a discussion of a meeting on the sidelines of the APEC summit and do not mention Ukraine, while RBC-Ukraine presents it as a Moscow attempt to agree on ending the war on its own terms without Zelensky; the quoted Peskov statement says nothing about the war or Ukraine. There are no independent reports in the sample.',
  'Kremlin spokesman Dmitry Peskov told The Wall Street Journal that there is no clear understanding yet of the meeting of Putin, Trump and Xi Jinping itself or its agenda, "although all three parties acknowledge the hypothetical possibility of such a meeting" (RIA Novosti, TASS, Interfax). RIA recalls presidential aide Yuri Ushakov\'s words that Beijing should initiate the meeting if Trump confirms his participation in the APEC summit, to be held in Shenzhen on 18–19 November; Interfax adds that practical preparation of the meeting has not yet begun. TASS (English) quotes Putin at Valdai: the possibility of the meeting largely depends on the host party. Russian reports in the sample do not mention Ukraine or the war.',
  'RBC-Ukraine, citing Peskov\'s interview with the WSJ, writes that Russia proposes holding a trilateral summit with the US and China in November to agree on ending the war on terms favourable to Moscow, and that there are no plans to invite Ukrainian President Volodymyr Zelensky. The outlet quotes the same Peskov statement, calls Putin a "Russian dictator" and writes that Trump is pointedly avoiding pressure on Moscow: he has frozen the Russia sanctions bill and is shifting responsibility for prolonging the war onto Zelensky. Zelensky, according to the outlet, believes Washington\'s steps look like an attempt to push Ukraine towards capitulation.',
  None])

