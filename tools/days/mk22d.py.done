@ext('1020-patriot-purl-delay', [14604, 14749])
def _(c):
    add(c, 'ind', 'The Kyiv Independent 21 октября пишет о встрече министра обороны Евгения Хмары и главнокомандующего Михаила Драпатого с делегацией Lockheed Martin, производителя перехватчиков PAC-3, на фоне острой нехватки ракет Patriot; по словам украинских чиновников и военных, Хегсет до сих пор не одобрил передачу значительной партии ракет.',
        'The Kyiv Independent 21 жовтня пише про зустріч міністра оборони Євгена Хмари та головнокомандувача Михайла Драпатого з делегацією Lockheed Martin, виробника перехоплювачів PAC-3, на тлі гострої нестачі ракет Patriot; за словами українських посадовців і військових, Гегсет досі не схвалив передачу значної партії ракет.',
        'The Kyiv Independent reports on 21 October that Defence Minister Yevhen Khmara and Commander-in-Chief Mykhailo Drapatyi met a delegation from Lockheed Martin, the maker of PAC-3 interceptors, amid a severe shortage of Patriot missiles; according to Ukrainian officials and officers, Hegseth has still not approved the transfer of a significant batch of missiles.',
        [(14604, 'U.S. Defense Secretary Pete Hegseth has yet to greenlight the transfer of a significant batch of Patriot missiles for Ukraine')])

apply(['c20a.json', 'c21a.json', 'c21b.json', 'c21c.json', 'c21f.json', 'c22a.json'])
