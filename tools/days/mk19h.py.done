import json, sys, sqlite3, re
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
from extlib import add, setd, ext, apply, EXT, NEW, q
OUT = '/workspace/compare-site-v2/tools/days/out/'
cards = []
card = lambda *a: cards.append(C(*a))

# ---------------- hourly run 10:00 Oct 19 (ids 12480-12690): 1 new Oct 19 card + extensions ----------------

def rep(c, path, old, new):
    o = c
    for p in path[:-1]: o = o[p]
    assert old in o[path[-1]], (c['key'], path, old[:40])
    o[path[-1]] = o[path[-1]].replace(old, new)

card('1019-dobropillia-control-disputed', [12562, 12563, 12566, 12576, 12652, 12669],
 'Пушилин называет Доброполье освобожденным и говорит о зачистке города; бригада «Рубеж»: Доброполье под контролем Сил обороны Украины', 'Доброполье, Дружковка, Николаевка (Донецкая область)', 'donetsk',
 ['расхождение: кто контролирует населённый пункт', 'не проверено', 'одна из групп не освещает'],
 S('ТАСС передает заявления главы ДНР Дениса Пушилина: в «освобожденном» Доброполье российским войскам предстоит зачистка города от, вероятно, оставшихся там солдат ВСУ, а Киев после «потери Доброполья» перебрасывает часть подразделений в Краматорск и Славянск, пытаясь стабилизировать ситуацию на фоне быстрого продвижения российских войск. По словам Пушилина, российские войска продвигаются в Дружковке, несмотря на большое число беспилотников, а положение ВСУ у Николаевки ухудшается; освобождение этого населенного пункта, по его словам, откроет дорогу к Славянску.',
   (12562, 'Пушилин назвал задачи ВС РФ в освобожденном Доброполье'),
   (12562, 'российским войскам предстоит зачистка города от вероятно оставшихся там солдат ВСУ'),
   (12566, 'Киев перебрасывает часть подразделений в Краматорск и Славянск, пытаясь стабилизировать ситуацию на фоне быстрого продвижения российских войск'),
   (12563, 'российские войска продвигаются в этом населенном пункте, несмотря на большое число беспилотников'),
   (12576, 'Освобождение этого населенного пункта откроет дорогу к Славянску')),
 S('Пресс-офицер бригады Нацгвардии «Рубеж» подполковник Максим Таран, слова которого передает «Общественное», заявил 19 октября, что город Доброполье находится под контролем Сил обороны Украины. По его словам, российские подразделения все чаще не вступают в открытый бой, а пытаются просачиваться между опорными пунктами; чтобы показать хоть какие-то результаты, они используют группы из двух-трех человек, которые добегают до населенного пункта, втыкают в землю российский флаг и снимают видео, даже если местность контролируют Силы обороны; такие группы, по словам Тарана, уничтожают. Генштаб ВСУ в утренней сводке, которую приводит «Украинская правда», пишет, что на Покровском направлении противник пытался продвинуться в том числе в сторону Доброполья.',
   (12652, 'місто Добропілля перебуває під контролем Сил оборони України'),
   (12652, 'Противник зараз намагається просочитися через наші позиції та обійти наші позиції.'),
   (12652, 'Це підрозділи із групи противника дві-три особи, в яких є задача взяти свій триколор і добігти до якогось населеного пункту та просто вставити в землю цей прапор і зняти відео, навіть якщо це місцевість, підконтрольна Силам оборони України'),
   (12669, 'у бік населених пунктів Торецьке, Вільне, Новий Донбас, Світле, Добропілля')),
 None,
 'Стороны прямо противоречат друг другу. Пушилин называет Доброполье «освобожденным» и говорит лишь о зачистке города от оставшихся солдат ВСУ, а пресс-офицер бригады «Рубеж» — что город под контролем Сил обороны Украины, а российские группы ставят флаги у населенных пунктов ради видео. Генштаб ВСУ упоминает Доброполье среди населенных пунктов, в сторону которых пытался продвинуться противник. О переброске украинских подразделений в Краматорск и Славянск, о положении у Николаевки и боях в Дружковке украинские источники в выборке не пишут. Независимых сообщений в выборке нет, поэтому проверить, кто контролирует город, по выборке невозможно.',
 'medium', 'Контроль над Добропольем стороны описывают противоположно; заявления обеих сторон не проверены независимо.', True,
 ['Пушилін називає Добропілля звільненим і говорить про зачистку міста; бригада «Рубіж»: Добропілля під контролем Сил оборони України', 'Добропілля, Дружківка, Миколаївка (Донецька область)',
  'Сторони прямо суперечать одна одній. Пушилін називає Добропілля «звільненим» і говорить лише про зачистку міста від решти солдатів ЗСУ, а пресофіцер бригади «Рубіж» — що місто під контролем Сил оборони України, а російські групи ставлять прапори біля населених пунктів заради відео. Генштаб ЗСУ згадує Добропілля серед населених пунктів, у бік яких намагався просунутися противник. Про перекидання українських підрозділів до Краматорська і Слов’янська, про становище біля Миколаївки та бої в Дружківці українські джерела у вибірці не пишуть. Незалежних повідомлень у вибірці немає, тому перевірити, хто контролює місто, за вибіркою неможливо.',
  'ТАСС передає заяви голови «ДНР» Дениса Пушиліна: у «звільненому» Добропіллі російським військам належить зачистка міста від, імовірно, солдатів ЗСУ, що там залишилися, а Київ після «втрати Добропілля» перекидає частину підрозділів до Краматорська і Слов’янська, намагаючись стабілізувати ситуацію на тлі швидкого просування російських військ. За словами Пушиліна, російські війська просуваються в Дружківці, попри велику кількість безпілотників, а становище ЗСУ біля Миколаївки погіршується; звільнення цього населеного пункту, за його словами, відкриє дорогу до Слов’янська.',
  'Пресофіцер бригади Нацгвардії «Рубіж» підполковник Максим Таран, слова якого передає «Суспільне», заявив 19 жовтня, що місто Добропілля перебуває під контролем Сил оборони України. За його словами, російські підрозділи дедалі частіше не вступають у відкритий бій, а намагаються просочуватися між опорними пунктами; щоб показати хоч якісь результати, вони використовують групи з двох-трьох людей, які добігають до населеного пункту, встромляють у землю російський прапор і знімають відео, навіть якщо місцевість контролюють Сили оборони; такі групи, за словами Тарана, знищують. Генштаб ЗСУ в ранковому зведенні, яке наводить «Українська правда», пише, що на Покровському напрямку противник намагався просунутися зокрема в бік Добропілля.',
  None],
 ['Pushilin calls Dobropillia liberated and speaks of clearing the town; Rubizh brigade: Dobropillia is under the control of Ukraine\'s Defence Forces', 'Dobropillia, Druzhkivka, Mykolaivka (Donetsk region)',
  'The sides directly contradict each other. Pushilin calls Dobropillia "liberated" and speaks only of clearing the town of remaining Ukrainian soldiers, while the Rubizh brigade press officer says the town is under the control of Ukraine\'s Defence Forces and that Russian groups plant flags near settlements for the sake of videos. Ukraine\'s General Staff lists Dobropillia among the settlements towards which the enemy tried to advance. Ukrainian sources in the sample do not mention a transfer of Ukrainian units to Kramatorsk and Sloviansk, the situation near Mykolaivka or fighting in Druzhkivka. There are no independent reports in the sample, so it is impossible to verify from the sample who controls the town.',
  'TASS relays statements by the head of the "DPR" Denis Pushilin: in "liberated" Dobropillia Russian troops still have to clear the town of Ukrainian soldiers who probably remain there, while Kyiv, after "losing Dobropillia", is moving some units to Kramatorsk and Sloviansk in an attempt to stabilise the situation amid a rapid Russian advance. According to Pushilin, Russian troops are advancing in Druzhkivka despite a large number of drones, and the position of Ukrainian forces near Mykolaivka is worsening; taking this settlement, he says, will open the road to Sloviansk.',
  'Rubizh National Guard brigade press officer Lieutenant Colonel Maksym Taran, quoted by Suspilne, said on 19 October that the town of Dobropillia is under the control of Ukraine\'s Defence Forces. According to him, Russian units increasingly avoid open combat and try to infiltrate between strongpoints; to show at least some results, they use groups of two or three people who run up to a settlement, stick a Russian flag in the ground and film a video, even if the area is controlled by the Defence Forces; such groups, Taran said, are destroyed. Ukraine\'s General Staff, in its morning report cited by Ukrainska Pravda, writes that in the Pokrovsk direction the enemy tried to advance, among other places, towards Dobropillia.',
  None])

# ---- extensions

@ext('1019-mod-targets-kyiv-irpin', [12586, 12648, 12682, 12674, 12631, 12671, 12665, 12667])
def _(c):
    # SUS 12631, UP 12671 (Tkachenko, same figures as SUS 12429 / RBC 12467), UP 12667 (Air Force, = RBC 12466) - ids only
    add(c, 'ru', 'Позже ТАСС сообщило, что дата-центр в Киеве уничтожен и не подлежит восстановлению.',
        'Пізніше ТАСС повідомило, що дата-центр у Києві знищено і він не підлягає відновленню.',
        'TASS later reported that the data centre in Kyiv had been destroyed and cannot be restored.',
        [(12586, 'В Киеве уничтожен дата-центр. Он не подлежит восстановлению')])
    c['ua'] = {'summary': 'Глава Киевской ОВА Тимур Ткаченко, слова которого передают «Общественное», РБК-Украина и «Украинская правда», сообщил о комбинированном ударе по Киевщине баллистическими и крылатыми ракетами и дронами. В Ирпене при прямом попадании в частный сектор погибла женщина, ранены шесть человек, среди них трое детей, трое пропали без вести; в Бучанском и Вышгородском районах повреждены частные дома, автомобили, производственные и складские помещения. Бывший мэр Ирпеня Александр Маркушин написал, что атаке подверглось «одно из крупнейших предприятий Ирпеня», не назвав его. Компания «Датагруп» сообщила, что ночной баллистический удар полностью уничтожил оборудование и инфраструктуру ее дата-центра в Киеве, восстановление невозможно, сотрудники не пострадали, услуги предоставляются с резервных площадок. По данным Воздушных сил, Россия применила «Искандер-М», С-400, «Искандер-К» и 269 дронов, сбиты или подавлены 247 целей, попадания — на 25 локациях. Зеленский написал, что всего было выпущено 16 баллистических ракет: мишенью снова были энергетика и инфраструктура, но повреждены также медицинская клиника, школа, станция метро и жилые дома, а предупреждения от партнеров снова не было.',
        'quotes': [q(*x) for x in [
            (12467, 'ворог завдав комбінованого удару балістичними та крилатими ракетами й ударними дронами'),
            (12429, 'В Ірпені внаслідок прямого влучання по приватному сектору загинула жінка'),
            (12467, 'В Ірпені Бучанського району травмовано шестеро людей, серед них троє дітей.'),
            (12665, 'одне з найбільших підприємств Ірпеня'),
            (12682, 'обладнання та інфраструктура дата-центру були повністю знищені'),
            (12648, 'відновлення та подальша робота неможливі'),
            (12466, 'Росія випустила балістичні ракети Іскандер-М та С-400'),
            (12451, 'протиповітряною обороною збито/подавлено 247 цілей'),
            (12674, 'Загалом росіяни застосували 16 балістичних ракет, і це була цілеспрямована атака проти Києва та Київщини'),
            (12674, 'пошкоджені також медична клініка, школа, станція метро та звичайні житлові будинки')]]}
    c['uk']['ua'] = 'Голова Київської ОВА Тимур Ткаченко, слова якого передають «Суспільне», РБК-Україна та «Українська правда», повідомив про комбінований удар по Київщині балістичними і крилатими ракетами та дронами. В Ірпені внаслідок прямого влучання в приватний сектор загинула жінка, поранено шістьох людей, серед них трьох дітей, троє зникли безвісти; у Бучанському та Вишгородському районах пошкоджено приватні будинки, автомобілі, виробничі та складські приміщення. Колишній мер Ірпеня Олександр Маркушин написав, що атаки зазнало «одне з найбільших підприємств Ірпеня», не назвавши його. Компанія «Датагруп» повідомила, що нічний балістичний удар повністю знищив обладнання та інфраструктуру її дата-центру в Києві, відновлення неможливе, співробітники не постраждали, послуги надаються з резервних майданчиків. За даними Повітряних сил, Росія застосувала «Іскандер-М», С-400, «Іскандер-К» і 269 дронів, збито або подавлено 247 цілей, влучання — на 25 локаціях. Зеленський написав, що загалом було випущено 16 балістичних ракет: мішенню знову були енергетика та інфраструктура, але пошкоджено також медичну клініку, школу, станцію метро і житлові будинки, а попередження від партнерів знову не було.'
    c['en']['ua'] = 'The head of the Kyiv regional military administration Tymur Tkachenko, quoted by Suspilne, RBC-Ukraine and Ukrainska Pravda, reported a combined strike on the Kyiv region with ballistic and cruise missiles and drones. In Irpin a woman was killed by a direct hit on private houses, six people were injured, including three children, and three are missing; private houses, cars and production and warehouse premises were damaged in the Bucha and Vyshhorod districts. Former Irpin mayor Oleksandr Markushyn wrote that "one of the largest enterprises in Irpin" had been attacked, without naming it. The company Datagroup said the overnight ballistic strike completely destroyed the equipment and infrastructure of its data centre in Kyiv, restoration is impossible, staff were unhurt and services are provided from backup sites. According to the Air Force, Russia used Iskander-M, S-400 and Iskander-K missiles and 269 drones; 247 targets were shot down or suppressed, with hits at 25 locations. Zelensky wrote that 16 ballistic missiles were fired in total: the targets were again energy and infrastructure, but a medical clinic, a school, a metro station and residential buildings were also damaged, and again there was no warning from partners.'
    setd(c, 'Минобороны РФ называет пораженные объекты военными: «Файер Пойнт», «Химволокно», локомотивное депо и дата-центр «Дата групп» в Киеве, завод «Планета пластик» в Ирпене. Из этого списка украинские источники в выборке подтверждают только уничтожение дата-центра: о нем сообщила сама компания «Датагруп», которая предоставляет услуги связи бизнесу и абонентам в более чем 90 населенных пунктах; о военном назначении объекта она не пишет. В Ирпене бывший мэр говорит о серьезно пострадавшем крупном предприятии, не называя его; остальные объекты украинские источники не называют и заявление Минобороны не комментируют. Украинские источники пишут о погибшей женщине, шести раненых, в том числе троих детях, и трех пропавших без вести в Ирпене, а Зеленский — о поврежденных клинике, школе, станции метро и жилых домах; российские источники о жертвах и повреждениях жилья не пишут. О сухогрузе у Одессы украинские источники в выборке не сообщают. Независимых сообщений в выборке нет.',
        'Міноборони РФ називає уражені об’єкти військовими: «Файер Пойнт», «Хімволокно», локомотивне депо і дата-центр «Дата груп» у Києві, завод «Планета пластик» в Ірпені. З цього переліку українські джерела у вибірці підтверджують лише знищення дата-центру: про нього повідомила сама компанія «Датагруп», яка надає послуги зв’язку бізнесу та абонентам у понад 90 населених пунктах; про військове призначення об’єкта вона не пише. В Ірпені колишній мер говорить про серйозно пошкоджене велике підприємство, не називаючи його; решту об’єктів українські джерела не називають і заяву Міноборони не коментують. Українські джерела пишуть про загиблу жінку, шістьох поранених, зокрема трьох дітей, і трьох зниклих безвісти в Ірпені, а Зеленський — про пошкоджені клініку, школу, станцію метро і житлові будинки; російські джерела про жертви і пошкодження житла не пишуть. Про суховантаж біля Одеси українські джерела у вибірці не повідомляють. Незалежних повідомлень у вибірці немає.',
        'The Russian Defence Ministry calls the facilities it hit military targets: Fire Point, Khimvolokno, a locomotive depot and the Data Group data centre in Kyiv, and the Planeta Plastik plant in Irpin. Of this list, Ukrainian sources in the sample confirm only the destruction of the data centre: it was reported by the company Datagroup itself, which provides communications services to businesses and customers in more than 90 localities; it says nothing about any military purpose of the facility. In Irpin the former mayor speaks of a large enterprise that was badly hit, without naming it; Ukrainian sources do not name the other facilities and do not comment on the ministry\'s statement. Ukrainian sources report a woman killed, six injured, including three children, and three missing in Irpin, and Zelensky mentions a damaged clinic, school, metro station and residential buildings; Russian sources do not mention casualties or damage to housing. Ukrainian sources in the sample do not report on the cargo ship near Odesa. There are no independent reports in the sample.')
    c['uncertainty_reason'] = 'Заявления Минобороны РФ о военном назначении пораженных объектов независимо не проверены; кроме дата-центра «Датагруп», украинские источники не называют пострадавшие предприятия, данные о раненых и пропавших без вести предварительные.'

@ext('1019-energy-strikes-west-centre', [12514, 12544, 12599, 12620, 12685, 12649, 12638, 12646])
def _(c):
    # SUS 12646 (Vinnytsia water utility explains why there is no water without power) - id only
    add(c, 'ru', 'Позже РИА Новости и ТАСС со ссылкой на «Укрэнерго» сообщили о новых отключениях в десяти областях — Волынской, Житомирской, Ровенской, Тернопольской, Хмельницкой, Винницкой, Кировоградской, Харьковской, Одесской и Николаевской; причиной компания назвала повреждение энергообъектов. ТАСС также привел слова Романюка о 66 тыс. абонентов без света на Волыни и сообщил, что за ночь на Украине повреждено более 10 объектов энергетической инфраструктуры.',
        'Пізніше РИА Новости і ТАСС з посиланням на «Укренерго» повідомили про нові відключення в десяти областях — Волинській, Житомирській, Рівненській, Тернопільській, Хмельницькій, Вінницькій, Кіровоградській, Харківській, Одеській і Миколаївській; причиною компанія назвала пошкодження енергооб’єктів. ТАСС також навів слова Романюка про 66 тис. абонентів без світла на Волині й повідомив, що за ніч в Україні пошкоджено понад 10 об’єктів енергетичної інфраструктури.',
        'RIA Novosti and TASS later reported, citing Ukrenergo, new outages in ten regions — Volyn, Zhytomyr, Rivne, Ternopil, Khmelnytskyi, Vinnytsia, Kirovohrad, Kharkiv, Odesa and Mykolaiv; the company named damage to energy facilities as the cause. TASS also relayed Romaniuk\'s figure of 66 thousand customers without power in Volyn and reported that more than 10 energy infrastructure facilities in Ukraine were damaged overnight.',
        [(12514, 'В компании отметили, что это связано с повреждением энергообъектов.'),
         (12599, 'Электричества нет у части жителей Винницкой, Волынской, Житомирской, Кировоградской, Николаевской, Одесской, Ровненской, Тернопольской, Харьковской и Хмельницкой областей'),
         (12544, 'В Волынской области 66 тыс. пользователей остались без света'),
         (12620, 'На Украине за ночь повреждено более 10 объектов энергетической инфраструктуры')])
    c['ua'] = {'summary': '«Общественное» и РБК-Украина со ссылкой на местные власти сообщают о массированной атаке на энергетику. Глава Винницкой ОВА Наталья Заболотная написала, что «враг продолжает массированную атаку по энергетической инфраструктуре», на Винничине есть разрушения. На Житомирщине объекты энергетики второй день подряд под ударом, в Бердичевской громаде после попадания беспилотника возник пожар; погибших и пострадавших нет. На Волыни без света около 66 тысяч абонентов, есть попадания в Ковельской громаде. На Ровенщине зафиксировано попадание в Острожской громаде; глава ОВА Александр Коваль пишет, что больше всего обесточенных объектов в Ровенском районе, а новые атаки усложняют восстановление. Обесточены часть Хмельниччины после российского обстрела и Компанеевская громада на Кировоградщине. В Лозовой на Харьковщине, по словам городского головы Сергея Зеленского, почти сутки длится массированная атака, часть громады без света, повреждены учреждение здравоохранения и склад. Под Львовом сбит беспилотник, в селе Зубра повреждены шесть жилых домов и шесть автомобилей.',
        'quotes': [q(*x) for x in [
            (12685, 'ворог продовжує масовану атаку по енергетичній інфраструктурі'),
            (12434, 'Наразі інформації про загиблих та постраждалих внаслідок ударів не надходило.'),
            (12434, 'стало відомо 19 жовтня о 3:20. На місці виникла пожежа.'),
            (12449, 'без електропостачання залишилися орієнтовно 66 тисяч абонентів'),
            (12442, 'Маємо приліт. Працюють всі екстеренні служби на місці прильоту.'),
            (12453, 'Нові атаки ускладнюють роботу енергетиків з відновлення'),
            (12649, 'аварійно-відновлювальні роботи розпочнуться після завершення повітряної тривоги'),
            (12454, 'Через пошкодження електромереж наразі відсутнє електропостачання.'),
            (12685, 'майже добу триває масована ворожа атака'),
            (12638, "У Лозовій внаслідок ударів російських БпЛА пошкоджені заклад охорони здоров'я та складська будівля"),
            (12435, 'у селі Зубра Львівського району пошкоджені шість житлових будинків та шість автівок')]]}
    c['uk']['ua'] = '«Суспільне» і РБК-Україна з посиланням на місцеву владу повідомляють про масовану атаку на енергетику. Начальниця Вінницької ОВА Наталя Заболотна написала, що «ворог продовжує масовану атаку по енергетичній інфраструктурі», на Вінниччині є руйнування. На Житомирщині об’єкти енергетики другий день поспіль під ударом, у Бердичівській громаді після влучання безпілотника виникла пожежа; загиблих і постраждалих немає. На Волині без світла близько 66 тисяч абонентів, є влучання в Ковельській громаді. На Рівненщині зафіксовано влучання в Острозькій громаді; голова ОВА Олександр Коваль пише, що найбільше знеструмлених об’єктів у Рівненському районі, а нові атаки ускладнюють відновлення. Знеструмлено частину Хмельниччини після російського обстрілу та Компаніївську громаду на Кіровоградщині. У Лозовій на Харківщині, за словами міського голови Сергія Зеленського, майже добу триває масована атака, частина громади без світла, пошкоджено заклад охорони здоров’я і склад. Під Львовом збито безпілотник, у селі Зубра пошкоджено шість житлових будинків і шість автомобілів.'
    c['en']['ua'] = 'Suspilne and RBC-Ukraine, citing local officials, report a massive attack on energy facilities. The head of the Vinnytsia regional administration Nataliia Zabolotna wrote that "the enemy continues its massive attack on energy infrastructure" and that there is destruction in the Vinnytsia region. In the Zhytomyr region energy facilities have been under attack for the second day in a row, and a drone hit caused a fire in the Berdychiv community; no one was killed or injured. In Volyn about 66 thousand customers are without power, with hits in the Kovel community. In the Rivne region a hit was recorded in the Ostroh community; regional head Oleksandr Koval writes that most of the facilities without power are in the Rivne district and that new attacks are complicating restoration. Part of the Khmelnytskyi region lost power after Russian shelling, as did the Kompaniivka community in the Kirovohrad region. In Lozova in the Kharkiv region, according to mayor Serhii Zelenskyi, a massive attack has been going on for almost a day, part of the community is without power and a healthcare facility and a warehouse were damaged. Near Lviv a drone was shot down, damaging six houses and six cars in the village of Zubra.'
    setd(c, 'Российские агентства, ссылаясь на «Укрэнерго» и украинских чиновников, сообщают об отключениях света в десяти областях, о 66 тыс. обесточенных абонентов на Волыни и о повреждении за ночь более 10 энергообъектов, но пишут лишь о «повреждении» энергообъектов и инфраструктуры, не связывая его с ударами; о самих атаках беспилотников и попаданиях российские источники в выборке не сообщают. Украинские источники описывают массированную атаку на энергетику: глава Винницкой ОВА прямо называет причиной удары, о попаданиях и обесточиваниях после атак сообщают власти Житомирской, Волынской, Ровенской, Хмельницкой, Кировоградской и Харьковской областей. Независимых сообщений в выборке нет.',
        'Російські агентства, посилаючись на «Укренерго» та українських посадовців, повідомляють про відключення світла в десяти областях, про 66 тис. знеструмлених абонентів на Волині та про пошкодження за ніч понад 10 енергооб’єктів, але пишуть лише про «пошкодження» енергооб’єктів та інфраструктури, не пов’язуючи його з ударами; про самі атаки безпілотників і влучання російські джерела у вибірці не повідомляють. Українські джерела описують масовану атаку на енергетику: начальниця Вінницької ОВА прямо називає причиною удари, про влучання і знеструмлення після атак повідомляє влада Житомирської, Волинської, Рівненської, Хмельницької, Кіровоградської та Харківської областей. Незалежних повідомлень у вибірці немає.',
        'Russian agencies, citing Ukrenergo and Ukrainian officials, report power outages in ten regions, 66 thousand customers without power in Volyn and more than 10 energy facilities damaged overnight, but speak only of "damage" to energy facilities and infrastructure without linking it to strikes; Russian sources in the sample do not report the drone attacks and hits themselves. Ukrainian sources describe a massive attack on the energy sector: the head of the Vinnytsia regional administration explicitly names strikes as the cause, and officials in the Zhytomyr, Volyn, Rivne, Khmelnytskyi, Kirovohrad and Kharkiv regions report hits and outages after attacks. There are no independent reports in the sample.')
    c['title'] = 'Массированный удар по энергетике 19 октября: отключения в десяти областях, на Волыни без света 66 тыс. абонентов, попадания на Житомирщине и Ровенщине'
    c['uk']['t'] = 'Масований удар по енергетиці 19 жовтня: відключення в десяти областях, на Волині без світла 66 тис. абонентів, влучання на Житомирщині та Рівненщині'
    c['en']['t'] = 'Massive strike on energy facilities on 19 October: outages in ten regions, 66 thousand customers without power in Volyn, hits in the Zhytomyr and Rivne regions'
    c['place'] = 'Винницкая, Житомирская, Волынская, Ровенская, Хмельницкая, Кировоградская, Харьковская, Львовская области'
    c['uk']['p'] = 'Вінницька, Житомирська, Волинська, Рівненська, Хмельницька, Кіровоградська, Харківська, Львівська області'
    c['en']['p'] = 'Vinnytsia, Zhytomyr, Volyn, Rivne, Khmelnytskyi, Kirovohrad, Kharkiv, Lviv regions'
    c['uncertainty_reason'] = 'Данные предварительные: последствия атак уточняются, число обесточенных потребителей по большинству областей в выборке не приводится.'

@ext('1019-strikes-regions-rivne-dnipro', [12640, 12661, 12662, 12495])
def _(c):
    # UP 12661 (Dnipro, = SUS 12187), UP 12662 (Rivne, = SUS 12194) - ids only
    add(c, 'ru', 'РИА Новости со ссылкой на польское агентство воздушного движения PANSA также сообщило о временном закрытии аэропортов Люблина и Жешува из-за активности военной авиации.',
        'РИА Новости з посиланням на польське агентство повітряного руху PANSA також повідомило про тимчасове закриття аеропортів Любліна і Жешува через активність військової авіації.',
        'RIA Novosti, citing the Polish air navigation agency PANSA, also reported the temporary closure of Lublin and Rzeszow airports because of military aviation activity.',
        [(12495, 'Аэропорты польских Люблина и Жешува закрыты из-за активных полетов военной авиации')])
    c['ua'] = {'summary': '«Общественное» со ссылкой на главу Ровенской ОВА Александра Коваля пишет, что всю ночь на 19 октября ПВО отражала удар по Ровенщине, было «немало сбитий», но противник поразил несколько объектов гражданской инфраструктуры, ранены две женщины. По Днепру около 5:00 российская армия ударила управляемыми авиабомбами: повреждены частные дома, ранена 84-летняя женщина, она госпитализирована в состоянии средней тяжести; на Никопольщине повреждено предприятие, в Зайцевской громаде возник пожар. В Кривом Роге, по словам главы Совета обороны города Александра Вилкула, российская армия ударила барражирующим боеприпасом «Бандероль» по промышленному предприятию, повреждены многоэтажные дома; глава ОВА Александр Ганжа сообщил о двух раненых. На Черкасщине обезврежены ракета и два беспилотника, ударов и пострадавших нет. Николаевская ОВА сообщает об атаках «шахедов» по энергетике и ракетой «Бандероль» по Николаеву, пострадавших нет.',
        'quotes': [q(*x) for x in [
            (12194, 'Упродовж ночі сили ППО тримають удар по Рівненщині.'),
            (12194, 'За попередньою інформацією, двоє жінок поранені'),
            (12187, 'внаслідок атаки пошкоджені приватні будинки. За попередньою інформацією, у них можуть бути заблоковані люди.'),
            (12193, 'Голова Дніпропетровської облради Микола Лукашук підтвердив атаку керованими авіаційними бомбами.'),
            (12286, 'У стані середньої тяжкості госпіталізована 84-річна жінка.'),
            (12286, 'На Нікопольщині під ударом були райцентр, Покровська та Марганецька громади. Пошкоджене підприємство.'),
            (12286, 'У Зайцівській громаді Синельниківського району сталася пожежа.'),
            (12640, 'російська армія вдарила баражуючим боєприпасом типу «Бандероль». Пошкоджені багатоповерхові будинки.'),
            (12640, 'внаслідок удару поранення дістали двоє людей'),
            (12192, 'Ударів по області вдалося уникнути. Звернень про потерпілих чи пошкодження майна не надходило'),
            (12190, 'Під ударом була енергетична інфраструктура. Постраждалих немає'),
            (12190, 'Також російські війська атакували Миколаїв ракетою «Бандероль».')]]}
    c['uk']['ua'] = '«Суспільне» з посиланням на голову Рівненської ОВА Олександра Коваля пише, що всю ніч на 19 жовтня ППО відбивала удар по Рівненщині, було «чимало збиттів», але противник уразив кілька об’єктів цивільної інфраструктури, поранено двох жінок. По Дніпру близько 5:00 російська армія вдарила керованими авіабомбами: пошкоджено приватні будинки, поранено 84-річну жінку, її госпіталізовано в стані середньої тяжкості; на Нікопольщині пошкоджено підприємство, у Зайцівській громаді сталася пожежа. У Кривому Розі, за словами голови Ради оборони міста Олександра Вілкула, російська армія вдарила баражуючим боєприпасом «Бандероль» по промисловому підприємству, пошкоджено багатоповерхові будинки; начальник ОВА Олександр Ганжа повідомив про двох поранених. На Черкащині знешкоджено ракету і два безпілотники, ударів і постраждалих немає. Миколаївська ОВА повідомляє про атаки «шахедів» по енергетиці та ракетою «Бандероль» по Миколаєву, постраждалих немає.'
    c['en']['ua'] = 'Suspilne, citing Rivne regional administration head Oleksandr Koval, writes that air defences repelled a strike on the Rivne region throughout the night of 19 October with "quite a few shoot-downs", but the enemy hit several civilian infrastructure facilities and two women were injured. In Dnipro the Russian army struck with guided aerial bombs at around 5:00: private houses were damaged and an 84-year-old woman was injured and hospitalised in moderate condition; in the Nikopol district an enterprise was damaged, and a fire broke out in the Zaitseve community. In Kryvyi Rih, according to the head of the city defence council Oleksandr Vilkul, the Russian army hit an industrial enterprise with a "Banderol" loitering munition, damaging apartment blocks; regional head Oleksandr Hanzha reported two people injured. In the Cherkasy region a missile and two drones were neutralised, with no hits or casualties. The Mykolaiv regional administration reports Shahed attacks on energy facilities and a "Banderol" missile strike on Mykolaiv, with no casualties.'
    for path, old, new in [
        (('diverge',), 'удар управляемыми авиабомбами по Днепру с раненой 84-летней женщиной,', 'удар управляемыми авиабомбами по Днепру с раненой 84-летней женщиной, удар «Бандеролью» по промышленному предприятию в Кривом Роге с двумя ранеными,'),
        (('uk', 'd'), 'удар керованими авіабомбами по Дніпру з пораненою 84-річною жінкою,', 'удар керованими авіабомбами по Дніпру з пораненою 84-річною жінкою, удар «Бандероллю» по промисловому підприємству в Кривому Розі з двома пораненими,'),
        (('en', 'd'), 'a guided-bomb strike on Dnipro that injured an 84-year-old woman,', 'a guided-bomb strike on Dnipro that injured an 84-year-old woman, a Banderol strike on an industrial enterprise in Kryvyi Rih that injured two,'),
        (('title',), 'удары по Ровенщине, Днепру и Николаевщине', 'удары по Ровенщине, Днепру, Кривому Рогу и Николаевщине'),
        (('uk', 't'), 'удари по Рівненщині, Дніпру та Миколаївщині', 'удари по Рівненщині, Дніпру, Кривому Рогу та Миколаївщині'),
        (('en', 't'), 'strikes on the Rivne region, Dnipro and the Mykolaiv region', 'strikes on the Rivne region, Dnipro, Kryvyi Rih and the Mykolaiv region')]:
        rep(c, path, old, new)
    c['uncertainty_reason'] += ' В заголовке «Общественного» о Кривом Роге говорится о двух погибших, в тексте — о двух раненых.'

@ext('1019-rubio-intel-sanctions-apec', [12546, 12687, 12592, 12672, 12683, 12650, 12673, 12676])
def _(c):
    # TASS EN 12546, Interfax 12687 (same Rubio quotes: meeting talks / "no pause"); RBC 12683 (Rubio on the 60 days via Magno News);
    # SUS 12650, UP 12673 (Ihnat, = RBC 12469); Meduza EN 12676 (= Meduza 12459) - ids only; TASSr 12592 (Ihnat) - in diverge
    add(c, 'ua', '«Украинская правда» со ссылкой на Reuters приводит также слова Рубио о «вполне реальном риске эскалации» и распространения конфликта на другую страну, в том числе из-за дронов, отклоненных средствами РЭБ.',
        '«Українська правда» з посиланням на Reuters наводить також слова Рубіо про «цілком реальний ризик ескалації» та поширення конфлікту на іншу країну, зокрема через дрони, відхилені засобами РЕБ.',
        'Ukrainska Pravda, citing Reuters, also quotes Rubio on a "very real risk of escalation" and of the conflict spreading to another country, including via drones diverted by electronic warfare.',
        [(12672, 'цілком реальний ризик ескалації та поширення конфлікту'),
         (12672, 'безпілотники, уражені засобами радіоелектронної боротьби, заходять на територію сусідньої країни')])
    for path, old, new in [
        (('diverge',), ', а РБК-Украина не пересказывает слова о санкциях и АТЭС.', '; слова о санкциях и встрече на АТЭС украинские СМИ (РБК-Украина, «Украинская правда») пересказывают позже.'),
        (('uk', 'd'), ', а РБК-Україна не переказує слова про санкції та АТЕС.', '; слова про санкції та зустріч на АТЕС українські ЗМІ (РБК-Україна, «Українська правда») переказують пізніше.'),
        (('en', 'd'), ', while RBC-Ukraine does not relay his remarks on sanctions and APEC.', '; Ukrainian media (RBC-Ukraine, Ukrainska Pravda) relay his remarks on sanctions and the APEC meeting later.'),
        (('diverge',), 'российские источники в выборке об этом не пишут.', 'ТАСС передает его слова о том, что разведданные о пусках снова не поступили, не уточняя, что речь о первом ударе.'),
        (('uk', 'd'), 'російські джерела у вибірці про це не пишуть.', 'ТАСС передає його слова про те, що розвіддані про пуски знову не надійшли, не уточнюючи, що йдеться про перший удар.'),
        (('en', 'd'), 'Russian sources in the sample do not mention this.', 'TASS relays his words that intelligence on the launches again did not arrive, without specifying that this concerned the first strike.')]:
        rep(c, path, old, new)

@ext('1019-peskov-trilateral-meeting', [12607, 12663, 12675])
def _(c):
    add(c, 'ru', 'Позже ТАСС сообщило, что МИД КНР заявил об отсутствии данных о возможной встрече лидеров России, США и Китая.',
        'Пізніше ТАСС повідомило, що МЗС КНР заявило про відсутність даних щодо можливої зустрічі лідерів Росії, США і Китаю.',
        'TASS later reported that the Chinese Foreign Ministry said it had no information about a possible meeting of the leaders of Russia, the US and China.',
        [(12607, 'МИД КНР заявил об отсутствии данных о возможной встрече лидеров РФ, США и Китая')])
    add(c, 'ua', '«Украинская правда», пересказывая WSJ, приводит оценку газеты: такой саммит без участия Зеленского «стал бы беспрецедентным» и вызвал бы тревогу в европейских столицах.',
        '«Українська правда», переказуючи WSJ, наводить оцінку газети: такий саміт без участі Зеленського «став би безпрецедентним» і викликав би тривогу в європейських столицях.',
        'Ukrainska Pravda, retelling the WSJ, quotes the paper\'s assessment that such a summit without Zelensky "would be unprecedented" and would alarm European capitals.',
        [(12663, 'без участі президента України Володимира Зеленського – став би безпрецедентним і викликав би тривогу в європейських столицях')])
    add(c, 'ind', 'Meduza, пересказывая WSJ, добавляет, что такой трехсторонний формат без Зеленского и европейских лидеров Путин рассматривает как новую Ялтинскую конференцию.',
        'Meduza, переказуючи WSJ, додає, що такий тристоронній формат без Зеленського та європейських лідерів Путін розглядає як нову Ялтинську конференцію.',
        'Meduza, retelling the WSJ, adds that Putin sees such a three-way format without Zelensky and European leaders as a new Yalta conference.',
        [(12675, 'Такой трехсторонний формат без участия президента Украины Владимира Зеленского и европейских лидеров Путин рассматривает как новую Ялтинскую конференцию')])
    c['diverge'] += ' О заявлении МИД КНР, что у него нет данных о встрече, в выборке сообщает только ТАСС.'
    c['uk']['d'] += ' Про заяву МЗС КНР, що в нього немає даних про зустріч, у вибірці повідомляє лише ТАСС.'
    c['en']['d'] += ' Only TASS in the sample reports the Chinese Foreign Ministry\'s statement that it has no information about the meeting.'
    rep(c, ('uncertainty_reason',), 'то, что Зеленского не позовут, в выборке не подкреплено цитатой', 'то, что Зеленского не позовут, — формулировка WSJ, а не цитата Пескова')

