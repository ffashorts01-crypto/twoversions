import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
cards.append(C('1010-europe-reacts-diesel', [10463, 9935, 7827, 9943, 7820, 9929, 6951, 9302, 9125, 8486],
 'Европа, Австралия и Конгресс США критикуют сделку Трампа о российском дизеле', 'Брюссель, Таллин, Варшава, Лондон, Канберра, Вашингтон', 'ukraine-wide',
 [],
 S('Интерфакс цитирует главу дипломатии ЕС Каю Каллас: приостановка санкций США против российского дизеля дает Москве дополнительные доходы, «сейчас не время ослаблять давление на Россию, и Европа этого делать не будет».',
   (10463, 'Сейчас не время ослаблять давление на Россию, и Европа этого делать не будет')),
 S('РБК-Украина пишет, что, по словам Каллас, министры ЕС в понедельник одобрят крупнейший пакет санкций. Премьер Эстонии Кристен Михал призвал ЕС усилить Украину так, чтобы от российских НПЗ «остались только руины», премьер Финляндии Петтери Орпо — прекратить выдачу россиянам туристических виз, глава МИД Польши Радослав Сикорский заметил, что дефицит дизеля есть «даже в Москве». Лондон, по данным Суспільне, заявил, что продолжит давить на Россию санкциями.',
   (9935, 'Министры иностранных дел ЕС в понедельник одобрят самый большой пакет санкций против российской военной машины.'),
   (9943, 'Евросоюз должен настолько усилить Украину и ее военную мощь, чтобы от российских нефтеперерабатывающих заводов остались только руины.')),
 S('DW приводит слова Каллас о «дополнительных доходах для ведения войны». The Guardian цитирует министра энергетики Австралии Криса Боуэна: страна «не нуждается и не хочет российского топлива». Kyiv Independent пишет о двухпартийной критике сделки в Конгрессе США.',
   (9302, 'Приостановка санкций США в отношении российского дизельного топлива предоставит РФ "дополнительные доходы для ведения войны "'),
   (9125, 'Russia “should not be rewarded for their illegal and immoral invasion of Ukraine”'),
   (8486, 'drew sharp criticism on Oct. 10 from both Democrats and Republicans in Congress')),
 'Источники единодушно передают критику сделки; российские сообщают в основном позицию Каллас, украинские и независимые — более широкий круг реакций, включая Конгресс США.',
 'low', '', False,
 ['Європа, Австралія і Конгрес США критикують угоду Трампа щодо російського дизеля', 'Брюссель, Таллінн, Варшава, Лондон, Канберра, Вашингтон',
  'Джерела одностайно передають критику угоди; російські повідомляють переважно позицію Каллас, українські й незалежні — ширше коло реакцій, зокрема Конгресу США.',
  'Інтерфакс цитує очільницю дипломатії ЄС Каю Каллас: призупинення санкцій США проти російського дизеля дає Москві додаткові доходи, «зараз не час послаблювати тиск на Росію, і Європа цього не робитиме».',
  'РБК-Україна пише, що, за словами Каллас, міністри ЄС у понеділок схвалять найбільший пакет санкцій. Прем’єр Естонії Крістен Міхал закликав ЄС посилити Україну так, щоб від російських НПЗ «залишилися лише руїни», прем’єр Фінляндії Петтері Орпо — припинити видачу росіянам туристичних віз, глава МЗС Польщі Радослав Сікорський зауважив, що дефіцит дизеля є «навіть у Москві». Лондон, за даними Суспільного, заявив, що продовжить тиснути на Росію санкціями.',
  'DW наводить слова Каллас про «додаткові доходи для ведення війни». The Guardian цитує міністра енергетики Австралії Кріса Боуена: країна «не потребує і не хоче російського пального». Kyiv Independent пише про двопартійну критику угоди в Конгресі США.'],
 ['Europe, Australia and the US Congress criticise Trump\'s Russian diesel deal', 'Brussels, Tallinn, Warsaw, London, Canberra, Washington',
  'The sources uniformly report criticism of the deal; Russian ones mostly convey Kallas\'s position, Ukrainian and independent ones a wider range of reactions, including in the US Congress.',
  'Interfax quotes EU foreign policy chief Kaja Kallas: suspending US sanctions on Russian diesel gives Moscow extra revenue, and "now is not the time to ease pressure on Russia, and Europe will not do so".',
  'RBC-Ukraine writes that, according to Kallas, EU ministers will approve the largest sanctions package on Monday. Estonian Prime Minister Kristen Michal urged the EU to strengthen Ukraine so that only "ruins" remain of Russian refineries, Finnish Prime Minister Petteri Orpo called for ending tourist visas for Russians, and Polish Foreign Minister Radoslaw Sikorski noted a diesel shortage "even in Moscow". London, according to Suspilne, said it will keep up sanctions pressure on Russia.',
  'DW quotes Kallas on "additional revenue to wage war". The Guardian quotes Australian Energy Minister Chris Bowen: the country does not "need or want Russian fuel". Kyiv Independent reports bipartisan criticism of the deal in the US Congress.']))

cards.append(C('1010-miami-talks-outcome', [10425, 4547, 10474, 4577, 8474],
 'Итоги встречи в Майами: Уиткофф — «конструктивно», украинская делегация возвращается досрочно', 'Майами', 'ukraine-wide',
 ['одна из групп не освещает'],
 S('Интерфакс цитирует Стива Уиткоффа: представители США, Франции, ФРГ, Великобритании, Еврокомиссии, Украины и НАТО провели «конструктивную встречу». РИА Новости со ссылкой на советника Зеленского Дмитрия Литвина пишет, что украинская делегация возвращается в Киев после досрочного прекращения переговоров. По данным NYT в пересказе Интерфакса, Уиткофф и Кушнер ранее предлагали России разморозить активы в обмен на ограниченное прекращение огня.',
   (10425, 'Переговоры США с представителями Украины и европейских стране в Майами прошли конструктивно'),
   (4547, 'Украинская делегация возвращается в Киев из США после досрочного прекращения переговоров')),
 None,
 S('Kyiv Independent пишет, что встреча 9 октября, названная Уиткоффом «конструктивной», прошла в тот же день, когда Вашингтон ослабил ограничения на экспорт российского дизеля.',
   (8474, 'on the same day Washington moved to ease restrictions on Russian diesel exports')),
 'Американская сторона называет встречу конструктивной, тогда как, по данным российских источников со ссылкой на Литвина и FT, переговоры прекращены досрочно; независимые источники связывают это со сделкой о дизеле.',
 'low', '', False,
 ['Підсумки зустрічі в Маямі: Віткофф — «конструктивно», українська делегація повертається достроково', 'Маямі',
  'Американська сторона називає зустріч конструктивною, тоді як, за даними російських джерел із посиланням на Литвина і FT, переговори припинено достроково; незалежні джерела пов’язують це з угодою щодо дизеля.',
  'Інтерфакс цитує Стіва Віткоффа: представники США, Франції, ФРН, Великої Британії, Єврокомісії, України і НАТО провели «конструктивну зустріч». РІА Новини з посиланням на радника Зеленського Дмитра Литвина пише, що українська делегація повертається до Києва після дострокового припинення переговорів. За даними NYT у переказі Інтерфаксу, Віткофф і Кушнер раніше пропонували Росії розморозити активи в обмін на обмежене припинення вогню.',
  None,
  'Kyiv Independent пише, що зустріч 9 жовтня, яку Віткофф назвав «конструктивною», відбулася того ж дня, коли Вашингтон послабив обмеження на експорт російського дизеля.'],
 ['Outcome of the Miami meeting: Witkoff says "constructive", Ukrainian delegation returns early', 'Miami',
  'The US side calls the meeting constructive, while, according to Russian sources citing Lytvyn and the FT, the talks were cut short; independent sources link this to the diesel deal.',
  'Interfax quotes Steve Witkoff: representatives of the US, France, Germany, the UK, the European Commission, Ukraine and NATO held a "constructive meeting". RIA Novosti, citing Zelensky adviser Dmytro Lytvyn, writes that the Ukrainian delegation is returning to Kyiv after the talks ended early. According to the NYT as relayed by Interfax, Witkoff and Kushner had earlier offered Russia unfrozen assets in exchange for a limited ceasefire.',
  None,
  'Kyiv Independent writes that the 9 October meeting, which Witkoff called "constructive", took place on the same day Washington eased restrictions on Russian diesel exports.']))

cards.append(C('1010-oleshky-humanitarian', [10424, 4541, 5649, 8485],
 'Алешки: Москва говорит о гуманитарном кризисе по вине ВСУ, Kyiv Independent — о готовящейся дезинформации', 'Алешки (Олешки), Херсонская область', 'kherson',
 ['расхождение: ответственность'],
 S('Помощник президента РФ Юрий Ушаков сообщил, что Путин и Трамп затронули гуманитарную ситуацию в Алешках, а омбудсмен Яна Лантратова будет на связи с аппаратом Мелании Трамп. Лантратова, по данным ТАСС, заявила, что кризис вызван блокадой, «умышленно» установленной ВСУ, и сообщила о сложных переговорах о доставке гуманитарных грузов и эвакуации.',
   (10424, 'Президенты РФ и США Владимир Путин и Дональд Трамп затронули гуманитарную ситуацию в городе Алешки Херсонской области'),
   (5649, 'The humanitarian crisis in Alyoshki was caused by a blockade deliberately imposed by the Ukrainian armed forces')),
 None,
 S('Kyiv Independent пишет, что Россия готовит дезинформационную кампанию с постановочными интервью жителей оккупированных Олешек.',
   (8485, 'Russia prepares a disinformation campaign involving staged interviews with residents of the Russian-occu')),
 'Российская сторона возлагает ответственность за кризис на ВСУ и выводит тему на уровень Путина и Трампа; Kyiv Independent представляет это как подготовку дезинформационной кампании. Украинские официальные источники в выборке 10 октября тему не комментируют.',
 'medium', 'Противоположные версии, гуманитарная ситуация независимо не проверена.', True,
 ['Олешки: Москва говорить про гуманітарну кризу з вини ЗСУ, Kyiv Independent — про підготовку дезінформації', 'Олешки, Херсонська область',
  'Російська сторона покладає відповідальність за кризу на ЗСУ і виводить тему на рівень Путіна і Трампа; Kyiv Independent подає це як підготовку дезінформаційної кампанії. Українські офіційні джерела у вибірці 10 жовтня тему не коментують.',
  'Помічник президента РФ Юрій Ушаков повідомив, що Путін і Трамп торкнулися гуманітарної ситуації в Олешках, а омбудсменка Яна Лантратова буде на зв’язку з апаратом Меланії Трамп. Лантратова, за даними ТАСС, заявила, що кризу спричинила блокада, «умисно» встановлена ЗСУ, і повідомила про складні переговори щодо доставки гуманітарних вантажів та евакуації.',
  None,
  'Kyiv Independent пише, що Росія готує дезінформаційну кампанію з постановочними інтерв’ю мешканців окупованих Олешок.'],
 ['Oleshky: Moscow blames Ukraine for a humanitarian crisis, Kyiv Independent reports a disinformation campaign in preparation', 'Oleshky, Kherson Oblast',
  'The Russian side blames the crisis on the Ukrainian army and raises the topic to the level of Putin and Trump; Kyiv Independent presents it as preparation for a disinformation campaign. Ukrainian official sources in the sample do not comment on the topic on 10 October.',
  'Presidential aide Yuri Ushakov said Putin and Trump discussed the humanitarian situation in Oleshky and that ombudswoman Yana Lantratova will be in contact with Melania Trump\'s office. Lantratova, according to TASS, said the crisis was caused by a blockade "deliberately" imposed by the Ukrainian army and reported difficult negotiations on delivering aid and evacuation.',
  None,
  'Kyiv Independent writes that Russia is preparing a disinformation campaign with staged interviews of residents of occupied Oleshky.']))

cards.append(C('1010-front-claims', [10428, 10448, 4539, 6945, 7841],
 'Фронт: Минобороны РФ — Лукашово и Лобановка «в кольце окружения», продвижение в Доброполье; Генштаб ВСУ — около 200 боев за день', 'Харьковская и Донецкая области', 'donetsk',
 ['атрибуция', 'не проверено независимо'],
 S('Минобороны РФ заявило, что группировка «Север» в «кольце окружения» взяла под контроль Лукашово и Лобановку в Харьковской области и пресекла попытки ВСУ деблокировать окруженные силы, а в Доброполье российские войска продвинулись в центре и на северо-западе, на территории шахты «Добропольская».',
   (10448, 'В кольце окружения в ходе активных боевых действий взяты под контроль населенные пункты Лукашово и Лобановка Харьковской области'),
   (4539, 'Российские войска продвинулись в центре и на северо-западе Доброполья')),
 S('Генштаб ВСУ сообщил, что накануне российские войска нанесли 88 авиаударов с 282 управляемыми бомбами, а за текущие сутки до 22:00 произошли 195 боевых столкновений, больше всего на Покровском, Гуляйпольском и Константиновском направлениях.',
   (6945, 'Вчора війська РФ завдали одного ракетного та 88 авіаційних ударів, зокрема скинули 282 керовані авіабомби.'),
   (7841, 'На фронті від початку доби відбулося 195 бойових зіткнень')),
 None,
 'Стороны описывают разные аспекты боев; украинская сводка не подтверждает и не опровергает заявленное Минобороны РФ окружение в Харьковской области. Независимой проверки нет.',
 'medium', 'Фронтовые заявления сторон не проверены независимо.', False,
 ['Фронт: Міноборони РФ — Лукашове і Лобанівка «в кільці оточення», просування в Добропіллі; Генштаб ЗСУ — близько 200 боїв за день', 'Харківська і Донецька області',
  'Сторони описують різні аспекти боїв; українське зведення не підтверджує і не спростовує заявленого Міноборони РФ оточення в Харківській області. Незалежної перевірки немає.',
  'Міноборони РФ заявило, що угруповання «Північ» у «кільці оточення» взяло під контроль Лукашове і Лобанівку в Харківській області та припинило спроби ЗСУ деблокувати оточені сили, а в Добропіллі російські війська просунулися в центрі й на північному заході, на території шахти «Добропільська».',
  'Генштаб ЗСУ повідомив, що напередодні російські війська завдали 88 авіаударів із 282 керованими бомбами, а за поточну добу до 22:00 відбулося 195 бойових зіткнень, найбільше на Покровському, Гуляйпільському і Костянтинівському напрямках.',
  None],
 ['Front line: Russia says Lukashove and Lobanivka taken "inside an encirclement", advance in Dobropillia; Ukraine reports about 200 clashes', 'Kharkiv and Donetsk oblasts',
  'The sides describe different aspects of the fighting; the Ukrainian report neither confirms nor denies the encirclement in Kharkiv region claimed by Russia. There is no independent verification.',
  'The Russian Defence Ministry said its North group took control of Lukashove and Lobanivka in Kharkiv region "inside the encirclement" and thwarted Ukrainian attempts to relieve the encircled forces, and that in Dobropillia Russian troops advanced in the centre and north-west, on the grounds of the Dobropilska mine.',
  'Ukraine\'s General Staff said that the previous day Russian forces carried out 88 air strikes with 282 guided bombs, and that by 22:00 that day there had been 195 clashes, most of them in the Pokrovsk, Huliaipole and Kostiantynivka directions.',
  None]))

cards.append(C('1010-russian-side-casualties', [10435, 10457, 4549, 10462, 10433, 10467, 10440],
 'Российские власти: обстрелы Белгородской области и ЛНР, удар по Запорожской ТЭС, поврежденные суда в Азове; Минобороны — сухогруз на пути в Одессу', 'Белгородская область, оккупированные территории, Азов', 'russia-other',
 ['единственный источник'],
 S('Губернатор Белгородской области Александр Шуваев сообщил о 106 атаках за сутки, есть погибшие и раненые; глава ЛНР Леонид Пасечник — о четырех погибших и пятерых раненых. Глава администрации Энергодара Максим Пухов заявил об артобстреле Запорожской ТЭС и здания медсанчасти. Губернатор Ростовской области сообщил о двух поврежденных судах в Азове. Минобороны РФ заявило о поражении сухогруза, доставлявшего в порт Одесса «грузы военного назначения».',
   (10435, 'За минувшие сутки ВСУ 106 раз атаковали территорию Белгородской области'),
   (10457, 'погибли четверо мирных жителей, еще пятеро получили ранения'),
   (10462, 'ВСУ атаковали Запорожскую ТЭС и здание медсанчасти в Энергодаре'),
   (10433, 'поражено морское судно типа "сухогруз", доставлявшее в порт Одесса грузы военного назначения')),
 None, None,
 'Данные исходят только от российских и назначенных Россией властей; украинские и независимые источники в выборке эти сообщения не комментируют.',
 'medium', 'Одна группа источников, нет независимого подтверждения.', False,
 ['Російська влада: обстріли Бєлгородської області та «ЛНР», удар по Запорізькій ТЕС, пошкоджені судна в Азові; Міноборони — суховантаж на шляху до Одеси', 'Бєлгородська область, окуповані території, Азов',
  'Дані походять лише від російської та призначеної Росією влади; українські й незалежні джерела у вибірці ці повідомлення не коментують.',
  'Губернатор Бєлгородської області Олександр Шуваєв повідомив про 106 атак за добу, є загиблі й поранені; очільник «ЛНР» Леонід Пасічник — про чотирьох загиблих і п’ятьох поранених. Глава окупаційної адміністрації Енергодара Максим Пухов заявив про артобстріл Запорізької ТЕС і будівлі медсанчастини. Губернатор Ростовської області повідомив про два пошкоджені судна в Азові. Міноборони РФ заявило про ураження суховантажу, який доставляв до порту Одеса «вантажі військового призначення».',
  None, None],
 ['Russian authorities: shelling of Belgorod region and occupied Luhansk, strike on Zaporizhzhia thermal plant, ships damaged in Azov; Defence Ministry claims a cargo ship bound for Odesa', 'Belgorod Oblast, occupied territories, Azov',
  'The information comes only from Russian and Russian-installed authorities; Ukrainian and independent sources in the sample do not comment on these reports.',
  'Belgorod governor Alexander Shuvayev reported 106 attacks over the day, with dead and injured; Russian-installed Luhansk head Leonid Pasechnik reported four civilians killed and five injured. Enerhodar\'s Russian-installed administrator Maxim Pukhov reported shelling of the Zaporizhzhia thermal power plant and a medical unit building. The Rostov governor reported two ships damaged in Azov. The Russian Defence Ministry said it hit a cargo ship carrying "military cargo" to the port of Odesa.',
  None, None]))

