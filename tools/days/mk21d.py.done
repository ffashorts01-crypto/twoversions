# ---- extension of an earlier Oct 21 card (new articles 15365, 15366 collected at 01:00) ----
@ext('1021-kyiv-ballistic-evening-strike', [15365, 15366])
def _(c):
    add(c, 'ind',
        "DW со ссылкой на Кличко сообщает о шести пострадавших, четверо госпитализированы, и по предварительным данным называет число ракет — 10, в том числе «Искандер-М», «Циркон» и С-400. The Kyiv Independent приводит рассказ жителя, который вместе с соседями вытащил из горящего дома мужчину и его жену.",
        "DW з посиланням на Кличка повідомляє про шістьох постраждалих, четверо госпіталізовані, і за попередніми даними називає кількість ракет — 10, зокрема «Іскандер-М», «Циркон» і С-400. The Kyiv Independent наводить розповідь мешканця, який разом із сусідами витягнув із палаючого будинку чоловіка та його дружину.",
        "DW, citing Klitschko, reports six injured, four of them hospitalised, and, citing preliminary data, puts the number of missiles at 10, including Iskander-M, Zircon and S-400. The Kyiv Independent quotes a resident who, together with neighbours, pulled a man and his wife out of a burning house.",
        [(15366, 'по городу было выпущено 10 ракет, в том числе Искандер-М, Циркон и С-400'),
         (15365, 'Fortunately, we managed to rescue a man and his wife who were inside the burning house.')])
    setd(c,
        c['diverge'] + " Число и типы ракет по предварительным данным называет только DW.",
        c['uk']['d'] + " Кількість і типи ракет за попередніми даними називає лише DW.",
        c['en']['d'] + " Only DW gives the number and types of missiles, citing preliminary data.")
apply(['c21b.json'])
