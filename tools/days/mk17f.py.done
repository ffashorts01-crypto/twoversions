cards = []
card = lambda *a: cards.append(C(*a))

card('1017-romania-f16-black-sea', [4992, 11028, 11058, 4980, 7361, 8270, 8784, 9487, 9480],
 'Румынские F-16 сбили два беспилотника над Черным морем; Минобороны РФ заявило о поражении сухогруза у Одессы', 'Черное море, Румыния, Одесса', 'odesa',
 ['одна из групп не освещает', 'российская сторона заявляет, украинская не комментирует'],
 S('РИА Новости со ссылкой на минобороны Румынии сообщает, что два румынских F-16 сбили два беспилотника над территориальными водами страны. Отдельно Минобороны РФ заявило, что в 40 км южнее порта Одесса поражен сухогруз с грузами военного и двойного назначения.',
   (4992, 'Румынские истребители F-16 сбили два беспилотника над территориальными водами Румынии, сообщило румынское министерство обороны.'),
   (11058, 'поражено морское судно типа "сухогруз", перевозившее в грузы военного и двойного назначения')),
 S('Суспильне и «Украинская правда» пишут об уничтожении двух дронов со ссылкой на минобороны и МИД Румынии; происхождение беспилотников не установлено, Румыния инициировала отдельное заседание Североатлантического совета по безопасности в Черном море. Заявление Минобороны РФ о сухогрузе украинские источники в выборке не комментируют.',
   (7361, 'Румунія повідомила НАТО та партнерів про інцидент. Походження безпілотників не відоме.')),
 S('DW подтверждает по данным Reuters и минобороны Румынии, что F-16 сбили два дрона, напоминая о недавней атаке дронов на химические танкеры у Сулинского канала; DW также сообщает, что Бухарест предложил взять на себя часть расходов на американский контингент.',
   (8784, 'Romanian F-16 fighter jets have shot down two drones over the country\'s territorial waters, according to the Romanian Defense Ministry.')),
 'Об инциденте с дронами над Румынией сообщают все группы; заявление Минобороны РФ о поражении сухогруза у Одессы не подтверждено ни украинскими, ни независимыми источниками.',
 'medium', 'Заявление о поражении судна исходит только от Минобороны РФ; происхождение дронов над Румынией не установлено.', False,
 ['Румунські F-16 збили два безпілотники над Чорним морем; Міноборони РФ заявило про ураження суховантажу біля Одеси', 'Чорне море, Румунія, Одеса',
  'Про інцидент із дронами над Румунією повідомляють усі групи; заяву Міноборони РФ про ураження суховантажу біля Одеси не підтверджено ні українськими, ні незалежними джерелами.',
  'РИА Новости з посиланням на міноборони Румунії повідомляє, що два румунські F-16 збили два безпілотники над територіальними водами країни. Окремо Міноборони РФ заявило, що за 40 км на південь від порту Одеса уражено суховантаж із вантажами військового та подвійного призначення.',
  'Суспільне та «Українська правда» пишуть про знищення двох дронів із посиланням на міноборони та МЗС Румунії; походження безпілотників не встановлено, Румунія ініціювала окреме засідання Північноатлантичної ради щодо безпеки в Чорному морі. Заяву Міноборони РФ про суховантаж українські джерела у вибірці не коментують.',
  'DW підтверджує за даними Reuters і міноборони Румунії, що F-16 збили два дрони, нагадуючи про нещодавню атаку дронів на хімічні танкери біля Сулінського каналу; DW також повідомляє, що Бухарест запропонував узяти на себе частину витрат на американський контингент.'],
 ['Romanian F-16s shoot down two drones over the Black Sea; Russian MoD claims a hit on a cargo ship off Odesa', 'Black Sea, Romania, Odesa',
  'All groups report the drone incident over Romania; the Russian MoD claim of hitting a cargo ship off Odesa is not confirmed by Ukrainian or independent sources.',
  'RIA Novosti, citing Romania\'s defence ministry, reports that two Romanian F-16s shot down two drones over the country\'s territorial waters. Separately, the Russian MoD said a cargo ship carrying military and dual-use cargo was hit 40 km south of the port of Odesa.',
  'Suspilne and Ukrainska Pravda report the downing of two drones, citing Romania\'s defence and foreign ministries; the drones\' origin has not been established, and Romania called a separate North Atlantic Council meeting on Black Sea security. Ukrainian sources in the sample do not comment on the Russian MoD claim about the cargo ship.',
  'DW confirms, citing Reuters and Romania\'s defence ministry, that F-16s shot down two drones, recalling the recent drone attack on chemical tankers near the Sulina Canal; DW also reports that Bucharest offered to cover part of the cost of the US contingent.'])

card('1017-moldova-ukrainian-border-guards', [4972, 7307],
 'В Молдове задержали двух украинских пограничников, пересекших Днестр при задержании мужчины', 'Голошница, Молдова', 'ukraine-wide',
 ['расхождение: формулировки'],
 S('РИА Новости, ссылаясь на видео из молдавских соцсетей, пишет, что жители Молдовы обвинили украинских пограничников в попытке утопить переплывавшего Днестр мужчину и что при этом украинцы пересекли границу.',
   (4972, 'Жители Молдавии обвинили украинских пограничников в попытке утопить переплывавшего Днестр мужчину')),
 S('Суспильне со ссылкой на пограничную полицию Молдовы сообщает, что двое украинских пограничников на моторной лодке пересекли границу у села Голошница во время задержания гражданина Украины; молдавский патруль задержал их, дело передано в прокуратуру.',
   (7307, 'Патруль молдовської прикордонної поліції вирушив на місце події та затримав обох українських службовців.')),
 None,
 'РИА делает акцент на обвинениях в «попытке утопить» мужчину со ссылкой на соцсети; Суспильне излагает официальную версию молдавской погранполиции о задержании нарушителя без таких формулировок.',
 'medium', 'Обстоятельства инцидента известны по пресс-релизу и видео из соцсетей; украинская погранслужба в выборке не комментирует.', False,
 ['У Молдові затримали двох українських прикордонників, які перетнули Дністер під час затримання чоловіка', 'Голошниця, Молдова',
  'РИА робить акцент на звинуваченнях у «спробі втопити» чоловіка з посиланням на соцмережі; Суспільне викладає офіційну версію молдовської прикордонної поліції про затримання порушника без таких формулювань.',
  'РИА Новости, посилаючись на відео з молдовських соцмереж, пише, що жителі Молдови звинуватили українських прикордонників у спробі втопити чоловіка, який перепливав Дністер, і що при цьому українці перетнули кордон.',
  'Суспільне з посиланням на прикордонну поліцію Молдови повідомляє, що двоє українських прикордонників на моторному човні перетнули кордон біля села Голошниця під час затримання громадянина України; молдовський патруль затримав їх, справу передано до прокуратури.',
  None],
 ['Moldova detains two Ukrainian border guards who crossed the Dniester while detaining a man', 'Holoshnytsia, Moldova',
  'RIA stresses accusations of an "attempt to drown" the man, citing social media; Suspilne gives the official account of Moldova\'s border police about detaining a violator, without such wording.',
  'RIA Novosti, citing videos from Moldovan social media, writes that Moldovan residents accused Ukrainian border guards of trying to drown a man swimming across the Dniester and that the Ukrainians crossed the border in the process.',
  'Suspilne, citing Moldova\'s border police, reports that two Ukrainian border guards in a motorboat crossed the border near the village of Holoshnytsia while detaining a Ukrainian citizen; a Moldovan patrol detained them and the case was passed to prosecutors.',
  None])

card('1017-pow-executions-huliaipole', [8250, 8667],
 'Силы обороны: российские военные казнили украинских пленных на Гуляйпольском направлении', 'Гуляйпольское направление, Запорожская область', 'zaporizhzhia',
 ['одна из групп не освещает', 'не проверено'],
 None,
 S('«Украинская правда» со ссылкой на спикера группировки «Юг» Максима Кравчука и Офис генпрокурора сообщает, что военные, вероятно, 38-й отдельной мотострелковой бригады РФ казнили захваченных в плен украинских бойцов; факт зафиксировали украинские военные.',
   (8250, 'стратили військовослужбовців ЗСУ, яких до того захопили у полон')),
 S('Kyiv Independent пересказывает слова Кравчука: украинские военные перехватили радиопереговоры российских солдат во время предполагаемых казней.',
   (8667, 'Ukrainian forces intercepted radio communications between Russian soldiers as the alleged executions took place')),
 'Российские источники в выборке обвинения не освещают; независимого подтверждения нет, Kyiv Independent называет казни предполагаемыми.',
 'medium', 'Обвинение основано на данных украинских военных и перехвате, независимо не проверено.', False,
 ['Сили оборони: російські військові стратили українських полонених на Гуляйпільському напрямку', 'Гуляйпільський напрямок, Запорізька область',
  'Російські джерела у вибірці звинувачення не висвітлюють; незалежного підтвердження немає, Kyiv Independent називає страти ймовірними.',
  None,
  '«Українська правда» з посиланням на речника угруповання «Південь» Максима Кравчука та Офіс генпрокурора повідомляє, що військові, ймовірно, 38-ї окремої мотострілецької бригади РФ стратили захоплених у полон українських бійців; факт зафіксували українські військові.',
  'Kyiv Independent переказує слова Кравчука: українські військові перехопили радіопереговори російських солдатів під час ймовірних страт.'],
 ['Defence forces: Russian troops executed Ukrainian POWs on the Huliaipole axis', 'Huliaipole axis, Zaporizhzhia region',
  'Russian sources in the sample do not cover the accusation; there is no independent confirmation, and Kyiv Independent calls the executions alleged.',
  None,
  'Ukrainska Pravda, citing Southern Forces Group spokesperson Maksym Kravchuk and the Prosecutor General\'s Office, reports that troops probably from Russia\'s 38th Separate Motor Rifle Brigade executed captured Ukrainian soldiers; Ukrainian troops recorded the fact.',
  'Kyiv Independent relays Kravchuk\'s words: Ukrainian troops intercepted radio communications between Russian soldiers during the alleged executions.'])

card('1017-un-civilian-casualties-displacement', [8972, 7294, 8655],
 'ООН: число погибших и раненых мирных жителей в Украине в сентябре выросло на 85%; МОМ предупреждает о новом переселении зимой', 'Украина', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('РБК-Украина со ссылкой на Мониторинговую миссию ООН сообщает, что в сентябре погибли не менее 328 мирных жителей и 2105 получили ранения, что на 85% больше, чем годом ранее. Суспильне пишет о предупреждении МОМ: вернувшиеся домой украинцы зимой могут снова покинуть жилье из-за атак на энергетику и затрат на отопление.',
   (8972, 'У вересні в Україні загинули щонайменше 328 цивільних, ще 2105 дістали поранення.'),
   (7294, 'українці, які повернулися додому після вимушеного виїзду, взимку можуть знову залишити домівки')),
 S('Kyiv Independent приводит оценку МОМ: миллионы вернувшихся украинцев рискуют снова стать переселенцами этой зимой из-за российских ударов по гражданской инфраструктуре.',
   (8655, 'Millions of Ukrainians who returned home are at risk of displacement this winter as Russia continues its attacks on civilian infrastructure')),
 'Российские источники в выборке доклады ООН не освещают; украинские и независимые источники совпадают.',
 'low', '', False,
 ['ООН: кількість загиблих і поранених цивільних в Україні у вересні зросла на 85%; МОМ попереджає про нове переселення взимку', 'Україна',
  'Російські джерела у вибірці доповіді ООН не висвітлюють; українські та незалежні джерела збігаються.',
  None,
  'РБК-Україна з посиланням на Моніторингову місію ООН повідомляє, що у вересні загинули щонайменше 328 цивільних і 2105 дістали поранення, що на 85% більше, ніж роком раніше. Суспільне пише про попередження МОМ: українці, які повернулися додому, взимку можуть знову залишити житло через атаки на енергетику та витрати на опалення.',
  'Kyiv Independent наводить оцінку МОМ: мільйони українців, які повернулися, ризикують знову стати переселенцями цієї зими через російські удари по цивільній інфраструктурі.'],
 ['UN: civilian deaths and injuries in Ukraine rose 85% in September; IOM warns of new displacement this winter', 'Ukraine',
  'Russian sources in the sample do not cover the UN reports; Ukrainian and independent sources agree.',
  None,
  'RBC-Ukraine, citing the UN Human Rights Monitoring Mission, reports that at least 328 civilians were killed and 2105 injured in September, 85% more than a year earlier. Suspilne reports the IOM warning that Ukrainians who returned home may leave again in winter because of attacks on energy and heating costs.',
  'Kyiv Independent cites the IOM estimate that millions of returnees risk displacement again this winter because of Russian strikes on civilian infrastructure.'])

card('1017-kyiv-klitschko-protest', [9482, 8661, 8244],
 'В Киеве прошла акция с требованием отставки мэра Кличко из-за подготовки к зиме', 'Киев', 'kyiv',
 ['расхождение: числа', 'одна из групп не освещает'],
 None,
 S('«Украинская правда» сообщает, что на Крещатике у здания КГГА около 200 человек, по подсчетам полиции, требовали отставки Виталия Кличко, держа плакаты вроде «Кличку поздно метаться, пора прощаться».',
   (8244, 'За підрахунками поліції, в акції беруть участь близько 200 людей.')),
 S('Корреспондентка DW насчитала около 400 участников, недовольных подготовкой Киева к зиме и коммунальными услугами; Kyiv Independent пишет о сотнях протестующих и акции длиной более двух часов.',
   (9482, 'По ее оценке, в демонстрации участвует примерно 400 человек.'),
   (8661, '"Kyiv without Klitschko," hundreds of protesters chanted as they took to the streets in central Kyiv')),
 'Оценки численности расходятся: около 200 человек по данным полиции (УП) и около 400 по оценке корреспондентки DW. Российские источники в выборке акцию не освещают.',
 'low', '', False,
 ['У Києві відбулася акція з вимогою відставки мера Кличка через підготовку до зими', 'Київ',
  'Оцінки чисельності розходяться: близько 200 людей за даними поліції (УП) і близько 400 за оцінкою кореспондентки DW. Російські джерела у вибірці акцію не висвітлюють.',
  None,
  '«Українська правда» повідомляє, що на Хрещатику біля будівлі КМДА близько 200 людей, за підрахунками поліції, вимагали відставки Віталія Кличка, тримаючи плакати на кшталт «Кличку пізно метатися, пора прощатися».',
  'Кореспондентка DW нарахувала близько 400 учасників, невдоволених підготовкою Києва до зими та комунальними послугами; Kyiv Independent пише про сотні протестувальників і акцію, що тривала понад дві години.'],
 ['Kyiv rally demands Mayor Klitschko resign over winter preparations', 'Kyiv',
  'Crowd estimates differ: about 200 people according to police (UP) and about 400 according to a DW correspondent. Russian sources in the sample do not cover the rally.',
  None,
  'Ukrainska Pravda reports that about 200 people, by police count, demanded Vitali Klitschko\'s resignation on Khreshchatyk outside the city administration, holding placards such as "Too late for Klitschko to rush about, time to say goodbye".',
  'A DW correspondent counted about 400 participants unhappy with Kyiv\'s winter preparations and utilities; Kyiv Independent writes of hundreds of protesters and a rally lasting over two hours.'])

card('1017-putin-restoration-programme', [11045, 8712],
 'Путин поручил правительству утвердить программу восстановления торговой и логистической инфраструктуры, пострадавшей от украинских ударов', 'Россия', 'russia',
 ['расхождение: формулировки', 'одна из групп не освещает'],
 S('«Интерфакс» сообщает о поручении Путина утвердить программу восстановления объектов торговой и логистической инфраструктуры, «пострадавших в результате террористических актов».',
   (11045, 'Утвердить программу восстановления объектов торговой и логистической инфраструктуры, пострадавших в результате террористических актов')),
 None,
 S('Meduza пишет о том же поручении, называя причиной повреждений украинские удары; пункт включен в перечень поручений по итогам заседания Совета по стратегическому развитию и нацпроектам.',
   (8712, 'Соответствующий пункт включен в перечень поручений по итогам заседания Совета при президенте по стратегическому развитию и национальным проектам.')),
 'Российские источники говорят о «террористических актах», Meduza — об украинских ударах. Украинские источники в выборке поручение не освещают.',
 'low', '', False,
 ['Путін доручив уряду затвердити програму відновлення торговельної та логістичної інфраструктури, що постраждала від українських ударів', 'Росія',
  'Російські джерела говорять про «терористичні акти», Meduza — про українські удари. Українські джерела у вибірці доручення не висвітлюють.',
  '«Інтерфакс» повідомляє про доручення Путіна затвердити програму відновлення об’єктів торговельної та логістичної інфраструктури, «що постраждали внаслідок терористичних актів».',
  None,
  'Meduza пише про те саме доручення, називаючи причиною пошкоджень українські удари; пункт включено до переліку доручень за підсумками засідання Ради зі стратегічного розвитку та нацпроєктів.'],
 ['Putin orders the government to approve a programme to restore trade and logistics infrastructure damaged by Ukrainian strikes', 'Russia',
  'Russian sources speak of "terrorist acts", Meduza of Ukrainian strikes. Ukrainian sources in the sample do not cover the order.',
  'Interfax reports Putin\'s order to approve a programme to restore trade and logistics facilities "damaged as a result of terrorist acts".',
  None,
  'Meduza reports the same order, naming Ukrainian strikes as the cause of the damage; the item was included in the list of instructions following a meeting of the Council for Strategic Development and National Projects.'])

card('1017-italy-crosetto-us-mistake', [8330, 8236],
 'Министр обороны Италии Крозетто: ограничение США доступа Украины к спутникам и разведке — «серьезная ошибка»', 'Рим', 'ukraine-wide',
