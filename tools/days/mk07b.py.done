import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from mk07 import S, C
cards = json.load(open('/tmp/c07a.json'))

cards.append(C('1007-kyiv-day-evening', [4371, 7662, 9800, 9806, 7676, 9808, 7680],
 'Дневная и вечерняя атаки на Киев 7 октября: погибший, пожар в многоэтажке', 'Киев: Соломенский, Оболонский и Деснянский районы', 'kyiv',
 ['умолчание', 'расхождение: числа погибших'],
 S('РИА Новости со ссылкой на мэра Киева Виталия Кличко сообщает, что столица частично осталась без света и воды: из-за проблем с электроснабжением обесточены насосные станции, на правом берегу перебои с водоснабжением. Об атаке и пострадавших в заметке не говорится.',
   (4371, 'Из-за проблемы с электроснабжением частично обесточены водопроводные насосные станции. На правом берегу города перебои с водоснабжением')),
 S('По данным Кличко, ГСЧС и КГВА (Українська правда), в результате дневной атаки погиб мужчина, на Оболони возле горящего автомобиля нашли тело женщины, а число пострадавших в Соломенском и Оболонском районах к вечеру достигло 13. Вечером, по данным ГСЧС, российский дрон попал в 12-этажный дом в Деснянском районе на уровне 10-го этажа: четверо пострадавших, среди них дети, спасены 22 человека, в том числе 8 детей.',
   (7662, 'Внаслідок російської атаки на Київ 7 жовтня загинув чоловік'),
   (7680, 'Рятувальникам вдалося врятувати 22 особи, зокрема 8 дітей.'),
   (9806, 'По данным мэра, пожар загорелся в 12-этажном доме.')),
 None,
 'РИА Новости сообщает о перебоях со светом и водой со ссылкой на Кличко, но не связывает их с атакой и не упоминает пострадавших. В украинских материалах неясно число погибших: Українська правда пишет о погибшем мужчине и о теле женщины, найденном на Оболони, РБК-Украина — об одном погибшем.',
 'medium', 'Число погибших в украинских материалах расходится.', False,
 ['Денна й вечірня атаки на Київ 7 жовтня: загиблий, пожежа в багатоповерхівці', 'Київ: Солом’янський, Оболонський і Деснянський райони',
  'РІА Новини повідомляє про перебої зі світлом і водою з посиланням на Кличка, але не пов’язує їх з атакою і не згадує постраждалих. В українських матеріалах неясна кількість загиблих: Українська правда пише про загиблого чоловіка і про тіло жінки, знайдене на Оболоні, РБК-Україна — про одного загиблого.',
  'РІА Новини з посиланням на мера Києва Віталія Кличка повідомляє, що столиця частково залишилася без світла й води: через проблеми з електропостачанням знеструмлено насосні станції, на правому березі перебої з водопостачанням. Про атаку і постраждалих у замітці не йдеться.',
  'За даними Кличка, ДСНС і КМВА (Українська правда), внаслідок денної атаки загинув чоловік, на Оболоні біля палаючого автомобіля знайшли тіло жінки, а кількість постраждалих у Солом’янському та Оболонському районах до вечора сягнула 13. Увечері, за даними ДСНС, російський дрон влучив у 12-поверховий будинок у Деснянському районі на рівні 10-го поверху: четверо постраждалих, серед них діти, врятовано 22 людини, зокрема 8 дітей.',
  None],
 ['Daytime and evening attacks on Kyiv on 7 October: one killed, high-rise fire', 'Kyiv: Solomianskyi, Obolonskyi and Desnianskyi districts',
  'RIA Novosti reports power and water outages, citing Klitschko, but does not link them to the attack or mention casualties. The Ukrainian materials are unclear on the death toll: Ukrainska Pravda writes of a man killed and of a woman\'s body found in Obolon, RBC-Ukraine of one person killed.',
  'RIA Novosti, citing Kyiv Mayor Vitali Klitschko, reports that the capital was partly left without electricity and water: power problems cut supply to pumping stations, causing water outages on the right bank. The report does not mention an attack or casualties.',
  'According to Klitschko, the State Emergency Service and the city military administration (Ukrainska Pravda), a man was killed in the daytime attack, a woman\'s body was found near a burning car in Obolon, and by evening the number of injured in Solomianskyi and Obolonskyi districts had reached 13. In the evening, according to the emergency service, a Russian drone hit a 12-storey building in Desnianskyi district at the level of the 10th floor: four people were injured, including children, and 22 people were rescued, among them 8 children.',
  None]))

cards.append(C('1007-seshcha-airfield', [6808, 9234],
 'ВСУ заявили о поражении аэродрома «Сеща» в Брянской области', 'Аэродром «Сеща», Брянская область', 'russia-other',
 ['одна из групп не освещает', 'не проверено'],
 None,
 S('Генштаб ВСУ, по данным Суспільне, заявил о поражении аэродрома «Сеща» в Брянской области; степень ущерба уточняется. По данным Генштаба, также поражены станция РЭБ у Гриньово и радиолокационная станция у Элионки.',
   (6808, 'у Брянській області Росії українським військовим вдалося уразити аеродром «Сеща». Ступінь завданих пошкоджень російській армії внаслідок цього удару уточнюється.')),
 S('DW пересказывает заявление Генштаба ВСУ об ударе по аэродрому в ночь на 7 октября и со ссылкой на «Радио Свобода» напоминает, что Воздушные силы Украины не раз сообщали о запусках ударных дронов с этого аэродрома.',
   (9234, 'Воздушные силы ВСУ неоднократно сообщали о запуске ударных БПЛА с этого российского аэродрома.')),
 'Российские источники в выборке удар по «Сеще» не комментируют; Минобороны РФ лишь сообщает о сбитых над Брянской и другими областями дронах. Данные об ущербе исходят только от Генштаба ВСУ и независимо не подтверждены.',
 'medium', 'Единственный источник сведений — Генштаб ВСУ.', False,
 ['ЗСУ заявили про ураження аеродрому «Сеща» в Брянській області', 'Аеродром «Сеща», Брянська область',
  'Російські джерела у вибірці удар по «Сещі» не коментують; Міноборони РФ лише повідомляє про збиті над Брянською та іншими областями дрони. Дані про шкоду походять тільки від Генштабу ЗСУ і незалежно не підтверджені.',
  None,
  'Генштаб ЗСУ, за даними Суспільного, заявив про ураження аеродрому «Сеща» в Брянській області; ступінь шкоди уточнюється. За даними Генштабу, також уражено станцію РЕБ біля Гриньова і радіолокаційну станцію біля Еліонки.',
  'DW переказує заяву Генштабу ЗСУ про удар по аеродрому в ніч на 7 жовтня і з посиланням на «Радіо Свобода» нагадує, що Повітряні сили України не раз повідомляли про запуски ударних дронів із цього аеродрому.'],
 ['Ukraine says it hit Seshcha airfield in Bryansk region', 'Seshcha airfield, Bryansk Oblast',
  'Russian sources in the sample do not comment on the strike on Seshcha; the Russian Defence Ministry only reports drones shot down over Bryansk and other regions. The damage claims come only from Ukraine\'s General Staff and have not been independently confirmed.',
  None,
  'Ukraine\'s General Staff, according to Suspilne, said it had hit Seshcha airfield in Bryansk region; the extent of the damage is being clarified. According to the General Staff, an electronic warfare station near Hrynovo and a radar station near Eliionka were also hit.',
  'DW relays the General Staff\'s statement on the strike on the airfield on the night of 7 October and, citing Radio Liberty, recalls that Ukraine\'s Air Force has repeatedly reported strike drones being launched from this airfield.']))

cards.append(C('1007-samara-astrakhan', [6794, 7654, 9799],
 'Украина заявила о результатах ударов по ЛПДС «Самара» и Астраханскому ГПЗ', 'Самарская и Астраханская области, Пермский край', 'russia-other',
 ['одна сторона освещает', 'не проверено'],
 None,
 S('Зеленский заявил об ударах за сутки по четырем целям — двум нефтяным объектам и полигону в Пермском, Самарском и Астраханском регионах. Генштаб, по данным Українська правда, утверждает, что после удара 2 октября на ЛПДС «Самара» подтверждены повреждения одиннадцати резервуаров, а Астраханский газоперерабатывающий завод получил многочисленные повреждения. РБК-Украина со ссылкой на OSINT-аналитиков ASTRA пишет, что станция «Самара» снова горит.',
   (6794, 'По двох нафтових обʼєктах та полігону в Пермському, Самарському та Астраханському регіонах.'),
   (7654, 'отримали чисельні пошкодження'),
   (9799, 'В поселке Рассвет Волжского района Самарской области горит ЛПДС "Самара".')),
 None,
 'Российские источники в выборке результаты ударов не комментируют; РБК-Украина упоминает, что губернатор Самарской области сообщал о беспилотной атаке. Данные о повреждениях исходят от Генштаба ВСУ и OSINT-аналитиков и независимо не проверены.',
 'medium', 'Оценки ущерба дает только украинская сторона.', False,
 ['Україна заявила про результати ударів по ЛВДС «Самара» та Астраханському ГПЗ', 'Самарська й Астраханська області, Пермський край',
  'Російські джерела у вибірці результати ударів не коментують; РБК-Україна згадує, що губернатор Самарської області повідомляв про атаку безпілотників. Дані про пошкодження походять від Генштабу ЗСУ та OSINT-аналітиків і незалежно не перевірені.',
  None,
  'Зеленський заявив про удари за добу по чотирьох цілях — двох нафтових об’єктах і полігону в Пермському, Самарському та Астраханському регіонах. Генштаб, за даними Української правди, стверджує, що після удару 2 жовтня на ЛВДС «Самара» підтверджено пошкодження одинадцяти резервуарів, а Астраханський газопереробний завод отримав численні пошкодження. РБК-Україна з посиланням на OSINT-аналітиків ASTRA пише, що станція «Самара» знову горить.',
  None],
 ['Ukraine reports results of strikes on the Samara oil pumping station and Astrakhan gas plant', 'Samara and Astrakhan regions, Perm Krai',
  'Russian sources in the sample do not comment on the results of the strikes; RBC-Ukraine mentions that the Samara governor had reported a drone attack. The damage claims come from Ukraine\'s General Staff and OSINT analysts and have not been independently verified.',
  None,
  'Zelensky said Ukraine had struck four targets in a day: two oil facilities and a training ground in the Perm, Samara and Astrakhan regions. The General Staff, according to Ukrainska Pravda, claims that after the strike of 2 October damage to eleven tanks at the Samara oil pumping station has been confirmed, and that the Astrakhan gas processing plant suffered extensive damage. RBC-Ukraine, citing OSINT analysts from ASTRA, writes that the Samara station is burning again.',
  None]))

cards.append(C('1007-drones-over-russia', [6414, 4353, 6432, 9768],
 'Минобороны РФ: сотни украинских беспилотников сбиты над Россией за сутки', 'Регионы России, Крым, Черное и Азовское моря', 'russia-other',
 ['единственный источник'],
 S('Минобороны РФ сообщило, что за ночь дежурные силы ПВО уничтожили 311 украинских беспилотников самолетного типа над Белгородской, Брянской, Самарской и другими областями, Пермским краем, Крымом и акваториями Черного и Азовского морей, а днем, с 8.00 до 20.00 мск, — еще 59. По данным РИА Новости, всего за сутки сбиты 764 беспилотника и четыре управляемые авиабомбы.',
   (6414, 'В течение прошедшей ночи дежурными силами ПВО перехвачены и уничтожены 311 украинских беспилотных летательных аппаратов самолетного типа'),
   (4353, 'Силы ПВО за сутки уничтожили 764 украинских беспилотника')),
 S('РБК-Украина, пересказывая отчет Минобороны РФ, пишет, что ночью Силы обороны Украины применили несколько сотен ударных дронов против разных областей России.',
   (9768, 'Силы обороны Украины применили несколько сотен ударных дронов во время нового воздушного нападения на разные области России.')),
 None,
 'Обе стороны опираются на данные Минобороны РФ; о последствиях атаки на земле ведомство не сообщает. Ночная цифра (311) и суточная (764) относятся к разным периодам.',
 'medium', 'Данные о числе дронов исходят только от Минобороны РФ.', False,
 ['Міноборони РФ: сотні українських безпілотників збито над Росією за добу', 'Регіони Росії, Крим, Чорне та Азовське моря',
  'Обидві сторони спираються на дані Міноборони РФ; про наслідки атаки на землі відомство не повідомляє. Нічна цифра (311) і добова (764) стосуються різних періодів.',
  'Міноборони РФ повідомило, що за ніч чергові сили ППО знищили 311 українських безпілотників літакового типу над Бєлгородською, Брянською, Самарською та іншими областями, Пермським краєм, Кримом і акваторіями Чорного та Азовського морів, а вдень, з 8.00 до 20.00 за московським часом, — ще 59. За даними РІА Новини, загалом за добу збито 764 безпілотники та чотири керовані авіабомби.',
  'РБК-Україна, переказуючи звіт Міноборони РФ, пише, що вночі Сили оборони України застосували кілька сотень ударних дронів проти різних областей Росії.',
  None],
 ['Russian Defence Ministry: hundreds of Ukrainian drones shot down over Russia in a day', 'Russian regions, Crimea, Black and Azov seas',
  'Both sides rely on Russian Defence Ministry data; the ministry says nothing about the consequences of the attack on the ground. The overnight figure (311) and the daily figure (764) refer to different periods.',
  'The Russian Defence Ministry said air defences destroyed 311 Ukrainian fixed-wing drones overnight over Belgorod, Bryansk, Samara and other regions, Perm Krai, Crimea and the Black and Azov seas, and another 59 during the day, from 8.00 to 20.00 Moscow time. According to RIA Novosti, a total of 764 drones and four guided aerial bombs were shot down over the day.',
  'RBC-Ukraine, relaying the Russian Defence Ministry\'s report, writes that overnight Ukraine\'s Defence Forces used several hundred strike drones against various Russian regions.',
  None]))

cards.append(C('1007-nato-military-committee', [4386, 9789, 6800, 7650],
 'Военный комитет НАТО впервые за восемь лет посетил Киев', 'Киев', 'kyiv',
 ['расхождение: формулировки'],
 S('РИА Новости приводит критику визита военного комитета НАТО на Украину со стороны политического аналитика Алана Уотсона, который напомнил, что Первую мировую войну спровоцировала система союзов. Заголовок заметки утверждает, что появление чиновников НАТО «шокировало США».',
   (4386, 'Политический аналитик Алан Уотсон в соцсети X раскритиковал визит военного комитета НАТО на Украину.')),
 S('Председатель Военного комитета НАТО адмирал Джузеппе Каво Драгоне сообщил, что комитет впервые за восемь лет прибыл в Киев с официальным визитом; представители 32 стран обсудили с главнокомандующим ВСУ Михаилом Драпатым ситуацию на поле боя и дальнейшую поддержку. Українська правда уточняет, что визит состоялся 6 октября.',
   (6800, 'Після восьмирічної перерви військовий комітет НАТО повертається до Києва з офіційним візитом.'),
   (7650, '32 члени Військового комітету НАТО 6 жовтня відвідали Київ та зустрілися з головнокомандувачем Збройних сил України Михайлом Драпатим.')),
 None,
 'Украинские СМИ подают визит как знак поддержки, РИА Новости — через критику одного американского аналитика; заголовок РИА о том, что визит «шокировал США», опирается на мнение одного человека.',
 'low', '', False,
 ['Військовий комітет НАТО вперше за вісім років відвідав Київ', 'Київ',
  'Українські ЗМІ подають візит як знак підтримки, РІА Новини — через критику одного американського аналітика; заголовок РІА про те, що візит «шокував США», спирається на думку однієї людини.',
  'РІА Новини наводить критику візиту військового комітету НАТО в Україну з боку політичного аналітика Алана Вотсона, який нагадав, що Першу світову війну спровокувала система союзів. Заголовок замітки стверджує, що поява посадовців НАТО «шокувала США».',
  'Голова Військового комітету НАТО адмірал Джузеппе Каво Драгоне повідомив, що комітет уперше за вісім років прибув до Києва з офіційним візитом; представники 32 країн обговорили з головнокомандувачем ЗСУ Михайлом Драпатим ситуацію на полі бою і подальшу підтримку. Українська правда уточнює, що візит відбувся 6 жовтня.',
  None],
 ['NATO Military Committee visits Kyiv for the first time in eight years', 'Kyiv',
  'Ukrainian media present the visit as a sign of support, RIA Novosti through the criticism of a single American analyst; RIA\'s headline claiming the visit "shocked the US" rests on one person\'s opinion.',
  'RIA Novosti quotes criticism of the NATO Military Committee\'s visit to Ukraine by political analyst Alan Watson, who recalled that the First World War was triggered by a system of alliances. The report\'s headline claims the appearance of NATO officials "shocked the US".',
  'The chair of the NATO Military Committee, Admiral Giuseppe Cavo Dragone, said the committee had come to Kyiv on an official visit for the first time in eight years; representatives of 32 countries discussed the battlefield situation and further support with Ukraine\'s commander-in-chief Mykhailo Drapatyi. Ukrainska Pravda specifies that the visit took place on 6 October.',
  None]))

cards.append(C('1007-eu-sanctions', [9774, 7640, 8417, 9230],
 'Послы ЕС одобрили крупнейший список санкций против России', 'Брюссель', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('РБК-Украина со ссылкой на редактора «Радио Свободная Европа» Рикарда Йозвяка пишет, что послы ЕС согласовали санкции против 743 человек и 826 организаций военной промышленности России, а также против 77 человек, «избранных» в Госдуму от оккупированных территорий. Українська правда со ссылкой на Reuters называет пакет крупнейшим по объему списком за все время.',
   (9774, 'По его словам, послы ЕС сегодня дали "зеленый свет" новым санкциям против 743 человек и 826 организаций военной промышленности России.'),
   (7640, 'стане найбільшим за обсягом переліком')),
 S('Kyiv Independent пишет, что послы единогласно одобрили крупнейший в истории список санкций против ВПК России, который министры иностранных дел ЕС должны формально утвердить 12 октября в Люксембурге. DW приводит те же данные Йозвяка.',
   (8417, 'EU ambassadors unanimously approved nearly 1,600 sanctions targeting Russia\'s military-industrial complex on Oct. 7'),
