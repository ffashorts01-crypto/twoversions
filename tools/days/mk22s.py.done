import json, sys
sys.path.insert(0, "/workspace/compare-site-v2/tools/days")
from lib import S, C
OUT = "/workspace/compare-site-v2/tools/days/out/"
# ---------------- hourly run 22 Oct 10:04: new backlog cards for 20 Oct ----------------
c20 = []
c20.append(C('1020-vance-ukraine-not-nato', [13736, 15094, 14057, 14370, 14382, 14833, 14876],
 'Вэнс: Украина не должна быть в НАТО, формального союза с ней нет, удары по российской энергетике надо прекратить',
 'США', 'ukraine-wide',
 ['расхождение: акценты', 'умолчание', 'одна из групп не освещает'],
 S("«Интерфакс» передает слова вице-президента США Джей Ди Вэнса в интервью порталу 2Way: у США нет официальных альянсов с Украиной, она не в НАТО и, по его мнению, не должна там быть; у Вашингтона и Киева «несколько разные интересы», Украина должна перестать бомбить российскую энергетику, поскольку это поднимает стоимость дизеля для американцев. ТАСС на английском пишет, что Вэнс не стал называть Украину союзником Вашингтона, и напоминает, что Трамп не раз резко критиковал Зеленского за удары по российским НПЗ, которые, по его словам, вредят мировому рынку дизеля, в том числе в США.",
   (15094, 'Я не думаю, что они должны быть в НАТО'),
   (15094, 'Я думаю, Украина должна перестать бомбить российскую энергетику'),
   (13736, 'Vance also stopped short of calling Ukraine an ally of Washington and said it should stop striking Russian oil refineries.')),
 S("«Украинская правда», «Общественное» и РБК-Украина приводят ту же цитату Вэнса из интервью 2WAY Tonight полнее: формального союзнического соглашения с Украиной нет, вступать в НАТО ей, по его мнению, не следует, но это «очень достойная восхищения, прекрасная страна» с множеством замечательных людей, и по ряду вопросов страны будут сотрудничать. «Украинская правда» добавляет, что Украина, по словам Вэнса, «в определенном смысле» партнер США, но интересы иногда расходятся — в частности, из-за ударов по российским дизельным объектам. «Общественное» напоминает о договоренности Трампа и Путина о поставках российского дизеля и временной лицензии Минфина США. В отдельном материале РБК-Украина пишет, что Украина не исключает другого формата безопасности вместо НАТО, но настаивает на юридически обязывающих гарантиях.",
   (14057, 'Я не думаю, що вона повинна вступати до НАТО. Я вважаю, що це країна, дуже гідна захоплення, прекрасна країна з безліччю чудових людей.'),
   (14382, 'у певному сенсі вони, безперечно, є партнерами'),
   (14876, "Україна не виключає іншого формату безпеки замість НАТО, однак наполягає на юридично зобов'язувальних гарантіях, які справді працюватимуть.")),
 None,
 "Слова Вэнса о НАТО и ударах по энергетике обе группы передают одинаково. Российские агентства опускают его похвалу Украине как «прекрасной стране» и слова о продолжении сотрудничества и выносят на первый план требование прекратить удары и рост цен на дизель для американцев; украинские издания приводят цитату целиком и добавляют контекст сделки Трампа и Путина по дизелю и позицию Киева о гарантиях безопасности. Независимые источники в подборке интервью не освещают.",
 'low', 'Цитаты из интервью совпадают у обеих групп; спор только об акцентах.', False,
 ('Венс: Україна не повинна бути в НАТО, формального союзу з нею немає, удари по російській енергетиці слід припинити',
  'США',
  "Слова Венса про НАТО та удари по енергетиці обидві групи передають однаково. Російські агентства опускають його похвалу Україні як «прекрасній країні» та слова про продовження співпраці й виносять на перший план вимогу припинити удари та зростання цін на дизель для американців; українські видання наводять цитату повністю й додають контекст угоди Трампа і Путіна щодо дизеля та позицію Києва щодо гарантій безпеки. Незалежні джерела в добірці інтерв’ю не висвітлюють.",
  "«Інтерфакс» передає слова віцепрезидента США Джей Ді Венса в інтерв’ю порталу 2Way: у США немає офіційних альянсів з Україною, вона не в НАТО і, на його думку, не повинна там бути; у Вашингтона і Києва «дещо різні інтереси», Україна має припинити бомбити російську енергетику, бо це підвищує вартість дизеля для американців. ТАСС англійською пише, що Венс не став називати Україну союзником Вашингтона, і нагадує, що Трамп не раз різко критикував Зеленського за удари по російських НПЗ, які, за його словами, шкодять світовому ринку дизеля, зокрема в США.",
  "«Українська правда», «Суспільне» і РБК-Україна наводять ту саму цитату Венса з інтерв’ю 2WAY Tonight повніше: формальної союзницької угоди з Україною немає, вступати до НАТО їй, на його думку, не слід, але це «дуже гідна захоплення, прекрасна країна» з безліччю чудових людей, і в низці питань країни співпрацюватимуть. «Українська правда» додає, що Україна, за словами Венса, «у певному сенсі» партнер США, але інтереси часом розходяться — зокрема через удари по російських дизельних об’єктах. «Суспільне» нагадує про домовленість Трампа і Путіна щодо постачання російського дизеля та тимчасову ліцензію Мінфіну США. В окремому матеріалі РБК-Україна пише, що Україна не виключає іншого формату безпеки замість НАТО, але наполягає на юридично зобов’язувальних гарантіях.",
  None),
 ('Vance: Ukraine should not be in NATO, there is no formal alliance with it, and strikes on Russian energy should stop',
  'US',
  "Both groups convey Vance's words on NATO and energy strikes the same way. Russian agencies omit his praise of Ukraine as a \"beautiful country\" and his words about continued cooperation, foregrounding the demand to stop the strikes and the rising diesel costs for Americans; Ukrainian outlets quote him in full and add the context of the Trump-Putin diesel deal and Kyiv's position on security guarantees. Independent sources in the selection do not cover the interview.",
  "Interfax relays US Vice President JD Vance's words in an interview with the 2Way portal: the US has no official alliances with Ukraine, it is not in NATO and, in his view, should not be; Washington and Kyiv have \"somewhat different interests\", and Ukraine should stop bombing Russian energy because it raises the cost of diesel for Americans. TASS in English writes that Vance stopped short of calling Ukraine an ally of Washington and recalls that Trump has repeatedly criticised Zelensky over strikes on Russian refineries, which he says harm the global diesel market, including in the US.",
  "Ukrainska Pravda, Suspilne and RBC-Ukraine give the same Vance quote from the 2WAY Tonight interview more fully: there is no formal alliance agreement with Ukraine and in his view it should not join NATO, but it is \"a very admirable, beautiful country\" with many wonderful people, and the two countries will cooperate on some issues. Ukrainska Pravda adds that, according to Vance, Ukraine is \"in a certain sense\" a US partner, but interests sometimes diverge, notably over strikes on Russian diesel facilities. Suspilne recalls the Trump-Putin arrangement on Russian diesel supplies and the US Treasury's temporary licence. In a separate piece RBC-Ukraine writes that Ukraine does not rule out a security format other than NATO but insists on legally binding guarantees.",
  None)))

c20.append(C('1020-front-claims-timoshevka', [13981, 13495, 15131, 15124, 14061, 14378, 14371, 14421, 14569],
 'Минобороны РФ заявило о взятии Тимошевки в Запорожской области; Генштаб ВСУ — 206 боестолкновений за сутки',
 'Запорожская область — линия фронта', 'zaporizhzhia',
 ['расхождение: кто контролирует населённые пункты', 'не проверено', 'российская сторона заявляет, украинская не комментирует'],
 S("Минобороны России заявило, что подразделения группировки «Восток» «освободили» Тимошевку в Запорожской области. РИА Новости и «Интерфакс» со ссылкой на ведомство добавляют, что при этом под контроль взят крупный район обороны площадью около 6 квадратных километров, потери ВСУ составили до роты, 8 боевых бронированных машин, 11 автомобилей и 17 наземных роботизированных комплексов, а взятие села создало условия для продвижения на запад. В общей сводке «Интерфакс» передает, что российские группировки за сутки улучшили положение на ряде направлений, а потери ВСУ составили, в частности, до 215 военнослужащих на направлении «Южной» группировки, до 340 — «Центра», до 220 — «Запада» и до 235 — «Севера».",
   (13981, 'освободили населенный пункт Тимошевка Запорожской области'),
   (13495, 'Потери ВСУ составили до роты живой силы, 8 боевых бронированных машин, 11 автомобилей и 17 наземных роботизированных комплексов'),
   (15131, 'создало условия для дальнейшего продвижения подразделений группировки "Восток" в западном направлении')),
 S("«Украинская правда» и «Общественное» со ссылкой на Генштаб ВСУ пишут о 206 боестолкновениях за 19 октября: больше всего атак отбито на Южно-Слобожанском (26) и Покровском (21) направлениях; потери России за сутки Генштаб оценивает в 1560 человек. Вечерняя сводка, по данным «Украинской правды», — 229 боестолкновений с начала 20 октября, больше всего на Константиновском (33) и Покровском (26) направлениях. Тимошевка в сводках не упоминается.",
   (14378, 'Протягом 19 жовтня на фронті зафіксували 206 бойових зіткнень.'),
   (14421, 'Загалом від початку цієї доби відбулося 229 бойових зіткнень.')),
 S("The Kyiv Independent передает данные Генштаба ВСУ о потерях России за сутки (1560 человек) и с начала вторжения, отмечая, что о собственных потерях Генштаб не сообщает, ссылаясь на оперативную секретность, а CSIS оценивает соотношение потерь примерно как 2,5:1 или 2:1 не в пользу России. Заявление Минобороны России о Тимошевке независимые издания в подборке не проверяли.",
   (14569, "Ukraine's General Staff has not revealed its own losses during the full-scale invasion, citing operational secrecy.")),
 "Российская сторона заявляет о взятии Тимошевки и называет потери ВСУ по каждому направлению; украинские сводки село не называют и приводят число боестолкновений и потери России. Обе стороны сообщают только о потерях противника. Независимой проверки заявлений ни одной из сторон нет.",
 'medium', 'Заявление о взятии села исходит только от Минобороны России, украинская сторона его не комментирует, независимых данных нет.', False,
 ('Міноборони РФ заявило про взяття Тимошівки в Запорізькій області; Генштаб ЗСУ — 206 боєзіткнень за добу',
  'Запорізька область — лінія фронту',
  "Російська сторона заявляє про взяття Тимошівки й називає втрати ЗСУ за кожним напрямком; українські зведення село не називають і наводять кількість боєзіткнень і втрати Росії. Обидві сторони повідомляють лише про втрати супротивника. Незалежної перевірки заяв жодної зі сторін немає.",
  "Міноборони Росії заявило, що підрозділи угруповання «Восток» «звільнили» Тимошівку в Запорізькій області. РИА Новости та «Інтерфакс» з посиланням на відомство додають, що при цьому під контроль узято великий район оборони площею близько 6 квадратних кілометрів, втрати ЗСУ становили до роти, 8 бойових броньованих машин, 11 автомобілів і 17 наземних роботизованих комплексів, а взяття села створило умови для просування на захід. У загальному зведенні «Інтерфакс» передає, що російські угруповання за добу поліпшили становище на низці напрямків, а втрати ЗСУ становили, зокрема, до 215 військових на напрямку «Південного» угруповання, до 340 — «Центру», до 220 — «Заходу» і до 235 — «Півночі».",
  "«Українська правда» і «Суспільне» з посиланням на Генштаб ЗСУ пишуть про 206 боєзіткнень за 19 жовтня: найбільше атак відбито на Південно-Слобожанському (26) і Покровському (21) напрямках; втрати Росії за добу Генштаб оцінює в 1560 осіб. Вечірнє зведення, за даними «Української правди», — 229 боєзіткнень від початку 20 жовтня, найбільше на Костянтинівському (33) і Покровському (26) напрямках. Тимошівка у зведеннях не згадується.",
  "The Kyiv Independent передає дані Генштабу ЗСУ про втрати Росії за добу (1560 осіб) і від початку вторгнення, зазначаючи, що про власні втрати Генштаб не повідомляє, посилаючись на оперативну таємницю, а CSIS оцінює співвідношення втрат приблизно як 2,5:1 або 2:1 не на користь Росії. Заяву Міноборони Росії про Тимошівку незалежні видання в добірці не перевіряли."),
 ('Russian Defence Ministry claims capture of Tymoshivka in Zaporizhzhia region; Ukraine\'s General Staff reports 206 clashes in a day',
  'Zaporizhzhia region, front line',
  "The Russian side claims the capture of Tymoshivka and gives Ukrainian losses for each direction; Ukrainian reports do not name the village and give the number of clashes and Russian losses. Both sides report only the enemy's losses. There is no independent verification of either side's claims.",
  "Russia's Defence Ministry said units of the Vostok group \"liberated\" Tymoshivka (Timoshevka) in Zaporizhzhia region. RIA Novosti and Interfax, citing the ministry, add that a large defensive area of about 6 square kilometres was taken, Ukrainian losses amounted to up to a company, 8 armoured combat vehicles, 11 vehicles and 17 unmanned ground systems, and that taking the village created conditions for an advance westwards. In the general summary Interfax reports that Russian groups improved their positions in several directions over the day, with Ukrainian losses of up to 215 servicemen in the Southern group's direction, up to 340 for Centre, up to 220 for West and up to 235 for North.",
  "Ukrainska Pravda and Suspilne, citing Ukraine's General Staff, report 206 clashes on 19 October, with most attacks repelled in the South Slobozhanskyi (26) and Pokrovsk (21) directions; the General Staff puts Russian losses for the day at 1560 people. The evening report, according to Ukrainska Pravda, gave 229 clashes since the start of 20 October, most of them in the Kostiantynivka (33) and Pokrovsk (26) directions. Tymoshivka is not mentioned in the reports.",
  "The Kyiv Independent relays the General Staff's figures on Russian losses for the day (1560 people) and since the start of the invasion, noting that the General Staff does not disclose Ukraine's own losses, citing operational secrecy, and that CSIS estimates the casualty ratio at roughly 2.5:1 or 2:1 against Russia. Independent outlets in the selection have not verified the Russian Defence Ministry's claim about Tymoshivka.")))

c20.append(C('1020-night-drones-energy-logistics', [13974, 13478, 14847, 14376, 14059, 14848, 14377, 14864, 14889, 14067, 14573],
 'Ночная атака 165 дронов: Минобороны РФ — логистические центры в Хмельницком и Ковеле; Украина — удары по энергетике, отключения в двенадцати областях',
 'Украина — Хмельницкий, Ковель, Тернопольская, Одесская и Житомирская области', 'ukraine-wide',
 ['расхождение: характер объектов', 'умолчание'],
 S("Минобороны России сообщило, что ночью беспилотниками поражены объекты логистической и портовой инфраструктуры Украины: логистический центр «Гранд импорт» в Хмельницком, где, по версии ведомства, хранились грузы военного и двойного назначения для ВСУ, и транспортно-логистический центр в Ковеле Волынской области; отдельно ведомство заявило об ударах по судам в порту Рени и на пути в Одессу. РИА Новости выносит в заголовок удар по логистическому центру в Ковеле. Об ударах по энергетике и отключениях света в этих материалах не говорится.",
   (13974, 'логистический центр «Гранд импорт» в г. Хмельницком, используемый для хранения грузов военного и двойного назначения, предназначенных для обеспечения ВСУ'),
   (13478, 'транспортно-логистический центр (ООО "Виндор Транс Сервис") в населенном пункте Ковель')),
 S("РБК-Украина, «Украинская правда» и «Общественное» со ссылкой на Воздушные силы пишут, что с 18:00 Россия выпустила 165 ударных дронов, из них 105 реактивных; к 08:00 сбиты или подавлены 115, еще 20 оставались в воздухе, попадания зафиксированы на 30 локациях. По данным глав областей, на Тернопольщине повреждены три энергообъекта в Кременецком районе, на Одесщине — объекты энергетики ДТЭК, без света остаются около 32,7 тысячи семей; на Житомирщине, по словам главы ОВА Виталия Бунечко, россияне целились в энергетическую и железнодорожную инфраструктуру, возникли пожары, закрылся гипермаркет ОЛДИ. Минэнерго и «Укрэнерго» сообщили об отключениях в двенадцати областях. Об ударе по логистическому центру в Хмельницком украинские источники в подборке не пишут; о Ковеле РБК-Украина в другом материале упоминает как об ударе по ТРЦ, где разрушены складские здания.",
   (14376, 'Росія атакувала Україну 165 безпілотниками, зокрема 105 реактивними'),
   (14848, 'Пошкодження енергетичних об\'єктів зафіксували у Кременецькому районі.'),
   (14864, 'цілили в енергетичну та залізничну інфраструктуру')),
 S("The Kyiv Independent со ссылкой на «Укрэнерго» пишет об отключениях света в двенадцати областях, от Кировоградской и Житомирской до Львовской, Одесской, Ровенской, Тернопольской и Хмельницкой; первый замминистра энергетики Артем Некрасов говорит, что Россия «систематически и целенаправленно» атакует энергетику, а издание связывает это с приближением пятой зимы войны. Заявления Минобороны России о логистических центрах независимые издания в подборке не проверяли.",
   (14573, 'There are new power outages in the Kirovohrad, Zhytomyr, Lviv, Odesa, Rivne, Ternopil, Khmelnytskyi, Zaporizhia, Donetsk, Kharkiv, Sumy and Chernihiv oblasts in the morning')),
 "Российская сторона называет целями логистические центры с военными грузами и не упоминает энергетику; украинские и независимые источники пишут об ударах по энергетике и железной дороге и об отключениях в двенадцати областях, но не упоминают Хмельницкий, а Ковель упоминается лишь как удар по ТРЦ со складскими зданиями. Характер объектов, названных Минобороны, независимо не подтвержден.",
 'medium', 'Назначение логистических центров известно только из заявления Минобороны России; украинские источники их не упоминают.', False,
 ('Нічна атака 165 дронів: Міноборони РФ — логістичні центри в Хмельницькому і Ковелі; Україна — удари по енергетиці, відключення у дванадцяти областях',
  'Україна — Хмельницький, Ковель, Тернопільська, Одеська і Житомирська області',
  "Російська сторона називає цілями логістичні центри з військовими вантажами й не згадує енергетику; українські та незалежні джерела пишуть про удари по енергетиці й залізниці та про відключення у дванадцяти областях, але не згадують Хмельницький, а Ковель згадується лише як удар по ТРЦ зі складськими будівлями. Характер об’єктів, названих Міноборони, незалежно не підтверджено.",
  "Міноборони Росії повідомило, що вночі безпілотниками уражено об’єкти логістичної та портової інфраструктури України: логістичний центр «Гранд імпорт» у Хмельницькому, де, за версією відомства, зберігалися вантажі військового та подвійного призначення для ЗСУ, і транспортно-логістичний центр у Ковелі Волинської області; окремо відомство заявило про удари по суднах у порту Рені та на шляху до Одеси. РИА Новости виносить у заголовок удар по логістичному центру в Ковелі. Про удари по енергетиці та відключення світла в цих матеріалах не йдеться.",
  "РБК-Україна, «Українська правда» і «Суспільне» з посиланням на Повітряні сили пишуть, що з 18:00 Росія випустила 165 ударних дронів, із них 105 реактивних; до 08:00 збито або подавлено 115, ще 20 залишалися в повітрі, влучання зафіксовано на 30 локаціях. За даними очільників областей, на Тернопільщині пошкоджено три енергооб’єкти в Кременецькому районі, на Одещині — об’єкти енергетики ДТЕК, без світла залишаються близько 32,7 тисячі родин; на Житомирщині, за словами голови ОВА Віталія Бунечка, росіяни цілили в енергетичну та залізничну інфраструктуру, виникли пожежі, зачинився гіпермаркет ОЛДІ. Міненерго та «Укренерго» повідомили про відключення у дванадцяти областях. Про удар по логістичному центру в Хмельницькому українські джерела в добірці не пишуть; про Ковель РБК-Україна в іншому матеріалі згадує як про удар по ТРЦ, де зруйновано складські будівлі.",
  "The Kyiv Independent з посиланням на «Укренерго» пише про відключення світла у дванадцяти областях, від Кіровоградської та Житомирської до Львівської, Одеської, Рівненської, Тернопільської і Хмельницької; перший заступник міністра енергетики Артем Некрасов каже, що Росія «систематично і цілеспрямовано» атакує енергетику, а видання пов’язує це з наближенням п’ятої зими війни. Заяв Міноборони Росії про логістичні центри незалежні видання в добірці не перевіряли."),
 ('Overnight attack by 165 drones: Russian MoD cites logistics centres in Khmelnytskyi and Kovel; Ukraine reports energy strikes and outages in twelve regions',
  'Ukraine: Khmelnytskyi, Kovel, Ternopil, Odesa and Zhytomyr regions',
  "The Russian side names logistics centres holding military cargo as the targets and does not mention energy; Ukrainian and independent sources report strikes on energy and railways and outages in twelve regions but do not mention Khmelnytskyi, while Kovel is mentioned only as a strike on a shopping centre with warehouse buildings. The nature of the sites named by the Defence Ministry has not been independently confirmed.",
  "Russia's Defence Ministry said drones struck Ukrainian logistics and port infrastructure overnight: the Grand Import logistics centre in Khmelnytskyi, which according to the ministry stored military and dual-use cargo for the Ukrainian armed forces, and a transport and logistics centre in Kovel, Volyn region; separately, the ministry claimed strikes on ships in the port of Reni and en route to Odesa. RIA Novosti headlines the strike on the Kovel logistics centre. These reports say nothing about strikes on energy or power cuts.",
  "RBC-Ukraine, Ukrainska Pravda and Suspilne, citing the Air Force, write that from 18:00 Russia launched 165 attack drones, 105 of them jet-powered; by 08:00, 115 had been shot down or suppressed, another 20 were still in the air, and hits were recorded at 30 locations. According to regional heads, three energy facilities were damaged in Kremenets district of Ternopil region and DTEK energy sites in Odesa region, leaving about 32.7 thousand families without power; in Zhytomyr region, according to governor Vitalii Bunechko, Russia targeted energy and railway infrastructure, fires broke out and an OLDI hypermarket closed. The Energy Ministry and Ukrenergo reported outages in twelve regions. Ukrainian sources in the selection do not mention the strike on the Khmelnytskyi logistics centre; RBC-Ukraine mentions Kovel in another piece as a strike on a shopping centre where warehouse buildings were destroyed.",
  "The Kyiv Independent, citing Ukrenergo, reports power outages in twelve oblasts, from Kirovohrad and Zhytomyr to Lviv, Odesa, Rivne, Ternopil and Khmelnytskyi; First Deputy Energy Minister Artem Nekrasov says Russia \"systematically and purposefully\" attacks the energy sector, and the outlet links this to the approach of the war's fifth winter. Independent outlets in the selection have not verified the Russian Defence Ministry's claims about the logistics centres.")))

c20.append(C('1020-dubno-epicentr-strike', [13987, 15158, 14397, 14893],
 'Удар по Ровенщине днем 20 октября: Минобороны РФ — логистический центр «Эпицентр-К» в Дубно; украинские власти — торговый центр, трое раненых',
 'Ровенская область — Дубно', 'ukraine-wide',
 ['расхождение: характер объектов', 'не проверено', 'одна из групп не освещает'],
 S("Минобороны России сообщило, что днем беспилотником поражен логистический центр «Эпицентр-К» в Дубно Ровенской области, на территории которого, по версии ведомства, расположен складской комплекс, используемый в интересах ВСУ; «Интерфакс» передает это сообщение под заголовком об ударе по логистическому комплексу. В том же сообщении ведомство заявило о поражении на переходе морем контейнеровоза с грузами для ВСУ. О пострадавших в этих материалах не говорится.",
   (13987, 'на территории которого расположен складской комплекс, используемый в интересах ВСУ'),
   (15158, 'Российские военные сообщили, что во вторник днем ударом БПЛА поразили объект логистики в Ровненской области.')),
 S("«Украинская правда» и РБК-Украина со ссылкой на главу Ровенской ОВА Александра Коваля сообщают об атаке на торговый центр в области: по предварительным данным, ранены три человека, двое госпитализированы, возник пожар, и жителей соседних домов призвали закрыть окна. РБК-Украина пишет об ударе реактивным дроном по торговому центру в Ровно, а также напоминает, что Россия ударила по ТРЦ в Ковеле, где разрушены складские здания, и по гипермаркету ОЛДИ в Житомире. Название объекта и город украинские материалы в подборке называют по-разному, «Эпицентр» и Дубно не упоминаются.",
   (14397, 'За попередньою інформацією, троє людей поранені, з них двох – госпіталізували.'),
   (14893, 'РФ вгатила реактивним дроном по торговому центру у Рівному.')),
 None,
 "Минобороны России называет пораженный объект логистическим центром со складами для ВСУ и не сообщает о пострадавших; украинские власти говорят о торговом центре, трех раненых и пожаре. Место различается: Минобороны называет Дубно, РБК-Украина — Ровно, «Украинская правда» — Ровенскую область. Независимые источники в подборке удар не освещают, назначение объекта не подтверждено.",
 'medium', 'Использование объекта в интересах ВСУ известно только из заявления Минобороны России; украинские источники описывают торговый центр, независимой проверки нет.', False,
 ('Удар по Рівненщині вдень 20 жовтня: Міноборони РФ — логістичний центр «Епіцентр-К» у Дубні; українська влада — торговельний центр, троє поранених',
  'Рівненська область — Дубно',
  "Міноборони Росії називає уражений об’єкт логістичним центром зі складами для ЗСУ й не повідомляє про постраждалих; українська влада говорить про торговельний центр, трьох поранених і пожежу. Місце різниться: Міноборони називає Дубно, РБК-Україна — Рівне, «Українська правда» — Рівненщину. Незалежні джерела в добірці удар не висвітлюють, призначення об’єкта не підтверджено.",
  "Міноборони Росії повідомило, що вдень безпілотником уражено логістичний центр «Епіцентр-К» у Дубні Рівненської області, на території якого, за версією відомства, розташований складський комплекс, що використовується в інтересах ЗСУ; «Інтерфакс» передає це повідомлення під заголовком про удар по логістичному комплексу. У тому самому повідомленні відомство заявило про ураження на переході морем контейнеровоза з вантажами для ЗСУ. Про постраждалих у цих матеріалах не йдеться.",
  "«Українська правда» і РБК-Україна з посиланням на голову Рівненської ОВА Олександра Коваля повідомляють про атаку на торговельний центр в області: за попередніми даними, поранено трьох людей, двох госпіталізовано, виникла пожежа, і мешканців сусідніх будинків закликали зачинити вікна. РБК-Україна пише про удар реактивним дроном по торговому центру в Рівному, а також нагадує, що Росія вдарила по ТРЦ у Ковелі, де зруйновано складські будівлі, і по гіпермаркету ОЛДІ в Житомирі. Назву об’єкта та місто українські матеріали в добірці називають по-різному, «Епіцентр» і Дубно не згадуються.",
  None),
 ('Strike on Rivne region on 20 October: Russian MoD cites the Epicentr-K logistics centre in Dubno; Ukrainian authorities report a shopping centre and three injured',
  'Rivne region, Dubno',
  "Russia's Defence Ministry calls the site a logistics centre with warehouses for the Ukrainian army and reports no casualties; Ukrainian authorities speak of a shopping centre, three injured and a fire. The location differs: the MoD names Dubno, RBC-Ukraine Rivne city, Ukrainska Pravda the Rivne region. Independent sources in the selection do not cover the strike, and the use of the site has not been confirmed.",
  "Russia's Defence Ministry said a drone hit the Epicentr-K logistics centre in Dubno, Rivne region, during the day; according to the ministry, a warehouse complex used for the Ukrainian armed forces is located there. Interfax relays the statement under a headline about a strike on a logistics complex. In the same statement the ministry claimed a hit on a container ship carrying cargo for the Ukrainian army at sea. These reports say nothing about casualties.",
  "Ukrainska Pravda and RBC-Ukraine, citing Rivne regional governor Oleksandr Koval, report an attack on a shopping centre in the region: according to preliminary data three people were injured, two of them hospitalised, a fire broke out and residents of nearby buildings were urged to close their windows. RBC-Ukraine writes of a jet drone striking a shopping centre in Rivne and recalls that Russia hit a shopping centre in Kovel, where warehouse buildings were destroyed, and an OLDI hypermarket in Zhytomyr. The Ukrainian reports in the selection name the site and town differently and do not mention Epicentr or Dubno.",
  None)))

json.dump(c20, open(OUT + 'c20d.json', 'w'), ensure_ascii=False, indent=1)
print('c20d', len(c20))
