        [(14419, 'Україна має сама прагнути укласти угоду')])
    add(c, 'ind', 'DW (на русском) передает те же слова Трампа о необязательности встречи Путина и Зеленского и его слова об «огромной» ненависти между ними.',
        'DW (російською) передає ті самі слова Трампа про необов’язковість зустрічі Путіна і Зеленського та його слова про «величезну» ненависть між ними.',
        'DW (in Russian) relays the same words of Trump that a Putin-Zelensky meeting is not necessary and his words about the "huge" hatred between them.',
