def noop(c): pass

@ext('1020-zelensky-rubio-early-warning', [13507, 13528, 14103, 14941, 14063, 14400, 14938])
def _(c):
    add(c, 'ru', 'Вечером РИА Новости передало слова Зеленского в Осло: после разговора с Рубио связь Starlink, возможно, восстановится через 48 часов; позже — слова главы Пентагона Пита Хегсета, что США «ничего не отменяли» и не давали указаний по Starlink и Starshield.',
        'Увечері РИА Новости передало слова Зеленського в Осло: після розмови з Рубіо зв’язок Starlink, можливо, відновиться за 48 годин; пізніше — слова голови Пентагону Піта Гегсета, що США «нічого не скасовували» і не давали вказівок щодо Starlink і Starshield.',
        'In the evening RIA Novosti relayed Zelensky\'s words in Oslo that after his talk with Rubio the Starlink connection might be restored within 48 hours, and later Pentagon chief Pete Hegseth\'s words that the US "cancelled nothing" and gave no instructions on Starlink and Starshield.',
        [(13507, 'И мы решили, что, возможно, через 48 часов у нас снова будет связь'),
         (13528, 'Мы ничего не отменяли.')])
    add(c, 'ua', '«Общественное» пишет, что в ближайшие 48 часов Зеленский может снова связаться с Рубио по Starlink; РБК-Украина — что Хегсет отрицает какие-либо ограничения: решения может принимать сама Starlink.',
        '«Суспільне» пише, що найближчих 48 годин Зеленський може знову сконтактувати з Рубіо щодо Starlink; РБК-Україна — що Гегсет заперечує будь-які обмеження: рішення може ухвалювати сама Starlink.',
        'Suspilne writes that Zelensky may contact Rubio again about Starlink within the next 48 hours; RBC-Ukraine that Hegseth denies any restrictions, saying Starlink itself can make such decisions.',
        [(14103, 'протягом наступних 48 годин може сконтактувати з Марком Рубіо з цього питання'),
         (14941, 'Ми нічого не обмежували.')])

@ext('1020-trump-ukraine-must-want-deal', [13511, 13513, 14419, 14712, 13508, 13509, 13510, 13512, 13514, 13526, 13531, 13532, 13741, 14501, 14056])
