    add(c, 'ru', 'РИА Новости добавляет его слова, что Зеленский мог заключить гораздо более выгодную сделку два года назад, а встреча Путина и Зеленского для урегулирования не обязательна.',
        'РИА Новости додає його слова, що Зеленський міг укласти значно вигіднішу угоду два роки тому, а зустріч Путіна і Зеленського для врегулювання не обов’язкова.',
        'RIA Novosti adds his words that Zelensky could have made a much better deal two years ago and that a Putin-Zelensky meeting is not necessary for a settlement.',
        [(13511, 'Вероятно, он мог заключить гораздо более выгодную сделку, чем та, которую, возможно, может заключить сейчас'),
         (13513, 'Им не обязательно быть в одной комнате.')])
    add(c, 'ua', '«Украинская правда» выносит в заголовок слова Трампа, что Путину и Зеленскому не обязательно быть в одной комнате для соглашения.',
        '«Українська правда» виносить у заголовок слова Трампа, що Путіну і Зеленському не обов’язково бути в одній кімнаті для угоди.',
