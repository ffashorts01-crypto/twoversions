@ext('1019-kyiv-ballistic-night', [12225, 12261, 12279, 12309])
def _(c):
    rep(c, ('ru', 'summary'), 'О целях, попаданиях и пострадавших российские источники в выборке не пишут, сообщений Минобороны РФ об этой атаке нет.', 'О попаданиях и пострадавших российские источники в выборке не пишут.')
    rep(c, ('uk', 'ru'), 'Про цілі, влучання і постраждалих російські джерела у вибірці не пишуть, повідомлень Міноборони РФ про цю атаку немає.', 'Про влучання і постраждалих російські джерела у вибірці не пишуть.')
    rep(c, ('en', 'ru'), 'Russian sources in the sample do not write about targets, hits or casualties, and there is no Russian Defence Ministry statement on this attack.', 'Russian sources in the sample do not write about hits or casualties.')
    add(c, 'ru', 'Утром Минобороны РФ заявило о ночном массированном ударе высокоточным оружием наземного базирования и ударными беспилотниками большой дальности: по его данным, поражены предприятия военной промышленности, объекты хранения крылатых ракет и БПЛА и центр обработки данных в Киеве и Киевской области; заявление передают РИА Новости, ТАСС и «Интерфакс».',
        'Уранці Міноборони РФ заявило про нічний масований удар високоточною зброєю наземного базування та ударними безпілотниками великої дальності: за його даними, уражено підприємства військової промисловості, об’єкти зберігання крилатих ракет і БпЛА та центр обробки даних у Києві та Київській області; заяву передають РИА Новости, ТАСС та «Інтерфакс».',
        'In the morning the Russian Defence Ministry claimed a massive overnight strike with ground-based precision weapons and long-range attack drones: according to it, military-industrial plants, cruise missile and drone storage sites and a data centre in Kyiv and the Kyiv region were hit; RIA Novosti, TASS and Interfax relay the statement.',
        [(12279, 'В результате удара поражены предприятия военной промышленности, объекты хранения крылатых ракет, беспилотных летательных аппаратов и центр обработки данных в городе Киеве и Киевской области'),
         (12309, 'Вооруженные силы России ночью нанесли массированный удар высокоточным оружием наземного базирования и беспилотниками по целям в Киеве и Киевской области')])
    for path, old, new in [
        (('title',), 'российские агентства сообщают о взрывах в Луцке, Ровно и Днепре', 'Минобороны РФ — удар по ВПК, взрывы в Луцке, Ровно и Днепре'),
        (('uk', 't'), 'російські агентства повідомляють про вибухи в Луцьку, Рівному і Дніпрі', 'Міноборони РФ — удар по ВПК, вибухи в Луцьку, Рівному і Дніпрі'),
        (('en', 't'), 'Russian agencies report explosions in Lutsk, Rivne and Dnipro', 'Russian MoD claims hits on defence industry; explosions in Lutsk, Rivne and Dnipro'),
        (('diverge',), 'Российские агентства о целях и последствиях не пишут и повторяют формулировку об ударах по «центрам принятия решений», РБК-Украина сообщает',
         'Минобороны РФ заявляет о поражении предприятий военной промышленности, складов крылатых ракет и БПЛА и центра обработки данных, о повреждениях метро и жилых домов российские источники не пишут; РБК-Украина сообщает'),
        (('uk', 'd'), 'Російські агентства про цілі й наслідки не пишуть і повторюють формулювання про удари по «центрах ухвалення рішень», РБК-Україна повідомляє',
         'Міноборони РФ заявляє про ураження підприємств військової промисловості, складів крилатих ракет і БпЛА та центру обробки даних, про пошкодження метро і житлових будинків російські джерела не пишуть; РБК-Україна повідомляє'),
        (('en', 'd'), 'Russian agencies do not write about targets or consequences and repeat the line about strikes on "decision-making centres", while RBC-Ukraine reports',
         'The Russian Defence Ministry claims hits on military-industrial plants, cruise missile and drone depots and a data centre, and Russian sources do not mention damage to the metro or residential buildings, while RBC-Ukraine reports')]:
        rep(c, path, old, new)
    c['uncertainty_reason'] += ' Заявление Минобороны РФ о поражении военных объектов независимо не подтверждено.'

@ext('1019-kyiv-cruise-missiles-morning', [12293])
