apply(['c18d.json', 'c19a.json', 'c19c.json', 'c19d.json'])
json.dump(cards, open(OUT + 'c19e.json', 'w'), ensure_ascii=False, indent=1)
print('new cards', len(cards))
# length check on all touched / new cards
for f in ['c18d.json', 'c19a.json', 'c19c.json', 'c19d.json', 'c19e.json']:
    for c in json.load(open(OUT + f)):
        L = [len(c[s]['summary']) for s in ('ru', 'ua', 'ind') if c[s]] + [len(c[l][k]) for l in ('uk', 'en') for k in ('ru', 'ua', 'ind', 'd') if c[l][k]] + [len(c['diverge'])]
        if max(L) > 1400: print('TOO LONG', f, c['key'], max(L))
        if len(c['title']) > 160: print('TITLE LONG', c['key'], len(c['title']))
