import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1014-burnham-zelensky-london', [10706, 10781, 5907, 7122, 7162, 8032, 8073, 8086, 8306, 8574],
 'Зеленский в Лондоне: Бёрнем обещает ускорить поставки ракет LMM против реактивных дронов', 'Лондон', 'ukraine-wide',
 ['одна из групп не освещает'],
 S('Интерфакс и ТАСС со ссылкой на канцелярию премьера сообщают, что Великобритания поставит зенитные ракеты на 45 млн фунтов и ускорит поставку части пакета на 10 млн фунтов; ранее Лондон обязался передать более 5000 ракет LMM за 1,6 млрд фунтов. После встречи на Даунинг-стрит лидеры обсудили, как ускорить оборонную поддержку Украины перед зимой, в том числе по дальнобойным ракетам.',
   (5907, 'The UK has already committed 1.6 billion pounds to deliver more than 5000 LMMs to Ukraine over the next four years'),
   (10781, 'В том, что касается дальнобойных ракет, лидеры обсудили то, как Великобритания могла бы ускорить оборонную поддержку Украины в преддверии зимы')),
 S('Зеленский сообщил о решении ускорить поставки британских средств ПВО против реактивных «шахедов». Бёрнем, по данным Суспильного, пообещал, что они прибудут как можно быстрее, и сообщил о подготовке нового пакета санкций против России; в Палате общин он сказал, что хочет восстановить мосты между Украиной и США, воздержавшись от критики Трампа.',
   (8086, 'Сьогодні є рішення про прискорене постачання британських засобів ППО Україні для протидії реактивним шахедам')),
 S('BBC пишет, что Бёрнем осторожно балансирует между Трампом и Украиной; Kyiv Independent отмечает, что визит пришелся на момент, когда администрация Трампа давит на Киев из-за ударов по НПЗ и угрожает прекратить обмен разведданными.',
   (8574, 'The visit comes at a tense moment for Ukraine')),
 'Российские агентства пересказывают британские заявления без оценок; украинские и независимые источники подчеркивают контекст давления со стороны США.',
 'low', '', False,
 ['Зеленський у Лондоні: Бернем обіцяє пришвидшити постачання ракет LMM проти реактивних дронів', 'Лондон',
  'Російські агентства переказують британські заяви без оцінок; українські та незалежні джерела наголошують на контексті тиску з боку США.',
  'Інтерфакс і ТАСС з посиланням на канцелярію прем’єра повідомляють, що Велика Британія постачить зенітні ракети на 45 млн фунтів і пришвидшить постачання частини пакета на 10 млн фунтів; раніше Лондон зобов’язався передати понад 5000 ракет LMM за 1,6 млрд фунтів. Після зустрічі на Даунінг-стріт лідери обговорили, як пришвидшити оборонну підтримку України перед зимою, зокрема щодо далекобійних ракет.',
  'Зеленський повідомив про рішення пришвидшити постачання британських засобів ППО проти реактивних «шахедів». Бернем, за даними Суспільного, пообіцяв, що вони прибудуть якомога швидше, і повідомив про підготовку нового пакета санкцій проти Росії; у Палаті громад він сказав, що хоче відновити мости між Україною та США, утримавшись від критики Трампа.',
  'BBC пише, що Бернем обережно балансує між Трампом і Україною; Kyiv Independent зазначає, що візит припав на момент, коли адміністрація Трампа тисне на Київ через удари по НПЗ і погрожує припинити обмін розвідданими.'],
 ['Zelensky in London: Burnham pledges faster deliveries of LMM missiles against jet-powered drones', 'London',
  'Russian agencies relay British statements without comment; Ukrainian and independent sources stress the context of US pressure.',
  'Interfax and TASS, citing the prime minister\'s office, report that Britain will deliver 45 million pounds of surface-to-air missiles and accelerate a 10 million pound part of the package; London had earlier committed to more than 5000 LMMs for 1.6 billion pounds. After the Downing Street meeting the leaders discussed how to speed up defence support for Ukraine before winter, including on long-range missiles.',
  'Zelensky announced a decision to speed up deliveries of British air defence against jet-powered Shaheds. Burnham, according to Suspilne, promised they would arrive as soon as possible and said a new package of sanctions on Russia was being prepared; in the Commons he said he wants to rebuild bridges between Ukraine and the US, refraining from criticising Trump.',
  'The BBC writes that Burnham is carefully balancing between Trump and Ukraine; Kyiv Independent notes the visit came as the Trump administration presses Kyiv over refinery strikes and threatens to cut intelligence sharing.'])

card('1014-eu-286bn-defence', [10753, 10756, 7138, 8053, 9389, 8571],
 'Еврокомиссия выделила Украине 2,86 млрд евро на дроны, ПВО и боеприпасы', 'Брюссель', 'ukraine-wide',
 ['стороны совпадают'],
 S('Интерфакс сообщает, что ЕК выделила Украине 2,86 млрд евро в рамках оборонного компонента пакета помощи на 90 млрд евро — на беспилотники, ПВО, ракеты, радары, РЭБ и боеприпасы; в тот же день Еврокомиссия объявила о 168,2 млн евро на первые проекты программы оборонной промышленности EDIP.',
   (10753, 'Выделяя сегодня 2,86 млрд евро, мы продолжаем удовлетворять самые неотложные оперативные потребности Украины')),
 S('Суспильне и Украинская правда передают то же решение; по данным ЕК, у Украины остается 29,64 млрд евро доступной финансовой поддержки на 2026 год.',
   (7138, 'Україна все ще має 29,64 млрд євро доступної фінансової підтримки на 2026 рік')),
 S('DW и Kyiv Independent приводят слова Урсулы фон дер Ляйен о том, что поддержка Европы важна как никогда, чтобы помочь Украине защитить воздушное пространство.',
   (8571, 'With today\'s 2.86 billion euro disbursement, we keep addressing Ukraine\'s most urgent operational needs')),
 'Расхождений в фактах нет; российские источники пересказывают коммюнике ЕК без оценок.',
 'low', '', False,
 ['Єврокомісія виділила Україні 2,86 млрд євро на дрони, ППО і боєприпаси', 'Брюссель',
  'Розбіжностей у фактах немає; російські джерела переказують комюніке ЄК без оцінок.',
  'Інтерфакс повідомляє, що ЄК виділила Україні 2,86 млрд євро в межах оборонного компонента пакета допомоги на 90 млрд євро — на безпілотники, ППО, ракети, радари, РЕБ і боєприпаси; того ж дня Єврокомісія оголосила про 168,2 млн євро на перші проєкти програми оборонної промисловості EDIP.',
  'Суспільне і Українська правда передають те саме рішення; за даними ЄК, в України залишається 29,64 млрд євро доступної фінансової підтримки на 2026 рік.',
  'DW і Kyiv Independent наводять слова Урсули фон дер Ляєн про те, що підтримка Європи важлива як ніколи, щоб допомогти Україні захистити повітряний простір.'],
 ['European Commission disburses 2.86 billion euros to Ukraine for drones, air defence and ammunition', 'Brussels',
  'There are no factual discrepancies; Russian sources relay the Commission statement without comment.',
  'Interfax reports that the Commission disbursed 2.86 billion euros to Ukraine under the defence component of the 90 billion euro aid package — for drones, air defence, missiles, radars, electronic warfare and ammunition; the same day the Commission announced 168.2 million euros for the first projects under the EDIP defence industry programme.',
  'Suspilne and Ukrainska Pravda report the same decision; according to the Commission, Ukraine still has 29.64 billion euros of available financial support for 2026.',
  'DW and Kyiv Independent quote Ursula von der Leyen saying Europe\'s support matters more than ever to help Ukraine protect its airspace.'])

card('1014-truce-unclear-refinery-claims', [10769, 5967, 5948, 5934, 7145, 8054, 8074, 8582, 9406, 8568],
 'Кремль: энергоперемирие Трампа «не конкретизировано»; Новак обвинил Украину в ударах по двум НПЗ, Киев назвал это фейком', 'Москва, Киев', 'ukraine-wide',
 ['расхождение: факты', 'атрибуция'],
 S('Песков заявил, что предложенное Трампом энергетическое перемирие не конкретизировано и работа в этом направлении продолжается, а европейцы, в отличие от США, делают все, чтобы война продолжалась. Вице-премьер Александр Новак сказал, что, по данным Минэнерго и компаний, Украина атаковала два НПЗ — в Саратовской и Рязанской областях — и не демонстрирует движения к перемирию.',
   (10769, 'По данным Минэнерго и компаний сегодня киевским режимом были атакованы два нефтеперерабатывающих завода - в Саратовской и Рязанской областях.'),
   (5934, 'Europeans are taking a different approach: they are doing everything they can to ensure that this war continues')),
 S('Советник президента по коммуникациям Дмитрий Литвин назвал заявление Новака фейком: по его словам, атакован дата-центр и еще ряд объектов, но не НПЗ. Суспильне и Украинская правда передают слова Пескова о «неконкретизированном» перемирии на фоне ночного удара по энергетике.',
   (8074, 'Росіяни вкинули фейк про начебто два атакованих НПЗ.')),
 S('DW пишет, что The Insider не нашел подтверждений атак на энергообъекты России за сутки: очаги возгорания в Балаково на карте NASA FIRMS расположены рядом с ЦОД и металлургическим заводом. Kyiv Independent связывает слова Пескова с продолжающимися ударами по украинской энергосистеме.',
   (9406, 'расследовательское издание The Insider не нашло подтверждений атак на энергетические объекты России за последние сутки')),
 'Россия обвиняет Украину в ударах по двум НПЗ, Киев это отрицает, независимого подтверждения ударов по НПЗ нет. Одновременно Кремль ставит под сомнение сами рамки перемирия, о котором объявил Трамп.',
 'medium', 'Факт ударов по НПЗ оспаривается.', True,
 ['Кремль: енергоперемир’я Трампа «не конкретизоване»; Новак звинуватив Україну в ударах по двох НПЗ, Київ назвав це фейком', 'Москва, Київ',
  'Росія звинувачує Україну в ударах по двох НПЗ, Київ це заперечує, незалежного підтвердження ударів по НПЗ немає. Водночас Кремль ставить під сумнів самі рамки перемир’я, про яке оголосив Трамп.',
  'Пєсков заявив, що запропоноване Трампом енергетичне перемир’я не конкретизоване і робота в цьому напрямку триває, а європейці, на відміну від США, роблять усе, щоб війна тривала. Віцепрем’єр Олександр Новак сказав, що, за даними Міненерго і компаній, Україна атакувала два НПЗ — у Саратовській і Рязанській областях — і не демонструє руху до перемир’я.',
  'Радник президента з комунікацій Дмитро Литвин назвав заяву Новака фейком: за його словами, атаковано дата-центр і ще низку об’єктів, але не НПЗ. Суспільне і Українська правда передають слова Пєскова про «неконкретизоване» перемир’я на тлі нічного удару по енергетиці.',
  'DW пише, що The Insider не знайшов підтверджень атак на енергооб’єкти Росії за добу: осередки займання в Балаково на мапі NASA FIRMS розташовані поруч із ЦОД і металургійним заводом. Kyiv Independent пов’язує слова Пєскова з тривалими ударами по українській енергосистемі.'],
 ['Kremlin says Trump\'s energy truce is "not specified"; Novak accuses Ukraine of striking two refineries, Kyiv calls it fake', 'Moscow, Kyiv',
  'Russia accuses Ukraine of striking two refineries, Kyiv denies it, and there is no independent confirmation of refinery strikes. At the same time the Kremlin questions the very terms of the truce Trump announced.',
  'Peskov said the energy truce proposed by Trump had not been specified and work on it continues, and that Europeans, unlike the US, are doing everything to keep the war going. Deputy Prime Minister Alexander Novak said that, according to the Energy Ministry and companies, Ukraine attacked two refineries — in Saratov and Ryazan regions — and shows no movement towards a truce.',
  'Presidential communications adviser Dmytro Lytvyn called Novak\'s statement fake: he said a data centre and several other sites were hit, but not refineries. Suspilne and Ukrainska Pravda relay Peskov\'s remarks about the "unspecified" truce against the backdrop of the overnight strike on energy.',
  'DW writes that The Insider found no confirmation of attacks on Russian energy facilities over the day: fire hotspots in Balakovo on the NASA FIRMS map lie near the data centre and a steel plant. Kyiv Independent links Peskov\'s remarks to continuing strikes on Ukraine\'s power grid.'])

card('1014-diesel-deal-backlash', [7144, 7150, 8765, 9407, 8570, 8583, 8588, 9152, 8586, 8591, 9409],
 'Критика дизельной сделки Трампа: Мелони, сенаторы США и проект итогов саммита ЕС; Зеленский: «больно, когда Трамп выбирает не нашу сторону»', 'Рим, Брюссель, Вашингтон', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Премьер Италии Джорджа Мелони в Сенате заявила, что капитуляцию тех, кто защищает свою свободу, нельзя назвать миром. По данным Суспильного, в проекте итогового коммюнике саммита ЕС лидеры выразят «сожаление» решением США снять санкции с российского дизеля и призовут к дальнейшему давлению на Россию.',
   (7144, 'Ніхто мене не переконає, що капітуляцію тих, хто захищає свою свободу, можна назвати миром.'),
   (7150, 'Європейська рада закликає до швидкого та ефективного впровадження заходів щодо колишніх російських комбатантів')),
 S('Kyiv Independent пишет, что двухпартийная группа сенаторов США потребовала отменить сделку, назвав ее подарком противнику, а Мелони — «очень рискованной»; Зеленский в интервью Пирсу Моргану сказал, что Украина теряет сильного партнера. 75 евродепутатов призвали ЕС не идти на уступки России, а, по данным Kyiv Independent, Венгрия и Болгария смягчили формулировки о вступлении Украины в ЕС. Эксперты DW считают, что сделка вряд ли снизит цены на дизель.',
   (8570, 'This deal is a gift to our adversary and a betrayal of our Allies; it should be rescinded'),
   (8588, "It's painful when President Trump chooses one \u200cside, not our \u2060side")),
 'Украинские и независимые источники единодушно критичны к сделке; российские источники в выборке эти реакции не освещают.',
 'low', '', False,
 ['Критика дизельної угоди Трампа: Мелоні, сенатори США і проєкт підсумків саміту ЄС; Зеленський: «боляче, коли Трамп обирає не наш бік»', 'Рим, Брюссель, Вашингтон',
  'Українські та незалежні джерела одностайно критичні до угоди; російські джерела у вибірці ці реакції не висвітлюють.',
  None,
  'Прем’єрка Італії Джорджа Мелоні в Сенаті заявила, що капітуляцію тих, хто захищає свою свободу, не можна назвати миром. За даними Суспільного, у проєкті підсумкового комюніке саміту ЄС лідери висловлять «жаль» через рішення США зняти санкції з російського дизелю і закличуть до подальшого тиску на Росію.',
  'Kyiv Independent пише, що двопартійна група сенаторів США вимагала скасувати угоду, назвавши її подарунком противнику, а Мелоні — «дуже ризикованою»; Зеленський в інтерв’ю Пірсу Моргану сказав, що Україна втрачає сильного партнера. 75 євродепутатів закликали ЄС не йти на поступки Росії, а, за даними Kyiv Independent, Угорщина і Болгарія пом’якшили формулювання щодо вступу України до ЄС. Експерти DW вважають, що угода навряд чи знизить ціни на дизель.'],
 ['Backlash over Trump\'s diesel deal: Meloni, US senators and draft EU summit conclusions; Zelensky: "painful when Trump chooses not our side"', 'Rome, Brussels, Washington',
  'Ukrainian and independent sources are uniformly critical of the deal; Russian sources in the sample do not cover these reactions.',
  None,
  'Italian Prime Minister Giorgia Meloni told the Senate that the capitulation of those defending their freedom cannot be called peace. According to Suspilne, in the draft EU summit conclusions leaders will express "regret" over the US decision to lift sanctions on Russian diesel and call for further pressure on Russia.',
  'Kyiv Independent writes that a bipartisan group of US senators demanded the deal be rescinded, calling it a gift to the adversary, and Meloni called it "very risky"; Zelensky told Piers Morgan that Ukraine is losing a strong partner. 75 MEPs urged the EU to make no concessions to Russia, and, according to Kyiv Independent, Hungary and Bulgaria watered down wording on Ukraine\'s EU accession. DW experts say the deal is unlikely to lower diesel prices.'])
json.dump(cards, open('/workspace/compare-site-v2/tools/days/out/c14c.json', 'w'), ensure_ascii=False)
print(len(cards))
