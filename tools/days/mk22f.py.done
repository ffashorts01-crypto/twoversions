@ext('1021-hubbard-released', [15252, 15281, 15240, 13797, 13820, 13876, 14989, 14127, 14138, 14140, 14742, 14728, 14717, 14778, 14627, 14633, 14646, 15321])
def _(c):
    add(c, 'ru', '«Интерфакс» сообщает, что Уиткофф и Кирилл Дмитриев встретились с Хаббардом в аэропорту Пулково, а затем приводит пост Трампа: освобождения следовало добиться еще при Байдене.',
        '«Інтерфакс» повідомляє, що Віткофф і Кирило Дмитрієв зустрілися з Габбардом в аеропорту Пулково, а потім наводить допис Трампа: звільнення слід було домогтися ще за Байдена.',
        'Interfax reports that Witkoff and Kirill Dmitriev met Hubbard at Pulkovo airport, and then quotes Trump\'s post saying the release should have been achieved under Biden.',
        [(15252, 'встретились в аэропорту Пулково с освобожденным гражданином США Стивеном Хаббардом'),
         (15281, 'Это следовало сделать давно, еще при сонном Джо Байдене и глупых демократах')])
    add(c, 'ua', 'РБК-Украина, пересказывая сообщение РИА Новости, напоминает, что Хаббард с 2014 года жил в Изюме, по его словам, российские военные похитили его из собственного дома, а родственники называли его пацифистом, который никогда не взял бы в руки оружие.',
        'РБК-Україна, переказуючи повідомлення РИА Новости, нагадує, що Габбард з 2014 року жив в Ізюмі, за його словами, російські військові викрали його з власного будинку, а родичі називали його пацифістом, який ніколи не взяв би до рук зброю.',
        'RBC-Ukraine, retelling the RIA Novosti report, recalls that Hubbard had lived in Izium since 2014, that by his account Russian soldiers abducted him from his own home, and that his relatives called him a pacifist who would never have taken up arms.',
        [(14989, 'За словами американця, російські військові викрали його з власного будинку.'),
         (14989, 'родичі Габбарда називали його пацифістом і запевняли, що він ніколи не взяв би до рук зброю')])
    add(c, 'ind', 'DW и Al Jazeera приводят слова Трампа, что США ничего не отдали взамен и обмена не потребовалось.',
        'DW і Al Jazeera наводять слова Трампа, що США нічого не віддали натомість і обміну не знадобилося.',
        'DW and Al Jazeera quote Trump as saying the US gave nothing in return and no exchange was needed.',
        [(14778, 'the US was not required to give anything in return for the release of the 74-year-old former teacher from Michigan')])
    appd(c, 'РБК-Украина, в отличие от российских агентств, пишет, что Хаббарда, по его словам, похитили из дома в Изюме, и называет его пацифистом со слов родственников.',
         'РБК-Україна, на відміну від російських агентств, пише, що Габбарда, за його словами, викрали з дому в Ізюмі, і називає його пацифістом зі слів родичів.',
         'Unlike the Russian agencies, RBC-Ukraine writes that Hubbard, by his account, was abducted from his home in Izium, and calls him a pacifist, citing his relatives.')

