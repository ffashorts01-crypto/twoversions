cards.append(C('1010-night-attack-west', [10447, 9916, 9920, 7806, 7808, 7809, 6947],
 'Ночная атака 160 дронов: реактивный дрон впервые долетел до Львова, удар по железной дороге на Житомирщине', 'Украина: Львов, Ивано-Франковск, Житомирская область', 'ukraine-wide',
 ['атрибуция'],
 S('Минобороны РФ, по данным Интерфакса, заявило, что за сутки поражены объекты энергетики Украины, «используемые в интересах ВПК», а также цеха производства беспилотников.',
   (10447, 'Минобороны РФ сообщило, что в течение суток поражены объекты энергетики Украины, используемые в интересах ВПК страны.')),
 S('Воздушные силы ВСУ сообщили, что в ночь на 10 октября Россия атаковала 160 дронами, 110 из них — реактивные «Шахеды»; сбиты или подавлены 117, попадания зафиксированы на 14 локациях. Утром ПВО сбила под Львовом реактивный дрон, впервые залетевший на территорию города; взрывы были слышны и в Ивано-Франковске. Житомирская ОВА сообщила об ударе по железнодорожной инфраструктуре Коростенской громады, пострадал один человек.',
   (7808, 'Зафіксовані влучання на 14 локаціях.'),
   (7806, 'протиповітряна оборона збила поблизу Львова російський реактивний безпілотник, який перед цим залетів на територію міста'),
   (7809, 'російські війська атакували безпілотниками залізничну інфраструктуру Коростенської громади на Житомирщині')),
 None,
 'Минобороны РФ называет пораженные энергообъекты связанными с ВПК; украинская сторона пишет о попаданиях по железной дороге и атаке на запад страны. Независимые источники в выборке ночную атаку отдельно не описывают.',
 'low', '', False,
 ['Нічна атака 160 дронів: реактивний дрон уперше долетів до Львова, удар по залізниці на Житомирщині', 'Україна: Львів, Івано-Франківськ, Житомирська область',
  'Міноборони РФ називає уражені енергооб’єкти пов’язаними з ОПК; українська сторона пише про влучання по залізниці та атаку на захід країни. Незалежні джерела у вибірці нічну атаку окремо не описують.',
  'Міноборони РФ, за даними Інтерфаксу, заявило, що за добу уражено об’єкти енергетики України, «що використовуються в інтересах ОПК», а також цехи виробництва безпілотників.',
  'Повітряні сили ЗСУ повідомили, що в ніч на 10 жовтня Росія атакувала 160 дронами, 110 з них — реактивні «Шахеди»; збито або подавлено 117, влучання зафіксовано на 14 локаціях. Вранці ППО збила під Львовом реактивний дрон, який уперше залетів на територію міста; вибухи було чути й в Івано-Франківську. Житомирська ОВА повідомила про удар по залізничній інфраструктурі Коростенської громади, постраждала одна людина.',
