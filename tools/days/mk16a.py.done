import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1016-dobropillia-putin-command-post', [10966, 6636, 4901, 4908, 4911, 4913, 4917, 10971, 10976, 10981, 4904, 10984, 10993, 10977, 4899, 6169, 6175, 10973, 10970, 4927, 6645, 10990, 10994, 4906, 4912, 4910, 4923, 6635, 4903, 7240, 9629],
 'Путин на командном пункте: Генштаб РФ заявил о взятии Доброполья и уничтожении группировки ВСУ на севере Харьковской области', 'Доброполье, Донецкая область; Харьковская область', 'donetsk',
 ['расхождение: факты', 'не проверено независимо'],
 S('Путин посетил вспомогательный пункт управления Объединенной группировки войск. Начальник Генштаба Валерий Герасимов доложил, что группировка «Центр» освободила Доброполье, «один из основных узлов обороны противника»; командир 61-й бригады морской пехоты Александр Балюра заявил о полном контроле над городом. Путин сообщил о завершении уничтожения «двухтысячной группировки» ВСУ в Харьковской области, переходе под контроль 461 кв. км и 28 населенных пунктов, а Герасимов — о 92 населенных пунктах с 1 сентября. По словам Путина, под контролем ВСУ в ДНР осталось 2748 кв. км, ЛНР полностью под контролем России, а темпы наступления «значительно возросли». Минобороны также заявило о взятии Алексеево-Дружковки и Великомихайловки.',
   (10966, 'Войсками группировки "Центр" освобожден город Доброполье, один из основных узлов обороны противника на днепропетровском направлении'),
   (4911, 'В настоящее время Доброполье находится под нашим полным контролем, проводим мероприятия по поиску и уничтожению одиночных украинских военнослужащих'),
   (10981, 'Полностью завершено уничтожение двухтысячной группировки противника, окруженной в северо-восточной части Харьковской области.'),
   (10973, 'Тем не менее темпы продвижения значительно возросли')),
 S('Утренняя сводка Генштаба ВСУ не подтверждает потерю города: Доброполье упомянуто среди населенных пунктов, в сторону которых российские войска пытались продвинуться на Покровском направлении, где зафиксировано 60 атак.',
   (7240, 'На Покровському напрямку окупанти здійснили 60 атак')),
 S('Al Jazeera пишет, что украинское контрнаступление южнее Лимана отбросило российскую попытку взять Доброполье, а Третий армейский корпус заявил о возвращении еще 100 кв. км в Донецкой области.',
   (9629, 'A separate counteroffensive further south pushed back against an attempted Russian takeover of Dobropillya.')),
 'Российское командование заявляет о полном контроле над Добропольем, тогда как украинский Генштаб в тот же день описывает бои за подступы к городу, а Al Jazeera — отражение российской попытки его взять. Цифры о «двухтысячной группировке» и захваченной территории исходят только от российской стороны и независимо не проверены.',
 'medium', 'Заявления сторон о контроле над Добропольем противоречат друг другу; независимого подтверждения нет.', True,
 ['Путін на командному пункті: Генштаб РФ заявив про взяття Добропілля і знищення угруповання ЗСУ на півночі Харківщини', 'Добропілля, Донеччина; Харківщина',
  'Російське командування заявляє про повний контроль над Добропіллям, тоді як український Генштаб того ж дня описує бої на підступах до міста, а Al Jazeera — відбиття російської спроби його взяти. Цифри про «двотисячне угруповання» і захоплену територію походять лише від російської сторони і незалежно не перевірені.',
  'Путін відвідав допоміжний пункт управління Об’єднаного угруповання військ. Начальник Генштабу Валерій Герасимов доповів, що угруповання «Центр» «звільнило» Добропілля, «один з основних вузлів оборони противника»; командир 61-ї бригади морської піхоти Олександр Балюра заявив про повний контроль над містом. Путін повідомив про завершення знищення «двотисячного угруповання» ЗСУ на Харківщині, перехід під контроль 461 кв. км і 28 населених пунктів, а Герасимов — про 92 населені пункти з 1 вересня. За словами Путіна, під контролем ЗСУ в Донецькій області залишилося 2748 кв. км, Луганщина повністю під контролем Росії, а темпи наступу «значно зросли». Міноборони також заявило про взяття Олексієво-Дружківки та Великомихайлівки.',
  'Ранкове зведення Генштабу ЗСУ не підтверджує втрату міста: Добропілля згадано серед населених пунктів, у бік яких російські війська намагалися просунутися на Покровському напрямку, де зафіксовано 60 атак.',
  'Al Jazeera пише, що український контрнаступ південніше Лимана відкинув російську спробу взяти Добропілля, а Третій армійський корпус заявив про повернення ще 100 кв. км на Донеччині.'],
 ['Putin at command post: Russian General Staff claims capture of Dobropillia and destruction of a Ukrainian grouping in northern Kharkiv region', 'Dobropillia, Donetsk region; Kharkiv region',
  'The Russian command claims full control of Dobropillia, while the Ukrainian General Staff on the same day describes fighting on the approaches to the town and Al Jazeera reports a Russian attempt to take it being repelled. The figures on the "two-thousand-strong grouping" and captured territory come only from the Russian side and are not independently verified.',
  'Putin visited an auxiliary command post of the Joint Group of Forces. Chief of General Staff Valery Gerasimov reported that the Centre group had "liberated" Dobropillia, "one of the main enemy defence hubs"; Alexander Balyura, commander of the 61st naval infantry brigade, claimed full control of the town. Putin announced the completed destruction of a "two-thousand-strong" Ukrainian grouping in Kharkiv region, with 461 sq km and 28 settlements taken, and Gerasimov cited 92 settlements since 1 September. According to Putin, Ukraine still holds 2748 sq km of Donetsk region, Luhansk region is fully under Russian control and the pace of the offensive has "increased significantly". The Defence Ministry also claimed Oleksiievo-Druzhkivka and Velykomykhailivka.',
  'The Ukrainian General Staff\'s morning report does not confirm the loss of the town: Dobropillia is listed among the places towards which Russian forces tried to advance on the Pokrovsk axis, where 60 attacks were recorded.',
  'Al Jazeera writes that a Ukrainian counteroffensive south of Lyman pushed back a Russian attempt to take Dobropillia, and the Third Army Corps said it had retaken another 100 sq km in Donetsk region.'])

card('1016-putin-orders-energy-strikes', [10978, 10982, 10968, 10975, 6166, 6177, 6182, 10983, 10986, 10988, 10992, 6176, 4905, 10980, 10965, 6168, 10967, 6178, 6171, 10995, 6640, 6641, 6642, 8937, 8938, 7273, 8735, 8699],
 'Герасимов доложил Путину о начале массированных ударов по энергетике Украины; Путин велел продолжать удары, зону безопасности — не обсуждать', 'Украина', 'ukraine-wide',
 ['расхождение: оценка ситуации'],
 S('Герасимов доложил Путину, что армия «приступила к нанесению массированных ударов по объектам энергетики Украины», определен перечень объектов; по его словам, удары по портам привели к остановке основных украинских портов на Черном море, поражаются мосты стратегического значения и снижены возможности Украины производить дальнобойное оружие. Путин поручил продолжать массированные и групповые удары по объектам ВПК и логистическим центрам, назвав их ответом на действия Киева, и заявил, что создание зоны безопасности на приграничных территориях не будет предметом переговоров.',
   (10978, 'Вооруженные силы России приступили к нанесению массированных ударов по объектам энергетики Украины. Определен перечень данных объектов и необходимый наряд средств для их поражения'),
   (10982, 'должно быть продолжено нанесение массированных и групповых ударов по объектам военно-промышленного комплекса и логистическим центрам противника'),
   (6168, 'we are not going to make this a subject of any potential peace talks with Ukraine')),
 S('Украинские СМИ пишут, что Россия «забыла» об объявленном Трампом «энергетическом перемирии», и указывают, что энергообъекты являются гражданской инфраструктурой; Суспильне напоминает, что Киев снял ограничения на удары по НПЗ после ударов по энергетике Киева и Харькова 14 октября.',
   (8937, 'Хоча РФ ніколи не припиняла бити по цивільній інфраструктурі України, навіть під час "перемир\'я".'),
   (7273, 'Після цього він сказав, що скасував обмеження для українських Сил оборони щодо атак на російські нафтопереробні заводи.')),
 S('The Guardian и Meduza со ссылкой на NYT описывают перехваченный, по данным украинской разведки, российский план зимних ударов, цель которого — оставить Киев, Харьков и Одессу без света, тепла и воды и вынудить Украину капитулировать.',
   (8735, 'in a strategy meant to punish Ukraine’s population and drive the country to capitulation'),
   (8699, 'Russia expects to force Ukraine to capitulate this coming winter by disabling its energy system')),
 'Российское командование представляет удары как ответ на атаки Киева и как удары по военно-промышленным целям; украинские и независимые источники говорят о целенаправленном разрушении гражданской энергетики крупных городов.',
 'low', '', False,
 ['Герасимов доповів Путіну про початок масованих ударів по енергетиці України; Путін наказав продовжувати удари, зону безпеки — не обговорювати', 'Україна',
  'Російське командування подає удари як відповідь на атаки Києва і як удари по військово-промислових цілях; українські та незалежні джерела говорять про цілеспрямоване руйнування цивільної енергетики великих міст.',
  'Герасимов доповів Путіну, що армія «розпочала завдавати масованих ударів по об’єктах енергетики України», визначено перелік об’єктів; за його словами, удари по портах призвели до зупинки основних українських портів на Чорному морі, уражаються мости стратегічного значення і знижено можливості України виробляти далекобійну зброю. Путін доручив продовжувати масовані та групові удари по об’єктах ВПК і логістичних центрах, назвавши їх відповіддю на дії Києва, і заявив, що створення зони безпеки на прикордонних територіях не буде предметом переговорів.',
  'Українські ЗМІ пишуть, що Росія «забула» про оголошене Трампом «енергетичне перемир’я», і наголошують, що енергооб’єкти є цивільною інфраструктурою; Суспільне нагадує, що Київ зняв обмеження на удари по НПЗ після ударів по енергетиці Києва і Харкова 14 жовтня.',
  'The Guardian і Meduza з посиланням на NYT описують перехоплений, за даними української розвідки, російський план зимових ударів, мета якого — залишити Київ, Харків та Одесу без світла, тепла і води та змусити Україну капітулювати.'],
 ['Gerasimov reports to Putin the start of massive strikes on Ukraine\'s energy; Putin orders strikes to continue and rules out talks on a security zone', 'Ukraine',
  'The Russian command presents the strikes as a response to Kyiv\'s attacks and as strikes on defence-industrial targets; Ukrainian and independent sources speak of deliberate destruction of civilian energy in major cities.',
  'Gerasimov reported to Putin that the army had "begun massive strikes on Ukraine\'s energy facilities" and that a list of targets had been drawn up; he said strikes on ports had halted Ukraine\'s main Black Sea ports, that bridges of strategic importance were being hit and that Ukraine\'s capacity to produce long-range weapons had been reduced. Putin ordered massive and group strikes on defence-industry sites and logistics centres to continue, calling them a response to Kyiv\'s actions, and said that a security zone in border areas would not be a subject of negotiations.',
  'Ukrainian media write that Russia has "forgotten" the "energy ceasefire" announced by Trump and stress that energy facilities are civilian infrastructure; Suspilne recalls that Kyiv lifted restrictions on refinery strikes after the strikes on Kyiv and Kharkiv energy on 14 October.',
  'The Guardian and Meduza, citing the NYT, describe a Russian winter strike plan, intercepted according to Ukrainian intelligence, aimed at leaving Kyiv, Kharkiv and Odesa without power, heat and water and forcing Ukraine to capitulate.'])

json.dump(cards, open('/workspace/compare-site-v2/tools/days/out/c16a.json','w'), ensure_ascii=False, indent=1)
print(len(cards))
