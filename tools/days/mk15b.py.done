cards = []
card = lambda *a: cards.append(C(*a))
NB = '\u00a0'

card('1015-kyiv-day-evening-strikes', [4864, 4868, 4875, 4861, 8108, 8125, 8147, 8841, 8844, 7216, 8135, 8820, 8832, 8145, 8842, 8148, 8838, 8603, 8619],
 'Дневные и вечерние удары: дрон упал в Печерском районе Киева, 7 раненых; вечером часть Киева, Луцка и области без света и воды', 'Киев, Луцк, Хмельницкая область, Запорожье', 'kyiv',
 ['одна из групп не освещает'],
 S('РИА Новости со ссылкой на украинские СМИ и Минэнерго сообщает о взрывах в Киеве, отключении электричества в части Киева и области, падении давления воды в четырех районах правобережья, а также о масштабных отключениях света и перебоях с водой в Луцке.',
   (4868, 'Часть Киева и Киевской области осталась без электроснабжения, сообщило министерство энергетики Украины.')),
 S('Днем дрон упал между жилыми домами в Печерском районе Киева: по данным Виталия Кличко, пострадали 7 человек, трое госпитализированы. Воздушные силы сообщили, что с 7:30 до 18:00 Россия запустила 138 ударных дронов (90 реактивных), 125 сбиты или подавлены. Вечером, по данным Минэнерго, после атаки на объект критической энергоинфраструктуры часть потребителей Киева и области осталась без света; в Луцке обломки повредили ЛЭП, на Хмельнитчине горела нефтебаза в Шепетовском районе, в Запорожье — частное предприятие.',
   (8125, 'Уже 7 постраждалих, внаслідок падіння ворожого БпЛА між житловими будинками в Печерському районі'),
   (8135, 'протиповітряною обороною збито/подавлено 125 БпЛА (79 із них – реактивні)')),
 S('Kyiv Independent сообщает о дроне, упавшем у пятиэтажного дома в Печерском районе, и о вечерних отключениях в Киеве после ударов по энергетике.',
   (8619, 'Widespread power outages have occurred in certain areas of Kyiv and the surrounding region')),
 'Российские источники пересказывают украинские сообщения без указания целей; Минобороны РФ эти удары отдельно не комментирует.',
 'low', '', False,
 ['Денні та вечірні удари: дрон упав у Печерському районі Києва, 7 поранених; увечері частина Києва, Луцька та області без світла і води', 'Київ, Луцьк, Хмельниччина, Запоріжжя',
  'Російські джерела переказують українські повідомлення без зазначення цілей; Міноборони РФ ці удари окремо не коментує.',
  'РИА Новости з посиланням на українські ЗМІ і Міненерго повідомляє про вибухи в Києві, відключення електрики в частині Києва та області, падіння тиску води в чотирьох районах правобережжя, а також про масштабні відключення світла і перебої з водою в Луцьку.',
  'Вдень дрон упав між житловими будинками в Печерському районі Києва: за даними Віталія Кличка, постраждали 7 людей, троє госпіталізовані. Повітряні сили повідомили, що з 7:30 до 18:00 Росія запустила 138 ударних дронів (90 реактивних), 125 збито або подавлено. Увечері, за даними Міненерго, після атаки на об’єкт критичної енергоінфраструктури частина споживачів Києва та області залишилася без світла; у Луцьку уламки пошкодили ЛЕП, на Хмельниччині горіла нафтобаза в Шепетівському районі, у Запоріжжі — приватне підприємство.',
  'Kyiv Independent повідомляє про дрон, що впав біля п’ятиповерхівки в Печерському районі, і про вечірні відключення в Києві після ударів по енергетиці.'],
 ['Daytime and evening strikes: drone falls in Kyiv\'s Pechersk district, 7 injured; in the evening parts of Kyiv, Lutsk and the region lose power and water', 'Kyiv, Lutsk, Khmelnytskyi region, Zaporizhzhia',
  'Russian sources relay Ukrainian reports without naming targets; the Russian Defence Ministry does not comment on these strikes separately.',
  'RIA Novosti, citing Ukrainian media and the Energy Ministry, reports explosions in Kyiv, power cuts in parts of Kyiv and the region, a drop in water pressure in four right-bank districts, and large-scale power and water outages in Lutsk.',
  'During the day a drone fell between apartment blocks in Kyiv\'s Pechersk district: according to Vitali Klitschko, 7 people were hurt and three hospitalised. The Air Force said that from 7:30 to 18:00 Russia launched 138 attack drones (90 jet-powered), of which 125 were downed or suppressed. In the evening, according to the Energy Ministry, an attack on a critical energy facility left some consumers in Kyiv and the region without power; in Lutsk debris damaged power lines, an oil depot burned in Shepetivka district of Khmelnytskyi region, and a private enterprise in Zaporizhzhia.',
  'Kyiv Independent reports the drone that fell near a five-storey building in Pechersk and the evening outages in Kyiv after strikes on energy.'])

card('1015-su34-borisoglebsk-neptune', [7188, 8123, 8836, 7179, 8602],
 'ВМС Украины: ракетами «Нептун» поражены шесть Су-34 на аэродроме Борисоглебск', 'Борисоглебск, Воронежская область', 'russia-other',
 ['одна из групп не освещает', 'расхождение: числа'],
 None,
 S('ВМС Украины сообщили, что ночью ракетами «Нептун» ударили по аэродрому «Борисоглебск» и уничтожили шесть бомбардировщиков Су-34М, зафиксированы детонации и пожар. Зеленский уточнил, что уничтожены четыре самолета и два поражены, назвав их готовыми к новым ударам по Украине; спикер ВМС Дмитрий Плетенчук назвал это полугодом работы российского ВПК.',
   (8123, 'Знищені чотири літаки Су-34, два літаки Су-34 уражені.'),
   (7188, 'Унаслідок удару знищено шість бомбардувальників Су-34М')),
 S('Kyiv Independent пересказывает данные Зеленского: из шести пораженных Су-34М четыре уничтожены, два повреждены.',
   (8602, 'An overnight attack on the Borisoglebsk military airfield in Russia\'s Voronezh region hit six Su-34M bomber jets, destroying four and damaging two')),
 'ВМС говорят о шести уничтоженных самолетах, Зеленский — о четырех уничтоженных и двух поврежденных. Российские источники в выборке удар не комментируют; независимого подтверждения нет.',
 'medium', 'Данные о потерях расходятся и не подтверждены независимо.', True,
 ['ВМС України: ракетами «Нептун» уражено шість Су-34 на аеродромі Борисоглєбськ', 'Борисоглєбськ, Воронезька область',
  'ВМС говорять про шість знищених літаків, Зеленський — про чотири знищені і два пошкоджені. Російські джерела у вибірці удар не коментують; незалежного підтвердження немає.',
  None,
  'ВМС України повідомили, що вночі ракетами «Нептун» ударили по аеродрому «Борисоглєбськ» і знищили шість бомбардувальників Су-34М, зафіксовано детонації і пожежу. Зеленський уточнив, що знищено чотири літаки і два уражено, назвавши їх готовими до нових ударів по Україні; речник ВМС Дмитро Плетенчук назвав це пів року роботи російського ВПК.',
  'Kyiv Independent переказує дані Зеленського: із шести уражених Су-34М чотири знищено, два пошкоджено.'],
 ['Ukraine\'s Navy: six Su-34s hit with Neptune missiles at Borisoglebsk airfield', 'Borisoglebsk, Voronezh region',
  'The Navy speaks of six aircraft destroyed, Zelensky of four destroyed and two damaged. Russian sources in the sample do not comment; there is no independent confirmation.',
  None,
  'Ukraine\'s Navy said it struck Borisoglebsk airfield overnight with Neptune missiles and destroyed six Su-34M bombers, with detonations and a fire recorded. Zelensky specified that four aircraft were destroyed and two hit, calling them ready for new strikes on Ukraine; Navy spokesman Dmytro Pletenchuk called it half a year of Russian defence industry output.',
  'Kyiv Independent relays Zelensky\'s figures: of the six Su-34Ms hit, four were destroyed and two damaged.'])

card('1015-starshield-restored', [4867, 6018, 10795, 6011, 7192, 8115, 8112, 7204, 8104, 9427, 8598, 8616, 9620, 9429],
 'Минобороны Украины: работа Starshield восстановлена; сенатор Тиллис инициирует расследование в отношении Пентагона; Маск: Зеленскому «пора уходить»', 'Украина, Вашингтон', 'ukraine-wide',
 ['расхождение: оценка ситуации'],
 S('РИА Новости со ссылкой на Newsweek пишет, что Starshield возобновил работу с ограничением 160 км/ч, а ТАСС со ссылкой на Daily Telegraph — что ограничения сделали непригодной значительную часть дронов ВСУ. Интерфакс и ТАСС цитируют Илона Маска, написавшего в X, что Зеленскому пора уходить.',
   (4867, 'она по-прежнему ограничена 160 километрами в час'),
   (10795, 'И вот бойня продолжается. (...) Зеленскому пора уходить')),
 S('Источники в Минобороны Украины сообщили, что работа Starshield в движении восстановилась и продолжает улучшаться, ведомство выясняет причины ограничений. Сенатор-республиканец Том Тиллис инициировал расследование в отношении главы Пентагона Пита Хегсета, предположив, что сбой произошел на уровне систем Starshield Минобороны США; группа поддержки Украины в Конгрессе назвала ограничения недопустимыми.',
   (8115, 'станом на зараз робота Starshield у русі відновилася і продовжується (покращуватись), фіксуємо це по звітах від підрозділів'),
   (7204, 'Я не сподіваюся, що міністр оборони Гегсет продемонструє прозорість')),
 S('Kyiv Independent отмечает, что спустя почти 48 часов ни Вашингтон, ни SpaceX не взяли на себя ответственность; DW сообщает, что ЕС предложил Украине подключение к спутниковой системе Govsatcom в начале 2027 года.',
   (8616, 'nobody in Washington, nor at SpaceX, has taken responsibility for the apparent decision to hobble Ukrainian military communications')),
 'Украинская сторона и американские законодатели ищут ответственных в Пентагоне; российские источники подчеркивают ущерб для ВСУ и тиражируют призыв Маска к уходу Зеленского. Кто принял решение об ограничении, официально не известно.',
 'low', '', False,
 ['Міноборони України: роботу Starshield відновлено; сенатор Тілліс ініціює розслідування щодо Пентагону; Маск: Зеленському «час іти»', 'Україна, Вашингтон',
  'Українська сторона й американські законодавці шукають відповідальних у Пентагоні; російські джерела наголошують на шкоді для ЗСУ і тиражують заклик Маска до відставки Зеленського. Хто ухвалив рішення про обмеження, офіційно не відомо.',
  'РИА Новости з посиланням на Newsweek пише, що Starshield відновив роботу з обмеженням 160 км/год, а ТАСС з посиланням на Daily Telegraph — що обмеження зробили непридатною значну частину дронів ЗСУ. Інтерфакс і ТАСС цитують Ілона Маска, який написав в X, що Зеленському час іти.',
  'Джерела в Міноборони України повідомили, що робота Starshield у русі відновилася і продовжує покращуватися, відомство з’ясовує причини обмежень. Сенатор-республіканець Том Тілліс ініціював розслідування щодо очільника Пентагону Піта Гегсета, припустивши, що збій стався на рівні систем Starshield Міноборони США; група підтримки України в Конгресі назвала обмеження неприпустимими.',
  'Kyiv Independent зазначає, що через майже 48 годин ні Вашингтон, ні SpaceX не взяли на себе відповідальність; DW повідомляє, що ЄС запропонував Україні підключення до супутникової системи Govsatcom на початку 2027 року.'],
 ['Ukraine\'s Defence Ministry says Starshield service restored; Senator Tillis launches a probe into the Pentagon; Musk says it is "time for Zelensky to go"', 'Ukraine, Washington',
  'The Ukrainian side and US lawmakers look for those responsible in the Pentagon; Russian sources stress the damage to Ukraine\'s forces and amplify Musk\'s call for Zelensky to go. Who decided on the restriction is not officially known.',
  'RIA Novosti, citing Newsweek, writes that Starshield resumed with a 160 km/h limit, and TASS, citing the Daily Telegraph, that the restrictions rendered a large part of Ukraine\'s drones unusable. Interfax and TASS quote Elon Musk writing on X that it is time for Zelensky to go.',
  'Sources in Ukraine\'s Defence Ministry said Starshield on the move has been restored and keeps improving, and the ministry is looking into the causes. Republican Senator Thom Tillis launched an investigation into Pentagon chief Pete Hegseth, suggesting the failure occurred at the level of the US Defense Department\'s Starshield systems; the Congressional Ukraine Caucus called the restrictions unacceptable.',
  'Kyiv Independent notes that after nearly 48 hours neither Washington nor SpaceX has taken responsibility; DW reports that the EU offered Ukraine a connection to the Govsatcom satellite system in early 2027.'])

card('1015-us-intel-patriot-shortage', [10811, 10849, 6084, 8092, 8819, 8142, 7211, 9618],
 'Washington Post: разведка США пригрозила прекратить обмен данными при новых ударах по НПЗ; CNN: у Украины закончились ракеты для Patriot', 'Киев, Вашингтон', 'ukraine-wide',
 ['расхождение: оценка ситуации'],
 S('Интерфакс со ссылкой на CBS News пишет, что США могли намеренно не предупредить Киев о российских ударах на этой неделе, а официально ссылались на проблемы с системой обнаружения из-за погоды; по данным CNN, Украина израсходовала все ракеты для Patriot. ТАСС со ссылкой на The Economist отмечает, что по программе PURL Украина получает 95% ракет-перехватчиков для Patriot.',
   (10811, 'США могли целенаправленно воздержаться от того, что заблаговременно оповестить Украину о российских ударах'),
   (6084, 'Ukraine receives 95% of the interceptor missiles for the Patriot air defense systems')),
 S('Украинская правда со ссылкой на Washington Post сообщает, что американская разведка предупредила посольство Украины о немедленном прекращении обмена данными в случае новых ударов по российской энергетике. РБК-Украина и УП пересказывают данные CNN: почти все баллистические ракеты последнего удара не были перехвачены из-за нехватки перехватчиков. Глава МИД Франции Жан-Ноэль Барро заявил, что Европа предоставляет Украине две трети разведданных.',
   (8092, 'Попередження були настільки масовими, що телефонували всім, чиє прізвище звучить по-українськи'),
   (8142, 'майже всі балістичні ракети під час останнього удару не були перехоплені через брак ракет-перехоплювачів')),
 S('Al Jazeera пишет, что украинцы опасаются сокращения американской разведки: сирены на этой неделе звучали лишь за секунды до ударов, которые убили не менее 15 человек.',
   (9618, 'The air raid sirens began howling just seconds before or after yet another wave of missiles struck')),
 'Источники сходятся в фактах, но опираются на анонимные данные американских СМИ; официального подтверждения от правительства США нет. Россия подчеркивает зависимость Украины от США, Украина и Франция — роль европейской разведки.',
 'medium', 'Данные основаны на анонимных источниках СМИ.', False,
 ['Washington Post: розвідка США пригрозила припинити обмін даними в разі нових ударів по НПЗ; CNN: в України закінчилися ракети для Patriot', 'Київ, Вашингтон',
  'Джерела збігаються у фактах, але спираються на анонімні дані американських ЗМІ; офіційного підтвердження від уряду США немає. Росія наголошує на залежності України від США, Україна і Франція — на ролі європейської розвідки.',
  'Інтерфакс із посиланням на CBS News пише, що США могли навмисно не попередити Київ про російські удари цього тижня, а офіційно посилалися на проблеми із системою виявлення через погоду; за даними CNN, Україна витратила всі ракети для Patriot. ТАСС із посиланням на The Economist зазначає, що за програмою PURL Україна отримує 95% ракет-перехоплювачів для Patriot.',
  'Українська правда з посиланням на Washington Post повідомляє, що американська розвідка попередила посольство України про негайне припинення обміну даними в разі нових ударів по російській енергетиці. РБК-Україна та УП переказують дані CNN: майже всі балістичні ракети останнього удару не були перехоплені через брак перехоплювачів. Очільник МЗС Франції Жан-Ноель Барро заявив, що Європа надає Україні дві третини розвідданих.',
  'Al Jazeera пише, що українці побоюються скорочення американської розвідки: сирени цього тижня лунали лише за секунди до ударів, які вбили щонайменше 15 людей.'],
 ['Washington Post: US intelligence threatened to halt data sharing if refinery strikes continue; CNN: Ukraine has run out of Patriot missiles', 'Kyiv, Washington',
  'Sources agree on facts but rely on anonymous US media reports; there is no official confirmation from the US government. Russia stresses Ukraine\'s dependence on the US, Ukraine and France the role of European intelligence.',
  'Interfax, citing CBS News, writes that the US may have deliberately not warned Kyiv of Russian strikes this week, while officially citing weather problems with the detection system; according to CNN, Ukraine has used up all its Patriot missiles. TASS, citing The Economist, notes that under PURL Ukraine receives 95% of its Patriot interceptors.',
  'Ukrainska Pravda, citing the Washington Post, reports that US intelligence warned Ukraine\'s embassy that data sharing would stop immediately if strikes on Russian energy resumed. RBC-Ukraine and UP relay CNN: almost all ballistic missiles in the last strike were not intercepted because of a lack of interceptors. French Foreign Minister Jean-Noël Barrot said Europe provides Ukraine with two thirds of its intelligence.',
  'Al Jazeera writes that Ukrainians fear US intelligence cuts: this week sirens sounded only seconds before strikes that killed at least 15 people.'])

card('1015-storm-shadow-uk-boats', [10855, 4855, 6082, 6089, 4862, 8824, 8134, 8618],
 'Bloomberg: Британия передаст Украине новую партию Storm Shadow; Times — Украина применяла британские безэкипажные катера K3 Scout', 'Лондон', 'ukraine-wide',
 ['атрибуция'],
 S('Интерфакс, РИА Новости и ТАСС со ссылкой на Bloomberg пишут, что Бёрнем и Зеленский обсудили пополнение запасов Storm Shadow и поставка планируется до зимы; Даунинг-стрит от комментариев отказалась. РИА и ТАСС со ссылкой на The Times сообщают, что Украина использовала британские катера K3 Scout компании Kraken Technology, в том числе для ударов по Сочи; по данным газеты, Британия закупила 20 таких катеров.',
   (4855, 'Вопрос о пополнении запасов крылатых ракет британского производства обсуждался премьер-министром Энди Бернемом и Владимиром Зеленским'),
   (4862, 'Беспилотные катера британского производства использовались украинцами для нанесения ударов по Сочи')),
 S('Украинская правда и РБК-Украина со ссылкой на Bloomberg пишут, что Британия отправляет дополнительные ракеты, чтобы Украина могла сорвать российские операции против гражданской инфраструктуры до зимы.',
   (8134, 'Велика Британія надсилає Україні додаткові ракети великої дальності Storm Shadow')),
 S('Kyiv Independent уточняет, что официального объявления о поставке не было.',
   (8618, 'No official public announcement of this resupply has been made.')),
 'Факты совпадают; российские агентства дополнительно подчеркивают британское участие в ударах по российской территории. Официально поставка не подтверждена.',
 'low', '', False,
 ['Bloomberg: Британія передасть Україні нову партію Storm Shadow; Times — Україна застосовувала британські безекіпажні катери K3 Scout', 'Лондон',
  'Факти збігаються; російські агентства додатково наголошують на британській участі в ударах по російській території. Офіційно постачання не підтверджено.',
  'Інтерфакс, РИА Новости і ТАСС з посиланням на Bloomberg пишуть, що Бернем і Зеленський обговорили поповнення запасів Storm Shadow і постачання планується до зими; Даунінг-стріт від коментарів відмовилася. РИА і ТАСС з посиланням на The Times повідомляють, що Україна використовувала британські катери K3 Scout компанії Kraken Technology, зокрема для ударів по Сочі; за даними газети, Британія закупила 20 таких катерів.',
  'Українська правда і РБК-Україна з посиланням на Bloomberg пишуть, що Британія відправляє додаткові ракети, щоб Україна могла зірвати російські операції проти цивільної інфраструктури до зими.',
  'Kyiv Independent уточнює, що офіційного оголошення про постачання не було.'],
 ['Bloomberg: UK to send Ukraine a new batch of Storm Shadows; The Times says Ukraine used British K3 Scout uncrewed boats', 'London',
  'The facts agree; Russian agencies additionally stress British involvement in strikes on Russian territory. The delivery has not been officially confirmed.',
  'Interfax, RIA Novosti and TASS, citing Bloomberg, write that Burnham and Zelensky discussed replenishing Storm Shadow stocks, with delivery planned before winter; Downing Street declined to comment. RIA and TASS, citing The Times, report that Ukraine used British K3 Scout boats made by Kraken Technology, including in strikes on Sochi; according to the paper, Britain bought 20 such boats.',
  'Ukrainska Pravda and RBC-Ukraine, citing Bloomberg, write that Britain is sending additional missiles so Ukraine can disrupt Russian operations against civilian infrastructure before winter.',
  'Kyiv Independent notes there has been no official announcement of the delivery.'])

card('1015-front-claims', [6598, 10835, 6043, 4837, 4835, 4836, 4856, 7183, 8146, 7200, 8807, 8128, 8596, 8609],
 'Фронт: Минобороны РФ — Нефедовка и Черное на Харьковщине, 31 здание в Доброполье; Генштаб ВСУ — 260 боев, удары по «Рубикону»', 'Харьковская, Донецкая, Запорожская, Херсонская области', 'donetsk',
 ['расхождение: оценка ситуации', 'не проверено независимо'],
 S('Минобороны РФ заявило, что группировка «Север» «в кольце окружения» взяла Нефедовку и Черное в Харьковской области, а в Доброполье за сутки «освобождено» 31 здание; ВСУ, по данным ведомства, потеряли до 220 военных в зоне «Запада» и свыше 190 — «Востока». РИА Новости со ссылкой на силовые структуры сообщает о смене командующего 10-м армейским корпусом ВСУ после «скандалов в бригадах».',
   (10835, 'установлен контроль над населенными пунктами Нефедовка и Черное Харьковской области'),
   (4837, 'В течение суток освобождено 31 здание, уничтожено до 15-ти украинских военнослужащих')),
 S('Генштаб ВСУ сообщил о 260 боях за 14 октября, 85 авиаударах и 278 КАБ, а к 22:00 15 октября — о 244 боях; по его данным, потери России с начала 2026 года превысили 350 тысяч человек, максимум — в сентябре, 46' + NB + '230. Силы обороны поразили скопление личного состава подразделения «Рубикон» у Новоконстантиновки в Запорожской области и место запуска дронов у Донецка.',
   (7183, 'Російські військові завдали одного ракетного удару та 85 авіаційних ударів, під час яких скинули 278 керованих авіабомб.'),
   (8128, 'уразили місце зосередження особового складу підрозділу БпЛА "Рубікон" в районі Новокостянтинівки Запорізької області')),
 S('Kyiv Independent со ссылкой на ГУР сообщает, что подразделение «Шаманбат» и 426-й полк беспилотных систем уничтожили центр подготовки операторов дронов 18-й армии РФ в Хорлах Херсонской области.',
   (8609, 'Ukrainian units destroyed a Russian training center for drone operators in Khorly, in occupied Kherson Oblast')),
 'Российская сторона сообщает о взятии населенных пунктов и «окружении» на Харьковщине, украинская — о числе боев, потерях противника и ударах по его дроновым подразделениям. Российские заявления о новых селах украинская сторона не подтверждает; данные обеих сторон независимо не проверены.',
 'medium', 'Фронтовые заявления сторон независимо не проверены.', True,
 ['Фронт: Міноборони РФ — Нефедівка і Чорне на Харківщині, 31 будівля в Добропіллі; Генштаб ЗСУ — 260 боїв, удари по «Рубікону»', 'Харківська, Донецька, Запорізька, Херсонська області',
  'Російська сторона повідомляє про захоплення населених пунктів і «оточення» на Харківщині, українська — про кількість боїв, втрати противника та удари по його дронових підрозділах. Російські заяви про нові села українська сторона не підтверджує; дані обох сторін незалежно не перевірені.',
  'Міноборони РФ заявило, що угруповання «Північ» «у кільці оточення» захопило Нефедівку і Чорне на Харківщині, а в Добропіллі за добу «звільнено» 31 будівлю; ЗСУ, за даними відомства, втратили до 220 військових у зоні «Заходу» і понад 190 — «Сходу». РИА Новости з посиланням на силові структури повідомляє про зміну командувача 10-го армійського корпусу ЗСУ після «скандалів у бригадах».',
  'Генштаб ЗСУ повідомив про 260 боїв за 14 жовтня, 85 авіаударів і 278 КАБ, а до 22:00 15 жовтня — про 244 бої; за його даними, втрати Росії з початку 2026 року перевищили 350 тисяч осіб, максимум — у вересні, 46' + NB + '230. Сили оборони уразили скупчення особового складу підрозділу «Рубікон» біля Новокостянтинівки на Запоріжжі та місце запуску дронів біля Донецька.',
  'Kyiv Independent з посиланням на ГУР повідомляє, що підрозділ «Шаманбат» і 426-й полк безпілотних систем знищили центр підготовки операторів дронів 18-ї армії РФ у Хорлах на Херсонщині.'],
 ['Front: Russia claims Nefedivka and Chorne in Kharkiv region and 31 buildings in Dobropillia; Ukraine\'s General Staff reports 260 clashes and strikes on Rubikon', 'Kharkiv, Donetsk, Zaporizhzhia, Kherson regions',
  'The Russian side reports capturing villages and an "encirclement" in Kharkiv region; the Ukrainian side reports numbers of clashes, enemy losses and strikes on its drone units. Ukraine does not confirm the Russian claims of new villages; neither side\'s data is independently verified.',
  'The Russian Defence Ministry said its North group took Nefedivka and Chorne in Kharkiv region "in the encirclement", and that 31 buildings in Dobropillia were "liberated" in a day; it said Ukraine lost up to 220 troops in the West group\'s zone and over 190 in the East\'s. RIA Novosti, citing security sources, reports the replacement of the commander of Ukraine\'s 10th Army Corps after "scandals in the brigades".',
  'The General Staff reported 260 clashes on 14 October, 85 air strikes and 278 guided bombs, and by 22:00 on 15 October 244 clashes; it said Russian losses since the start of 2026 exceeded 350 thousand, peaking in September at 46' + NB + '230. Ukrainian forces hit a concentration of Rubikon unit personnel near Novokostiantynivka in Zaporizhzhia region and a drone launch site near Donetsk.',
  'Kyiv Independent, citing military intelligence (HUR), reports that the Shamanbat unit and the 426th Unmanned Systems Regiment destroyed a drone operator training centre of Russia\'s 18th Army in Khorly, Kherson region.'])

card('1015-kharkiv-shooting-suspect-charged', [8137, 8827, 8617],
 'СБУ предъявила подозрение российскому военному Леониду Рыжикову в расстреле пятерых безоружных военных ВСУ и гражданского', 'Харьковская область', 'kharkiv',
 ['одна из групп не освещает'],
 None,
 S('СБУ и Харьковская областная прокуратура сообщили о подозрении 36-летнему жителю Санкт-Петербурга Леониду Рыжикову («Юла»), служившему во 2-м батальоне 1009-го мотострелкового полка: по версии следствия, 13 октября он расстрелял пятерых безоружных украинских военных и одного гражданского; по данным СБУ, в конце июля его мобилизовали в российскую армию.',
   (8137, 'Йдеться про 36-річного громадянина РФ, мешканця Санкт Петербурга Леоніда Рижикова.')),
 S('Kyiv Independent пишет, что подозреваемому предъявлены обвинения в военных преступлениях и ему грозит пожизненное заключение.',
   (8617, 'has been charged with war crimes, Ukraine\'s Security Service (SBU) reported on Oct. 15')),
 'Украинская версия о российском военном противоречит заявлению РИА Новости от 14 октября о том, что стрелком был украинский мобилизованный; российские источники 15 октября дело не комментировали.',
 'low', '', True,
 ['СБУ повідомила про підозру російському військовому Леоніду Рижикову в розстрілі п’ятьох беззбройних військових ЗСУ і цивільного', 'Харківська область',
  'Українська версія про російського військового суперечить заяві РИА Новости від 14 жовтня про те, що стрільцем був український мобілізований; російські джерела 15 жовтня справу не коментували.',
  None,
  'СБУ і Харківська обласна прокуратура повідомили про підозру 36-річному мешканцю Санкт-Петербурга Леоніду Рижикову («Юла»), який служив у 2-му батальйоні 1009-го мотострілецького полку: за версією слідства, 13 жовтня він розстріляв п’ятьох беззбройних українських військових і одного цивільного; за даними СБУ, наприкінці липня його мобілізували до російської армії.',
  'Kyiv Independent пише, що підозрюваному висунуто звинувачення у воєнних злочинах і йому загрожує довічне ув’язнення.'],
 ['SBU charges Russian soldier Leonid Ryzhikov with shooting five unarmed Ukrainian soldiers and a civilian', 'Kharkiv region',
  'The Ukrainian version naming a Russian soldier contradicts RIA Novosti\'s claim on 14 October that the gunman was a mobilised Ukrainian; Russian sources did not comment on the case on 15 October.',
  None,
  'The SBU and the Kharkiv regional prosecutor\'s office charged 36-year-old St Petersburg resident Leonid Ryzhikov ("Yula"), who served in the 2nd Battalion of the 1009th Motor Rifle Regiment: investigators say that on 13 October he shot five unarmed Ukrainian soldiers and one civilian; according to the SBU, he was mobilised into the Russian army at the end of July.',
  'Kyiv Independent writes that the suspect has been charged with war crimes and faces life imprisonment.'])
