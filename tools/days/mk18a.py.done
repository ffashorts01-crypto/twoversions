import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1018-st-petersburg-drone-attack',
 [11076, 11078, 11082, 11083, 11084, 11085, 11088, 11089, 11091, 11094, 11098, 11101, 11103, 9085, 9087,
  5016, 5022, 5024, 5028, 5031, 5102, 5103, 5107, 5115, 5116, 5117, 5125, 5128, 5131, 5139,
  6243, 6246, 6247, 6249, 6250, 6258, 6263, 6264, 6268, 6304, 6331, 6333, 6335, 6339,
  9032, 9033, 9050, 9068, 7385, 8275, 8283,
  8797, 8357, 8789, 8672, 8723, 8720],
 'Крупнейшая атака дронов на Петербург и Ленобласть: горят нефтяной терминал и нефтебаза «Ручьи», поврежден дата-центр VK, один погибший', 'Санкт-Петербург, Ленинградская область', 'russia-other',
 ['расхождение: характер объектов', 'расхождение: числа пострадавших'],
 S('Губернатор Ленобласти Александр Дрозденко сообщил о 144 сбитых над регионом дронах; обломки упали на жилые дома, поврежден дата-центр VK и подстанция «Восточная». Губернатор Петербурга Александр Беглов заявил, что один человек погиб, пятеро госпитализированы, повреждены 12 многоквартирных домов, горели нефтяной терминал и «объекты гражданской инфраструктуры»; аэропорт Пулково временно ограничивал работу. СК возбудил дело о теракте, Ozon сообщил о пожаре на своем логистическом центре.',
   (11098, 'один человек погиб, пять пострадали и находятся в больницах'),
   (11094, 'нанесли удары беспилотниками по объектам гражданской инфраструктуры'),
   (9085, 'Массовая атака БПЛА в Ленинградской области не нарушила работу социальных объектов, инфраструктуры, объектов энергетики и жизнеобеспечения.')),
 S('Украинские СМИ со ссылкой на российских губернаторов и Telegram-каналы пишут о пожаре на Петербургском нефтяном терминале, ударе по вантовому мосту Западного скоростного диаметра и перебоях со светом. Компания Fire Point заявила, что ее дроны атаковали нефтебазу «Ручьи», нефтяной терминал и серьезно повредили дата-центр «ВКонтакте».',
   (9068, 'Серед уражених цілей - нафтобаза "Ручьи" та Петербурзький нафтовий термінал.'),
   (9050, 'дрон влучив у вантовий міст через Корабельний фарватер у Санкт-Петербурзі')),
 S('BBC и Al Jazeera пишут, что удар успешно поразил два нефтяных объекта города, склад Ozon и дата-центр VK; Киев официально не комментировал. Meduza называет атаку, по всей видимости, самой масштабной для региона с начала войны и насчитывает одного погибшего и 15 пострадавших в городе и области.',
   (8357, 'At least one person has been killed in an overnight attack on St Petersburg that successfully targeted two of the city\'s oil facilities.'),
   (8723, 'По всей видимости, эта атака стала самой масштабной для региона с начала войны.')),
 'Российские власти говорят об ударах по «гражданской инфраструктуре» и «теракте», а Ленобласть уверяет, что работа энергетики не нарушена; украинский производитель дронов и независимые СМИ указывают на целенаправленные удары по нефтяным объектам и дата-центру. Число пострадавших: пятеро в Петербурге по Беглову, 15 в городе и области по подсчету Meduza.',
 'low', '', True,
 ['Наймасштабніша атака дронів на Петербург і Ленобласть: горять нафтовий термінал і нафтобаза «Ручьи», пошкоджено дата-центр VK, один загиблий', 'Санкт-Петербург, Ленінградська область',
  'Російська влада говорить про удари по «цивільній інфраструктурі» і «теракт», а Ленобласть запевняє, що роботу енергетики не порушено; український виробник дронів і незалежні ЗМІ вказують на цілеспрямовані удари по нафтових об’єктах і дата-центру. Кількість постраждалих: п’ятеро в Петербурзі за Бегловим, 15 у місті й області за підрахунком Meduza.',
  'Губернатор Ленобласті Олександр Дрозденко повідомив про 144 збиті над регіоном дрони; уламки впали на житлові будинки, пошкоджено дата-центр VK і підстанцію «Восточная». Губернатор Петербурга Олександр Беглов заявив, що одна людина загинула, п’ятеро госпіталізовані, пошкоджено 12 багатоквартирних будинків, горіли нафтовий термінал і «об’єкти цивільної інфраструктури»; аеропорт Пулково тимчасово обмежував роботу. СК порушив справу про теракт, Ozon повідомив про пожежу на своєму логістичному центрі.',
  'Українські ЗМІ з посиланням на російських губернаторів і Telegram-канали пишуть про пожежу на Петербурзькому нафтовому терміналі, удар по вантовому мосту Західного швидкісного діаметра та перебої зі світлом. Компанія Fire Point заявила, що її дрони атакували нафтобазу «Ручьи», нафтовий термінал і серйозно пошкодили дата-центр «ВКонтакте».',
  'BBC і Al Jazeera пишуть, що удар успішно вразив два нафтові об’єкти міста, склад Ozon і дата-центр VK; Київ офіційно не коментував. Meduza називає атаку, ймовірно, наймасштабнішою для регіону від початку війни і налічує одного загиблого та 15 постраждалих у місті й області.'],
 ['Largest drone attack on St Petersburg and Leningrad region: oil terminal and Ruchyi depot ablaze, VK data centre damaged, one dead', 'St Petersburg, Leningrad region',
  'Russian authorities speak of strikes on "civilian infrastructure" and a "terrorist act", and Leningrad region insists energy facilities were not disrupted; a Ukrainian drone maker and independent media point to targeted strikes on oil facilities and a data centre. Casualties: five in St Petersburg per Beglov, 15 in the city and region per Meduza\'s count.',
  'Leningrad region governor Alexander Drozdenko reported 144 drones downed over the region; debris fell on residential buildings, and a VK data centre and the Vostochnaya substation were damaged. St Petersburg governor Alexander Beglov said one person was killed and five hospitalised, 12 apartment blocks were damaged, and the oil terminal and "civilian infrastructure facilities" were on fire; Pulkovo airport temporarily restricted operations. The Investigative Committee opened a terrorism case, and Ozon reported a fire at its logistics centre.',
  'Ukrainian media, citing Russian governors and Telegram channels, report a fire at the St Petersburg Oil Terminal, a strike on the cable-stayed bridge of the Western High-Speed Diameter and power cuts. The company Fire Point said its drones attacked the Ruchyi oil depot and the oil terminal and seriously damaged the VKontakte data centre.',
  'The BBC and Al Jazeera write that the strike successfully hit two of the city\'s oil facilities, an Ozon warehouse and a VK data centre; Kyiv has not officially commented. Meduza calls the attack apparently the largest on the region since the war began and counts one dead and 15 injured in the city and region.'])

card('1018-drones-moscow-mod-totals',
 [11071, 11074, 11081, 11100, 11087, 11093, 11095, 11097, 11102, 11104, 9073, 9078, 9072, 11108,
  5023, 5026, 5027, 5029, 5032, 5034, 5037, 5066, 6238, 6323, 6288, 6673, 8271, 8786],
 'Минобороны РФ: за ночь сбиты 1015 украинских дронов, за сутки — 1256 и семь ракет «Фламинго»; на Москву летели 512 БПЛА', 'Москва, регионы России', 'russia-other',
 ['одна из групп не освещает', 'не проверено'],
 S('Минобороны РФ заявило, что за ночь над 16 регионами и акваторией Черного моря уничтожены 1015 беспилотников, а за сутки — 1256 дронов и семь крылатых ракет «Фламинго»; РИА называет ночной показатель почти рекордным. Сергей Собянин сообщил, что за сутки в сторону Московского региона летели 512 БПЛА, 127 из них нейтрализованы на подлете. Из-за ограничений в аэропортах рейсы уходили на запасные аэродромы, включая Хельсинки и Минск.',
   (9078, 'Средствами противовоздушной обороны сбиты семь (7) крылатых ракет большой дальности "Фламинго" и 1256 беспилотных летательных аппаратов самолетного типа'),
   (5029, 'В период с 08.30 17 октября до 08.30 18 октября в сторону Московского региона летело 512 БПЛА.')),
 S('«Украинская правда» пересказывает сообщения Собянина о «якобы сбитых» дронах, летевших на Москву вторую ночь подряд, не приводя собственных оценок.',
   (8271, 'Другу ніч поспіль влада Москви заявляє про атаку дронів на столицю Росії.')),
 S('DW со ссылкой на Собянина сообщает о сбоях в работе всех четырех московских аэропортов.',
   (8786, 'Из-за утренних налетов БПЛА в работе всех четырех московских аэропортов возникли сбои.')),
 'Все цифры сбитых дронов и ракет исходят от Минобороны РФ и российских властей; украинская сторона в выборке их не подтверждает и не опровергает.',
 'medium', 'Данные о сбитых дронах и ракетах — только от российской стороны.', False,
 ['Міноборони РФ: за ніч збито 1015 українських дронів, за добу — 1256 і сім ракет «Фламінго»; на Москву летіли 512 БпЛА', 'Москва, регіони Росії',
  'Усі цифри збитих дронів і ракет надходять від Міноборони РФ і російської влади; українська сторона у вибірці їх не підтверджує і не спростовує.',
  'Міноборони РФ заявило, що за ніч над 16 регіонами та акваторією Чорного моря знищено 1015 безпілотників, а за добу — 1256 дронів і сім крилатих ракет «Фламінго»; РИА називає нічний показник майже рекордним. Сергій Собянін повідомив, що за добу в бік Московського регіону летіли 512 БпЛА, 127 із них нейтралізовано на підльоті. Через обмеження в аеропортах рейси йшли на запасні аеродроми, зокрема Гельсінкі та Мінськ.',
  '«Українська правда» переказує повідомлення Собяніна про «нібито збиті» дрони, що летіли на Москву другу ніч поспіль, не наводячи власних оцінок.',
  'DW з посиланням на Собяніна повідомляє про збої в роботі всіх чотирьох московських аеропортів.'],
 ['Russian MoD: 1015 Ukrainian drones downed overnight, 1256 and seven Flamingo missiles in a day; 512 drones flew towards Moscow', 'Moscow, Russian regions',
  'All figures for downed drones and missiles come from the Russian MoD and Russian authorities; the Ukrainian side in the sample neither confirms nor denies them.',
  'The Russian MoD said 1015 drones were destroyed overnight over 16 regions and the Black Sea, and 1256 drones and seven Flamingo cruise missiles over the day; RIA calls the overnight figure near-record. Sergei Sobyanin said 512 drones flew towards the Moscow region over the day, 127 of them neutralised on approach. Airport restrictions sent flights to alternate airfields, including Helsinki and Minsk.',
  'Ukrainska Pravda relays Sobyanin\'s reports of "allegedly downed" drones flying at Moscow for a second night in a row, without giving its own estimates.',
  'DW, citing Sobyanin, reports disruptions at all four Moscow airports.'])

card('1018-strikes-west-ukraine-energy',
 [6674, 11092, 9079, 6325, 6292, 5025, 5036, 5046, 5042,
  8281, 7387, 8284, 7403, 7461, 8286, 7416, 7487, 8287, 7436, 7410, 9052, 9055, 7431, 8276, 9038, 7370, 7424, 7447, 9054, 9040, 7391, 7411],
 'Удар «Искандером» и 180 дронами: пожары в Ровно и на Волыни, удары по энергетике; Минобороны РФ — поражен центр «Новой почты»', 'Ровно, Волынская, Тернопольская, Львовская, Винницкая, Одесская области', 'ukraine-wide',
 ['расхождение: характер объекта', 'расхождение: цель удара'],
 S('Минобороны РФ заявило о групповых ударах дронами по логистическим центрам и портам Украины, в том числе по логистическому центру «Новой почты» в Ровно, где якобы хранились грузы двойного назначения и комплектующие для БПЛА. РИА со ссылкой на Олега Кипера сообщило, что около 24 тысяч потребителей Одесской области остались без света.',
   (11092, 'В результате поражен логистический центр "Новая Почта" в городе Ровно'),
   (5042, 'Около 24 тысяч потребителей остались без электроснабжения в Одесской области')),
 S('Воздушные силы сообщили об атаке одной баллистической ракетой «Искандер-М» и 180 дронами, 152 из них сбиты или подавлены. Глава Ровенской ОВА Александр Коваль заявил, что целями снова стали объекты гражданской инфраструктуры; на Волыни в Маневичах горело предприятие по производству замороженной продукции, на Тернопольщине поражены энергообъекты, на Винничине и Одесщине — критическая инфраструктура, во Львовской области поврежден склад логистического комплекса.',
   (8281, 'росіяни атакували Україну 1 балістичною ракетою "Іскандер-М" та 180 ударними БпЛА різних типів'),
   (8284, 'Знову серед цілей ворога об\'єкти цивільної інфраструктури.'),
   (7416, 'підприємство займається виготовленням замороженої продукції')),
 None,
 'Минобороны РФ называет пораженный объект в Ровно логистическим центром с военными грузами, украинские власти — объектом гражданской инфраструктуры; независимые источники в выборке этот удар не освещают.',
 'medium', 'Характер пораженного объекта в Ровно стороны описывают противоположно; независимой проверки нет.', True,
 ['Удар «Іскандером» і 180 дронами: пожежі в Рівному і на Волині, удари по енергетиці; Міноборони РФ — уражено центр «Нової пошти»', 'Рівне, Волинська, Тернопільська, Львівська, Вінницька, Одеська області',
  'Міноборони РФ називає уражений об’єкт у Рівному логістичним центром із військовими вантажами, українська влада — об’єктом цивільної інфраструктури; незалежні джерела у вибірці цей удар не висвітлюють.',
  'Міноборони РФ заявило про групові удари дронами по логістичних центрах і портах України, зокрема по логістичному центру «Нової пошти» в Рівному, де нібито зберігалися вантажі подвійного призначення та комплектуючі для БпЛА. РИА з посиланням на Олега Кіпера повідомило, що близько 24 тисяч споживачів Одеської області залишилися без світла.',
  'Повітряні сили повідомили про атаку однією балістичною ракетою «Іскандер-М» і 180 дронами, 152 з них збито або подавлено. Голова Рівненської ОВА Олександр Коваль заявив, що цілями знову стали об’єкти цивільної інфраструктури; на Волині в Маневичах горіло підприємство з виробництва замороженої продукції, на Тернопільщині уражено енергооб’єкти, на Вінниччині та Одещині — критичну інфраструктуру, на Львівщині пошкоджено склад логістичного комплексу.',
  None],
 ['Iskander and 180 drones: fires in Rivne and Volyn, energy hit; Russian MoD says a Nova Poshta hub was struck', 'Rivne, Volyn, Ternopil, Lviv, Vinnytsia, Odesa regions',
  'The Russian MoD calls the facility hit in Rivne a logistics centre with military cargo; Ukrainian authorities call it civilian infrastructure. Independent sources in the sample do not cover this strike.',
  'The Russian MoD reported group drone strikes on Ukrainian logistics centres and ports, including the Nova Poshta logistics centre in Rivne, where dual-use cargo and drone components were allegedly stored. RIA, citing Oleh Kiper, reported that about 24 thousand consumers in Odesa region were left without power.',
  'The Air Force reported an attack with one Iskander-M ballistic missile and 180 drones, 152 of which were downed or suppressed. Rivne regional governor Oleksandr Koval said civilian infrastructure was again among the targets; in Manevychi in Volyn region a frozen-food plant was on fire, energy facilities were hit in Ternopil region, critical infrastructure in Vinnytsia and Odesa regions, and a logistics warehouse was damaged in Lviv region.',
  None])

card('1018-civilian-casualties-ukraine',
 [5055, 6259, 5080, 6278, 8272, 9030, 7384, 8290, 7413, 7443, 9061, 7460, 8291, 7505, 7394, 7380, 8280, 7386, 7399, 7382, 7388, 7414, 7446, 7498, 7464, 7495, 7368, 7442, 7379, 7396, 8677, 8788],
 'Удары по городам Украины: погибшие в Запорожье, Полтаве и на Сумщине, ранен ребенок в Одессе, в Славянске число погибших после авиаудара выросло до шести', 'Запорожье, Полтава, Одесса, Славянск, Херсон, Сумская и Харьковская области', 'ukraine-wide',
 ['одна из групп не освещает'],
 S('РИА Новости и ТАСС со ссылкой на украинские телеканалы сообщают о взрывах в Одессе и Днепре на фоне воздушной тревоги, ТАСС — о повреждении объекта критической инфраструктуры в Днепре; о жертвах среди мирных жителей российские источники не пишут.',
   (5055, 'Взрыв прогремел в Одессе на юге Украины на фоне воздушной тревоги')),
 S('В Запорожье при ударе по жилому дому погибла 27-летняя женщина. В Славянске после авиаударов 17 октября погибли 6 человек, 15 ранены, под завалами остаются тела. В Полтаве погиб преподаватель педуниверситета Константин Чуб, в Одессе дрон попал в многоэтажку — пострадали двое, в том числе девочка-подросток. На Херсонщине за сутки ранены 32 человека, на Сумщине погибли двое мужчин, в Изюме пострадали трое.',
   (8272, 'внаслідок ворожої атаки загинула 27-річна жінка'),
   (8290, 'загинули шестеро людей, ще 15 людей були поранені, пошкоджено понад 20 будинків'),
   (9061, 'Вдень 18 жовтня російський дрон влучив у дах багатоповерхового житлового будинку в Одесі. Серед постраждалих - дитина.')),
 S('Kyiv Independent со ссылкой на региональные власти насчитывает за сутки не менее 10 погибших и 73 раненых мирных жителей; DW сообщает о погибших в Запорожье и Полтаве.',
   (8677, 'Russian attacks across Ukraine killed at least 10 civilians and injured 73 others over the past day')),
 'Российские источники фиксируют лишь взрывы со ссылкой на украинские СМИ и не сообщают о жертвах; украинские и независимые источники приводят совпадающие данные о погибших и раненых.',
 'low', '', False,
 ['Удари по містах України: загиблі в Запоріжжі, Полтаві та на Сумщині, поранено дитину в Одесі, у Слов’янську кількість загиблих після авіаудару зросла до шести', 'Запоріжжя, Полтава, Одеса, Слов’янськ, Херсон, Сумська та Харківська області',
  'Російські джерела фіксують лише вибухи з посиланням на українські ЗМІ і не повідомляють про жертви; українські та незалежні джерела наводять збіжні дані про загиблих і поранених.',
  'РИА Новости і ТАСС з посиланням на українські телеканали повідомляють про вибухи в Одесі та Дніпрі на тлі повітряної тривоги, ТАСС — про пошкодження об’єкта критичної інфраструктури в Дніпрі; про жертви серед цивільних російські джерела не пишуть.',
  'У Запоріжжі під час удару по житловому будинку загинула 27-річна жінка. У Слов’янську після авіаударів 17 жовтня загинули 6 людей, 15 поранені, під завалами залишаються тіла. У Полтаві загинув викладач педуніверситету Костянтин Чуб, в Одесі дрон влучив у багатоповерхівку — постраждали двоє, зокрема дівчинка-підліток. На Херсонщині за добу поранено 32 людей, на Сумщині загинули двоє чоловіків, в Ізюмі постраждали троє.',
  'Kyiv Independent з посиланням на регіональну владу налічує за добу щонайменше 10 загиблих і 73 поранених цивільних; DW повідомляє про загиблих у Запоріжжі та Полтаві.'],
 ['Strikes on Ukrainian cities: deaths in Zaporizhzhia, Poltava and Sumy region, child injured in Odesa, Sloviansk air-strike death toll rises to six', 'Zaporizhzhia, Poltava, Odesa, Sloviansk, Kherson, Sumy and Kharkiv regions',
  'Russian sources only note explosions, citing Ukrainian media, and do not report casualties; Ukrainian and independent sources give matching figures for the dead and wounded.',
  'RIA Novosti and TASS, citing Ukrainian TV channels, report explosions in Odesa and Dnipro amid air-raid alerts, and TASS reports damage to a critical infrastructure facility in Dnipro; Russian sources do not mention civilian casualties.',
  'In Zaporizhzhia a 27-year-old woman was killed when a residential building was hit. In Sloviansk 6 people were killed and 15 injured in air strikes on October 17, with bodies still under the rubble. In Poltava teacher-training university lecturer Kostiantyn Chub was killed; in Odesa a drone hit a high-rise, injuring two, including a teenage girl. In Kherson region 32 people were injured over the day, two men were killed in Sumy region and three people were hurt in Izium.',
  'Kyiv Independent, citing regional authorities, counts at least 10 civilians killed and 73 injured over the day; DW reports deaths in Zaporizhzhia and Poltava.'])

