cards.append(C('1007-eu-defence-funding', [8415, 6799, 7651],
 'Еврокомиссия перечислила Украине более миллиарда евро на оборонное производство', 'Брюссель — Киев', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Суспільне со ссылкой на пресс-релиз Еврокомиссии пишет, что средства выделены в рамках оборонного компонента кредита на поддержку Украины и пойдут на дроны, средства их перехвата, боеприпасы и ракеты украинского производства. Премьер-министр Сергей Корецкий, по данным Українська правда, подтвердил получение денег.',
   (6799, 'Ці кошти підуть на фінансування безпілотників, засобів їх перехоплення, боєприпасів, а також ракет, що виробляють українські підприємства.'),
   (7651, 'Україна отримала від ЄС 1,2 млрд євро, які спрямують на зміцнення оборонної промисловості країни')),
 S('Kyiv Independent пишет, что Еврокомиссия 7 октября объявила о выплате Украине оборонной помощи в рамках кредита ЕС и цитирует председателя Еврокомиссии: средства помогут укрепить оборонную промышленность Украины.',
   (8415, 'Today\'s disbursement will help strengthen Ukraine\'s defense industry.')),
 'Расхождений между источниками нет; российские источники в выборке выплату не освещают.',
 'low', '', False,
 ['Єврокомісія перерахувала Україні понад мільярд євро на оборонне виробництво', 'Брюссель — Київ',
  'Розбіжностей між джерелами немає; російські джерела у вибірці виплату не висвітлюють.',
  None,
  'Суспільне з посиланням на пресреліз Єврокомісії пише, що кошти виділено в межах оборонного компонента кредиту на підтримку України і їх спрямують на дрони, засоби їх перехоплення, боєприпаси та ракети українського виробництва. Прем’єр-міністр Сергій Корецький, за даними Української правди, підтвердив отримання коштів.',
  'Kyiv Independent пише, що Єврокомісія 7 жовтня оголосила про виплату Україні оборонної допомоги в межах кредиту ЄС, і цитує президентку Єврокомісії: кошти допоможуть зміцнити оборонну промисловість України.'],
 ['European Commission transfers more than a billion euros to Ukraine for defence production', 'Brussels — Kyiv',
  'There are no discrepancies between the sources; Russian sources in the sample do not cover the payment.',
  None,
  'Suspilne, citing a European Commission press release, writes that the money comes from the defence component of the EU support loan for Ukraine and will go to drones, interceptors, ammunition and missiles made in Ukraine. Prime Minister Serhii Koretskyi, according to Ukrainska Pravda, confirmed receipt of the funds.',
  'Kyiv Independent writes that on 7 October the European Commission announced the disbursement of defence support to Ukraine under the EU loan and quotes the Commission president as saying the money will help strengthen Ukraine\'s defence industry.']))

cards.append(C('1007-odesa-ships-ports', [6416, 6417, 4344, 4379, 6436],
 'Минобороны РФ заявило об ударах по сухогрузам и портам Одесской области', 'Порты Одесса, Южный и Черноморск', 'odesa',
 ['российская сторона заявляет, украинская не комментирует'],
 S('Минобороны РФ сообщило, что дроны «Герань-4 Сикер» поразили в порту Южный сухогруз, «который использовался для доставки военных грузов ВСУ», в порту Черноморск — хранилище горюче-смазочных материалов, а днем на переходе морем — еще один сухогруз, шедший в порт Одесса с грузами «для обеспечения ВСУ». РИА Новости также пишет о поражении сухогруза в порту Одессы. Названия судов и сведения о пострадавших не приводятся.',
   (6416, 'Расчеты «Герань-4 Сикер» ударили по сухогрузу, который использовался для доставки военных грузов ВСУ.'),
   (6417, 'поражено хранилище горюче-смазочных материалов в порту Черноморск в Одесской области'),
   (4379, 'в результате ударов на переходе морем был поражен сухогруз, доставлявший в порт "Одесса" грузы, предназначенные для обеспечения ВСУ')),
 None, None,
 'Украинские и независимые источники в выборке эти удары не подтверждают и не комментируют; характер грузов и названия судов известны только из заявлений Минобороны РФ.',
 'medium', 'Сведения есть только в заявлениях Минобороны РФ.', False,
 ['Міноборони РФ заявило про удари по суховантажах і портах Одеської області', 'Порти Одеса, Південний і Чорноморськ',
  'Українські та незалежні джерела у вибірці ці удари не підтверджують і не коментують; характер вантажів і назви суден відомі лише з заяв Міноборони РФ.',
  'Міноборони РФ повідомило, що дрони «Герань-4 Сікер» уразили в порту Південний суховантаж, «який використовувався для доставки військових вантажів ЗСУ», у порту Чорноморськ — сховище пально-мастильних матеріалів, а вдень на переході морем — ще один суховантаж, що йшов до порту Одеса з вантажами «для забезпечення ЗСУ». РІА Новини також пише про ураження суховантажу в порту Одеси. Назв суден і відомостей про постраждалих не наведено.',
  None, None],
 ['Russian Defence Ministry claims strikes on cargo ships and ports in Odesa region', 'Ports of Odesa, Pivdennyi and Chornomorsk',
  'Ukrainian and independent sources in the sample neither confirm nor comment on these strikes; the nature of the cargo and the names of the ships are known only from Russian Defence Ministry statements.',
  'The Russian Defence Ministry said Geran-4 Seeker drones hit a cargo ship in the port of Pivdennyi "that was used to deliver military cargo for the Ukrainian armed forces", a fuel and lubricants depot in the port of Chornomorsk, and during the day another cargo ship at sea bound for the port of Odesa with cargo "to supply the Ukrainian armed forces". RIA Novosti also reports a cargo ship hit in the port of Odesa. No ship names or casualty details are given.',
  None, None]))

cards.append(C('1007-zaporizhzhia-transport', [9756, 7628],
 'Удар по объекту транспортной инфраструктуры в Запорожье', 'Запорожье', 'zaporizhzhia',
 ['одна из групп не освещает'],
 None,
 S('Врио главы Запорожской ОВА Михаил Семикин сообщил, что в ночь на 7 октября российские войска ударили по объекту транспортной инфраструктуры Запорожья; из-за последствий атаки возможны временные ограничения движения. Какой именно объект пострадал, не уточняется, данных о пострадавших не было.',
   (7628, 'Росіяни атакували обʼєкт транспортної інфраструктури Запоріжжя. Через наслідки атаки можливе тимчасове обмеження руху на окремих ділянках доріг.'),
   (9756, 'Какой именно объект понес удар, в ОВА не уточняют.')),
 None,
 'Оба материала опираются на одно сообщение ОВА без подробностей. Российские источники в выборке этот удар отдельно не упоминают.',
 'low', '', False,
 ['Удар по об’єкту транспортної інфраструктури в Запоріжжі', 'Запоріжжя',
  'Обидва матеріали спираються на одне повідомлення ОВА без подробиць. Російські джерела у вибірці цей удар окремо не згадують.',
  None,
  'Т. в. о. начальника Запорізької ОВА Михайло Семікін повідомив, що в ніч на 7 жовтня російські війська вдарили по об’єкту транспортної інфраструктури Запоріжжя; через наслідки атаки можливе тимчасове обмеження руху. Який саме об’єкт постраждав, не уточнюється, даних про постраждалих не було.',
  None],
 ['Strike on a transport infrastructure facility in Zaporizhzhia', 'Zaporizhzhia',
  'Both reports rely on a single regional administration statement without details. Russian sources in the sample do not mention this strike separately.',
  None,
  'Acting Zaporizhzhia governor Mykhailo Semikin said that on the night of 7 October Russian forces struck a transport infrastructure facility in Zaporizhzhia; traffic may be temporarily restricted because of the damage. Which facility was hit was not specified, and there was no information on casualties.',
  None]))

cards.append(C('1007-oleshky', [4373, 4375, 4388, 5414, 5417, 9777, 7642],
 'Ситуация в Алешках: взаимные обвинения сторон', 'Алешки (Олешки), Херсонская область', 'kherson',
 ['расхождение: кто виноват'],
 S('Назначенный Россией губернатор Херсонской области Владимир Сальдо заявил, что ВСУ уничтожили автомобили с гуманитарной помощью для Алешек, водители спаслись; по его словам, международные организации ограничиваются «словами возмущения», а ситуация в городе не настолько критическая, чтобы вызывать такой шум. Посол МИД РФ Родион Мирошник обвинил Киев в «средневековой блокаде» Алешек с помощью дронов. Сальдо также заявил о готовности рассмотреть предложения Украины, если они улучшат положение жителей.',
   (4373, 'Автомобили с гуманитарной помощью из России, направленные в Алешки в Херсонской области, были уничтожены ВСУ'),
   (4388, 'Киевский режим устроил в Алешках в Херсонской области средневековую блокаду современными методами'),
   (5417, 'The situation in the Kherson Region city of Alyoshki is not so critical as to warrant the uproar stirred up at international organizations')),
 S('СБУ, по данным Українська правда и РБК-Украина, заявила, что Россия готовит информационно-психологические операции по ситуации в оккупированных Олешках: военнослужащим одного из подразделений якобы приказали снять «компрометирующие» постановочные интервью с местными жителями с обвинениями в адрес ВСУ.',
   (7642, 'Служба безпеки України попереджає, що Росія активізувала підготовку низки інформаційно-психологічних спецоперацій щодо ситуації у тимчасово окупованому місті Олешки Херсонської області.'),
   (9777, 'Россияне готовят серию постановочных интервью с жителями оккупированных Олешек Херсонской области.')),
 None,
 'Российская сторона возлагает ответственность за тяжелое положение Алешек на ВСУ и говорит о «блокаде» дронами; СБУ заранее объявляет будущие видеообращения жителей с обвинениями ВСУ постановочными. Утверждения обеих сторон в материалах не проверены. Губернатор Сальдо одновременно говорит о «бесчеловечных актах агрессии» и о том, что ситуация не настолько критична.',
 'medium', 'Сведения обеих сторон не проверены, независимых источников нет.', True,
 ['Ситуація в Олешках: взаємні звинувачення сторін', 'Олешки, Херсонська область',
  'Російська сторона покладає відповідальність за важке становище Олешок на ЗСУ і говорить про «блокаду» дронами; СБУ заздалегідь оголошує майбутні відеозвернення мешканців зі звинуваченнями ЗСУ постановочними. Твердження обох сторін у матеріалах не перевірені. Губернатор Сальдо водночас говорить про «нелюдські акти агресії» і про те, що ситуація не настільки критична.',
  'Призначений Росією губернатор Херсонської області Володимир Сальдо заявив, що ЗСУ знищили автомобілі з гуманітарною допомогою для Олешок, водії врятувалися; за його словами, міжнародні організації обмежуються «словами обурення», а ситуація в місті не настільки критична, щоб спричиняти такий галас. Посол МЗС РФ Родіон Мірошник звинуватив Київ у «середньовічній блокаді» Олешок за допомогою дронів. Сальдо також заявив про готовність розглянути пропозиції України, якщо вони поліпшать становище мешканців.',
  'СБУ, за даними Української правди і РБК-Україна, заявила, що Росія готує інформаційно-психологічні операції щодо ситуації в окупованих Олешках: військовослужбовцям одного з підрозділів нібито наказали зняти «компрометувальні» постановочні інтерв’ю з місцевими мешканцями зі звинуваченнями на адресу ЗСУ.',
  None],
 ['Situation in Oleshky: mutual accusations', 'Oleshky, Kherson Oblast',
  'The Russian side blames the Ukrainian armed forces for Oleshky\'s plight and speaks of a drone "blockade"; the SBU pre-emptively labels future video appeals by residents accusing the Ukrainian army as staged. Neither side\'s claims are verified in the materials. Governor Saldo speaks both of "inhuman acts of aggression" and of a situation that is not so critical.',
  'Russian-installed Kherson governor Volodymyr Saldo said the Ukrainian army destroyed vehicles carrying humanitarian aid for Oleshky, with the drivers escaping; according to him, international organisations limit themselves to "words of outrage", and the situation in the town is not critical enough to warrant such an uproar. Russian Foreign Ministry ambassador-at-large Rodion Miroshnik accused Kyiv of a "medieval blockade" of Oleshky using drones. Saldo also said he was ready to consider Ukrainian proposals if they improved residents\' situation.',
  'The SBU, according to Ukrainska Pravda and RBC-Ukraine, said Russia is preparing information and psychological operations about the situation in occupied Oleshky: soldiers of one unit were allegedly ordered to film "compromising" staged interviews with local residents accusing the Ukrainian army.',
  None]))

cards.append(C('1007-dpr-civilian-casualties', [4398, 5433],
 'Власти ДНР: трое мирных жителей погибли за сутки', 'Донецк, Горловка, Донецкая область', 'donetsk',
 ['российская сторона заявляет, украинская не комментирует'],
 S('По данным управления по документированию военных преступлений при администрации главы ДНР, которые приводят РИА Новости и ТАСС, 7 октября в результате атак ВСУ, в том числе дронов, погибли три мирных жителя и восемь ранены. ТАСС уточняет: двое погибли в поселке Спартак на окраине Донецка, один — в Горловке.',
   (4398, 'Три мирных жителя погибли, еще восемь получили ранения в результате атак ВСУ в Донецкой Народной Республике за прошедшие сутки'),
   (5433, 'Two people were killed in the village of Spartak on the outskirts of Donetsk.')),
 None, None,
 'Данные исходят только от назначенных Россией властей; украинские и независимые источники в выборке их не комментируют и не проверяют.',
 'medium', 'Единственный источник — российские власти региона.', False,
 ['Влада «ДНР»: троє цивільних загинули за добу', 'Донецьк, Горлівка, Донецька область',
  'Дані походять лише від призначеної Росією влади; українські та незалежні джерела у вибірці їх не коментують і не перевіряють.',
  'За даними управління з документування воєнних злочинів при адміністрації глави «ДНР», які наводять РІА Новини і ТАСС, 7 жовтня внаслідок атак ЗСУ, зокрема дронів, загинули троє цивільних і восьмеро поранені. ТАСС уточнює: двоє загинули в селищі Спартак на околиці Донецька, один — у Горлівці.',
  None, None],
 ['"DPR" authorities: three civilians killed in a day', 'Donetsk, Horlivka, Donetsk Oblast',
  'The figures come only from the Russian-installed authorities; Ukrainian and independent sources in the sample neither comment on nor verify them.',
  'According to the war-crimes documentation office of the "DPR" head\'s administration, cited by RIA Novosti and TASS, three civilians were killed and eight wounded on 7 October in Ukrainian attacks, including by drones. TASS specifies that two were killed in the village of Spartak on the outskirts of Donetsk and one in Horlivka.',
  None, None]))

cards.append(C('1007-front-claims', [4349, 4350, 6785, 9766, 9794],
 'Фронт 7 октября: заявления о Доброполье, окружении в Харьковской области и Купянске', 'Донецкая и Харьковская области', 'ukraine-wide',
 ['расхождение: кто контролирует населённые пункты'],
 S('Минобороны РФ, по данным РИА Новости, заявило, что группировка «Центр» продвинулась в центре и на севере Доброполья и за сутки «освободила» 82 здания, а группировка «Север» ведет бои за пять населенных пунктов в «окруженной части» Харьковской области и «продолжает сжимать кольцо окружения».',
   (4349, 'Бойцы группировки "Центр" продвинулись в центре и на севере Доброполья в ДНР, сообщило Минобороны .'),
   (4350, 'Подразделения группировки войск "Север" в Харьковской области продолжают сжимать кольцо окружения и расширять внешнюю зону контроля.')),
 S('Генштаб ВСУ сообщил о 202 боестолкновениях за сутки. РБК-Украина со ссылкой на ISW пишет об улучшении позиций ВСУ в Донецкой и Запорожской областях и об отсутствии подтверждений российского продвижения под Великим Бурлуком. Спикер Группировки объединенных сил Виктор Трегубов признал, что российским группам иногда удается проникать в Купянск, но плацдарм на правом берегу Оскола, по его словам, сокращается.',
   (6785, 'Про це йдеться в ранковому зведенні Генштабу ЗСУ 7 жовтня.'),
   (9766, 'По оценке ISW, подтверждений продвижения российской армии нет.'),
   (9794, 'вражеским группам иногда все еще удается проникать с северной стороны прямо в Купянск')),
 None,
 'Российская сторона говорит о продвижении в Доброполье и об «окружении» украинских сил в Харьковской области; украинские источники пишут о контратаках, отсутствии подтвержденного российского продвижения и сокращении российского плацдарма у Купянска. О ситуации в Доброполье украинские материалы этого дня не сообщают. Независимой проверки нет.',
 'medium', 'Заявления сторон о линии фронта не проверены независимо.', True,
 ['Фронт 7 жовтня: заяви про Добропілля, оточення в Харківській області та Куп’янськ', 'Донецька і Харківська області',
  'Російська сторона говорить про просування в Добропіллі та про «оточення» українських сил у Харківській області; українські джерела пишуть про контратаки, відсутність підтвердженого російського просування і скорочення російського плацдарму біля Куп’янська. Про ситуацію в Добропіллі українські матеріали цього дня не повідомляють. Незалежної перевірки немає.',
