import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1014-drones-moscow-sber', [10714, 10721, 10707, 10728, 4765, 4770, 4772, 5914, 5918, 4779, 5962, 7124, 7116, 9382, 9384, 8581, 8565],
 'Одна из крупнейших атак дронов на Москву: Собянин — 493 БПЛА; в Балаково поврежден строящийся ЦОД Сбербанка, один погибший', 'Москва, Саратовская и Ростовская области', 'russia-other',
 ['одна из групп не освещает'],
 S('Мэр Москвы Сергей Собянин сообщил, что за ночь в сторону Московского региона летели 493 беспилотника, 180 из них уничтожены на подлете к столице; по подсчетам РИА Новости и ТАСС, это одна из самых массированных атак за последнее время. Минобороны РФ заявило о 902 сбитых за ночь дронах над 20 с лишним регионами и Азовским морем. В Балаково, по словам губернатора Романа Бусаргина, погиб человек и повреждены жилые дома; Сбербанк подтвердил атаку на свой ЦОД, заявив, что сервисы работают штатно. Песков сказал, что власти ведут диалог с бизнесом о защите дата-центров.',
   (10714, 'В период с 20:30 13 октября по 07:00 14 октября в сторону Московского региона летели 493 БПЛА.'),
   (10728, 'Мы подтверждаем факт атаки на центр обработки данных. При этом все системы и все сервисы Сбербанка работают штатно')),
 S('Суспильне пересказывает данные губернатора и Сбербанка о Балаково; по данным Telegram-каналов Exilenova+ и ASTRA, в Ростовской области взорвался резервуар нефтеналивного терминала, а всего за четверо суток выведены из строя не менее восьми из 12 резервуаров.',
   (7124, 'внаслідок ударів БпЛА у Балаково загинула одна людина, а також пошкоджено кілька житлових будинків')),
 S('DW пишет, что пострадал строящийся ЦОД Сбербанка, который к 2030 году хотели сделать крупнейшим в Европе; Kyiv Independent сообщает о жалобах пользователей на сбои онлайн-сервисов банка и о пожаре у металлургического завода в Балаково.',
   (9384, 'Одним из поврежденных зданий стал строящийся центр обработки данных (ЦОД) Сбербанка.')),
 'Российская сторона подчеркивает масштаб отраженной атаки и штатную работу сервисов, независимые СМИ — ущерб инфраструктуре. Число сбитых дронов приводится только по данным Минобороны РФ.',
 'low', '', False,
 ['Одна з найбільших атак дронів на Москву: Собянін — 493 БпЛА; у Балаково пошкоджено ЦОД «Сбербанку», що будується, один загиблий', 'Москва, Саратовська і Ростовська області',
  'Російська сторона наголошує на масштабі відбитої атаки і штатній роботі сервісів, незалежні ЗМІ — на шкоді інфраструктурі. Кількість збитих дронів наводиться лише за даними Міноборони РФ.',
  'Мер Москви Сергій Собянін повідомив, що за ніч у бік Московського регіону летіли 493 безпілотники, 180 з них знищено на підльоті до столиці; за підрахунками РИА Новости і ТАСС, це одна з наймасованіших атак останнім часом. Міноборони РФ заявило про 902 збиті за ніч дрони над 20 з гаком регіонами та Азовським морем. У Балаково, за словами губернатора Романа Бусаргіна, загинула людина і пошкоджено житлові будинки; «Сбербанк» підтвердив атаку на свій ЦОД, заявивши, що сервіси працюють штатно. Пєсков сказав, що влада веде діалог із бізнесом про захист дата-центрів.',
  'Суспільне переказує дані губернатора і «Сбербанку» про Балаково; за даними Telegram-каналів Exilenova+ і ASTRA, у Ростовській області вибухнув резервуар нафтоналивного термінала, а загалом за чотири доби виведено з ладу щонайменше вісім із 12 резервуарів.',
  'DW пише, що постраждав ЦОД «Сбербанку», що будується, який до 2030 року хотіли зробити найбільшим у Європі; Kyiv Independent повідомляє про скарги користувачів на збої онлайн-сервісів банку і про пожежу біля металургійного заводу в Балаково.'],
 ['One of the largest drone attacks on Moscow: Sobyanin reports 493 drones; Sberbank data centre under construction damaged in Balakovo, one dead', 'Moscow, Saratov and Rostov regions',
  'The Russian side stresses the scale of the repelled attack and normal operation of services; independent media focus on infrastructure damage. The number of drones downed comes only from the Russian Defence Ministry.',
  'Moscow Mayor Sergei Sobyanin said 493 drones flew towards the Moscow region overnight, 180 of them destroyed on approach to the capital; by RIA Novosti and TASS counts it was one of the most massive attacks in recent times. The Russian Defence Ministry claimed 902 drones downed overnight over 20-plus regions and the Sea of Azov. In Balakovo, Governor Roman Busargin said one person was killed and homes damaged; Sberbank confirmed an attack on its data centre, saying services work normally. Peskov said authorities are in dialogue with business on protecting data centres.',
  'Suspilne relays the governor\'s and Sberbank\'s statements on Balakovo; according to the Exilenova+ and ASTRA Telegram channels, a tank at an oil terminal in Rostov region exploded, and in four days at least eight of 12 tanks have been put out of action.',
  'DW writes that the damaged building was a Sberbank data centre under construction that was meant to become Europe\'s largest by 2030; Kyiv Independent reports user complaints about outages of the bank\'s online services and a fire near a steel plant in Balakovo.'])

card('1014-western-ukraine-lutsk-rivne', [10777, 5980, 6580, 4794, 4798, 8056, 8059, 8040, 8035, 8022, 8024, 8082, 8576],
 'Удары по западу Украины: в Луцке погибли шесть человек на складе, в Ровно ранены восемь; Минобороны РФ — удар по «Эпицентру» в Хмельницком', 'Луцк, Ровно, Хмельницкий, Тернополь, Винница', 'ukraine-wide',
 ['расхождение: характер целей'],
 S('Минобороны РФ заявило, что днем дроны поразили в Хмельницком транспортно-логистический центр «Эпицентр», который, по версии ведомства, использовался для хранения и распределения грузов ВСУ. РИА Новости со ссылкой на украинские каналы сообщало о взрывах в Виннице и Ивано-Франковске.',
   (10777, 'поражен транспортно-логистический центр "Эпицентр", использовавшийся для хранения и распределения грузов в интересах ВСУ')),
 S('По данным властей Волыни, полиции и ГСЧС, обломки дрона попали в оптовый склад в Луцке: погибли 6 человек, 13 пострадали; ночью в городе горела нефтебаза. В Ровно, по данным Нацполиции, ранены восемь человек, в том числе 14-летний мальчик; в Тернополе реактивный дрон попал в административное здание, в Виннице дважды за день поврежден объект гражданской инфраструктуры. Компания «Эпицентр» сообщила, что накануне ее логистический центр в Хмельницком атаковали десять раз и сгорело около 85% товаров, работники не пострадали.',
   (8056, 'Російські дрони забрали життя шести мешканців Луцька, ще 13 людей постраждали.'),
   (8059, 'Наразі до лікарні доправлено вісьмох поранених, зокрема 14-річного хлопчика.'),
   (8022, 'Врешті ворогу вдалося досягнути свого – вогонь знищив близько 85% товарів, які зберігалися всередині.')),
 S('Kyiv Independent со ссылкой на главу Волынской ОВА Романа Романюка пишет, что пожар на складе в Луцке убил шесть человек и ранил 10, еще двое пострадали в девятиэтажном доме.',
   (8576, 'Wreckage of a Russian drone fell on the western city of Lutsk in Volyn Oblast, killing six people and injuring 10 others')),
 'Российская сторона называет «Эпицентр» военным логистическим объектом, украинская — торговым складом с гражданскими работниками. О жертвах в Луцке и Ровно российские источники в выборке не сообщают.',
 'low', '', True,
 ['Удари по заходу України: у Луцьку загинули шість людей на складі, у Рівному поранено вісьмох; Міноборони РФ — удар по «Епіцентру» в Хмельницькому', 'Луцьк, Рівне, Хмельницький, Тернопіль, Вінниця',
  'Російська сторона називає «Епіцентр» військовим логістичним об’єктом, українська — торговельним складом із цивільними працівниками. Про жертви в Луцьку і Рівному російські джерела у вибірці не повідомляють.',
  'Міноборони РФ заявило, що вдень дрони уразили в Хмельницькому транспортно-логістичний центр «Епіцентр», який, за версією відомства, використовувався для зберігання і розподілу вантажів ЗСУ. РИА Новости з посиланням на українські канали повідомляло про вибухи у Вінниці та Івано-Франківську.',
  'За даними влади Волині, поліції та ДСНС, уламки дрона влучили в гуртівню в Луцьку: загинули 6 людей, 13 постраждали; вночі в місті горіла нафтобаза. У Рівному, за даними Нацполіції, поранено вісьмох людей, зокрема 14-річного хлопця; у Тернополі реактивний дрон влучив в адміністративну будівлю, у Вінниці двічі за день пошкоджено об’єкт цивільної інфраструктури. Компанія «Епіцентр» повідомила, що напередодні її логістичний центр у Хмельницькому атакували десять разів і згоріло близько 85% товарів, працівники не постраждали.',
  'Kyiv Independent з посиланням на голову Волинської ОВА Романа Романюка пише, що пожежа на складі в Луцьку вбила шістьох людей і поранила 10, ще двоє постраждали в дев’ятиповерхівці.'],
 ['Strikes on western Ukraine: six killed at a warehouse in Lutsk, eight injured in Rivne; Russia claims a strike on Epicentr in Khmelnytskyi', 'Lutsk, Rivne, Khmelnytskyi, Ternopil, Vinnytsia',
  'Russia calls Epicentr a military logistics site, Ukraine a retail warehouse with civilian staff. Russian sources in the sample do not report the casualties in Lutsk and Rivne.',
  'The Russian Defence Ministry said drones struck the Epicentr transport and logistics centre in Khmelnytskyi during the day, which it says was used to store and distribute cargo for the Ukrainian army. RIA Novosti, citing Ukrainian channels, reported explosions in Vinnytsia and Ivano-Frankivsk.',
  'According to Volyn authorities, police and emergency services, drone debris hit a wholesale warehouse in Lutsk: 6 people were killed and 13 injured; an oil depot burned in the city overnight. In Rivne, the National Police said eight people were injured, including a 14-year-old boy; in Ternopil a jet-powered drone hit an administrative building, and in Vinnytsia a civilian infrastructure facility was damaged twice in a day. Epicentr said its logistics centre in Khmelnytskyi was attacked ten times the day before and about 85% of goods burned; no staff were hurt.',
  'Kyiv Independent, citing Volyn governor Roman Romaniuk, writes that the warehouse fire in Lutsk killed six people and injured 10, with two more hurt in a nine-storey building.'])

card('1014-nord-stream-trial-opens', [5908, 5947, 5954, 5901, 5921, 7153, 8039, 8303, 9386, 9393, 9149],
 'В Гамбурге начался суд над Сергеем Кузнецовым по делу о подрыве «Северных потоков»: обвинение говорит о военном преступлении, защита требует прекратить дело', 'Гамбург', 'ukraine-wide',
 ['расхождение: оценка события'],
 S('ТАСС называет подрыв газопроводов терактом и сообщает, что суд назначил 24 заседания; по версии генпрокуратуры ФРГ, Кузнецов и сообщники действовали по заданию украинских госструктур, а его действия следует квалифицировать как военное преступление. Агентство также цитирует немецкого журналиста Оливера Шрома, утверждающего, что ЦРУ на раннем этапе знало о плане и не возражало, и сообщает о митинге партии BSW с требованием политического расследования.',
   (5947, 'Since he committed the acts while being a Ukrainian army officer and with the knowledge of Ukrainian government agencies, they should be regarded as a war crime'),
   (5901, 'According to our sources, the CIA knew [of the sabotage plans] at an early stage.')),
 S('Украинская правда со ссылкой на Reuters пишет, что Кузнецова обвиняют в руководстве группой водолазов и подрывников, взорвавшей газопроводы в 2022 году, а процесс неудобен для правительства Германии, поддерживающего Украину; Суспильне подробно разбирает доводы немецкого следствия.',
   (8039, 'Кузнєцова звинувачують у керівництві групою українських агентів, яка складалася з водолазів і фахівців з вибухових речовин та здійснила підрив газопроводів.')),
 S('DW, BBC и Guardian сообщают, что 50-летний бывший офицер украинского спецназа предстал перед Ганзейским высшим земельным судом; обвинение утверждает, что группа действовала по приказу государственных органов, а защита отвергла обвинение в военном преступлении и попросила прекратить производство, указав на нарушения при экстрадиции из Италии.',
   (9149, 'A Ukrainian soldier led a team of divers that, acting on the order of state authorities, laid explosives on the bed of the Baltic Sea to blow up the Nord Stream gas pipelines, a court has heard.'),
   (9393, 'защита 50-летнего гражданина Украины Сергея Кузнецова. попросила Ганзейский высший земельный суд в Гамбурге прекратить судебное производство')),
 'Российские источники используют термин «теракт» и акцентируют версию о причастности ЦРУ, независимые СМИ — позиции обвинения и защиты. Версия о ЦРУ основана на источниках журналиста и не подтверждена.',
 'low', '', False,
 ['У Гамбурзі почався суд над Сергієм Кузнєцовим у справі про підрив «Північних потоків»: обвинувачення говорить про воєнний злочин, захист вимагає закрити справу', 'Гамбург',
  'Російські джерела використовують термін «теракт» і наголошують на версії про причетність ЦРУ, незалежні ЗМІ — на позиціях обвинувачення і захисту. Версія про ЦРУ ґрунтується на джерелах журналіста і не підтверджена.',
  'ТАСС називає підрив газогонів терактом і повідомляє, що суд призначив 24 засідання; за версією генпрокуратури ФРН, Кузнєцов і спільники діяли на завдання українських держструктур, а його дії слід кваліфікувати як воєнний злочин. Агентство також цитує німецького журналіста Олівера Шрома, який стверджує, що ЦРУ на ранньому етапі знало про план і не заперечувало, і повідомляє про мітинг партії BSW з вимогою політичного розслідування.',
  'Українська правда з посиланням на Reuters пише, що Кузнєцова звинувачують у керівництві групою водолазів і підривників, яка підірвала газогони у 2022 році, а процес незручний для уряду Німеччини, що підтримує Україну; Суспільне докладно розбирає аргументи німецького слідства.',
  'DW, BBC і Guardian повідомляють, що 50-річний колишній офіцер українського спецназу постав перед Ганзейським вищим земельним судом; обвинувачення стверджує, що група діяла за наказом державних органів, а захист відкинув звинувачення у воєнному злочині і попросив закрити провадження, вказавши на порушення під час екстрадиції з Італії.'],
 ['Trial of Serhii Kuznetsov over the Nord Stream sabotage opens in Hamburg: prosecutors allege a war crime, the defence seeks dismissal', 'Hamburg',
  'Russian sources use the term "terrorist attack" and highlight the claim of CIA involvement; independent media focus on the prosecution and defence. The CIA claim rests on a journalist\'s sources and is unconfirmed.',
  'TASS calls the pipeline blasts a terrorist attack and reports that the court has scheduled 24 hearings; according to the German federal prosecutor, Kuznetsov and accomplices acted on orders from Ukrainian state agencies, and his actions should be classed as a war crime. The agency also quotes German journalist Oliver Schrom, who claims the CIA knew of the plan early on and did not object, and reports a BSW party rally demanding a political inquiry.',
  'Ukrainska Pravda, citing Reuters, writes that Kuznetsov is accused of leading a group of divers and explosives specialists that blew up the pipelines in 2022, and that the trial is awkward for the German government, which supports Ukraine; Suspilne examines the German investigators\' arguments in detail.',
  'DW, the BBC and the Guardian report that the 50-year-old former Ukrainian special forces officer appeared before the Hanseatic Higher Regional Court; prosecutors say the group acted on the orders of state bodies, while the defence rejected the war crime charge and asked for the case to be dropped, citing flaws in his extradition from Italy.'])
json.dump(cards, open('/workspace/compare-site-v2/tools/days/out/c14b.json', 'w'), ensure_ascii=False)
print(len(cards))
