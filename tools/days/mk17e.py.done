import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1017-starlink-planned-operation', [8997, 7310, 8958, 9028, 8663, 8714, 8709],
 'Зеленский: ограничения Starlink действуют только в Украине, в ЕС терминалы работают — «спланированная операция»', 'Украина', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Зеленский заявил, что Украина отправила машины со Starlink в страны ЕС: там терминалы работают на скорости свыше 180 км/ч, тогда как в Украине связь пропадает при 161 км/ч, поэтому это «спланированная операция»; ответа от SpaceX нет. Временный поверенный Украины в США Денис Сеник сказал, что Киев ждет официального подтверждения от Пентагона и SpaceX. Советник Сергей Бескрестнов предупредил, что Россия может примерно через полгода получить собственную спутниковую сеть «Рассвет» для управления «шахедами».',
   (7310, 'Висновок наступний: обмеження діють на території України і не діють на території країн Європейського Союзу. Тобто це спланована операція'),
   (8958, 'Київ очікує офіційної відповіді від Пентагону та компанії SpaceX щодо повного відновлення роботи супутникової системи Starshield')),
 S('Kyiv Independent и Meduza подтверждают со слов Зеленского, что ограничение в 161 км/ч сохраняется и мешает дронам-перехватчикам сбивать реактивные «шахеды»; Meduza также пересказывает данные Telegraph о том, что идею ограничения предложил Маск.',
   (8663, 'Zelensky now confirmed that a speed limit of 161 kilometers per hour remains in place.')),
 'Российские источники в выборке заявления Зеленского не освещают; украинские и независимые источники совпадают в фактах.',
 'low', '', False,
 ['Зеленський: обмеження Starlink діють лише в Україні, в ЄС термінали працюють — «спланована операція»', 'Україна',
  'Російські джерела у вибірці заяви Зеленського не висвітлюють; українські та незалежні джерела збігаються у фактах.',
  None,
  'Зеленський заявив, що Україна відправила машини зі Starlink у країни ЄС: там термінали працюють на швидкості понад 180 км/год, тоді як в Україні зв’язок зникає за 161 км/год, тож це «спланована операція»; відповіді від SpaceX немає. Тимчасовий повірений України у США Денис Сенік сказав, що Київ чекає офіційного підтвердження від Пентагону і SpaceX. Радник Сергій Бескрестнов попередив, що Росія може приблизно за пів року отримати власну супутникову мережу «Рассвет» для керування «шахедами».',
  'Kyiv Independent і Meduza підтверджують зі слів Зеленського, що обмеження в 161 км/год зберігається і заважає дронам-перехоплювачам збивати реактивні «шахеди»; Meduza також переказує дані Telegraph про те, що ідею обмеження запропонував Маск.'],
 ['Zelensky: Starlink restrictions apply only in Ukraine while terminals work in the EU — a "planned operation"', 'Ukraine',
  'Russian sources in the sample do not cover Zelensky\'s statements; Ukrainian and independent sources agree on the facts.',
  None,
  'Zelensky said Ukraine sent vehicles with Starlink into EU countries, where the terminals worked at over 180 km/h, while in Ukraine the connection drops at 161 km/h, so this is a "planned operation"; SpaceX has not replied. Ukraine\'s chargé d\'affaires in the US Denys Senyk said Kyiv awaits official confirmation from the Pentagon and SpaceX. Adviser Serhii Beskrestnov warned that Russia could within about half a year obtain its own satellite network, Rassvet, to guide Shaheds.',
  'Kyiv Independent and Meduza confirm, citing Zelensky, that the 161 km/h cap remains and prevents interceptor drones from downing jet-powered Shaheds; Meduza also relays the Telegraph report that Musk proposed the restriction.'])

card('1017-belarus-ballistic-threat', [9000, 7311, 8253, 8669],
 'Зеленский: Россия хочет разместить в Беларуси баллистические установки для ударов по западу Украины', 'Беларусь, запад Украины', 'ukraine-wide',
 ['одна сторона освещает', 'не проверено'],
 None,
 S('Зеленский заявил журналистам, что Россия уже размещает в Беларуси ретрансляторы для дронов, но ей этого мало: Путину нужна поддержка Лукашенко, чтобы разместить там баллистику, что создаст угрозу прежде всего для западной Украины и означает прямое втягивание Беларуси в войну.',
   (7311, 'Їм потрібна підтримка Лукашенка для того, щоб на території Білорусі були розташовані інші види і балістики в тому числі.')),
 S('Kyiv Independent приводит слова Зеленского и данные Госпогранслужбы о том, что оборудование в Беларуси ретранслирует сигналы «шахедов», летящих на запад Украины.',
   (8669, 'Zelensky said Russia was already using drone signal repeaters in Belarus')),
 'Российские и белорусские источники в выборке заявление не комментируют; это оценка украинской стороны без независимого подтверждения.',
 'medium', 'Предупреждение основано на оценке украинского руководства и не подтверждено независимо.', False,
 ['Зеленський: Росія хоче розмістити в Білорусі балістичні установки для ударів по заходу України', 'Білорусь, захід України',
  'Російські та білоруські джерела у вибірці заяву не коментують; це оцінка української сторони без незалежного підтвердження.',
  None,
  'Зеленський заявив журналістам, що Росія вже розміщує в Білорусі ретранслятори для дронів, але їй цього замало: Путіну потрібна підтримка Лукашенка, щоб розмістити там балістику, що створить загрозу передусім для заходу України і означає пряме втягування Білорусі у війну.',
  'Kyiv Independent наводить слова Зеленського і дані Держприкордонслужби про те, що обладнання в Білорусі ретранслює сигнали «шахедів», які летять на захід України.'],
 ['Zelensky: Russia wants to station ballistic launchers in Belarus to strike western Ukraine', 'Belarus, western Ukraine',
  'Russian and Belarusian sources in the sample do not comment; this is the Ukrainian side\'s assessment without independent confirmation.',
  None,
  'Zelensky told journalists that Russia is already placing drone repeaters in Belarus but that this is not enough for it: Putin needs Lukashenko\'s support to station ballistic missiles there, which would threaten western Ukraine above all and would mean dragging Belarus directly into the war.',
  'Kyiv Independent quotes Zelensky and the State Border Guard Service, which says equipment in Belarus relays signals for Shaheds flying towards western Ukraine.'])

card('1017-coalition-drill-poland', [6196, 8965, 9013, 7305, 8224, 8242],
 'The Times: в ноябре около 1500 военных Британии, Франции, Германии и Польши отработают в Польше развертывание сил в Украине после перемирия', 'Польша', 'ukraine-wide',
 ['одна из групп не освещает'],
 S('ТАСС со ссылкой на The Times сообщает, что не менее 1500 военных Великобритании, Польши, Франции и Германии примут участие в первых учениях «коалиции желающих» в ноябре, которые преподносятся как репетиция развертывания в Украине в случае прекращения огня.',
   (6196, 'The maneuvers, which will take place in Poland, are being presented as a rehearsal for deployment in Ukraine in the event of a ceasefire.')),
 S('Украинские СМИ со ссылкой на The Times и Daily Mail пишут о тех же учениях; министр обороны Британии Уэс Стритинг подтвердил участие британских войск.',
   (7305, 'Британські війська візьмуть участь у масштабних військових навчаннях НАТО, мета яких — відпрацювати розгортання сил в Україні на випадок припинення вогню'),
   (8965, 'У листопаді до Польщі прибудуть щонайменше 1500 військових із Великої Британії, Франції, Німеччини та Польщі.')),
 None,
 'Расхождений в фактах нет: обе стороны опираются на публикацию The Times; российские источники не дают оценок.',
 'low', '', False,
 ['The Times: у листопаді близько 1500 військових Британії, Франції, Німеччини та Польщі відпрацюють у Польщі розгортання сил в Україні після перемир’я', 'Польща',
  'Розбіжностей у фактах немає: обидві сторони спираються на публікацію The Times; російські джерела не дають оцінок.',
  'ТАСС із посиланням на The Times повідомляє, що щонайменше 1500 військових Великої Британії, Польщі, Франції та Німеччини візьмуть участь у перших навчаннях «коаліції охочих» у листопаді, які подаються як репетиція розгортання в Україні в разі припинення вогню.',
  'Українські ЗМІ з посиланням на The Times і Daily Mail пишуть про ті самі навчання; міністр оборони Британії Вес Стрітінг підтвердив участь британських військ.',
  None],
 ['The Times: in November about 1500 British, French, German and Polish troops will rehearse in Poland a post-ceasefire deployment to Ukraine', 'Poland',
  'There are no factual discrepancies: both sides rely on The Times report; Russian sources offer no assessment.',
  'TASS, citing The Times, reports that at least 1500 troops from Britain, Poland, France and Germany will take part in the first "coalition of the willing" drills in November, presented as a rehearsal for deployment in Ukraine in the event of a ceasefire.',
  'Ukrainian media, citing The Times and the Daily Mail, report the same drills; British Defence Secretary Wes Streeting confirmed British troops would take part.',
  None])

card('1017-slovakia-hungary-70bn', [8976, 8956, 8660, 8783],
 'Фицо: Словакия и Венгрия не присоединятся к пакету в 70 млрд евро для Украины; Мадьяр готов к транзиту украинского зерна', 'Братислава, Будапешт', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Премьер Словакии Роберт Фицо заявил, что страна не будет участвовать в финансировании новой помощи Украине на 70 млрд евро, такой же позиции, по его словам, придерживается Петер Мадьяр. Макрон, напротив, пообещал, что Европа рассмотрит запрос Киева вместе с G7.',
   (8976, 'Словаччина та Угорщина заявили, що не долучаться до її фінансування.'),
   (8956, 'Ми, безумовно, розглядатимемо питання фінансування.')),
 S('Kyiv Independent добавляет, что к дополнительному пакету не намерена присоединяться и Чехия Андрея Бабиша; DW со ссылкой на Мадьяра сообщает, что Зеленский попросил соседей разрешить транзит украинского зерна, и венгерский премьер не видит препятствий, если зерно не попадет на внутренний рынок.',
   (8660, 'Czech Prime Minister Andrej Babis also signaled that his country would not join an additional financing package for Ukraine.'),
   (8783, 'Петер Мадьяр добавил, что не видит препятствий для такого решения, если зерно будет лишь пересекать территорию Венгрии и не попадать на внутренний рынок страны.')),
 'Российские источники в выборке эти заявления не освещают; расхождений между украинскими и независимыми источниками нет.',
 'low', '', False,
 ['Фіцо: Словаччина та Угорщина не долучаться до пакета в 70 млрд євро для України; Мадяр готовий до транзиту українського зерна', 'Братислава, Будапешт',
  'Російські джерела у вибірці ці заяви не висвітлюють; розбіжностей між українськими та незалежними джерелами немає.',
  None,
  'Прем’єр Словаччини Роберт Фіцо заявив, що країна не братиме участі у фінансуванні нової допомоги Україні на 70 млрд євро, такої самої позиції, за його словами, дотримується Петер Мадяр. Макрон, навпаки, пообіцяв, що Європа розгляне запит Києва разом із G7.',
  'Kyiv Independent додає, що до додаткового пакета не має наміру долучатися і Чехія Андрея Бабіша; DW з посиланням на Мадяра повідомляє, що Зеленський попросив сусідів дозволити транзит українського зерна, і угорський прем’єр не бачить перешкод, якщо зерно не потраплятиме на внутрішній ринок.'],
 ['Fico: Slovakia and Hungary will not join the 70 billion euro package for Ukraine; Magyar open to Ukrainian grain transit', 'Bratislava, Budapest',
  'Russian sources in the sample do not cover these statements; there are no discrepancies between Ukrainian and independent sources.',
  None,
  'Slovak Prime Minister Robert Fico said his country would not take part in funding the new 70 billion euro aid for Ukraine, and that Peter Magyar takes the same position. Macron, by contrast, promised that Europe would consider Kyiv\'s request together with the G7.',
  'Kyiv Independent adds that Andrej Babis\'s Czech Republic also does not intend to join the additional package; DW, citing Magyar, reports that Zelensky asked neighbours to allow transit of Ukrainian grain and that the Hungarian prime minister sees no obstacles as long as the grain does not enter the domestic market.'])

json.dump(cards, open('/workspace/compare-site-v2/tools/days/out/c17e.json','w'), ensure_ascii=False, indent=1)
print(len(cards))
