import sys, glob, os
sys.path.insert(0, "/workspace/compare-site-v2/tools/days")
from extlib import ext, add, setd, apply, q
# ---------------- hourly run 22 Oct 11:04: extensions with new ids 16373–16596 ----------------
def noop(c): pass

def rep(c, pairs):
    for k, old, new in pairs:
        d = c['diverge'] if k == 'ru' else c[k]['d']
        assert old in d, (c['key'], k, old[:40])
        if k == 'ru': c['diverge'] = d.replace(old, new)
        else: c[k]['d'] = d.replace(old, new)

@ext('1021-kyiv-ballistic-evening-strike', [16464, 16569, 16584, 16581, 16549, 16568, 16554, 16578])
def _(c):
    c['ru']['summary'] = "РИА Новости и ТАСС со ссылкой на «Общественное» вечером в среду, ночью и под утро 22 октября сообщали о взрывах в Киеве на фоне воздушной тревоги; ТАСС добавлял, что повреждена АЗС и на левом берегу Днепра прозвучали как минимум восемь взрывов. Чем наносился удар и есть ли пострадавшие, в сообщениях не говорится. РИА Новости написало о «двух сериях взрывов» за ночь и добавило стандартную формулировку о том, что армия России бьет по «центрам принятия решений» и объектам, которые ВСУ используют «совместно с натовскими специалистами». Утром ТАСС сообщил об ограничении движения по Южному мосту и, со слов Кличко, о повреждении части инфраструктуры метро, затем — о транспортном коллапсе; РИА Новости со ссылкой на «24-й канал» — о больших пробках и очередях на остановках. Днем ТАСС написал, что движение по мосту полностью перекрыто, и добавил, что, по данным Минобороны России, мост был поврежден ударом российских войск."
    c['uk']['ru'] = "РИА Новости і ТАСС з посиланням на «Суспільне» ввечері в середу, вночі та під ранок 22 жовтня повідомляли про вибухи в Києві на тлі повітряної тривоги; ТАСС додавав, що пошкоджено АЗС і на лівому березі Дніпра пролунали щонайменше вісім вибухів. Чим завдавали удару і чи є постраждалі, у повідомленнях не йдеться. РИА Новости написало про «дві серії вибухів» за ніч і додало стандартне формулювання про те, що армія Росії б’є по «центрах ухвалення рішень» і об’єктах, які ЗСУ використовують «спільно з натовськими фахівцями». Уранці ТАСС повідомив про обмеження руху Південним мостом і, зі слів Кличка, про пошкодження частини інфраструктури метро, потім — про транспортний колапс; РИА Новости з посиланням на «24-й канал» — про великі затори та черги на зупинках. Удень ТАСС написав, що рух мостом повністю перекрито, і додав, що, за даними Міноборони Росії, міст було пошкоджено ударом російських військ."
    c['en']['ru'] = "RIA Novosti and TASS, citing Suspilne, reported explosions in Kyiv during air-raid alerts on Wednesday evening, overnight and towards the morning of 22 October; TASS added that a petrol station was damaged and at least eight explosions were heard on the left bank of the Dnipro. The reports do not say what the strike was carried out with or whether anyone was hurt. RIA Novosti wrote of \"two series of explosions\" during the night and added its standard wording that the Russian army is striking \"decision-making centres\" and sites the Ukrainian army uses \"together with NATO specialists\". In the morning TASS reported traffic restrictions on the Southern Bridge and, citing Klitschko, damage to part of the metro infrastructure, then a traffic collapse; RIA Novosti, citing 24 Kanal, reported heavy traffic jams and queues at stops. During the day TASS wrote that traffic on the bridge had been closed completely, adding that according to Russia's Defence Ministry the bridge had been damaged by a Russian strike."
    c['ru']['quotes'].append(q(16464, 'В Киеве полностью перекрыли движение по Южному мосту через Днепр'))
    c['ua']['summary'] = "РБК-Украина, «Украинская правда» и «Общественное» со ссылкой на Воздушные силы, КГВА и Кличко пишут о двух волнах российских баллистических ударов по Киеву. Вечером в Днепровском районе были попадания в СТО и частный дом, повреждена АЗС, позже — транспортный объект в Дарницком районе; пострадали шестеро. «Общественное» подает удар в одном заголовке с согласием Украины на трехстороннюю встречу команд. Утром Кличко сообщил о 15 пострадавших, затем, по данным ГСЧС и полиции, — удары по шести районам, в Днепровском погиб 48-летний мужчина, ранены 22 человека, в том числе четверо детей. В Печерском районе повреждены 18 жилых домов, станция скорой помощи и Свято-Введенский монастырь; на Почайной сгорел гипермаркет «Эпицентр», в Оболонском районе горели два нежилых здания, ранен охранник. Советник президента Сергей Бескрестнов («Флеш») заявил, что по историческому центру ударили «Искандером» с кассетной боевой частью, чтобы ранить как можно больше людей. Поврежден Южный мост: метро с левого берега идет только до «Осокорков», где скопились толпы, а около 11:00 движение по мосту перекрыли в обе стороны."
    c['uk']['ua'] = "РБК-Україна, «Українська правда» і «Суспільне» з посиланням на Повітряні сили, КМВА та Кличка пишуть про дві хвилі російських балістичних ударів по Києву. Увечері в Дніпровському районі були влучання в СТО та приватний будинок, пошкоджено АЗС, пізніше — транспортний об’єкт у Дарницькому районі; постраждали шестеро. «Суспільне» подає удар в одному заголовку зі згодою України на тристоронню зустріч команд. Уранці Кличко повідомив про 15 постраждалих, потім, за даними ДСНС і поліції, — удари по шести районах, у Дніпровському загинув 48-річний чоловік, поранено 22 людини, серед них четверо дітей. У Печерському районі пошкоджено 18 житлових будинків, станцію швидкої допомоги та Свято-Введенський монастир; на Почайній згорів гіпермаркет «Епіцентр», в Оболонському районі горіли дві нежитлові будівлі, поранено охоронця. Радник президента Сергій Бескрестнов («Флеш») заявив, що по історичному центру вдарили «Іскандером» із касетною бойовою частиною, щоб травмувати якомога більше людей. Пошкоджено Південний міст: метро з лівого берега йде лише до «Осокорків», де зібралися натовпи, а близько 11:00 рух мостом перекрили в обох напрямках."
    c['en']['ua'] = "RBC-Ukraine, Ukrainska Pravda and Suspilne, citing the Air Force, the city administration and Klitschko, report two waves of Russian ballistic strikes on Kyiv. In the evening a car repair shop and a private house in Dniprovskyi district were hit and a petrol station damaged, later a transport site in Darnytskyi district; six people were hurt. Suspilne runs the strike in one headline with Ukraine's consent to a trilateral meeting of teams. In the morning Klitschko reported 15 injured; then, according to the emergency service and police, six districts were hit, a 48-year-old man was killed in Dniprovskyi and 22 people were injured, including four children. In Pecherskyi district 18 residential buildings, an ambulance station and the Holy Vvedensky Monastery were damaged; the Epicentr hypermarket at Pochaina burned down, and two non-residential buildings caught fire in Obolonskyi district, wounding a guard. Presidential adviser Serhiy Beskrestnov (\"Flash\") said the historic centre was hit by an Iskander with a cluster warhead in order to injure as many people as possible. The Southern Bridge was damaged: the metro from the left bank only runs to Osokorky, where crowds gathered, and at about 11:00 traffic on the bridge was closed in both directions."
    c['ua']['quotes'] += [q(16569, 'Цей удар було завдано не з військовою метою.'),
                          q(16554, 'в Оболонському районі зафіксували влучання в дві нежитлові споруди'),
                          q(16568, 'рух транспорту Південним мостом тимчасово перекритий в обох напрямках')]
    rep(c, [('ru', 'ТАСС сообщает лишь об ограничении движения по Южному мосту и повреждении инфраструктуры метро.',
             'ТАСС сообщает лишь об ограничении движения по Южному мосту и повреждении инфраструктуры метро, а затем о полном перекрытии моста, сославшись на Минобороны России, что мост поврежден российским ударом. Слова советника Зеленского о кассетной боевой части и ударе по историческому центру приводят только украинские издания.'),
            ('uk', 'ТАСС повідомляє тільки про обмеження руху Південним мостом і пошкодження інфраструктури метро.',
             'ТАСС повідомляє тільки про обмеження руху Південним мостом і пошкодження інфраструктури метро, а потім про повне перекриття мосту, пославшись на Міноборони Росії, що міст пошкоджено російським ударом. Слова радника Зеленського про касетну бойову частину й удар по історичному центру наводять лише українські видання.'),
            ('en', 'TASS reports only the traffic restriction on the Southern Bridge and damage to metro infrastructure.',
             "TASS reports only the traffic restriction on the Southern Bridge and damage to metro infrastructure, and later the bridge's full closure, citing Russia's Defence Ministry that the bridge was damaged by a Russian strike. Only Ukrainian outlets quote the Zelensky adviser's claim of a cluster warhead and a strike on the historic centre.")])

@ext('1022-mod-massive-strike-vpk-energy', [16431, 16474, 16440, 16534, 16579, 16540, 16574, 16596, 16537])
def _(c):
    add(c, 'ua', 'Замминистра энергетики Артем Некрасов сообщил о новых отключениях в шести областях и гибели энергетика в Харьковской области.',
        'Заступник міністра енергетики Артем Некрасов повідомив про нові знеструмлення в шести областях і загибель енергетика на Харківщині.',
        'Deputy Energy Minister Artem Nekrasov reported new power outages in six regions and an energy worker killed in Kharkiv region.',
        [(16537, 'внаслідок обстрілу Харківщини загинув енергетик')])
    add(c, 'ind', '«Медуза» приводит слова Зеленского о том, что удар нанесен «фактически сразу после очередных переговоров». The Moscow Times пишет, что за ночь российские удары убили не менее семи человек — троих в Запорожской области, двоих в Донецкой, по одному в Сумской и Харьковской.',
        '«Медуза» наводить слова Зеленського про те, що удару завдано «фактично одразу після чергових переговорів». The Moscow Times пише, що за ніч російські удари вбили щонайменше сімох людей — трьох у Запорізькій області, двох у Донецькій, по одному в Сумській і Харківській.',
        'Meduza quotes Zelensky as saying the strike came "practically right after another round of talks". The Moscow Times writes that Russian strikes killed at least seven people overnight: three in Zaporizhzhia region, two in Donetsk, and one each in Sumy and Kharkiv regions.',
        [(16574, 'этот удар был нанесен «фактически сразу после очередных переговоров»'),
         (16596, 'Russian attacks killed at least seven people across the country, including three in Zaporizhzhia, two in Donetsk, one in Sumy and a woman in the Kharkiv region.')])

@ext('1022-nato-nspa-ukraine-procurement', [16576, 16543])
def _(c):
    add(c, 'ua', '«Общественному» представитель НАТО сказал, что поддержка Украины через программу PURL продолжает поступать, хотя FT ранее писала об угрозах администрации Трампа ее остановить.',
        '«Суспільному» посадовець НАТО сказав, що підтримка України через програму PURL продовжує надходити, хоча FT раніше писала про погрози адміністрації Трампа її зупинити.',
        'A NATO official told Suspilne that support for Ukraine through the PURL programme continues to arrive, although the FT had earlier reported threats by the Trump administration to halt it.',
        [(16543, 'Ми вітаємо та заохочуємо подальші внески членів Альянсу')])
    add(c, 'ind', 'DW (на русском) со ссылкой на FT пишет, что партнерство с NSPA даст Украине дополнительный канал закупок: до сих пор ей приходилось полагаться лишь на двусторонние переговоры с отдельными странами. Борсбум приводит пример заказа 30 тысяч комплектов формы, глава миссии Украины при НАТО Алена Гетманчук говорит о «важных воротах» в оборонно-промышленную экосистему НАТО. По данным FT, решение принято на фоне ухудшения отношений Украины с США; издание напоминает о встрече Уиткоффа с Путиным.',
        'DW (російською) з посиланням на FT пише, що партнерство з NSPA дасть Україні додатковий канал закупівель: досі їй доводилося покладатися лише на двосторонні переговори з окремими країнами. Борсбум наводить приклад замовлення 30 тисяч комплектів форми, голова місії України при НАТО Альона Гетманчук говорить про «важливі ворота» до оборонно-промислової екосистеми НАТО. За даними FT, рішення ухвалено на тлі погіршення відносин України зі США; видання нагадує про зустріч Віткоффа з Путіним.',
        'DW (in Russian), citing the FT, writes that the partnership with NSPA will give Ukraine an additional procurement channel: until now it has had to rely only on bilateral talks with individual countries. Borsboom gives the example of an order for 30 thousand sets of uniforms, and Ukraine\'s head of mission to NATO Alyona Getmanchuk speaks of an "important gateway" into NATO\'s defence-industrial ecosystem. According to the FT, the decision comes amid worsening relations between Ukraine and the US; the outlet recalls Witkoff\'s meeting with Putin.',
        [(16576, 'До сих пор Украине приходилось полагаться лишь на двусторонние переговоры с отдельными странами.')])
    setd(c, "Все три группы одинаково передают суть публикации FT. Российские агентства дополняют ее позицией Москвы о том, что поставки оружия затягивают конфликт и вовлекают в него НАТО, и не упоминают контекст отношений Киева с Вашингтоном; РБК-Украина и DW связывают решение с ухудшением отношений Украины с США, РБК-Украина — также с задержкой поставок Patriot. РБК-Украина пишет, что Украине уже «разрешили» такие закупки, российские агентства и DW — что НАТО «позволит».",
         "Усі три групи однаково передають суть публікації FT. Російські агентства доповнюють її позицією Москви про те, що постачання зброї затягують конфлікт і втягують у нього НАТО, і не згадують контекст відносин Києва з Вашингтоном; РБК-Україна і DW пов’язують рішення з погіршенням відносин України зі США, РБК-Україна — також із затримкою постачання Patriot. РБК-Україна пише, що Україні вже «дозволили» такі закупівлі, російські агентства і DW — що НАТО «дозволить».",
         "All three groups convey the substance of the FT report in the same way. Russian agencies add Moscow's position that arms supplies prolong the conflict and drag NATO into it, and do not mention the context of Kyiv's relations with Washington; RBC-Ukraine and DW link the decision to worsening relations between Ukraine and the US, RBC-Ukraine also to the delay of Patriot deliveries. RBC-Ukraine writes that Ukraine has already been \"allowed\" to make such purchases, Russian agencies and DW that NATO \"will allow\" it.")
    c['tags'] = ['расхождение: формулировки', 'умолчание']

@ext('1020-picierno-hunger-strike-oleshky', [16586])
def _(c):
    add(c, 'ua', 'Омбудсмен Дмитрий Лубинец 22 октября сказал РБК-Украина, что люди в Олешках «фактически умирают», а Украина «практически на финишной прямой» в вопросе эвакуации тысяч мирных жителей, в том числе детей; переговоры с Россией идут ежедневно.',
        'Омбудсман Дмитро Лубінець 22 жовтня сказав РБК-Україна, що люди в Олешках «фактично вмирають», а Україна «практично на фінішній прямій» у питанні евакуації тисяч цивільних, зокрема дітей; перемовини з Росією тривають щодня.',
        'On 22 October ombudsman Dmytro Lubinets told RBC-Ukraine that people in Oleshky are "effectively dying" and that Ukraine is "practically on the home stretch" in arranging the evacuation of thousands of civilians, including children; talks with Russia are held daily.',
        [(16586, 'люди фактично вмирають'), (16586, 'зараз ми практично на фінішній прямій')])

@ext('1021-russian-diesel-first-tanker-us', [16567])
def _(c):
    add(c, 'ua', '«Украинская правда» со ссылкой на «Европейскую правду» приводит интервью Петра Павла: из-за снятия Трампом санкций против российского дизеля Москва упустила близкий шанс на перемирие, сделка дала Кремлю «возможность передохнуть»; предательством он ее не называет, но считает ошибкой.',
        '«Українська правда» з посиланням на «Європейську правду» наводить інтерв’ю Петра Павела: через скасування Трампом санкцій щодо російського дизеля Москва втратила близький шанс на перемир’я, угода дала Кремлю «можливість перепочити»; зрадою він її не називає, але вважає помилкою.',
        'Ukrainska Pravda, citing Yevropeiska Pravda, quotes Petr Pavel\'s interview: because Trump lifted sanctions on Russian diesel, Moscow missed a close chance of a ceasefire and the deal gave the Kremlin "a chance to catch its breath"; he does not call it betrayal but considers it a mistake.',
        [(16567, 'Я ще не знаю, чи можна це назвати зрадою, але я б назвав це помилкою.')])

ext('1021-hubbard-released', [16447])(noop)
ext('1022-lipetsk-moscow-drone-attack', [16391, 16472])(noop)
ext('1021-putin-witkoff-trilateral-talks', [16531, 16481, 16591])(noop)

files = sorted(os.path.basename(p) for p in glob.glob('/workspace/compare-site-v2/tools/days/out/c*.json'))
apply(files)
