@ext('1019-kyiv-ballistic-night', [12195])
def _(c):
    add(c, 'ua', 'В утренней сводке «Общественное» добавляет, что взрывы также звучали в Луцке, Ровно, Кропивницком и Днепре.',
        'У ранковому огляді «Суспільне» додає, що вибухи також лунали в Луцьку, Рівному, Кропивницькому та Дніпрі.',
        'In its morning round-up Suspilne adds that explosions were also heard in Lutsk, Rivne, Kropyvnytskyi and Dnipro.',
        [(12195, 'Вибухи також лунали в Луцьку, Рівному, Кропивницькому та Дніпрі.')])
    for path, old, new in [
        (('diverge',), 'О взрывах в Луцке, Ровно и Днепре в выборке пишут только российские агентства со ссылкой на «Общественное»; украинские источники выборки о западе страны пока не сообщают.',
         'О взрывах в Луцке, Ровно и Днепре российские агентства пишут со ссылкой на «Общественное»; само «Общественное» в утренней сводке подтверждает взрывы в этих городах и называет также Кропивницкий, о котором российские источники выборки не сообщают.'),
        (('uk', 'd'), 'Про вибухи в Луцьку, Рівному і Дніпрі у вибірці пишуть лише російські агентства з посиланням на «Суспільне»; українські джерела вибірки про захід країни поки не повідомляють.',
         'Про вибухи в Луцьку, Рівному і Дніпрі російські агентства пишуть з посиланням на «Суспільне»; саме «Суспільне» в ранковому огляді підтверджує вибухи в цих містах і називає також Кропивницький, про який російські джерела вибірки не повідомляють.'),
        (('en', 'd'), 'Explosions in Lutsk, Rivne and Dnipro are reported in the sample only by Russian agencies citing Suspilne; Ukrainian sources in the sample do not yet report on the west of the country.',
         'Russian agencies report explosions in Lutsk, Rivne and Dnipro citing Suspilne; Suspilne itself confirms explosions in these cities in its morning round-up and also names Kropyvnytskyi, which Russian sources in the sample do not mention.')]:
        rep(c, path, old, new)
    c['uncertainty_reason'] = 'Данные предварительные: о пострадавших при второй атаке известно только из «Общественного», Al Jazeera не разделяет последствия вечерней и ночной атак, о последствиях взрывов в Луцке и Кропивницком в выборке данных нет.'

@ext('1019-kyiv-cruise-missiles-morning', [12151, 12204])
def _(c):
    add(c, 'ru', 'ТАСС также сообщило о взрывах в Киеве на фоне воздушной тревоги.',
        'ТАСС також повідомило про вибухи в Києві на тлі повітряної тривоги.',
        'TASS also reported explosions in Kyiv amid an air-raid alert.',
        [(12151, 'В Киеве произошли взрывы. В городе действует воздушная тревога')])
    add(c, 'ua', 'В другом материале РБК-Украина со ссылкой на журналиста Алекса Рауфоглу и украинские источники пишет, что утром Россия ударила по Киеву баллистикой и Украина снова не получила раннего предупреждения об атаке, которое раньше поступало от США в рамках обмена разведданными; по данным The Washington Post, американская разведка предупреждала, что обмен остановят, если Украина продолжит бить по российским НПЗ.',
        'В іншому матеріалі РБК-Україна з посиланням на журналіста Алекса Рауфоглу та українські джерела пише, що вранці Росія вдарила по Києву балістикою і Україна знову не отримала раннього попередження про атаку, яке раніше надходило від США в межах обміну розвідданими; за даними The Washington Post, американська розвідка попереджала, що обмін зупинять, якщо Україна продовжить бити по російських НПЗ.',
        'In another piece RBC-Ukraine, citing journalist Alex Raufoglu and Ukrainian sources, writes that in the morning Russia struck Kyiv with ballistic missiles and Ukraine again did not receive an early warning of the attack, which used to come from the US as part of intelligence sharing; according to The Washington Post, US intelligence had warned that the sharing would be stopped if Ukraine kept striking Russian refineries.',
        [(12204, 'Уранці 19 жовтня Росія вдарила по Києву балістикою, і Україна знову не отримала раннього попередження про атаку.'),
         (12204, 'Знову не було раннього попередження про балістичну атаку на Київ'),
         (12204, 'американська розвідка попередила посольство України, що обмін даними зупинять, якщо Україна продовжить бити по російських НПЗ')])
    c['diverge'] += ' РБК-Украина в разных материалах называет утреннюю атаку то ударом крылатых ракет, то баллистическим ударом и пишет, что раннего предупреждения от партнеров снова не было; российские источники в выборке об этом не пишут.'
    c['uk']['d'] += ' РБК-Україна в різних матеріалах називає ранкову атаку то ударом крилатих ракет, то балістичним ударом і пише, що раннього попередження від партнерів знову не було; російські джерела у вибірці про це не пишуть.'
    c['en']['d'] += ' In different pieces RBC-Ukraine calls the morning attack either a cruise missile strike or a ballistic strike and writes that there was again no early warning from partners; Russian sources in the sample do not mention this.'
    c['uncertainty_reason'] = 'Данные предварительные: сведений о последствиях и пострадавших нет, РБК-Украина в разных материалах называет разный тип ракет, независимых сообщений нет.'

@ext('1019-peskov-trilateral-meeting', [12196])
def _(c):
    add(c, 'ua', '«Общественное» со ссылкой на WSJ и ее источники пишет, что Путин выдвинул эту идею в телефонном разговоре с Трампом 9 октября, когда договорились о дизельном топливе; американский высокопоставленный чиновник заявил газете, что Трамп согласия на такой саммит не давал, но может отнестись к идее положительно. По данным WSJ, Москва видит в трехстороннем формате способ закрепить статус великой державы, а сам формат исключает Европу, которую Кремль считает главным препятствием на пути к победе в Украине.',
        '«Суспільне» з посиланням на WSJ та її джерела пише, що Путін висунув цю ідею під час телефонної розмови з Трампом 9 жовтня, коли домовилися про дизельне паливо; американський високопосадовець заявив газеті, що Трамп згоди на такий саміт не давав, але може поставитися до ідеї позитивно. За даними WSJ, Москва бачить у тристоронньому форматі спосіб закріпити статус великої держави, а сам формат виключає Європу, яку Кремль вважає головною перешкодою на шляху до перемоги в Україні.',
        'Suspilne, citing the WSJ and its sources, writes that Putin floated the idea in a phone call with Trump on 9 October, when the diesel deal was agreed; a senior US official told the paper that Trump had not agreed to such a summit but might view the idea favourably. According to the WSJ, Moscow sees the three-way format as a way to cement its great-power status, and the format leaves out Europe, which the Kremlin regards as the main obstacle to victory in Ukraine.',
        [(12196, 'Путін висунув цю ідею під час телефонної розмови з Трампом 9 жовтня'),
         (12196, 'американський високопосадовець заявив, що Трамп не давав згоди на такий саміт'),
         (12196, 'Цей формат також виключає з картини Європу, яку Кремль вважає головною перешкодою на шляху до перемоги в Україні')])
    c['diverge'] += ' «Общественное», пересказывая WSJ, добавляет, что идею выдвинул сам Путин в разговоре с Трампом и что Трамп согласия на саммит не давал; в российских сообщениях выборки этих деталей нет.'
    c['uk']['d'] += ' «Суспільне», переказуючи WSJ, додає, що ідею висунув сам Путін у розмові з Трампом і що Трамп згоди на саміт не давав; у російських повідомленнях вибірки цих деталей немає.'
    c['en']['d'] += ' Suspilne, retelling the WSJ, adds that Putin himself floated the idea in his conversation with Trump and that Trump has not agreed to the summit; these details are absent from the Russian reports in the sample.'

@ext('1018-zelensky-bloomberg-capitulation', [12129])
def _(c):
    add(c, 'ru', 'Утром 19 октября РИА привело мнение украинского политолога Руслана Бортника: Зеленскому «нужна стратегия выхода из конфликта», а нагнетать эскалацию резкими заявлениями пора перестать; интервью Bloomberg агентство описывает как жалобу на то, что Вашингтон «якобы» склоняет Украину к капитуляции.',
        'Уранці 19 жовтня РИА навело думку українського політолога Руслана Бортника: Зеленському «потрібна стратегія виходу з конфлікту», а нагнітати ескалацію різкими заявами час припинити; інтерв’ю Bloomberg агентство описує як скаргу на те, що Вашингтон «нібито» схиляє Україну до капітуляції.',
        'On the morning of 19 October RIA quoted Ukrainian political analyst Ruslan Bortnik: Zelensky "needs a strategy for exiting the conflict" and should stop escalating with harsh statements; the agency describes the Bloomberg interview as a complaint that Washington is "allegedly" pushing Ukraine to capitulate.',
        [(12129, 'Зеленскому нужна стратегия выхода из конфликта.'),
         (12129, 'Сам Зеленский в интервью Bloomberg пожаловался, что Вашингтон во главе с Трампом якобы пытается склонить Украину к капитуляции.')])

@ext('1018-us-sanctions-wright-bessent', [12133, 12205])
def _(c):
    # RBC-Ukraine 12205: Reuters / Bayraktar on Turkey getting Russian diesel, same as RBC and Suspilne 11987 already in the card; id only
    add(c, 'ru', 'РИА Новости приводит мнение доцента Университета Южной Флориды Роба Меллена: 30-дневный срок для части мер по сентябрьскому закону о санкциях истек 18 октября, и без решения конгресса администрация, по его словам, вряд ли сможет применить эту норму; агентство напоминает слова Райта о том, что главные американские санкции остаются в силе.',
        'РИА Новости наводить думку доцента Університету Південної Флориди Роба Меллена: 30-денний строк для частини заходів за вересневим законом про санкції сплив 18 жовтня, і без рішення конгресу адміністрація, за його словами, навряд чи зможе застосувати цю норму; агентство нагадує слова Райта про те, що головні американські санкції залишаються в силі.',
        'RIA Novosti quotes Rob Mellen, an associate professor at the University of South Florida: the 30-day deadline for some measures under the September sanctions law expired on 18 October, and without a decision by Congress the administration is unlikely, he says, to be able to apply that provision; the agency recalls Wright\'s words that the main US sanctions remain in force.',
        [(12133, 'Требование о 30 днях означало, что, если президент решил бы действовать после их истечения, это могли бы оспорить в судебном порядке.'),
         (12133, 'Главные американские санкции в отношении России остаются в силе, заявил ранее министр энергетики Крис Райт.')])

