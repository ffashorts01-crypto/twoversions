# ---------------- hourly run 07:03 Oct 19 (ids 12123-12206): 1 new Oct 19 card + extensions ----------------
# Oct 19 drones over Russia (Chelyabinsk, Rostov) and Oct 19 front claims stay Russian-only (SKIPPED.md).

def rep(c, path, old, new):
    o = c
    for p in path[:-1]: o = o[p]
    assert old in o[path[-1]], (c['key'], path, old[:40])
    o[path[-1]] = o[path[-1]].replace(old, new)

card('1019-strikes-regions-rivne-dnipro', [12143, 12179, 12187, 12190, 12192, 12193, 12194],
 'Ночь и утро 19 октября: удары по Ровенщине, Днепру и Николаевщине, есть раненые; Польша поднимала авиацию', 'Ровенская, Днепропетровская, Николаевская, Черкасская области', 'ukraine-wide',
 ['умолчание', 'расхождение: формулировки', 'одна из групп не освещает'],
 S('ТАСС утром 19 октября сообщило о взрыве в Ровно, не приводя подробностей. РИА Новости со ссылкой на Оперативное командование Вооруженных сил Польши пишет, что польская военная авиация превентивно поднята в воздух «в связи с ударами» России беспилотниками по целям на западе Украины; в заголовке агентство называет это «якобы» действиями России, напоминает, что Польша прибегает к таким мерам регулярно, и приводит данные портала NaTemat о дороговизне вылетов истребителей. О целях, последствиях ударов и пострадавших российские источники в выборке не пишут.',
   (12179, 'В Ровно произошел взрыв. Подробности не приводятся'),
   (12143, 'Польские военные подняли в воздух авиацию якобы из-за действий Вооруженных сил России на Украине'),
   (12143, 'В связи с ударами, наносимыми Российской Федерацией с использованием беспилотных средств по целям в западной части Украины'),
   (12143, 'В последние дни Польша прибегает к таким мерам регулярно.')),
 S('«Общественное» со ссылкой на начальника Ровенской ОВА Александра Коваля пишет, что всю ночь на 19 октября ПВО отражала удар по Ровенщине и было «немало сбитий», но противник поразил несколько объектов гражданской инфраструктуры; по предварительным данным, ранены две женщины. По Днепру, по данным главы Днепропетровской ОВА Александра Ганжи и председателя облсовета Николая Лукашука, около 5:00 российская армия ударила управляемыми авиабомбами: повреждены частные дома, в которых могли оказаться заблокированы люди, ранена 84-летняя женщина, ее доставили в больницу; за ночь над областью сбит 21 беспилотник. На Черкасщине, по словам главы ОВА Игоря Табурца, обезврежены ракета и два беспилотника, ударов и пострадавших нет. Николаевская ОВА сообщает об атаках «шахедов» по энергетике области и ракетой «Бандероль» по промышленному объекту в Николаеве, пострадавших нет.',
   (12194, 'Упродовж ночі сили ППО тримають удар по Рівненщині.'),
   (12194, 'За попередньою інформацією, двоє жінок поранені'),
   (12187, 'внаслідок атаки пошкоджені приватні будинки. За попередньою інформацією, у них можуть бути заблоковані люди.'),
   (12187, 'поранення дістала 84-річна жінка. Медики доправили її до лікарні.'),
   (12193, 'Голова Дніпропетровської облради Микола Лукашук підтвердив атаку керованими авіаційними бомбами.'),
   (12192, 'Ударів по області вдалося уникнути. Звернень про потерпілих чи пошкодження майна не надходило'),
   (12190, 'Під ударом була енергетична інфраструктура. Постраждалих немає'),
   (12190, 'Також російські війська атакували Миколаїв ракетою «Бандероль».')),
 None,
 'Российские источники сообщают лишь о взрыве в Ровно и о том, что Польша подняла авиацию из-за ударов российских беспилотников по западу Украины; РИА Новости в заголовке называет это «якобы» действиями России, хотя в тексте приводит формулировку польского командования без оговорок. Украинские источники описывают последствия: попадания в объекты гражданской инфраструктуры и двое раненых на Ровенщине, удар управляемыми авиабомбами по Днепру с раненой 84-летней женщиной, атаки на энергетику Николаевщины. О пострадавших и поврежденных объектах российские источники не пишут; независимых сообщений в выборке нет.',
 'medium', 'Данные предварительные: сведения о раненых и пораженных объектах есть только от украинских региональных властей, российские источники последствий не описывают, независимых сообщений нет.', False,
 ['Ніч і ранок 19 жовтня: удари по Рівненщині, Дніпру та Миколаївщині, є поранені; Польща піднімала авіацію', 'Рівненська, Дніпропетровська, Миколаївська, Черкаська області',
  'Російські джерела повідомляють лише про вибух у Рівному і про те, що Польща підняла авіацію через удари російських безпілотників по заходу України; РИА Новости в заголовку називає це «нібито» діями Росії, хоча в тексті наводить формулювання польського командування без застережень. Українські джерела описують наслідки: влучання в об’єкти цивільної інфраструктури і двоє поранених на Рівненщині, удар керованими авіабомбами по Дніпру з пораненою 84-річною жінкою, атаки на енергетику Миколаївщини. Про постраждалих і пошкоджені об’єкти російські джерела не пишуть; незалежних повідомлень у вибірці немає.',
  'ТАСС уранці 19 жовтня повідомило про вибух у Рівному, не наводячи подробиць. РИА Новости з посиланням на Оперативне командування Збройних сил Польщі пише, що польську військову авіацію превентивно піднято в повітря «у зв’язку з ударами» Росії безпілотниками по цілях на заході України; у заголовку агентство називає це «нібито» діями Росії, нагадує, що Польща вдається до таких заходів регулярно, і наводить дані порталу NaTemat про дорожнечу вильотів винищувачів. Про цілі, наслідки ударів і постраждалих російські джерела у вибірці не пишуть.',
  '«Суспільне» з посиланням на начальника Рівненської ОВА Олександра Коваля пише, що всю ніч на 19 жовтня ППО відбивала удар по Рівненщині і було «чимало збиттів», але противник уразив кілька об’єктів цивільної інфраструктури; за попередньою інформацією, поранено двох жінок. По Дніпру, за даними очільника Дніпропетровської ОВА Олександра Ганжі та голови облради Миколи Лукашука, близько 5:00 російська армія вдарила керованими авіабомбами: пошкоджено приватні будинки, в яких могли опинитися заблоковані люди, поранено 84-річну жінку, її доправили до лікарні; за ніч над областю збито 21 безпілотник. На Черкащині, за словами голови ОВА Ігоря Табурця, знешкоджено ракету і два безпілотники, ударів і постраждалих немає. Миколаївська ОВА повідомляє про атаки «шахедів» по енергетиці області та ракетою «Бандероль» по промисловому об’єкту в Миколаєві, постраждалих немає.',
  None],
 ['Night and morning of 19 October: strikes on the Rivne region, Dnipro and the Mykolaiv region, people injured; Poland scrambled aircraft', 'Rivne, Dnipropetrovsk, Mykolaiv, Cherkasy regions',
  'Russian sources report only an explosion in Rivne and that Poland scrambled aircraft because of Russian drone strikes on western Ukraine; RIA Novosti\'s headline calls these "alleged" Russian actions, although the text quotes the Polish command\'s wording without caveats. Ukrainian sources describe the consequences: hits on civilian infrastructure and two injured in the Rivne region, a guided-bomb strike on Dnipro that injured an 84-year-old woman, attacks on energy facilities in the Mykolaiv region. Russian sources do not write about casualties or damaged facilities; there are no independent reports in the sample.',
  'On the morning of 19 October TASS reported an explosion in Rivne without giving details. RIA Novosti, citing the Operational Command of the Polish Armed Forces, writes that Polish military aircraft were scrambled as a precaution "in connection with strikes" by Russian drones on targets in western Ukraine; in its headline the agency calls these "alleged" Russian actions, notes that Poland resorts to such measures regularly and cites the NaTemat portal on how expensive fighter sorties are. Russian sources in the sample do not write about targets, consequences of the strikes or casualties.',
  'Suspilne, citing the head of the Rivne regional military administration Oleksandr Koval, writes that air defences repelled a strike on the Rivne region throughout the night of 19 October and there were "quite a few shoot-downs", but the enemy hit several civilian infrastructure facilities; according to preliminary information, two women were injured. In Dnipro, according to the head of the Dnipropetrovsk regional military administration Oleksandr Hanzha and regional council chairman Mykola Lukashuk, the Russian army struck with guided aerial bombs at around 5:00: private houses were damaged and people may have been trapped in them, and an 84-year-old woman was injured and taken to hospital; 21 drones were shot down over the region during the night. In the Cherkasy region, according to the head of the regional military administration Ihor Taburets, a missile and two drones were neutralised, with no hits or casualties. The Mykolaiv regional military administration reports Shahed attacks on the region\'s energy facilities and a "Banderol" missile strike on an industrial facility in Mykolaiv, with no casualties.',
  None])

