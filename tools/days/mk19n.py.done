import json, sys
sys.path.insert(0, "/workspace/compare-site-v2/tools/days")
from lib import S, C
OUT = "/workspace/compare-site-v2/tools/days/out/"
cards = []
card = lambda *a: cards.append(C(*a))
# ---------------- backlog run 21-22 Oct (ids 13431-15322), second batch ----------------
card('1019-moldova-protest-note', [13443, 14352, 14068, 14566],
 'Молдавский депутат Карп заявил о ноте протеста Украине из-за пограничников на Днестре; МИД Молдовы отправку ноты опроверг',
 'Голосница, граница Молдовы и Украины', 'moldova-romania',
 ['расхождение: подтверждение', 'умолчание'],
 S('РИА Новости сообщает как факт, что Молдавия направила Украине ноту протеста из-за инцидента с украинскими пограничниками, которые пересекли границу, преследуя мужчину, — со ссылкой на председателя парламентской комиссии по нацбезопасности Лилиана Карпа. По его словам, незаконное пересечение границы гражданином Украины не оправдывает действий пограничников, которые «не укладываются ни в какие этические нормы». Опровержение МИД Молдовы в выборке российских сообщений не приводится.',
   (13443, 'Молдавия направила Украине ноту протеста из-за инцидента с украинскими пограничниками, которые пересекли границу, преследуя мужчину'),
   (13443, 'Насколько мне известно, Министерство иностранных дел направило ноту протеста по поводу этого незаконного пересечения')),
 S('«Украинская правда» со ссылкой на «Европейскую правду» передает заявление Карпа о ноте протеста: украинские пограничники позволили себе пересечь линию госграницы, что он назвал грубым нарушением, хотя, по его словам, с начала вторжения граждане Украины не раз незаконно пересекали границу с Молдовой. На следующий день «Общественное» со ссылкой на издание Timpul сообщило, что МИД Молдовы опроверг эту информацию: нота протеста не направлялась, вопросы обсуждаются по официальным каналам.',
   (14352, 'Ми бачимо спробу українських прикордонників, які, на жаль, дозволили собі перетнути лінію державного кордону, що є грубим порушенням.'),
   (14068, 'в рамках врегулювання цієї ситуації нота протесту не надсилалася')),
 S('The Kyiv Independent пишет, что МИД Молдовы опроверг отправку ноты протеста, вопреки заявлению Карпа, и что вопрос решается по установленным каналам. Издание напоминает обстоятельства: двое украинских пограничников на моторной лодке оказались в Молдове, пытаясь задержать мужчину, переправлявшегося через Днестр у Голосницы; молдавская пограничная полиция их задержала, прокуратура возбудила дело, позже пограничников вернули Украине. По версии Госпогранслужбы Украины, лодку из-за низкого уровня воды и отказа двигателя снесло к молдавскому берегу.',
   (14566, 'Moldova\'s Foreign Ministry denied sending a diplomatic protest to Ukraine'),
   (14566, 'low water levels and an engine failure caused the border')),
 'РИА Новости подает отправку ноты протеста как установленный факт со слов депутата Карпа; опровержение МИД Молдовы, появившееся на следующий день, в российских материалах выборки отсутствует. Украинские и независимые источники сообщают и заявление Карпа, и опровержение МИД. Только независимое издание приводит объяснение украинской погранслужбы о том, что лодку снесло к молдавскому берегу.',
 'low', 'Заявление парламентария и позиция МИД Молдовы противоречат друг другу; текста ноты, если она была, в выборке нет.', True,
 ('Молдовський депутат Карп заявив про ноту протесту Україні через прикордонників на Дністрі; МЗС Молдови надсилання ноти спростувало',
  'Голосниця, кордон Молдови та України',
  'РИА Новости подає надсилання ноти протесту як встановлений факт зі слів депутата Карпа; спростування МЗС Молдови, яке з’явилося наступного дня, у російських матеріалах вибірки відсутнє. Українські та незалежні джерела повідомляють і заяву Карпа, і спростування МЗС. Лише незалежне видання наводить пояснення української прикордонної служби про те, що човен знесло до молдовського берега.',
  'РИА Новости повідомляє як факт, що Молдова надіслала Україні ноту протесту через інцидент з українськими прикордонниками, які перетнули кордон, переслідуючи чоловіка, — з посиланням на голову парламентської комісії з нацбезпеки Ліліана Карпа. За його словами, незаконний перетин кордону громадянином України не виправдовує дій прикордонників, які «не вкладаються в жодні етичні норми». Спростування МЗС Молдови у вибірці російських повідомлень не наводиться.',
  '«Українська правда» з посиланням на «Європейську правду» передає заяву Карпа про ноту протесту: українські прикордонники дозволили собі перетнути лінію держкордону, що він назвав грубим порушенням, хоча, за його словами, від початку вторгнення громадяни України не раз незаконно перетинали кордон із Молдовою. Наступного дня «Суспільне» з посиланням на видання Timpul повідомило, що МЗС Молдови спростувало цю інформацію: нота протесту не надсилалася, питання обговорюються офіційними каналами.',
  'The Kyiv Independent пише, що МЗС Молдови спростувало надсилання ноти протесту, всупереч заяві Карпа, і що питання вирішується встановленими каналами. Видання нагадує обставини: двоє українських прикордонників на моторному човні опинилися в Молдові, намагаючись затримати чоловіка, який переправлявся через Дністер біля Голосниці; молдовська прикордонна поліція їх затримала, прокуратура порушила справу, згодом прикордонників повернули Україні. За версією Держприкордонслужби України, човен через низький рівень води та відмову двигуна знесло до молдовського берега.'),
 ('Moldovan MP Carp says a protest note was sent to Ukraine over border guards on the Dniester; Moldova\'s Foreign Ministry denies sending it',
  'Holosnita, Moldova–Ukraine border',
  'RIA Novosti presents the sending of a protest note as an established fact on the word of MP Carp; the Moldovan Foreign Ministry\'s denial, which came the next day, is absent from the Russian reports in the sample. Ukrainian and independent sources report both Carp\'s statement and the ministry\'s denial. Only the independent outlet gives the Ukrainian border service\'s explanation that the boat drifted to the Moldovan bank.',
  'RIA Novosti reports as fact that Moldova sent Ukraine a protest note over an incident in which Ukrainian border guards crossed the border while pursuing a man, citing Lilian Carp, chair of the parliamentary national security committee. In his words, the illegal border crossing by a Ukrainian citizen does not justify the actions of the border guards, which "do not fit any ethical norms". The Moldovan Foreign Ministry\'s denial is not given in the Russian reports in the sample.',
  'Ukrainska Pravda, citing Yevropeiska Pravda, relays Carp\'s statement about the protest note: the Ukrainian border guards allowed themselves to cross the state border line, which he called a gross violation, although, he said, Ukrainian citizens have repeatedly crossed into Moldova illegally since the start of the invasion. The next day Suspilne, citing the outlet Timpul, reported that Moldova\'s Foreign Ministry had denied this: no protest note was sent, and the issues are being discussed through official channels.',
  'The Kyiv Independent writes that Moldova\'s Foreign Ministry denied sending a protest note, contradicting Carp, and that the matter is being handled through established channels. The outlet recalls the circumstances: two Ukrainian border guards in a motorboat ended up in Moldova while trying to detain a man crossing the Dniester near Holosnita; Moldovan border police detained them, prosecutors opened a case, and the guards were later returned to Ukraine. According to Ukraine\'s State Border Guard Service, low water and an engine failure caused the boat to drift to the Moldovan bank.'))

card('1019-trump-zelensky-someone-else-negotiate', [13450, 14827, 14825, 14363, 14563],
 'Трамп: Зеленскому, возможно, пора поручить переговоры кому-то другому, а Россия «ведет себя нормально» в вопросе Украины',
 'Вашингтон', 'ukraine-wide',
 ['расхождение: формулировки', 'умолчание'],
 S('РИА Новости пишет, что Трамп обвинил Зеленского, которого агентство называет «главой киевского режима», в нежелании завершить конфликт и предложил ему искать более сговорчивого представителя: «Возможно, Зеленскому пора поручить ведение переговоров кому-то другому». По словам Трампа в изложении агентства, Зеленский давно мог бы заключить мир на выгодных условиях, если бы прислушивался к нему; Трамп «признал», что Вашингтон делится с Киевом разведданными, ничего не получая взамен, а Россия, по его мнению, справедливо относится к Украине, как и Китай. Трамп также хотел бы обсудить конфликт с Си Цзиньпином и провести трехстороннюю встречу с ним и Путиным.',
   (13450, 'Возможно, Зеленскому пора поручить ведение переговоров кому-то другому'),
   (13450, 'Трамп признал, что Вашингтон делится с Киевом разведданными, не получая ничего взамен.'),
   (13450, 'Россия же, как считает глава Белого дома, справедливо относится к Украине.')),
 S('РБК-Украина и «Украинская правда» приводят слова Трампа журналистам: если бы Зеленский его послушал, он давно заключил бы гораздо лучшую сделку, и теперь, возможно, «пришло время кому-то другому вести переговоры от имени Украины»; по мнению Трампа, Зеленский не хочет останавливать войну. Отдельно РБК-Украина выносит в заголовок его слова о том, что Россия, «откровенно говоря, ведет себя вполне нормально в вопросе Украины» и «не так много делает»; трехстороннюю встречу с Путиным, которого издание называет диктатором, и Си Трамп провел бы не столько ради Украины, сколько ради обсуждения ядерного оружия. «Украинская правда» добавляет его оценку: Си и Россия были в отношении Украины «очень справедливы».',
   (14827, 'настав час комусь іншому вести переговори від імені України'),
   (14825, 'Росія, відверто кажучи, поводиться цілком нормально в питанні України'),
   (14363, 'Можливо, Зеленському пора доручити переговори комусь іншому')),
 S('The Kyiv Independent выносит в заголовок слова Трампа о том, что Россия «ведет себя нормально» в отношении Украины и «не так уж много делает», и сопоставляет их с событиями того же дня: удар российского дрона по парку убил шесть человек, в том числе двоих детей, а накануне Россия атаковала Киев баллистическими ракетами и почти три десятка энергообъектов. По словам издания, Трамп ничего об этом не сказал и похвалил Путина за сдержанность; главной целью возможной встречи с Путиным и Си он назвал ядерное разоружение.',
   (14563, 'Russia, frankly, has been fine on Ukraine.'),
   (14563, 'a Russian daytime drone strike in a public park killed six people, including two children')),
 'Слова Трампа все стороны передают близко к оригиналу, но по-разному их расставляют. РИА Новости передает оценку отношения России к Украине как «справедливое» и выносит на первый план призыв сменить переговорщика и «признание» о разведданных. Украинские источники подчеркивают фразу о том, что Россия «ведет себя нормально», и разбирают слова о Зеленском. Независимое издание прямо противопоставляет слова Трампа удару по парку в Новой Водолаге и ночной атаке на Киев; в российском материале выборки эти события не упоминаются.',
 'low', '', False,
 ('Трамп: Зеленському, можливо, час доручити переговори комусь іншому, а Росія «поводиться нормально» в питанні України',
  'Вашингтон',
  'Слова Трампа всі сторони передають близько до оригіналу, але по-різному розставляють акценти. РИА Новости передає оцінку ставлення Росії до України як «справедливе» і висуває на перший план заклик змінити переговорника та «визнання» щодо розвідданих. Українські джерела підкреслюють фразу про те, що Росія «поводиться нормально», і розбирають слова про Зеленського. Незалежне видання прямо протиставляє слова Трампа удару по парку в Новій Водолазі та нічній атаці на Київ; у російському матеріалі вибірки ці події не згадуються.',
  'РИА Новости пише, що Трамп звинуватив Зеленського, якого агентство називає «главою київського режиму», у небажанні завершити конфлікт і запропонував йому шукати поступливішого представника: «Можливо, Зеленському час доручити ведення переговорів комусь іншому». За словами Трампа в переказі агентства, Зеленський давно міг би укласти мир на вигідних умовах, якби прислухався до нього; Трамп «визнав», що Вашингтон ділиться з Києвом розвідданими, нічого не отримуючи навзамін, а Росія, на його думку, справедливо ставиться до України, як і Китай. Трамп також хотів би обговорити конфлікт із Сі Цзіньпіном і провести тристоронню зустріч із ним і Путіним.',
  'РБК-Україна і «Українська правда» наводять слова Трампа журналістам: якби Зеленський його послухав, він давно уклав би набагато кращу угоду, і тепер, можливо, «настав час комусь іншому вести переговори від імені України»; на думку Трампа, Зеленський не хоче зупиняти війну. Окремо РБК-Україна виносить у заголовок його слова про те, що Росія, «відверто кажучи, поводиться цілком нормально в питанні України» і «не так багато робить»; тристоронню зустріч із Путіним, якого видання називає диктатором, і Сі Трамп провів би не стільки заради України, скільки для обговорення ядерної зброї. «Українська правда» додає його оцінку: Сі та Росія були щодо України «дуже справедливими».',
  'The Kyiv Independent виносить у заголовок слова Трампа про те, що Росія «поводиться нормально» щодо України і «не так уже й багато робить», і зіставляє їх із подіями того ж дня: удар російського дрона по парку вбив шістьох людей, зокрема двох дітей, а напередодні Росія атакувала Київ балістичними ракетами і майже три десятки енергооб’єктів. За словами видання, Трамп нічого про це не сказав і похвалив Путіна за стриманість; головною метою можливої зустрічі з Путіним і Сі він назвав ядерне роззброєння.'),
 ('Trump: maybe it is time for Zelensky to let someone else negotiate, and Russia "has been fine" on Ukraine',
  'Washington',
  'All sides relay Trump\'s words close to the original but place the emphasis differently. RIA Novosti renders his view of Russia\'s attitude to Ukraine as "fair" and foregrounds the call to change the negotiator and the "admission" about intelligence. Ukrainian sources highlight the phrase that Russia "has been fine" and dissect the words about Zelensky. The independent outlet directly contrasts Trump\'s words with the strike on the park in Nova Vodolaha and the night attack on Kyiv; these events are not mentioned in the Russian report in the sample.',
  'RIA Novosti writes that Trump accused Zelensky, whom the agency calls "the head of the Kyiv regime", of being unwilling to end the conflict and suggested he look for a more accommodating representative: "Maybe it is time for Zelensky to entrust the negotiations to someone else." According to Trump as relayed by the agency, Zelensky could long ago have made peace on favourable terms had he listened to him; Trump "admitted" that Washington shares intelligence with Kyiv without getting anything in return, while Russia, in his view, treats Ukraine fairly, as does China. Trump would also like to discuss the conflict with Xi Jinping and hold a trilateral meeting with him and Putin.',
  'RBC-Ukraine and Ukrainska Pravda quote Trump telling reporters that had Zelensky listened to him, he would long ago have made a much better deal, and that now perhaps "it is time for someone else to negotiate on behalf of Ukraine"; in Trump\'s view, Zelensky does not want to stop the war. Separately, RBC-Ukraine headlines his words that Russia, "frankly, has been behaving quite normally on Ukraine" and "is not doing that much"; Trump would hold a trilateral meeting with Putin, whom the outlet calls a dictator, and Xi not so much for Ukraine\'s sake as to discuss nuclear weapons. Ukrainska Pravda adds his assessment that Xi and Russia have been "very fair" towards Ukraine.',
  'The Kyiv Independent headlines Trump\'s words that Russia "has been fine" on Ukraine and "hasn\'t been doing much", and sets them against the events of the same day: a Russian drone strike on a park killed six people, including two children, and the night before Russia attacked Kyiv with ballistic missiles and nearly thirty energy facilities. According to the outlet, Trump said nothing about this and praised Putin for his restraint; he named nuclear disarmament as the main purpose of a possible meeting with Putin and Xi.'))

json.dump(cards, open(OUT + 'c19l.json', 'w'), ensure_ascii=False, indent=1)
print('c19l', len(cards))
