# ---------------- hourly run 22 Oct 08:03: new cards (Oct 22 new ids, backlog Oct 19/20/21) ----------------
c22 = []
c22.append(C('1022-mod-massive-strike-vpk-energy', [15933, 15870, 15900, 15981, 15916, 15973, 15954, 15942, 15959],
 'Минобороны РФ: массированный удар по предприятиям ВПК, транспорту в Киеве и портам Одесской области; Сибига — удар по энергетике, больницам и жилью',
 'Киев, Винницкая и Полтавская области, Одесская область', 'ukraine-wide',
 ['расхождение: характер объектов', 'не проверено', 'одна из групп не освещает'],
 S("Минобороны России сообщило, что ночью армия нанесла массированный удар высокоточным оружием наземного базирования и беспилотниками: поражены предприятия ВПК Украины, задействованные в производстве и хранении крылатых ракет и дронов большой и средней дальности, объекты транспортной инфраструктуры в Киеве, портовой инфраструктуры в Одесской области и морские суда, «используемые в интересах ВСУ». РИА Новости, ТАСС и «Интерфакс» передают сводку без сведений о пострадавших; РИА Новости добавляет привычную формулировку о том, что удары наносятся для снижения военно-экономического потенциала противника. ТАСС со ссылкой на главу Винницкой ОВА Наталью Заболотную сообщает о повреждении промышленных и энергетических объектов в области.",
   (15981, 'Поражены предприятия военно-промышленного комплекса Украины, задействованные в производстве и хранении крылатых ракет и беспилотных летательных аппаратов большой и средней дальности, объекты транспортной инфраструктуры в Киеве'),
   (15870, 'ВС России бьют по инфраструктуре и логистике для снижения военно-экономического потенциала противника'),
   (15916, 'В Винницкой области повреждены промышленные и энергетические объекты')),
 S("РБК-Украина приводит заявление министра иностранных дел Андрея Сибиги, который отсылает к словам Уиткоффа, назвавшего Путина «гуманистом»: этой ночью киевляне, по его словам, услышали, как на самом деле звучит российский «гуманизм» — жестокую атаку десятками баллистических ракет по энергетической инфраструктуре, медучреждениям, торговым центрам и жилым районам; под ударом были и другие города, а мир, по словам министра, принесет только сила. «Общественное» и «Украинская правда» со ссылкой на Заболотную пишут, что в Винницкой области повреждены промышленные объекты, энергетика и частные дома, пострадавших нет. В Кременчуге, по словам главы Полтавской ОВА Виталия Дякивнича, беспилотник попал в здание частной телерадиокомпании среди жилой застройки, начался пожар; еще один дрон попал в энергообъект в Кременчугском районе, пострадавших, по предварительным данным, нет.",
   (15973, 'жорстока атака із застосуванням десятків балістичних ракет, спрямована на енергетичну інфраструктуру, медичні заклади, торговельні центри та житлові райони'),
   (15973, 'Лише сила принесе мир'),
   (15959, "На Вінниччині російська атака пошкодила промислові об'єкти, енергетичну інфраструктуру та приватні домоволодіння."),
   (15942, 'Унаслідок влучання БпЛА вночі 22 жовтня у будівлю приватної телерадіокомпанії виникла пожежа.')),
 None,
 "Минобороны России называет целями предприятия ВПК, транспортную инфраструктуру Киева, порты Одесской области и суда; украинская сторона говорит об ударах по энергетике, медучреждениям, торговым центрам, жилым районам и частной телерадиокомпании. Российские агентства о погибших и раненых не сообщают (о них — в карточке о вечернем и ночном ударах по Киеву), украинские источники не комментируют названные Минобороны цели, а о портах Одесской области и судах в украинских сообщениях подборки нет. Независимые источники в подборке заявление Минобороны не проверяли.",
 'medium', 'Цели удара названы только Минобороны России, украинская сторона описывает другие объекты; независимой проверки нет.', False,
 ('Міноборони РФ: масований удар по підприємствах ВПК, транспорту в Києві та портах Одеської області; Сибіга — удар по енергетиці, лікарнях і житлу',
  'Київ, Вінницька й Полтавська області, Одеська область',
  'Міноборони Росії називає цілями підприємства ВПК, транспортну інфраструктуру Києва, порти Одеської області та судна; українська сторона говорить про удари по енергетиці, медзакладах, торговельних центрах, житлових районах і приватній телерадіокомпанії. Російські агентства про загиблих і поранених не повідомляють (про них — у картці про вечірній і нічний удари по Києву), українські джерела не коментують названих Міноборони цілей, а про порти Одеської області та судна в українських повідомленнях добірки немає. Незалежні джерела в добірці заяву Міноборони не перевіряли.',
  'Міноборони Росії повідомило, що вночі армія завдала масованого удару високоточною зброєю наземного базування та безпілотниками: уражено підприємства ВПК України, задіяні у виробництві та зберіганні крилатих ракет і дронів великої та середньої дальності, об’єкти транспортної інфраструктури в Києві, портової інфраструктури в Одеській області та морські судна, «що використовуються в інтересах ЗСУ». РИА Новости, ТАСС та «Інтерфакс» передають зведення без відомостей про постраждалих; РИА Новости додає звичне формулювання про те, що удари завдаються для зниження військово-економічного потенціалу противника. ТАСС із посиланням на очільницю Вінницької ОВА Наталю Заболотну повідомляє про пошкодження промислових та енергетичних об’єктів в області.',
  'РБК-Україна наводить заяву міністра закордонних справ Андрія Сибіги, який відсилає до слів Віткоффа, що назвав Путіна «гуманістом»: цієї ночі кияни, за його словами, почули, як насправді звучить російський «гуманізм» — жорстоку атаку десятками балістичних ракет по енергетичній інфраструктурі, медзакладах, торговельних центрах і житлових районах; під ударом були й інші міста, а мир, за словами міністра, принесе лише сила. «Суспільне» та «Українська правда» з посиланням на Заболотну пишуть, що на Вінниччині пошкоджено промислові об’єкти, енергетику та приватні будинки, постраждалих немає. У Кременчуці, за словами очільника Полтавської ОВА Віталія Дяківнича, безпілотник влучив у будівлю приватної телерадіокомпанії серед житлової забудови, виникла пожежа; ще один дрон влучив в енергооб’єкт у Кременчуцькому районі, постраждалих, за попередніми даними, немає.',
  None),
 ('Russian MoD: massive strike on defence industry plants, transport in Kyiv and ports in Odesa region; Sybiha: strike on energy, hospitals and homes',
  'Kyiv, Vinnytsia and Poltava regions, Odesa region',
  'The Russian Defence Ministry names defence industry plants, Kyiv\'s transport infrastructure, ports in Odesa region and ships as the targets; the Ukrainian side speaks of strikes on energy, medical facilities, shopping centres, residential areas and a private TV and radio company. Russian agencies do not report the dead and injured (they are covered in the card on the evening and night strikes on Kyiv), Ukrainian sources do not comment on the targets named by the MoD, and Ukrainian reports in the selection say nothing about ports in Odesa region or ships. Independent sources in the selection have not checked the MoD statement.',
  'The Russian Defence Ministry said the army carried out a massive overnight strike with high-precision ground-based weapons and drones, hitting Ukrainian defence industry plants involved in producing and storing cruise missiles and long- and medium-range drones, transport infrastructure in Kyiv, port infrastructure in Odesa region and sea vessels "used in the interests of the Ukrainian armed forces". RIA Novosti, TASS and Interfax relay the summary without information on casualties; RIA Novosti adds the usual line that the strikes aim to reduce the enemy\'s military and economic potential. TASS, citing the head of the Vinnytsia regional administration Nataliia Zabolotna, reports damage to industrial and energy facilities in the region.',
  'RBC-Ukraine quotes Foreign Minister Andrii Sybiha, who alludes to Witkoff calling Putin a "humanist": tonight, he says, Kyiv residents heard what Russian "humanism" really sounds like, a brutal attack with dozens of ballistic missiles aimed at energy infrastructure, medical facilities, shopping centres and residential areas; other cities were also hit, and only strength, the minister says, will bring peace. Suspilne and Ukrainska Pravda, citing Zabolotna, write that industrial facilities, energy infrastructure and private houses were damaged in Vinnytsia region, with no one hurt. In Kremenchuk, according to the head of the Poltava regional administration Vitalii Diakivnych, a drone hit the building of a private TV and radio company among residential buildings, causing a fire; another drone hit an energy facility in Kremenchuk district, with no one hurt according to preliminary information.',
  None)))
json.dump(c22, open(OUT + 'c22b.json', 'w'), ensure_ascii=False, indent=1)
print('c22b', len(c22))

c21 = []
c21.append(C('1021-kremlin-trilateral-summit-china', [13827, 15231, 15235, 13559, 13955, 14465, 15041, 14753, 15977, 15868],
 'Кремль: Китай готовит встречу Путина, Трампа и Си на саммите АТЭС; Трамп — речь о денуклеаризации, DW — формат без Украины и ЕС',
 'Москва, Вашингтон', 'ukraine-wide',
 ['расхождение: формулировки', 'умолчание'],
 S("Помощник президента Юрий Ушаков в интервью «Вестям» сказал, что встреча Путина, Трампа и Си Цзиньпина интересна всем и будет «в какой-то мере исторической»: впервые встретятся лидеры трех таких крупных стран, а многое зависит от китайских хозяев саммита АТЭС. Песков, по данным «Интерфакса», говорит о «гипотетической готовности» трех сторон, но четкой повестки нет: американцы хотят говорить о ядерном разоружении, китайцы — нет; сравнение с Ялтинской конференцией он назвал неуместным. Путин на встрече с премьером Госсовета КНР Ли Цяном упомянул возможность увидеться с Си на саммите АТЭС в Шэньчжэне. Позже «Интерфакс» и РИА Новости передают слова Трампа: встреча должна быть посвящена в том числе денуклеаризации, тема украинского урегулирования тоже будет затронута.",
   (13827, 'It will probably be a historic meeting to some extent.'),
   (15235, 'С трёх сторон есть такая гипотетическая готовность такую встречу провести'),
   (15235, 'Вы знаете, что американцы хотят говорить по ядерному разоружению, но этого не хотят китайцы.'),
   (15231, 'Такое сравнение совсем не уместно'),
   (15977, 'Речь идет о денуклеаризации.')),
 S("«Украинская правда» со ссылкой на «Европейскую правду» и «Интерфакс» передает слова Ушакова о том, что Китай «уже готовит» встречу лидеров России, США и КНР и при благоприятном стечении обстоятельств включит ее в программу саммита АТЭС в Шэньчжэне; эту возможность обсуждали на встрече Путина с Уиткоффом. РБК-Украина выносит в заголовок другое: Кремль не верит в быстрый мир — по словам Ушакова, за один раунд весь комплекс проблем вокруг Украины не решить, сколько бы ни длилась встреча. Издания называют Путина «правителем» и «диктатором».",
   (14465, 'Китайські друзі, господарі саміту АТЕС, займуться, або, точніше, вже займаються її (тристоронньої зустрічі – ред.) підготовкою.'),
   (15041, 'все одно всі проблеми не вирішити')),
 S("DW разбирает, чего Китай хочет от такой встречи: по данным WSJ, Москва предложила трехсторонний саммит на полях АТЭС 18–19 ноября в Шэньчжэне — без Украины и ЕС, а Путин рассчитывает договориться с Трампом и Си о завершении войны на выгодных России условиях и видит в нем возможную «новую Ялту». Такой формат, по оценке DW, показывает, какие переговоры предпочел бы Кремль; Пекин, по данным газеты, не стал бы возражать.",
   (14753, 'offers a glimpse of the negotiating format the Kremlin would prefer'),
   (14753, 'Putin hopes to reach an agreement with Trump and Xi on ending the war in Ukraine on terms favorable to Russia')),
 "Российская сторона подает возможную встречу как историческую и интересную всем, отвергает сравнение с Ялтой и признает разногласия о повестке; Трамп в передаче российских агентств говорит о денуклеаризации и об Украине. Украинские издания подчеркивают слова Ушакова о том, что такая встреча не решит украинский вопрос, и называют Путина диктатором. DW со ссылкой на WSJ пишет, что формат без Украины и ЕС выгоден Кремлю и что Путин видит во встрече «новую Ялту» — именно это сравнение Кремль называет неуместным.",
 'low', 'Сообщения основаны на публичных заявлениях Ушакова, Пескова и Трампа; сведения WSJ о намерениях Путина и позиции Пекина официально не подтверждены.', False,
 ('Кремль: Китай готує зустріч Путіна, Трампа і Сі на саміті АТЕС; Трамп — йдеться про денуклеаризацію, DW — формат без України та ЄС',
  'Москва, Вашингтон',
  'Російська сторона подає можливу зустріч як історичну й цікаву всім, відкидає порівняння з Ялтою та визнає розбіжності щодо порядку денного; Трамп у переказі російських агентств говорить про денуклеаризацію та про Україну. Українські видання наголошують на словах Ушакова про те, що така зустріч не розв’яже українського питання, і називають Путіна диктатором. DW із посиланням на WSJ пише, що формат без України та ЄС вигідний Кремлю і що Путін бачить у зустрічі «нову Ялту» — саме це порівняння Кремль називає недоречним.',
  'Помічник президента Юрій Ушаков в інтерв’ю «Вєстям» сказав, що зустріч Путіна, Трампа і Сі Цзіньпіна цікава всім і буде «певною мірою історичною»: уперше зустрінуться лідери трьох таких великих країн, а багато що залежить від китайських господарів саміту АТЕС. Пєсков, за даними «Інтерфаксу», говорить про «гіпотетичну готовність» трьох сторін, але чіткого порядку денного немає: американці хочуть говорити про ядерне роззброєння, китайці — ні; порівняння з Ялтинською конференцією він назвав недоречним. Путін на зустрічі з прем’єром Держради КНР Лі Цяном згадав про можливість побачитися із Сі на саміті АТЕС у Шеньчжені. Пізніше «Інтерфакс» і РИА Новости передають слова Трампа: зустріч має бути присвячена зокрема денуклеаризації, тему українського врегулювання теж буде порушено.',
  '«Українська правда» з посиланням на «Європейську правду» та «Интерфакс» передає слова Ушакова про те, що Китай «уже готує» зустріч лідерів Росії, США та КНР і за сприятливого збігу обставин включить її до програми саміту АТЕС у Шеньчжені; цю можливість обговорювали на зустрічі Путіна з Віткоффом. РБК-Україна виносить у заголовок інше: Кремль не вірить у швидкий мир — за словами Ушакова, за один раунд увесь комплекс проблем навколо України не розв’язати, хоч скільки тривала б зустріч. Видання називають Путіна «правителем» і «диктатором».',
  'DW розбирає, чого Китай хоче від такої зустрічі: за даними WSJ, Москва запропонувала тристоронній саміт на полях АТЕС 18–19 листопада в Шеньчжені — без України та ЄС, а Путін розраховує домовитися з Трампом і Сі про завершення війни на вигідних Росії умовах і бачить у ньому можливу «нову Ялту». Такий формат, за оцінкою DW, показує, яким переговорам віддав би перевагу Кремль; Пекін, за даними газети, не заперечував би.'),
 ('Kremlin: China is preparing a Putin–Trump–Xi meeting at the APEC summit; Trump says it is about denuclearisation, DW notes a format without Ukraine and the EU',
  'Moscow, Washington',
  'The Russian side presents the possible meeting as historic and of interest to everyone, rejects the comparison with Yalta and acknowledges disagreements over the agenda; Trump, as relayed by Russian agencies, speaks of denuclearisation and Ukraine. Ukrainian outlets highlight Ushakov\'s words that such a meeting will not resolve the Ukrainian question and call Putin a dictator. DW, citing the WSJ, writes that a format without Ukraine and the EU suits the Kremlin and that Putin sees the meeting as a "new Yalta", the very comparison the Kremlin calls inappropriate.',
  'Presidential aide Yury Ushakov told Vesti that a meeting of Putin, Trump and Xi Jinping is of interest to everyone and will be "historic to some extent": the leaders of three such large countries will meet for the first time, and much depends on the Chinese hosts of the APEC summit. Peskov, according to Interfax, speaks of a "hypothetical readiness" of the three sides but says there is no clear agenda: the Americans want to talk about nuclear disarmament, the Chinese do not; he called the comparison with the Yalta Conference inappropriate. Meeting Chinese Premier Li Qiang, Putin mentioned the chance to see Xi at the APEC summit in Shenzhen. Later Interfax and RIA Novosti relay Trump\'s words: the meeting should be devoted, among other things, to denuclearisation, and the Ukrainian settlement will also be discussed.',
  'Ukrainska Pravda, citing Yevropeiska Pravda and Interfax, relays Ushakov\'s words that China is "already preparing" a meeting of the leaders of Russia, the US and China and, if circumstances are favourable, will include it in the programme of the APEC summit in Shenzhen; the possibility was discussed at Putin\'s meeting with Witkoff. RBC-Ukraine headlines something else: the Kremlin does not believe in a quick peace, since according to Ushakov the whole set of problems around Ukraine cannot be solved in one round, however long the meeting lasts. The outlets call Putin a "ruler" and a "dictator".',
  'DW examines what China wants from such a meeting: according to the WSJ, Moscow proposed a three-way summit on the sidelines of APEC on 18–19 November in Shenzhen, without Ukraine and the EU, and Putin hopes to agree with Trump and Xi on ending the war on terms favourable to Russia and sees it as a possible "new Yalta". Such a format, in DW\'s view, shows what kind of negotiations the Kremlin would prefer; Beijing, according to the paper, would not object.')))
json.dump(c21, open(OUT + 'c21b.json', 'w'), ensure_ascii=False, indent=1)
print('c21b', len(c21))

c19 = []
c19.append(C('1019-pope-zelensky-call-oleshky', [13455, 14359, 14821, 14562],
 'Папа Лев XIV после разговора с Путиным позвонил Зеленскому: надежда на помощь и добровольную эвакуацию жителей Алешек',
 'Ватикан, Киев', 'kherson',
 ['расхождение: формулировки', 'умолчание'],
 S("РИА Новости со ссылкой на пресс-службу Святого престола сообщает, что Папа Лев XIV в телефонном разговоре с Владимиром Зеленским обратил внимание на тяжелую ситуацию в Алешках и выразил надежду, что сотрудничество обеих сторон позволит доставить жителям продовольствие и медикаменты и обеспечить их добровольную и безопасную эвакуацию. Агентство напоминает, что в разговоре с понтификом 16 октября Путин дал «исчерпывающие разъяснения» об ответственности Киева, и называет Алешки российским городом.",
   (13455, 'Папа Римский выразил надежду, что сотрудничество обеих сторон (России и Украины - ред.) позволит доставить населению продовольственную и медицинскую помощь, а также обеспечить добровольную и безопасную эвакуацию мирных жителей')),
 S("«Украинская правда» и РБК-Украина со ссылкой на Святой престол пишут, что разговор состоялся через несколько дней после звонка Папы Путину и что понтифик напомнил о своей просьбе о «гуманитарном прекращении огня» в оккупированных Олешках. Зеленский, по его словам, подробно рассказал Папе о российской эскалации и постоянных ударах по украинским городам. РБК-Украина в цитате Ватикана добавляет к имени Путина редакционную пометку «диктатор».",
   (14359, 'Папа Римський поспілкувався з Зеленським щодо ситуації в тимчасово окупованому місті Олешки, що в Херсонській області.'),
   (14821, 'Під час бесіди Святіший Отець звернув увагу на важку ситуацію в місті Олешки Херсонської області')),
 S("The Kyiv Independent приводит слова Зеленского: Украина работает над тем, чтобы помочь людям в городе, и готовит решения, а Папа рассказал о своих контактах с российской стороной. Издание напоминает, что в городе без достаточных запасов еды и лекарств остаются около двух тысяч жителей, что стороны, по словам Лубинца, близки к соглашению об эвакуации, но окончательной договоренности публично не объявлено и неясно, насколько на нее повлиял Папа.",
   (14562, 'We are working to help our people there and are preparing solutions'),
   (14562, 'No final agreement has been publicly announced, and it remains unclear when an evacuation could begin.')),
 "Все три группы передают сообщение Ватикана о надежде на доставку помощи и эвакуацию. РИА Новости дополняет его версией Кремля об ответственности Киева и называет Алешки российским городом; украинские издания подчеркивают, что город оккупирован, и приводят слова Зеленского о российских ударах. The Kyiv Independent отмечает, что окончательной договоренности об эвакуации нет.",
 'low', 'Сообщения основаны на заявлении Святого престола и словах Зеленского; о ходе переговоров об эвакуации официальных подробностей нет.', False,
 ('Папа Лев XIV після розмови з Путіним зателефонував Зеленському: надія на допомогу й добровільну евакуацію мешканців Олешок',
  'Ватикан, Київ',
  'Усі три групи передають повідомлення Ватикану про надію на доставку допомоги та евакуацію. РИА Новости доповнює його версією Кремля про відповідальність Києва і називає Олешки російським містом; українські видання наголошують, що місто окуповане, і наводять слова Зеленського про російські удари. The Kyiv Independent зазначає, що остаточної домовленості про евакуацію немає.',
  'РИА Новости з посиланням на пресслужбу Святого Престолу повідомляє, що Папа Лев XIV у телефонній розмові з Володимиром Зеленським звернув увагу на важку ситуацію в Олешках і висловив надію, що співпраця обох сторін дасть змогу доставити мешканцям продовольство й медикаменти та забезпечити їхню добровільну й безпечну евакуацію. Агентство нагадує, що в розмові з понтифіком 16 жовтня Путін дав «вичерпні роз’яснення» щодо відповідальності Києва, і називає Олешки російським містом.',
  '«Українська правда» і РБК-Україна з посиланням на Святий Престол пишуть, що розмова відбулася через кілька днів після дзвінка Папи Путіну і що понтифік нагадав про своє прохання про «гуманітарне припинення вогню» в окупованих Олешках. Зеленський, за його словами, детально розповів Папі про російську ескалацію та постійні удари по українських містах. РБК-Україна в цитаті Ватикану додає до імені Путіна редакційну позначку «диктатор».',
  'The Kyiv Independent наводить слова Зеленського: Україна працює над тим, щоб допомогти людям у місті, і готує рішення, а Папа розповів про свої контакти з російською стороною. Видання нагадує, що в місті без достатніх запасів їжі та ліків залишаються близько двох тисяч мешканців, що сторони, за словами Лубінця, близькі до угоди про евакуацію, але остаточної домовленості публічно не оголошено й незрозуміло, наскільки на неї вплинув Папа.'),
 ('After his call with Putin, Pope Leo XIV phoned Zelensky: hopes for aid and a voluntary evacuation of Oleshky residents',
  'Vatican, Kyiv',
  'All three groups relay the Vatican\'s statement on hopes for aid deliveries and an evacuation. RIA Novosti adds the Kremlin\'s version blaming Kyiv and calls Oleshky a Russian town; Ukrainian outlets stress that the town is occupied and quote Zelensky on Russian strikes. The Kyiv Independent notes that there is no final agreement on an evacuation.',
  'RIA Novosti, citing the Holy See press office, reports that in a phone call with Volodymyr Zelensky Pope Leo XIV drew attention to the difficult situation in Oleshky and expressed hope that cooperation between the two sides would make it possible to deliver food and medicine to residents and ensure their voluntary and safe evacuation. The agency recalls that in his conversation with the pontiff on 16 October Putin gave "exhaustive explanations" of Kyiv\'s responsibility, and calls Oleshky a Russian town.',
  'Ukrainska Pravda and RBC-Ukraine, citing the Holy See, write that the call took place a few days after the Pope\'s call with Putin and that the pontiff recalled his request for a "humanitarian ceasefire" in occupied Oleshky. Zelensky said he told the Pope in detail about Russian escalation and constant strikes on Ukrainian cities. In the Vatican quote RBC-Ukraine adds the editorial note "dictator" to Putin\'s name.',
  'The Kyiv Independent quotes Zelensky: Ukraine is working to help the people in the town and is preparing solutions, and the Pope told him about his contacts with the Russian side. The outlet recalls that about two thousand residents remain in the town without sufficient food and medicine, that according to Lubinets the sides are close to an agreement on evacuation, but no final agreement has been publicly announced and it is unclear how much the Pope influenced it.')))
json.dump(c19, open(OUT + 'c19b.json', 'w'), ensure_ascii=False, indent=1)
print('c19b', len(c19))

c20 = []
c20.append(C('1020-picierno-hunger-strike-oleshky', [14942, 14440, 15036, 14746, 13844, 15878],
 'Алешки: вице-председатель Европарламента Пичерно объявила голодовку; Арахамия обещает «хорошую новость», Россия обвиняет Киев в блокаде',
 'Алешки (Олешки), Херсонская область', 'kherson',
 ['расхождение: кто виноват', 'умолчание'],
 S("ТАСС со ссылкой на посла по особым поручениям МИД Родиона Мирошника пишет о гуманитарном канале связи по Алешкам между уполномоченным по правам человека Яной Лантратовой и командой первой леди США Мелании Трамп: по его словам, канал поможет распространять «правдивую информацию» против западных обвинений в адрес России; при этом блокада должна быть снята, желающие — получить возможность уехать, а помощь — дойти до жителей. Позже РИА Новости приводит слова главы парламента Крыма Владимира Константинова: Крым готов принять жителей Алешек, их блокаду он называет «очередным военным преступлением киевского режима», а безопасно вывести людей, по его словам, мешают атаки ВСУ и дистанционное минирование дорог.",
   (13844, 'The blockade must be lifted. Those who wish to leave should be able to do so.'),
   (15878, 'Блокаду Алешек оцениваю как очередное военное преступление киевского режима.')),
 S("РБК-Украина и «Украинская правда» со ссылкой на пост в X пишут, что вице-председатель Европарламента Пина Пичерно объявила голодовку, чтобы привлечь внимание к гуманитарной катастрофе в оккупированных Олешках, и призвала требовать немедленного гуманитарного перемирия, допуска еды и лекарств и безопасной эвакуации желающих; акцией она поддерживает усилия Папы Льва XIV. Член украинской переговорной делегации Давид Арахамия сказал РБК-Украина, что ситуацию в Олешках обсуждали на переговорах с Уиткоффом в Осло и что на следующей неделе должна появиться хорошая новость; подробностей он не раскрыл.",
   (14440, 'Ця боротьба не може бути лише моєю.'),
   (15036, 'Є дуже важка ситуація в Олешках.')),
 S("DW в интервью с Пичерно в Страсбурге приводит ее слова: люди, пытающиеся выбраться из города, гибнут от беспилотников или на минах, а оставшиеся голодают; заявлений мало, не хватило даже слов Папы, поэтому она прибегает к ненасильственному протесту.",
   (14746, 'Если они пытаются выйти, они погибают от беспилотников или на минах, а если остаются в городе - голодают'),
   (14746, 'Слов недостаточно. Не хватило даже слов папы римского.')),
 "Украинские и независимые источники пишут о голодовке Пичерно и ставят в центр блокаду оккупированного города; российские источники в подборке голодовку не упоминают, говорят о канале связи с командой Мелании Трамп и о готовности Крыма принять жителей и возлагают ответственность за блокаду на Киев. Причины, по которым жители не могут выехать, описаны по-разному: Пичерно в интервью DW говорит о беспилотниках и минах, не называя сторону, Константинов — об атаках ВСУ и минировании дорог.",
 'medium', 'Обстоятельства блокады и обещанная Арахамией «хорошая новость» не раскрыты; независимых данных о положении в городе в подборке мало.', False,
 ('Олешки: віцепрезидентка Європарламенту Пічерно оголосила голодування; Арахамія обіцяє «гарну новину», Росія звинувачує Київ у блокаді',
  'Олешки, Херсонська область',
  'Українські й незалежні джерела пишуть про голодування Пічерно і ставлять у центр блокаду окупованого міста; російські джерела в добірці голодування не згадують, говорять про канал зв’язку з командою Меланії Трамп і про готовність Криму прийняти мешканців та покладають відповідальність за блокаду на Київ. Причини, через які мешканці не можуть виїхати, описано по-різному: Пічерно в інтерв’ю DW говорить про безпілотники й міни, не називаючи сторону, Константинов — про атаки ЗСУ та мінування доріг.',
  'ТАСС із посиланням на посла з особливих доручень МЗС Родіона Мірошника пише про гуманітарний канал зв’язку щодо Олешок між уповноваженою з прав людини Яною Лантратовою та командою першої леді США Меланії Трамп: за його словами, канал допоможе поширювати «правдиву інформацію» проти західних звинувачень на адресу Росії; водночас блокаду треба зняти, охочі мають отримати змогу виїхати, а допомога — дійти до мешканців. Пізніше РИА Новости наводить слова голови парламенту Криму Володимира Константинова: Крим готовий прийняти мешканців Олешок, їхню блокаду він називає «черговим воєнним злочином київського режиму», а безпечно вивезти людей, за його словами, заважають атаки ЗСУ та дистанційне мінування доріг.',
  'РБК-Україна та «Українська правда» з посиланням на допис у X пишуть, що віцепрезидентка Європарламенту Піна Пічерно оголосила голодування, щоб привернути увагу до гуманітарної катастрофи в окупованих Олешках, і закликала вимагати негайного гуманітарного перемир’я, допуску їжі та ліків і безпечної евакуації охочих; акцією вона підтримує зусилля Папи Лева XIV. Член української переговорної делегації Давид Арахамія сказав РБК-Україна, що ситуацію в Олешках обговорювали на переговорах із Віткоффом в Осло і що наступного тижня має з’явитися гарна новина; подробиць він не розкрив.',
  'DW в інтерв’ю з Пічерно у Страсбурзі наводить її слова: люди, які намагаються вибратися з міста, гинуть від безпілотників або на мінах, а ті, хто лишається, голодують; заяв замало, не вистачило навіть слів Папи, тому вона вдається до ненасильницького протесту.'),
 ('Oleshky: European Parliament Vice-President Picierno goes on hunger strike; Arakhamia promises "good news", Russia blames Kyiv for the blockade',
  'Oleshky, Kherson region',
  'Ukrainian and independent sources report Picierno\'s hunger strike and focus on the blockade of the occupied town; Russian sources in the selection do not mention the hunger strike, speak of a communication channel with Melania Trump\'s team and of Crimea\'s readiness to take in residents, and blame Kyiv for the blockade. The reasons residents cannot leave are described differently: Picierno, in her DW interview, speaks of drones and mines without naming a side, while Konstantinov speaks of Ukrainian attacks and the mining of roads.',
  'TASS, citing Foreign Ministry ambassador-at-large Rodion Miroshnik, writes about a humanitarian communication channel on Oleshky between human rights commissioner Yana Lantratova and the team of US First Lady Melania Trump: in his words, the channel will help spread "truthful information" against Western accusations against Russia; at the same time the blockade must be lifted, those who wish to leave must be able to do so and aid must reach residents. Later RIA Novosti quotes the speaker of the Crimean parliament Vladimir Konstantinov: Crimea is ready to take in Oleshky residents, he calls their blockade "another war crime of the Kyiv regime", and says Ukrainian attacks and remote mining of roads prevent people from being evacuated safely.',
  'RBC-Ukraine and Ukrainska Pravda, citing a post on X, write that European Parliament Vice-President Pina Picierno has gone on hunger strike to draw attention to the humanitarian catastrophe in occupied Oleshky and called for demanding an immediate humanitarian ceasefire, access for food and medicine and safe evacuation of those who wish to leave; with her action she supports the efforts of Pope Leo XIV. Davyd Arakhamia, a member of the Ukrainian negotiating delegation, told RBC-Ukraine that the situation in Oleshky was discussed at the talks with Witkoff in Oslo and that good news should come next week; he gave no details.',
  'DW, interviewing Picierno in Strasbourg, quotes her: people who try to leave the town die from drones or on mines, and those who stay are starving; statements are not enough, even the Pope\'s words were not enough, so she is resorting to non-violent protest.')))
json.dump(c20, open(OUT + 'c20c.json', 'w'), ensure_ascii=False, indent=1)
print('c20c', len(c20))
