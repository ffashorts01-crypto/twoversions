# ---- quote pre-check against the DB
db = sqlite3.connect('/workspace/compare-site-v2/data/articles.db')
n = lambda s: re.sub(r'\s+', ' ', s or '')
def chk(i, t):
    r = db.execute('select text from articles where id=?', (i,)).fetchone()
    if not r or n(t) not in n(r[0]): print('QUOTE BAD', i, t[:70])
FILES = ['c18a.json', 'c18b.json', 'c18c.json', 'c19a.json', 'c19b.json', 'c19d.json', 'c19e.json', 'c19f.json', 'c19g.json']
def lens(c):
    return [len(c[s]['summary']) for s in ('ru', 'ua', 'ind') if c[s]] + [len(c[l][k]) for l in ('uk', 'en') for k in ('ru', 'ua', 'ind', 'd') if c[l][k]] + [len(c['diverge'])]
if '--dry' in sys.argv:
    import copy
    for c in cards:
        for s in ('ru', 'ua', 'ind'):
            if c[s]:
                for qq in c[s]['quotes']: chk(qq['id'], qq['text'])
        print('NEW', c['key'], max(lens(c)), len(c['title']), len(c['uk']['t']), len(c['en']['t']))
    for f in FILES:
        for c in json.load(open(OUT + f)):
            if c['key'] in EXT:
                c = copy.deepcopy(c); EXT[c['key']](c)
                for s in ('ru', 'ua', 'ind'):
                    if c[s]:
                        for qq in c[s]['quotes']: chk(qq['id'], qq['text'])
                L = lens(c)
                print('DRY', c['key'], max(L), len(c['title']), len(c['uk']['t']), len(c['en']['t']))
    sys.exit()

apply(FILES)
json.dump(cards, open(OUT + 'c19h.json', 'w'), ensure_ascii=False, indent=1)
touched = set(EXT)
for f in FILES + ['c19h.json']:
    for c in json.load(open(OUT + f)):
        if c['key'] not in touched and f != 'c19h.json': continue
        for s in ('ru', 'ua', 'ind'):
            if c[s]:
                for qq in c[s]['quotes']: chk(qq['id'], qq['text'])
        L = lens(c)
        print(c['key'], max(L))
        if max(L) > 1400: print('TOO LONG', f, c['key'], max(L))
        if len(c['title']) > 160: print('TITLE LONG', c['key'], len(c['title']))
