card('1017-kherson-air-strikes', [8228, 8967, 8256, 7357, 9476],
 'Херсон: при авиаударах погиб водитель скорой, за день 37 пострадавших, среди них дети; поврежден офис Красного Креста', 'Херсон', 'kherson',
 ['одна из групп не освещает'],
