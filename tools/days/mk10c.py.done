cards.append(C('1010-odesa-dnipro-evening', [7832, 9945, 7842, 4566],
 'Вечерние удары: административное здание и комплекс TENET в Одессе, девятиэтажка в Днепре', 'Одесса, Днепр', 'odesa',
 ['расхождение: формулировки'],
 S('РИА Новости со ссылкой на Укринформ и Суспільне сообщает о взрывах в Днепре («Днепропетровске») на фоне воздушной тревоги, не уточняя последствий.',
   (4566, 'Взрыв вновь прогремел в субботу в Днепропетровске на Украине на фоне воздушной тревоги')),
