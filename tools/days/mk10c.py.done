  None]))

cards.append(C('1010-trump-refineries-intel', [10470, 10458, 5657, 7802, 7807, 6952, 9940, 9913, 9931, 7799, 9306, 8482],
 'Трамп требует от Киева прекратить удары по НПЗ; Axios: США пригрозили прекратить передачу разведданных', 'Вашингтон — Киев', 'ukraine-wide',
 ['расхождение: оценки'],
 S('Интерфакс со ссылкой на Axios пишет, что Трамп пошел на сделку с Россией по дизелю после того, как Зеленский проигнорировал полдюжины просьб прекратить атаки на российские НПЗ. ТАСС и Интерфакс цитируют Трампа: США говорили Зеленскому «не трогайте НПЗ», но он «идет и бьет» по ним.',
   (10458, 'после того, как президент Украины Владимир Зеленский проигнорировал полдюжины просьб США прекратить нападения на российские нефтеперерабатывающие заводы'),
   (10470, 'Мы говорили ему: можете наносить любые удары в России, но не трогайте НПЗ')),
 S('Українська правда и Суспільне со ссылкой на Axios сообщают, что Уиткофф и Кушнер на переговорах угрожали прекратить передачу Украине разведданных из-за ударов по НПЗ. Зеленский, по данным Axios в пересказе РБК-Украина, поддержал бы ослабление санкций только в обмен на энергетическое перемирие; по данным FT, Украина продолжит удары по НПЗ.',
   (7807, 'погрожували припиненням надання Україні розвідданих через удари по російських НПЗ'),
   (9913, 'Украина бы поддержала ослабление санкций для РФ только в обмен на энергетическое перемирие.')),
 S('DW со ссылкой на высокопоставленного украинского чиновника подтверждает угрозу прекратить передачу разведданных. Kyiv Independent пишет, что Трамп потребовал прекратить удары по НПЗ и предложил украинцам сменить президента.',
   (9306, 'США пригрозили Украине прекращением передачи разведывательных данных, если украинская армия не перестанет бить по российским нефтеперерабатывающим заводам')),
 'Российские источники подчеркивают версию Трампа о том, что Киев сам спровоцировал сделку по дизелю; украинские и независимые акцентируют давление Вашингтона и угрозу разведданным. Факт угрозы основан на анонимных источниках Axios и DW.',
 'medium', 'Угроза разведданным известна только из анонимных источников.', True,
 ['Трамп вимагає від Києва припинити удари по НПЗ; Axios: США пригрозили припинити передачу розвідданих', 'Вашингтон — Київ',
  'Російські джерела наголошують на версії Трампа про те, що Київ сам спровокував угоду щодо дизеля; українські й незалежні акцентують тиск Вашингтона і загрозу розвідданим. Факт погрози ґрунтується на анонімних джерелах Axios і DW.',
  'Інтерфакс із посиланням на Axios пише, що Трамп пішов на угоду з Росією щодо дизеля після того, як Зеленський проігнорував пів дюжини прохань припинити атаки на російські НПЗ. ТАСС та Інтерфакс цитують Трампа: США казали Зеленському «не чіпайте НПЗ», але він «іде і б’є» по них.',
  'Українська правда і Суспільне з посиланням на Axios повідомляють, що Віткофф і Кушнер на переговорах погрожували припинити передачу Україні розвідданих через удари по НПЗ. Зеленський, за даними Axios у переказі РБК-Україна, підтримав би послаблення санкцій лише в обмін на енергетичне перемир’я; за даними FT, Україна продовжить удари по НПЗ.',
  'DW з посиланням на високопосадовця України підтверджує погрозу припинити передачу розвідданих. Kyiv Independent пише, що Трамп вимагав припинити удари по НПЗ і запропонував українцям змінити президента.'],
 ['Trump demands Kyiv stop striking refineries; Axios: US threatened to cut off intelligence', 'Washington — Kyiv',
  'Russian sources stress Trump\'s version that Kyiv itself provoked the diesel deal; Ukrainian and independent ones focus on Washington\'s pressure and the threat to intelligence sharing. The threat is based on anonymous sources cited by Axios and DW.',
  'Interfax, citing Axios, writes that Trump struck the diesel deal with Russia after Zelensky ignored half a dozen US requests to stop attacking Russian refineries. TASS and Interfax quote Trump: the US told Zelensky "don\'t hit the refineries", but he "goes and hits" them.',
  'Ukrainska Pravda and Suspilne, citing Axios, report that Witkoff and Kushner threatened during talks to stop sharing intelligence with Ukraine over the refinery strikes. Zelensky, according to Axios as relayed by RBC-Ukraine, would support easing sanctions only in exchange for an energy truce; according to the FT, Ukraine will continue striking refineries.',
  'DW, citing a senior Ukrainian official, confirms the threat to stop sharing intelligence. Kyiv Independent writes that Trump demanded an end to refinery strikes and suggested Ukrainians replace their president.']))

cards.append(C('1010-trump-new-president', [5655, 4557, 6964, 7811, 9305, 9569, 9129, 9308],
