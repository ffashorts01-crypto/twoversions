import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1014-massive-ballistic-energy', [6563, 6566, 10723, 10719, 10726, 4773, 5909, 4771, 7120, 7121, 8033, 8046, 7125, 7119, 8026, 8027, 8025, 9603, 8575],
 'Массированный удар 39 баллистическими ракетами по энергетике Киева, области и Харькова: 600 тысяч без света; Минобороны РФ — ТЭЦ и «разведывательный» ЦОД', 'Киев, Киевская и Харьковская области', 'kyiv',
 ['расхождение: характер целей', 'расхождение: числа пострадавших'],
 S('Минобороны РФ заявило о массированном ударе высокоточным оружием и дронами большой дальности по объектам коммуникационной и энергетической инфраструктуры в Киеве, Киевской и Харьковской областях, «используемым в интересах ВПК и ВСУ». В списке — ЦОД «АТМ Укрсиббанк», который, по версии ведомства, собирал разведданные о ВС РФ, Дарницкая ТЭЦ-4, Киевские ТЭЦ-5 и ТЭЦ-6, Трипольская ТЭС, подстанция Киевская, а также Харьковская ТЭЦ-5 и Змиевская ТЭС.',
   (6566, 'теплоэлектроцентраль Дарницкая (ТЭЦ-4) , обеспечивающая электроэнергией объекты военно-промышленного комплекса в Киеве'),
   (4773, 'центр обработки данных "АТМ Укрсиббанк", работавший в целях сбора разведывательных сведений о Вооруженных силах РФ')),
 S('Воздушные силы сообщили о 39 ракетах, летящих по баллистической траектории, и 128 дронах (77 реактивных); сбиты или подавлены 4 ракеты и 115 дронов, попадания зафиксированы на 22 локациях. Зеленский назвал удар беспрецедентной демонстрацией неуважения России к США, объявившим прекращение огня по энергетике: без света не менее 600 тысяч человек, повреждены 26 элементов энергосистемы и четыре объекта нефтегазового комплекса. По данным полиции, с вечера 13 октября в Киеве погибли пять человек и 36 пострадали; Укрзализныця сообщила об атаках на депо и станции.',
   (7120, 'Основний напрямок удару — Київ, Київщина та Харківщина.'),
   (7121, 'такої демонстративної неповаги Росії до Америки ще не було'),
   (8046, "Загалом у Києві від вчорашнього вечора вже п'ятеро загиблих та 36 постраждалих")),
 S('Kyiv Independent со ссылкой на региональные власти пишет, что за сутки по Украине погибли не менее 10 и ранены 91 человек; Al Jazeera отмечает, что удар пришелся на дни после объявленного Трампом «энергетического перемирия» и оставил без света сотни тысяч людей.',
   (8575, 'Russia struck Ukraine with 39 missiles and 128 Shahed-type drones'),
   (9603, 'Russian air attacks have killed at least nine people in Ukraine and left hundreds of thousands without power')),
 'Россия называет цели объектами, работающими на ВПК и ВСУ, и разведывательным центром обработки данных; украинская сторона говорит об ударе по энергетике, попадающем под объявленное США перемирие, и о гибели мирных жителей. Независимого подтверждения военного использования объектов нет. Число погибших в Киеве в разных источниках различается.',
 'medium', 'Данные о пострадавших обновлялись в течение дня.', True,
 ['Масований удар 39 балістичними ракетами по енергетиці Києва, області та Харкова: 600 тисяч без світла; Міноборони РФ — ТЕЦ і «розвідувальний» ЦОД', 'Київ, Київська і Харківська області',
  'Росія називає цілі об’єктами, що працюють на ВПК і ЗСУ, та розвідувальним центром обробки даних; українська сторона говорить про удар по енергетиці, що підпадає під оголошене США перемир’я, і про загибель мирних жителів. Незалежного підтвердження військового використання об’єктів немає. Кількість загиблих у Києві в різних джерелах різниться.',
  'Міноборони РФ заявило про масований удар високоточною зброєю і дронами великої дальності по об’єктах комунікаційної та енергетичної інфраструктури в Києві, Київській і Харківській областях, «що використовуються в інтересах ВПК і ЗСУ». У переліку — ЦОД «АТМ Укрсиббанк», який, за версією відомства, збирав розвіддані про ЗС РФ, Дарницька ТЕЦ-4, Київські ТЕЦ-5 і ТЕЦ-6, Трипільська ТЕС, підстанція Київська, а також Харківська ТЕЦ-5 і Зміївська ТЕС.',
  'Повітряні сили повідомили про 39 ракет, що летять балістичною траєкторією, і 128 дронів (77 реактивних); збито або подавлено 4 ракети і 115 дронів, влучання зафіксовано на 22 локаціях. Зеленський назвав удар безпрецедентною демонстрацією неповаги Росії до США, які оголосили припинення вогню щодо енергетики: без світла щонайменше 600 тисяч людей, пошкоджено 26 елементів енергосистеми і чотири об’єкти нафтогазового комплексу. За даними поліції, з вечора 13 жовтня в Києві загинули п’ятеро людей і 36 постраждали; Укрзалізниця повідомила про атаки на депо і станції.',
  'Kyiv Independent з посиланням на регіональну владу пише, що за добу в Україні загинули щонайменше 10 і поранені 91 людина; Al Jazeera зазначає, що удар стався за кілька днів після оголошеного Трампом «енергетичного перемир’я» і залишив без світла сотні тисяч людей.'],
 ['Massive strike with 39 ballistic missiles on energy in Kyiv, the region and Kharkiv: 600 thousand without power; Russia claims power plants and an "intelligence" data centre', 'Kyiv, Kyiv and Kharkiv regions',
  'Russia calls the targets facilities working for the defence industry and the army and an intelligence data centre; the Ukrainian side speaks of a strike on energy covered by the US-announced truce and of civilian deaths. There is no independent confirmation of military use of the facilities. Death tolls in Kyiv differ between sources.',
  'The Russian Defence Ministry reported a massive strike with precision weapons and long-range drones on communications and energy infrastructure in Kyiv, Kyiv and Kharkiv regions "used in the interests of the defence industry and the Ukrainian army". The list includes the ATM Ukrsibbank data centre, which it says gathered intelligence on Russian forces, Darnytsia CHP-4, Kyiv CHP-5 and CHP-6, Trypillia thermal plant, the Kyivska substation, and Kharkiv CHP-5 and Zmiiv thermal plant.',
  'The Air Force reported 39 missiles on ballistic trajectories and 128 drones (77 jet-powered); 4 missiles and 115 drones were shot down or suppressed, with hits recorded at 22 locations. Zelensky called the strike an unprecedented display of Russian disrespect for the US, which had announced an energy ceasefire: at least 600 thousand people are without power, 26 elements of the power system and four oil and gas facilities were damaged. According to police, since the evening of 13 October five people have been killed and 36 injured in Kyiv; Ukrzaliznytsia reported attacks on depots and stations.',
  'Kyiv Independent, citing regional authorities, writes that at least 10 people were killed and 91 injured across Ukraine over the day; Al Jazeera notes that the strike came days after Trump announced an "energy ceasefire" and left hundreds of thousands without power.'])

card('1014-us-intel-warnings', [10733, 10743, 5910, 5916, 7123, 7132, 8037, 8041, 7165, 8069],
 'Зеленский подтвердил: США предупредили о возможной остановке обмена разведданными; о первой волне баллистики Украину снова не предупредили', 'Киев, Вашингтон', 'ukraine-wide',
 ['расхождение: оценка ситуации'],
 S('Интерфакс со ссылкой на Semafor пишет, что в Белом доме активно обсуждают, продолжать ли передачу разведданных Украине; консенсуса нет, против выступает директор ЦРУ Джон Рэтклифф, а источник допускает отказ лишь по целям на территории России. Песков сказал, что Москва «тщательно фиксирует» сообщения, но делать системные выводы рано; ТАСС пересказывает слова Зеленского и Игната.',
   (10733, 'Трамп очень зол. Он может отдать такое распоряжение'),
   (10743, 'Но пока рано делать какие-то системные выводы.')),
 S('Зеленский в интервью NPR сказал, что его генералам на военном уровне сообщили о возможной остановке обмена разведданными, если Украина не прекратит удары по российским НПЗ. Представитель Воздушных сил Юрий Игнат заявил, что около 22:40 предупреждения о баллистике от партнеров не было, но о трех следующих волнах партнеры предупредили. Сопредседатели группы по Украине в Конгрессе выступили против ограничений, а в Еврокомиссии сказали, что признаков прекращения обмена не видят.',
   (7132, 'Мої генерали повідомили мені, що отримали інформацію про те, що розвідувальні дані можуть припинитися'),
   (8037, 'але вже в наступні три хвилі атак, власне, повідомлення від партнерів про застосування балістики звучало'),
   (8069, 'у нас немає жодних ознак того, що обмін розвідданими припинився')),
 None,
 'Украинская сторона говорит об угрозе и частичных сбоях предупреждений; российская сторона подчеркивает неясность и споры в Вашингтоне. Официального решения США в источниках нет.',
 'medium', 'Позиция администрации США известна по анонимным источникам.', False,
 ['Зеленський підтвердив: США попередили про можливу зупинку обміну розвідданими; про першу хвилю балістики Україну знову не попередили', 'Київ, Вашингтон',
  'Українська сторона говорить про загрозу і часткові збої попереджень; російська сторона наголошує на неясності та суперечках у Вашингтоні. Офіційного рішення США в джерелах немає.',
  'Інтерфакс з посиланням на Semafor пише, що в Білому домі активно обговорюють, чи продовжувати передачу розвідданих Україні; консенсусу немає, проти виступає директор ЦРУ Джон Реткліфф, а джерело допускає відмову лише щодо цілей на території Росії. Пєсков сказав, що Москва «ретельно фіксує» повідомлення, але робити системні висновки зарано; ТАСС переказує слова Зеленського та Ігната.',
  'Зеленський в інтерв’ю NPR сказав, що його генералам на військовому рівні повідомили про можливу зупинку обміну розвідданими, якщо Україна не припинить удари по російських НПЗ. Речник Повітряних сил Юрій Ігнат заявив, що близько 22:40 попередження про балістику від партнерів не було, але про три наступні хвилі партнери попередили. Співголови групи з питань України в Конгресі виступили проти обмежень, а в Єврокомісії сказали, що ознак припинення обміну не бачать.',
  None],
 ['Zelensky confirms the US warned it may halt intelligence sharing; Ukraine again got no warning of the first ballistic wave', 'Kyiv, Washington',
  'The Ukrainian side speaks of a threat and partial gaps in warnings; the Russian side stresses uncertainty and disputes in Washington. The sources contain no official US decision.',
  'Interfax, citing Semafor, writes that the White House is actively debating whether to keep sharing intelligence with Ukraine; there is no consensus, CIA Director John Ratcliffe is opposed, and the source suggests a refusal might cover only targets inside Russia. Peskov said Moscow is "carefully noting" the reports but it is too early for systemic conclusions; TASS relays Zelensky and Ihnat.',
  'Zelensky told NPR that his generals were told at the military level that intelligence sharing could stop unless Ukraine halts strikes on Russian refineries. Air Force spokesman Yurii Ihnat said that at about 22:40 there was no ballistic warning from partners, but partners did warn about the next three waves. Co-chairs of the Congressional Ukraine Caucus opposed any restrictions, and the European Commission said it saw no signs that sharing had stopped.',
  None])

card('1014-starlink-speed-limit', [10741, 5925, 5939, 5988, 4808, 7137, 7136, 8034, 8062, 7171, 8080, 8083, 7172, 8304, 8309, 9388, 8569, 9151, 9612],
 'SpaceX без предупреждения ограничила скорость военных терминалов Starshield в Украине; Маск: решения принимают военные США', 'Украина', 'ukraine-wide',
 ['расхождение: ответственность'],
 S('ТАСС и РИА Новости передают слова Маска: системы Starshield принадлежат правительству США, ограничения скорости устанавливают американские военные и в конечном счете президент, а Starlink допускается только для гражданских и оборонительных целей. Песков сказал, что Кремлю известно лишь из сообщений СМИ, и добавил, что было бы лучше, если бы Starlink вообще не использовался в военных целях; ТАСС также цитирует 7-й корпус ДШВ о невозможности запускать дроны средней дальности.',
   (10741, 'было бы лучше, если бы такие блестящие технологии, как Starlink, вообще не использовались в военных целях'),
   (5988, 'Any limits on speed or usage are decided by the US military and ultimately [the president of the US] POTUS.')),
 S('Советник президента Сергей Бескрестнов («Флеш») сообщил, что ночью SpaceX без предупреждения ограничила скорость терминалов «военного пакета» Starshield в движении до 100 миль в час, что сорвало ряд миссий и ухудшило перехват реактивных «шахедов»; он связал это с политической ситуацией. Минобороны Украины заявило, что днем реальные ограничения были существенно ниже, к вечеру связь на скорости до 160 км/ч улучшилась; Зеленский назвал решение «большой ошибкой», которая приведет к жертвам.',
   (7137, 'Наші Сили оборони не отримували попередження про таке обмеження, і це призвело до зриву низки місій'),
   (7171, 'Протягом дня реальні обмеження були суттєво нижчими.'),
   (8080, 'Люди гинутимуть, якщо атаки продовжаться і Starlink не працюватиме.')),
 S('BBC, DW, Guardian, Al Jazeera и Kyiv Independent связывают ограничения с давлением администрации Трампа на Украину из-за ударов по НПЗ; SpaceX официально не комментировала, Маск в X заявил, что лимиты для Starshield определяют военные США и президент.',
   (9151, 'the sudden restrictions on the terminals travelling at high speeds on Tuesday evening led to the failure of several combat missions'),
   (8309, 'any limits on speed or usage are decided by the US military and ultimately [the US president]')),
 'Украинская сторона связывает ограничения с политическим давлением США, Маск перекладывает ответственность на правительство США, Кремль по существу не комментирует. Причина ограничения официально не объяснена.',
 'low', '', False,
 ['SpaceX без попередження обмежила швидкість військових терміналів Starshield в Україні; Маск: рішення ухвалюють військові США', 'Україна',
  'Українська сторона пов’язує обмеження з політичним тиском США, Маск перекладає відповідальність на уряд США, Кремль по суті не коментує. Причину обмеження офіційно не пояснено.',
  'ТАСС і РИА Новости передають слова Маска: системи Starshield належать уряду США, обмеження швидкості встановлюють американські військові й зрештою президент, а Starlink дозволено лише для цивільних і оборонних цілей. Пєсков сказав, що Кремлю відомо лише з повідомлень ЗМІ, і додав, що було б краще, якби Starlink узагалі не використовувався у військових цілях; ТАСС також цитує 7-й корпус ДШВ про неможливість запускати дрони середньої дальності.',
  'Радник президента Сергій Бескрестнов («Флеш») повідомив, що вночі SpaceX без попередження обмежила швидкість терміналів «військового пакета» Starshield у русі до 100 миль на годину, що зірвало низку місій і погіршило перехоплення реактивних «шахедів»; він пов’язав це з політичною ситуацією. Міноборони України заявило, що вдень реальні обмеження були суттєво нижчими, до вечора зв’язок на швидкості до 160 км/год покращився; Зеленський назвав рішення «великою помилкою», яка призведе до жертв.',
  'BBC, DW, Guardian, Al Jazeera і Kyiv Independent пов’язують обмеження з тиском адміністрації Трампа на Україну через удари по НПЗ; SpaceX офіційно не коментувала, Маск в X заявив, що ліміти для Starshield визначають військові США і президент.'],
 ['SpaceX restricts speed of military Starshield terminals in Ukraine without warning; Musk says the US military decides', 'Ukraine',
  'The Ukrainian side links the restrictions to US political pressure, Musk shifts responsibility to the US government, and the Kremlin does not comment on substance. The reason for the restriction has not been officially explained.',
  'TASS and RIA Novosti relay Musk: Starshield systems belong to the US government, speed limits are set by the US military and ultimately the president, and Starlink may be used only for civilian and defensive purposes. Peskov said the Kremlin knows only what media report, adding that it would be better if Starlink were not used for military purposes at all; TASS also quotes the 7th Air Assault Corps saying medium-range drones cannot be launched.',
  'Presidential adviser Serhii "Flash" Beskrestnov said SpaceX overnight, without warning, limited moving Starshield "military package" terminals to 100 miles per hour, disrupting a number of missions and hampering interception of jet-powered Shaheds; he linked it to the political situation. Ukraine\'s Defence Ministry said actual limits during the day were much lower, and by evening the connection at up to 160 km/h had improved; Zelensky called the decision a "big mistake" that will cost lives.',
  'The BBC, DW, the Guardian, Al Jazeera and Kyiv Independent link the restrictions to Trump administration pressure on Ukraine over refinery strikes; SpaceX made no official comment, and Musk wrote on X that Starshield limits are set by the US military and the president.'])
json.dump(cards, open('/workspace/compare-site-v2/tools/days/out/c14a.json', 'w'), ensure_ascii=False)
print(len(cards))
