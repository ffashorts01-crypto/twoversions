cards = []
cards.append(C('1012-night-attack-ships-rail', [6517, 10549, 6518, 4654, 10594, 10596, 4655, 7020, 7904, 7902, 8516],
 'Ночная атака: 121 дрон и ракета Х-59; Минобороны РФ — удары по сухогрузам, локомотивам и складу «Новой почты»', 'Одесская, Николаевская, Днепропетровская области', 'odesa',
 ['расхождение: характер целей', 'атрибуция'],
 S('Минобороны РФ заявило, что беспилотники поразили сухогруз, доставлявший в Одессу «грузы военного назначения», четыре локомотива «в интересах ВСУ» в районах Одессы, Кривого Рога и Пятихаток, а днем — логистический центр «Новая почта» в Терновке Николаевской области, «используемый для хранения грузов двойного назначения», и два сухогруза, шедших в порты Николаева и Одессы.',
   (10549, 'Российские военные нанесли удары по четырем локомотивам, связанным с украинской армией'),
   (10594, 'логистический центр "Новая почта", используемый для хранения грузов двойного назначения, предназначенных для обеспечения ВСУ')),
 S('Воздушные силы ВСУ сообщили, что с 18:00 11 октября Россия атаковала ракетой Х-59 и 121 ударным дроном, 76 из них — реактивные; ПВО обезвредила 89. Глава Одесской ОВА Олег Кипер сообщил об ударе по логистическим помещениям почтового оператора на юге области — поврежден фасад, пострадавших нет.',
   (7904, 'ППО знешкодила 89 ворожих дронів'),
   (7902, 'Російські окупаційні війська завдали удару по логістичних приміщеннях поштового оператора на півдні Одещини.')),
 S('Kyiv Independent со ссылкой на региональные власти пишет, что за сутки российские атаки убили не менее 10 и ранили 69 человек по всей Украине, а Россия продолжала бить по жилым домам и энергетике.',
   (8516, 'At least 10 people were killed and 69 others injured across Ukraine over the past day')),
 'Минобороны РФ называет пораженные объекты военными или «двойного назначения»; украинские власти говорят о гражданском почтовом операторе и пострадавших мирных жителях. Военный характер грузов независимо не подтвержден.',
 'medium', 'Характер целей по-разному описывается сторонами.', True,
 ['Нічна атака: 121 дрон і ракета Х-59; Міноборони РФ — удари по суховантажах, локомотивах і складу «Нової пошти»', 'Одеська, Миколаївська, Дніпропетровська області',
  'Міноборони РФ називає уражені об’єкти військовими або «подвійного призначення»; українська влада говорить про цивільного поштового оператора і постраждалих мирних жителів. Військовий характер вантажів незалежно не підтверджено.',
  'Міноборони РФ заявило, що безпілотники уразили суховантаж, який доставляв до Одеси «вантажі військового призначення», чотири локомотиви «в інтересах ЗСУ» в районах Одеси, Кривого Рогу і П’ятихаток, а вдень — логістичний центр «Нової пошти» в Терновому на Миколаївщині, «що використовується для зберігання вантажів подвійного призначення», і два суховантажі, що йшли до портів Миколаєва та Одеси.',
  'Повітряні сили ЗСУ повідомили, що з 18:00 11 жовтня Росія атакувала ракетою Х-59 і 121 ударним дроном, 76 із них — реактивні; ППО знешкодила 89. Голова Одеської ОВА Олег Кіпер повідомив про удар по логістичних приміщеннях поштового оператора на півдні області — пошкоджено фасад, постраждалих немає.',
  'Kyiv Independent з посиланням на регіональну владу пише, що за добу російські атаки вбили щонайменше 10 і поранили 69 людей по всій Україні, а Росія продовжувала бити по житлових будинках та енергетиці.'],
 ['Overnight attack: 121 drones and a Kh-59 missile; Russia claims strikes on cargo ships, locomotives and a Nova Poshta depot', 'Odesa, Mykolaiv and Dnipropetrovsk regions',
  'The Russian Defence Ministry calls the targets military or "dual-use"; Ukrainian authorities speak of a civilian postal operator and civilian casualties. The military nature of the cargo has not been independently confirmed.',
  'The Russian Defence Ministry said drones hit a cargo ship carrying "military cargo" to Odesa, four locomotives used "in the interests of the Ukrainian army" near Odesa, Kryvyi Rih and Piatykhatky, and during the day a Nova Poshta logistics centre in Ternovka, Mykolaiv region, "used to store dual-use cargo", as well as two cargo ships bound for the ports of Mykolaiv and Odesa.',
  'Ukraine\'s Air Force said that from 18:00 on 11 October Russia attacked with a Kh-59 missile and 121 strike drones, 76 of them jet-powered; air defence neutralised 89. Odesa governor Oleh Kiper reported a strike on a postal operator\'s logistics premises in the south of the region, damaging the facade, with no casualties.',
  'Kyiv Independent, citing regional authorities, writes that over the day Russian attacks killed at least 10 and injured 69 people across Ukraine, as Russia kept hitting residential buildings and energy infrastructure.']))

cards.append(C('1012-dnipro-lozova-vinnytsia', [7912, 7926, 7937, 8530],
 'Удары по Днепру, Павлограду, Лозовой и фабрике Roshen в Виннице: двое погибших', 'Днепр, Павлоград, Лозовая, Винница', 'dnipro',
 ['одна из групп не освещает'],
 None,
 S('Глава Днепропетровской ОВА Александр Ганжа сообщил об одном погибшем в Днепре и пожаре в торговом центре в Днепровском районе; в Павлограде ранены трое мужчин, один в тяжелом состоянии, в Днепре — еще трое. По данным ГСЧС, удар дронов по частному сектору Лозовой на Харьковщине убил 71-летнюю женщину, семеро пострадали, среди них 9-летняя девочка.',
   (7912, 'На жаль, через ворожу атаку на Дніпро загинула одна людина'),
   (7937, 'Внаслідок російських ударів БпЛА по приватному сектору міста Лозова загинула жінка, ще 7 людей постраждали, серед них – дитина')),
 S('Kyiv Independent пишет, что Россия ударила по производственному комплексу кондитерской компании Roshen в Виннице; благодаря эвакуации работники не пострадали. Компания отвергла распространяемые российскими СМИ утверждения о производстве там дронов.',
   (8530, 'The production complex in Vinnytsia is a civilian facility')),
 'Украинские и независимые источники совпадают; российские источники в выборке эти удары не упоминают. Kyiv Independent упоминает утверждения российских СМИ о военном использовании фабрики, которые компания отвергает.',
 'low', '', False,
 ['Удари по Дніпру, Павлограду, Лозовій і фабриці Roshen у Вінниці: двоє загиблих', 'Дніпро, Павлоград, Лозова, Вінниця',
  'Українські та незалежні джерела збігаються; російські джерела у вибірці ці удари не згадують. Kyiv Independent згадує твердження російських ЗМІ про військове використання фабрики, які компанія відкидає.',
  None,
  'Голова Дніпропетровської ОВА Олександр Ганжа повідомив про одного загиблого в Дніпрі та пожежу в торговельному центрі в Дніпровському районі; у Павлограді поранено трьох чоловіків, одного — у тяжкому стані, у Дніпрі — ще трьох людей. За даними ДСНС, удар дронів по приватному сектору Лозової на Харківщині вбив 71-річну жінку, семеро постраждали, серед них 9-річна дівчинка.',
  'Kyiv Independent пише, що Росія вдарила по виробничому комплексу кондитерської компанії Roshen у Вінниці; завдяки евакуації працівники не постраждали. Компанія відкинула поширювані російськими ЗМІ твердження про виробництво там дронів.'],
 ['Strikes on Dnipro, Pavlohrad, Lozova and a Roshen factory in Vinnytsia: two killed', 'Dnipro, Pavlohrad, Lozova, Vinnytsia',
  'Ukrainian and independent sources agree; Russian sources in the sample do not mention these strikes. Kyiv Independent mentions Russian media claims of military use of the factory, which the company rejects.',
  None,
  'Dnipropetrovsk governor Oleksandr Hanzha reported one person killed in Dnipro and a fire at a shopping centre in Dniprovskyi district; in Pavlohrad three men were injured, one seriously, and three more people in Dnipro. According to the State Emergency Service, a drone strike on a private housing area in Lozova, Kharkiv region, killed a 71-year-old woman and injured seven, including a 9-year-old girl.',
  'Kyiv Independent writes that Russia struck a production complex of confectionery company Roshen in Vinnytsia; thanks to an evacuation, no workers were hurt. The company rejected claims spread by Russian media that drones were made there.']))

cards.append(C('1012-donetsk-smerch-cherkaske', [7932, 7929, 9345],
