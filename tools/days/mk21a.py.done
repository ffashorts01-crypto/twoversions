import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
OUT = '/workspace/compare-site-v2/tools/days/out/'
cards = []
card = lambda *a: cards.append(C(*a))
# ---------------- backlog run 21-22 Oct (ids 13431-15322): Oct 21 ----------------
card('1021-putin-witkoff-trilateral-talks', [15260, 13818, 13561, 14464, 14476, 14734, 14639],
 'Путин принял Уиткоффа в Петербурге; Ушаков: Москва готова возобновить трехсторонние переговоры с США и Украиной в десятых числах ноября, Зеленский поддержал',
 'Санкт-Петербург', 'ukraine-wide',
 ['расхождение: формулировки', 'расхождение: кто виноват'],
 S('Российские агентства передают итоги встречи со слов помощника президента Юрия Ушакова. По данным РИА Новости, встреча в Константиновском дворце продолжалась почти три часа. «Интерфакс» приводит слова Ушакова о том, что Уиткофф проинформировал Путина о переговорах в Осло и отметил новые моменты в подходах европейцев и Киева, «хотя полезного» для урегулирования в них «не так уж и много». ТАСС на английском пишет, что стороны отдельно обсудили схему возможного возобновления трехсторонних переговоров России, США и Украины, и приводит слова Ушакова о том, что их возобновление сразу после выборов в Госдуму сорвал «украинский режим» массированными ударами в главный день голосования по Москве, другим городам и избирательным участкам.',
   (13561, 'Продолжалась почти три часа'),
   (15260, 'Отметил некоторые новые моменты в подходах европейцев и Киева, хотя полезного в контексте урегулирования украинского кризиса в них содержалось не так уж и много'),
   (13818, 'the scheme of a possible resumption of trilateral negotiations with the participation of representatives of Russia, the United States and Ukraine was specifically discussed'),
   (13818, 'was disrupted by the Ukrainian regime')),
 S('«Украинская правда» со ссылкой на «Интерфакс» и РИА Новости пишет, что Путин сообщил Уиткоффу о готовности Москвы возобновить трехсторонние переговоры в десятых числах ноября по «главной теме» — системе безопасности для России и Украины после окончания конфликта; по словам Ушакова, Уиткофф ответил, что Трамп воспримет такое решение с большим удовольствием, а новый раунд может пройти в Абу-Даби. Вечером издание привело слова Зеленского: по полученной обратной связи, Россия поддерживает трехстороннюю встречу на уровне команд, американская сторона предлагает провести ее как можно быстрее, и Украина это поддерживает; окончательные даты еще не известны.',
   (14464, 'ми, в принципі, готові відновити згадані тристоронні переговори в десятих числах листопада щодо головної теми'),
   (14476, 'Американська сторона пропонує це зробити як можна швидше, ми підтримуємо це.')),
 S('DW со ссылкой на опубликованный на сайте Кремля комментарий Ушакова сообщает, что Москва готова возобновить трехсторонние переговоры с Вашингтоном и Киевом «в десятых числах ноября» и обсуждать систему безопасности для России и Украины после окончания войны; со стороны России во встрече участвовал также Кирилл Дмитриев, а Путин высказал Уиткоффу соображения о возможной встрече с Трампом и Си Цзиньпином. «Медуза» выносит в заголовок вторую часть заявления — что «полезного» в новых предложениях ЕС и Украины, по мнению Кремля, «не так уж и много» — и напоминает о промежуточных выборах в Конгресс США, которыми аналитики объясняют последние шаги Трампа.',
   (14734, 'Москва готова возобновить трехсторонние переговоры с Вашингтоном и Киевом'),
   (14639, 'полезного в контексте урегулирования украинского кризиса в них содержалось не так уж и много')),
 'Готовность Москвы возобновить трехсторонние переговоры в ноябре передают все три группы, причем все со слов Ушакова. Российские агентства добавляют его версию о том, что прежнее возобновление переговоров сорвал Киев ударами в день выборов в Госдуму; в украинских и независимых материалах выборки эта версия не приводится. Украинские источники дополняют картину заявлением Зеленского о поддержке встречи на уровне команд, а «Медуза» и «Интерфакс» подчеркивают скептическую оценку Кремлем предложений Европы и Киева.',
 'low', 'Ход встречи известен в основном со слов российской стороны; американского изложения ее итогов в выборке почти нет.', False,
 ('Путін прийняв Віткоффа в Петербурзі; Ушаков: Москва готова відновити тристоронні переговори зі США та Україною в десятих числах листопада, Зеленський підтримав',
  'Санкт-Петербург',
  'Готовність Москви відновити тристоронні переговори в листопаді передають усі три групи, причому всі зі слів Ушакова. Російські агентства додають його версію про те, що попереднє відновлення переговорів зірвав Київ ударами в день виборів до Держдуми; в українських і незалежних матеріалах вибірки ця версія не наводиться. Українські джерела доповнюють картину заявою Зеленського про підтримку зустрічі на рівні команд, а «Медуза» та «Интерфакс» підкреслюють скептичну оцінку Кремлем пропозицій Європи та Києва.',
  'Російські агентства передають підсумки зустрічі зі слів помічника президента Юрія Ушакова. За даними РИА Новости, зустріч у Костянтинівському палаці тривала майже три години. «Интерфакс» наводить слова Ушакова про те, що Віткофф поінформував Путіна про переговори в Осло і відзначив нові моменти в підходах європейців і Києва, «хоча корисного» для врегулювання в них «не так уже й багато». ТАСС англійською пише, що сторони окремо обговорили схему можливого відновлення тристоронніх переговорів Росії, США та України, і наводить слова Ушакова про те, що їхнє відновлення одразу після виборів до Держдуми зірвав «український режим» масованими ударами в головний день голосування по Москві, інших містах і виборчих дільницях.',
  '«Українська правда» з посиланням на «Интерфакс» і РИА Новости пише, що Путін повідомив Віткоффу про готовність Москви відновити тристоронні переговори в десятих числах листопада щодо «головної теми» — системи безпеки для Росії та України після закінчення конфлікту; за словами Ушакова, Віткофф відповів, що Трамп сприйме таке рішення з великим задоволенням, а новий раунд може відбутися в Абу-Дабі. Увечері видання навело слова Зеленського: за отриманим зворотним зв’язком, Росія підтримує тристоронню зустріч на рівні команд, американська сторона пропонує провести її якомога швидше, і Україна це підтримує; остаточні дати ще не відомі.',
  'DW з посиланням на опублікований на сайті Кремля коментар Ушакова повідомляє, що Москва готова відновити тристоронні переговори з Вашингтоном і Києвом «у десятих числах листопада» та обговорювати систему безпеки для Росії та України після закінчення війни; з російського боку в зустрічі брав участь також Кирило Дмитрієв, а Путін висловив Віткоффу міркування щодо можливої зустрічі з Трампом і Сі Цзіньпіном. «Медуза» виносить у заголовок другу частину заяви — що «корисного» в нових пропозиціях ЄС і України, на думку Кремля, «не так уже й багато» — і нагадує про проміжні вибори до Конгресу США, якими аналітики пояснюють останні кроки Трампа.'),
 ('Putin receives Witkoff in St Petersburg; Ushakov: Moscow is ready to resume trilateral talks with the US and Ukraine in mid-November, Zelensky supports it',
  'St Petersburg',
  'All three groups report Moscow\'s readiness to resume trilateral talks in November, all of them citing Ushakov. Russian agencies add his version that the earlier resumption of talks was derailed by Kyiv\'s strikes on the day of the State Duma elections; this version does not appear in the Ukrainian and independent reports in the sample. Ukrainian sources complete the picture with Zelensky\'s statement of support for a meeting at team level, while Meduza and Interfax stress the Kremlin\'s sceptical assessment of the European and Kyiv proposals.',
  'Russian agencies relay the outcome of the meeting in the words of presidential aide Yury Ushakov. According to RIA Novosti, the meeting at the Konstantinovsky Palace lasted almost three hours. Interfax quotes Ushakov as saying Witkoff briefed Putin on the Oslo talks and noted new points in the approaches of the Europeans and Kyiv, "although there was not all that much" useful for a settlement in them. TASS in English writes that the sides specifically discussed a scheme for possibly resuming trilateral talks between Russia, the US and Ukraine, and quotes Ushakov as saying their resumption right after the State Duma elections was derailed by the "Ukrainian regime" through massive strikes on the main voting day on Moscow, other cities and polling stations.',
  'Ukrainska Pravda, citing Interfax and RIA Novosti, writes that Putin told Witkoff Moscow is ready to resume trilateral talks in mid-November on the "main topic", a security system for Russia and Ukraine after the end of the conflict; according to Ushakov, Witkoff replied that Trump would welcome such a decision with great pleasure, and a new round could take place in Abu Dhabi. In the evening the outlet quoted Zelensky: according to the feedback received, Russia supports a trilateral meeting at team level, the American side proposes holding it as soon as possible, and Ukraine supports this; the final dates are not yet known.',
  'DW, citing Ushakov\'s comment published on the Kremlin website, reports that Moscow is ready to resume trilateral talks with Washington and Kyiv "in mid-November" and to discuss a security system for Russia and Ukraine after the end of the war; Kirill Dmitriev also took part in the meeting on the Russian side, and Putin shared with Witkoff thoughts on a possible meeting with Trump and Xi Jinping. Meduza headlines the second part of the statement, that in the Kremlin\'s view there is "not all that much" useful in the new EU and Ukrainian proposals, and recalls the US midterm elections, which analysts see as driving Trump\'s recent moves.'))

card('1021-hubbard-released', [15217, 13812, 14454, 14623, 14516],
 'Россия освободила американца Стивена Хаббарда, осужденного за участие в боях на стороне Украины; Уиткофф назвал Путина «гуманистом»',
 'Санкт-Петербург', 'russia-other',
 ['расхождение: формулировки', 'умолчание'],
 S('«Интерфакс» передает слова Уиткоффа на встрече с Путиным: США благодарят Россию за освобождение Стивена Хаббарда «от имени президента США, от всех американцев», Трамп просил об этом по гуманитарным соображениям; Путин подтвердил, что Хаббард уже в аэропорту Пулково. ТАСС на английском в справке напоминает, что Хаббард осужден за участие в боевых действиях на стороне украинских сил, получил в 2024 году шесть лет и десять месяцев колонии и признал вину, а со ссылкой на Axios пишет, что освобождение было частью более широкого предложения, обсуждавшегося в Осло.',
   (15217, 'США благодарят Россию за освобождение американца Стивена Хаббарда'),
   (13812, 'Hubbard was convicted in Russia for taking part in combat operations alongside Ukrainian forces.'),
   (13812, 'He confessed to the charges.')),
 S('«Украинская правда» со ссылкой на «Европейскую правду» и CNN пишет, что Хаббард, проведший под стражей в России более четырех лет, освобожден на фоне визита Уиткоффа; 74-летний учитель на пенсии из Мичигана был признан Госдепартаментом незаконно задержанным, а Трамп накануне сообщил, что поднимал его дело в разговоре с Путиным.',
   (14454, '74-річний вчитель на пенсії зі штату Мічиган був визнаний Державним департаментом США незаконно затриманим')),
 S('«Медуза» пишет, что Хаббард в первые дни вторжения вступил в территориальную оборону в Харьковской области, где много лет жил, в апреле 2022 года попал в российский плен и в 2024 году получил шесть лет и десять месяцев колонии по обвинению в наемничестве. Би-би-си сообщает, что, по словам Трампа, никакого обмена не понадобилось, а Уиткофф после освобождения назвал Путина «гуманистом», что вызвало критику со стороны законодателей; по данным CBS, Хаббард был в плохом состоянии здоровья.',
   (14623, 'в апреле 2022 года попал в российский плен'),
   (14516, 'you are a humanitarian also sir, and I salute that')),
 'Российские источники описывают Хаббарда как осужденного за участие в боях на стороне Украины, признавшего вину, и выдвигают на первый план благодарность США России. Украинский источник называет его пожилым учителем на пенсии, которого Госдепартамент признал незаконно задержанным, и не упоминает его службу в теробороне. Независимые издания приводят обе стороны истории и пишут о критике в США слов Уиткоффа, назвавшего Путина «гуманистом».',
 'low', '', False,
 ('Росія звільнила американця Стівена Габбарда, засудженого за участь у боях на боці України; Віткофф назвав Путіна «гуманістом»',
  'Санкт-Петербург',
  'Російські джерела описують Габбарда як засудженого за участь у боях на боці України, який визнав провину, і висувають на перший план подяку США Росії. Українське джерело називає його літнім учителем на пенсії, якого Держдепартамент визнав незаконно затриманим, і не згадує про його службу в тероброні. Незалежні видання наводять обидва боки історії і пишуть про критику в США слів Віткоффа, який назвав Путіна «гуманістом».',
  '«Интерфакс» передає слова Віткоффа на зустрічі з Путіним: США дякують Росії за звільнення Стівена Габбарда «від імені президента США, від усіх американців», Трамп просив про це з гуманітарних міркувань; Путін підтвердив, що Габбард уже в аеропорту Пулково. ТАСС англійською в довідці нагадує, що Габбарда засуджено за участь у бойових діях на боці українських сил, він отримав у 2024 році шість років і десять місяців колонії і визнав провину, а з посиланням на Axios пише, що звільнення було частиною ширшої пропозиції, яку обговорювали в Осло.',
  '«Українська правда» з посиланням на «Європейську правду» і CNN пише, що Габбард, який перебував під вартою в Росії понад чотири роки, звільнений на тлі візиту Віткоффа; 74-річного вчителя на пенсії з Мічигану Держдепартамент визнав незаконно затриманим, а Трамп напередодні повідомив, що порушував його справу в розмові з Путіним.',
  '«Медуза» пише, що Габбард у перші дні вторгнення вступив до територіальної оборони в Харківській області, де багато років жив, у квітні 2022 року потрапив у російський полон і в 2024 році отримав шість років і десять місяців колонії за звинуваченням у найманстві. Бі-бі-сі повідомляє, що, за словами Трампа, жодного обміну не знадобилося, а Віткофф після звільнення назвав Путіна «гуманістом», що викликало критику з боку законодавців; за даними CBS, Габбард мав погане здоров’я.'),
 ('Russia frees American Stephen Hubbard, convicted of fighting on Ukraine\'s side; Witkoff calls Putin a "humanitarian"',
  'St Petersburg',
  'Russian sources describe Hubbard as convicted of fighting on Ukraine\'s side and as having confessed, and put the US thanks to Russia first. The Ukrainian source calls him an elderly retired teacher whom the State Department designated as wrongfully detained and does not mention his service in the territorial defence. Independent outlets give both sides of the story and report criticism in the US of Witkoff\'s words calling Putin a "humanitarian".',
  'Interfax relays Witkoff\'s words at the meeting with Putin: the US thanks Russia for freeing Stephen Hubbard "on behalf of the US president, of all Americans", and Trump had asked for it on humanitarian grounds; Putin confirmed that Hubbard was already at Pulkovo Airport. TASS in English, in a factbox, recalls that Hubbard was convicted of taking part in combat alongside Ukrainian forces, received six years and ten months in a penal colony in 2024 and confessed, and, citing Axios, writes that the release was part of a broader proposal discussed in Oslo.',
  'Ukrainska Pravda, citing Yevropeiska Pravda and CNN, writes that Hubbard, held in Russia for more than four years, was freed amid Witkoff\'s visit; the 74-year-old retired teacher from Michigan had been designated wrongfully detained by the State Department, and Trump said the day before that he had raised his case in a conversation with Putin.',
  'Meduza writes that in the first days of the invasion Hubbard joined the territorial defence in the Kharkiv region, where he had lived for many years, was captured by Russian forces in April 2022 and in 2024 received six years and ten months in a penal colony on mercenary charges. The BBC reports that, according to Trump, no swap was needed, and that after the release Witkoff called Putin a "humanitarian", drawing criticism from lawmakers; according to CBS, Hubbard was in poor health.'))

card('1021-su30-crash-kaliningrad', [13810, 14150, 14634, 14608],
 'В Калининградской области разбился истребитель Су-30; Минобороны РФ: угрозы жизни летчиков нет, Mash: оба ранены',
 'Калининградская область', 'russia-other',
 ['расхождение: последствия', 'не проверено'],
 S('ТАСС на английском передает заявление Минобороны России: истребитель Су-30 разбился во время планового учебно-тренировочного полета в Калининградской области, экипаж катапультировался и был эвакуирован наземной поисково-спасательной группой, угрозы жизни летчиков нет; самолет летел без боекомплекта и упал в безлюдной местности. О травмах экипажа и причинах крушения агентство не сообщает.',
   (13810, 'The crew members ejected and were evacuated by a ground search and rescue team.'),
   (13810, 'The aircraft was flying without ammunition and came down in an uninhabited area.')),
 S('«Общественное» со ссылкой на «Интерфакс» и Минобороны РФ сообщает о крушении Су-30 при «плановом учебно-тренировочном» полете: угрозы жизни летчикам нет, самолет упал в безлюдном районе, полет выполнялся без боекомплекта. Издание уточняет, что Су-30 — двухместный многоцелевой истребитель ВКС и морской авиации России.',
   (14150, 'Загрози життя льотчикам немає. Літак впав у безлюдному районі.')),
 S('«Медуза» передает версию Минобороны и добавляет данные близкого к силовикам телеграм-канала Mash: упал Су-30СМ, недалеко от Черняховска, летчиков с травмами доставили в военный госпиталь; видео падения опубликовал украинский мониторинговый канал. The Kyiv Independent также ссылается на Mash о том, что оба пилота ранены, и отмечает, что Москва не объяснила причину крушения; издание напоминает о росте напряженности между Россией и НАТО вокруг Калининграда.',
   (14634, 'Летчиков доставили в военный госпиталь с травмами.'),
   (14608, 'Moscow has not elaborated on the reason for the plane crash.')),
 'Все группы опираются на заявление Минобороны России о крушении во время учебного полета без жертв. Российский источник и украинский пересказ ограничиваются формулировкой «угрозы жизни летчиков нет»; независимые издания со ссылкой на Mash добавляют, что оба летчика получили травмы и госпитализированы, и подчеркивают, что причина крушения не названа.',
 'medium', 'Данные о травмах летчиков исходят от телеграм-канала Mash и официально не подтверждены; причина крушения неизвестна.', False,
 ('У Калінінградській області розбився винищувач Су-30; Міноборони РФ: загрози життю льотчиків немає, Mash: обидва поранені',
  'Калінінградська область',
  'Усі групи спираються на заяву Міноборони Росії про катастрофу під час навчального польоту без жертв. Російське джерело та український переказ обмежуються формулюванням «загрози життю льотчиків немає»; незалежні видання з посиланням на Mash додають, що обидва льотчики отримали травми і госпіталізовані, і наголошують, що причину катастрофи не названо.',
  'ТАСС англійською передає заяву Міноборони Росії: винищувач Су-30 розбився під час планового навчально-тренувального польоту в Калінінградській області, екіпаж катапультувався і був евакуйований наземною пошуково-рятувальною групою, загрози життю льотчиків немає; літак летів без боєкомплекту і впав у безлюдній місцевості. Про травми екіпажу та причини катастрофи агентство не повідомляє.',
  '«Суспільне» з посиланням на «Интерфакс» і Міноборони РФ повідомляє про катастрофу Су-30 під час «планового навчально-тренувального» польоту: загрози життю льотчиків немає, літак упав у безлюдному районі, політ виконувався без боєкомплекту. Видання уточнює, що Су-30 — двомісний багатоцільовий винищувач ПКС і морської авіації Росії.',
  '«Медуза» передає версію Міноборони і додає дані близького до силовиків телеграм-каналу Mash: упав Су-30СМ, неподалік Черняховська, льотчиків із травмами доставили до військового госпіталю; відео падіння оприлюднив український моніторинговий канал. The Kyiv Independent також посилається на Mash про те, що обидва пілоти поранені, і зазначає, що Москва не пояснила причину катастрофи; видання нагадує про зростання напруженості між Росією і НАТО навколо Калінінграда.'),
 ('Su-30 fighter jet crashes in Kaliningrad region; Russian MoD: pilots\' lives not in danger, Mash: both injured',
  'Kaliningrad region',
  'All groups rely on the Russian Defence Ministry\'s statement about a crash during a training flight with no fatalities. The Russian source and the Ukrainian retelling stick to the wording "the pilots\' lives are not in danger"; independent outlets, citing Mash, add that both pilots were injured and hospitalised, and stress that no cause of the crash has been given.',
  'TASS in English relays the Russian Defence Ministry\'s statement: an Su-30 fighter crashed during a scheduled training flight in the Kaliningrad region, the crew ejected and was evacuated by a ground search and rescue team, and the pilots\' lives are not in danger; the aircraft was flying without ammunition and came down in an uninhabited area. The agency says nothing about crew injuries or the cause of the crash.',
  'Suspilne, citing Interfax and the Russian Defence Ministry, reports the crash of an Su-30 during a "scheduled training" flight: the pilots\' lives are not in danger, the plane came down in an uninhabited area, and the flight was carried out without ammunition. The outlet notes that the Su-30 is a two-seat multirole fighter of Russia\'s Aerospace Forces and naval aviation.',
  'Meduza relays the Defence Ministry\'s version and adds information from the security-linked Telegram channel Mash: an Su-30SM went down near Chernyakhovsk, and the pilots were taken to a military hospital with injuries; a video of the crash was published by a Ukrainian monitoring channel. The Kyiv Independent also cites Mash as saying both pilots were injured, and notes that Moscow has not explained the cause of the crash; the outlet recalls rising tensions between Russia and NATO over Kaliningrad.'))
json.dump(cards, open(OUT + 'c21a.json', 'w'), ensure_ascii=False, indent=1)
print('c21a', len(cards))
