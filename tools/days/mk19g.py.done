# ---- quote pre-check against the DB (new cards + extension quotes)
db = sqlite3.connect('/workspace/compare-site-v2/data/articles.db')
n = lambda s: re.sub(r'\s+', ' ', s or '')
def chk(i, t):
    r = db.execute('select text from articles where id=?', (i,)).fetchone()
    if not r or n(t) not in n(r[0]): print('QUOTE BAD', i, t[:70])
for c in cards:
    for s in ('ru', 'ua', 'ind'):
        if c[s]:
            for q in c[s]['quotes']: chk(q['id'], q['text'])
if '--dry' in sys.argv: sys.exit()

apply(['c18a.json', 'c18b.json', 'c18c.json', 'c18d.json', 'c19a.json', 'c19b.json', 'c19d.json', 'c19e.json'])
json.dump(cards, open(OUT + 'c19f.json', 'w'), ensure_ascii=False, indent=1)
print('new cards', len(cards))
touched = set(EXT) | {c['key'] for c in cards}
for f in ['c18a.json', 'c18b.json', 'c18c.json', 'c18d.json', 'c19a.json', 'c19b.json', 'c19d.json', 'c19e.json', 'c19f.json']:
    for c in json.load(open(OUT + f)):
        if c['key'] not in touched: continue
        for s in ('ru', 'ua', 'ind'):
            if c[s]:
                for q in c[s]['quotes']: chk(q['id'], q['text'])
        L = [len(c[s]['summary']) for s in ('ru', 'ua', 'ind') if c[s]] + [len(c[l][k]) for l in ('uk', 'en') for k in ('ru', 'ua', 'ind', 'd') if c[l][k]] + [len(c['diverge'])]
        print(c['key'], max(L))
        if max(L) > 1400: print('TOO LONG', f, c['key'], max(L))
        if len(c['title']) > 160: print('TITLE LONG', c['key'], len(c['title']))
