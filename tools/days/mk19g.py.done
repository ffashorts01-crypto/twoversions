import json, sys, sqlite3, re
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
from extlib import add, setd, ext, apply, EXT, NEW
OUT = '/workspace/compare-site-v2/tools/days/out/'
cards = []
card = lambda *a: cards.append(C(*a))

# ---------------- hourly run 09:03 Oct 19 (ids 12312-12479): 2 new Oct 19 cards + extensions ----------------

def rep(c, path, old, new):
    o = c
    for p in path[:-1]: o = o[p]
    assert old in o[path[-1]], (c['key'], path, old[:40])
    o[path[-1]] = o[path[-1]].replace(old, new)

card('1019-mod-targets-kyiv-irpin', [12337, 12339, 12341, 12342, 12343, 12385, 12386, 12387, 12389, 12418, 12426, 12475, 12476, 12479, 12338, 12382, 12477, 12429, 12466, 12467, 12451],
 'Минобороны РФ называет цели удара по Киеву и Ирпеню — «Файер Пойнт», «Химволокно», депо, «Планета пластик»; в Ирпене погибла женщина, трое пропали без вести', 'Киев, Киевская область, Черное море', 'kyiv',
 ['не проверено', 'умолчание', 'одна из групп не освещает'],
 S('Минобороны РФ утром 19 октября перечислило цели ночного массированного удара высокоточным оружием наземного базирования и ударными беспилотниками. В Киеве, по его данным, поражены дата-центр «Дата групп»; логистический узел «Файер Пойнт», который, по версии ведомства, производил и хранил комплектующие для дальних ударных БПЛА и двигатели для крылатых ракет FP-5 «Фламинго»; предприятие «Химволокно», выпускавшее, как утверждается, компоненты боевых частей беспилотников; и локомотивное депо, где, по данным министерства, хранились ракеты FP-5 «Фламинго» и комплектующие к баллистическим ракетам FP-9. В Киевской области назван завод «Планета пластик» в Ирпене, производящий, по словам ведомства, полимерные материалы для нужд военной промышленности. Кроме того, Минобороны заявило о поражении сухогруза с грузами военного и двойного назначения в 130 км юго-западнее порта Одесса. Список целей передают РИА Новости, ТАСС и «Интерфакс»; о жертвах и повреждениях жилья российские источники не пишут.',
   (12342, 'В городе Киеве поражены: центр обработки данных (дата-центр "Дата Групп")'),
   (12343, 'логистический узел "Файер Пойнт", осуществляющий производство и хранение комплектующих для ударных БПЛА самолетного типа большой дальности, а также двигателей для крылатых ракет наземного базирования FP-5 "Фламинго"'),
   (12476, 'промышленное предприятие ОАО "Химволокно АП", которое производило компоненты для боевых частей беспилотников большой и средней дальности'),
   (12341, 'локомотивное депо Киев, на котором организовано складирование и хранение крылатых ракет наземного базирования FP-5 "Фламинго", а также комплектующих к баллистическим ракетам FP-9'),
   (12479, 'В Киевской области поражено промышленное предприятие Ирпень (завод "Планета пластик"), осуществляющее производство полимерных материалов для нужд военной промышленности'),
   (12477, 'При переходе морем в 130 км юго-западнее порта Одесса поражено морское судно типа сухогруз, перевозившее в грузы военного и двойного назначения')),
 S('Глава Киевской ОВА Тимур Ткаченко, слова которого передают «Общественное» и РБК-Украина, сообщил, что ночью Россия нанесла по Киевщине комбинированный удар баллистическими и крылатыми ракетами и ударными беспилотниками. В Ирпене ранены шесть человек, среди них трое детей, еще трое пропали без вести, их ищут; по словам первого заместителя городского головы Александра Пащинского, в результате прямого попадания в частный сектор погибла женщина. В Бучанском районе повреждены 11 частных домов, 6 автомобилей, производственное и складское помещения и заведение образования, в Вышгородском районе — частный дом, 5 автомобилей и объект инфраструктуры. Воздушные силы ВСУ сообщают, что Россия запустила баллистические ракеты «Искандер-М» и С-400 из Смоленской, Брянской и Курской областей, крылатые ракеты «Искандер-К» и 269 ударных дронов; по состоянию на 09:00 сбиты или подавлены 247 целей — 4 крылатые ракеты и 243 дрона, попадания зафиксированы на 25 локациях, падение обломков — на 8. Какие именно предприятия пострадали, украинские источники в выборке не уточняют.',
   (12467, 'ворог завдав комбінованого удару балістичними та крилатими ракетами й ударними дронами'),
   (12467, 'В Ірпені Бучанського району травмовано шестеро людей, серед них троє дітей.'),
   (12429, 'В Ірпені внаслідок прямого влучання по приватному сектору загинула жінка'),
   (12429, 'Загалом у Бучанському районі пошкоджено 11 приватних будинків, 6 автомобілів, виробниче та складське приміщення, заклад освіти'),
   (12466, 'Росія випустила балістичні ракети Іскандер-М та С-400'),
   (12466, 'Влучання зафіксували на 25 локаціях. Ще на 8 локаціях впали уламки збитих цілей.'),
   (12451, 'протиповітряною обороною збито/подавлено 247 цілей')),
 None,
 'Минобороны РФ называет пораженные объекты военными: «Файер Пойнт», «Химволокно», локомотивное депо и дата-центр «Дата групп» в Киеве, завод «Планета пластик» в Ирпене. Украинские источники в выборке эти объекты не называют и заявление Минобороны не комментируют; они пишут о погибшей женщине, шести раненых, в том числе троих детях, и трех пропавших без вести в Ирпене, о поврежденных частных домах, автомобилях, производственном и складском помещениях и заведении образования. О жертвах и повреждениях жилья российские источники не пишут, а число ракет и дронов приводят только Воздушные силы ВСУ. О сухогрузе у Одессы украинские источники в выборке не сообщают. Независимых сообщений в выборке нет.',
 'medium', 'Заявления Минобороны РФ о военном назначении пораженных объектов независимо не проверены; украинские источники не называют пострадавшие предприятия, данные о раненых и пропавших без вести предварительные.', False,
 ['Міноборони РФ називає цілі удару по Києву та Ірпеню — «Файер Пойнт», «Хімволокно», депо, «Планета пластик»; в Ірпені загинула жінка, троє зникли безвісти', 'Київ, Київська область, Чорне море',
  'Міноборони РФ називає уражені об’єкти військовими: «Файер Пойнт», «Хімволокно», локомотивне депо і дата-центр «Дата груп» у Києві, завод «Планета пластик» в Ірпені. Українські джерела у вибірці ці об’єкти не називають і заяву Міноборони не коментують; вони пишуть про загиблу жінку, шістьох поранених, зокрема трьох дітей, і трьох зниклих безвісти в Ірпені, про пошкоджені приватні будинки, автомобілі, виробниче і складське приміщення та заклад освіти. Про жертви і пошкодження житла російські джерела не пишуть, а кількість ракет і дронів наводять лише Повітряні сили ЗСУ. Про суховантаж біля Одеси українські джерела у вибірці не повідомляють. Незалежних повідомлень у вибірці немає.',
  'Міноборони РФ уранці 19 жовтня перелічило цілі нічного масованого удару високоточною зброєю наземного базування та ударними безпілотниками. У Києві, за його даними, уражено дата-центр «Дата груп»; логістичний вузол «Файер Пойнт», який, за версією відомства, виробляв і зберігав комплектуючі для далекобійних ударних БпЛА та двигуни для крилатих ракет FP-5 «Фламінго»; підприємство «Хімволокно», що випускало, як стверджується, компоненти бойових частин безпілотників; і локомотивне депо, де, за даними міністерства, зберігалися ракети FP-5 «Фламінго» та комплектуючі до балістичних ракет FP-9. У Київській області названо завод «Планета пластик» в Ірпені, що виробляє, за словами відомства, полімерні матеріали для потреб військової промисловості. Крім того, Міноборони заявило про ураження суховантажу з вантажами військового і подвійного призначення за 130 км на південний захід від порту Одеса. Перелік цілей передають РИА Новости, ТАСС та «Інтерфакс»; про жертви і пошкодження житла російські джерела не пишуть.',
  'Голова Київської ОВА Тимур Ткаченко, слова якого передають «Суспільне» і РБК-Україна, повідомив, що вночі Росія завдала по Київщині комбінованого удару балістичними і крилатими ракетами та ударними безпілотниками. В Ірпені поранено шістьох людей, серед них трьох дітей, ще троє зникли безвісти, їх шукають; за словами першого заступника міського голови Олександра Пащинського, внаслідок прямого влучання в приватний сектор загинула жінка. У Бучанському районі пошкоджено 11 приватних будинків, 6 автомобілів, виробниче і складське приміщення та заклад освіти, у Вишгородському районі — приватний будинок, 5 автомобілів та об’єкт інфраструктури. Повітряні сили ЗСУ повідомляють, що Росія запустила балістичні ракети «Іскандер-М» і С-400 зі Смоленської, Брянської та Курської областей, крилаті ракети «Іскандер-К» і 269 ударних дронів; станом на 09:00 збито або подавлено 247 цілей — 4 крилаті ракети і 243 дрони, влучання зафіксовано на 25 локаціях, падіння уламків — на 8. Які саме підприємства постраждали, українські джерела у вибірці не уточнюють.',
  None],
 ['Russian MoD names targets of the strike on Kyiv and Irpin — Fire Point, Khimvolokno, a depot, Planeta Plastik; in Irpin a woman was killed and three are missing', 'Kyiv, Kyiv region, Black Sea',
  'The Russian Defence Ministry calls the facilities it hit military targets: Fire Point, Khimvolokno, a locomotive depot and the Data Group data centre in Kyiv, and the Planeta Plastik plant in Irpin. Ukrainian sources in the sample do not name these facilities and do not comment on the ministry\'s statement; they report a woman killed, six injured, including three children, and three missing in Irpin, and damaged private houses, cars, production and warehouse premises and an educational facility. Russian sources do not mention casualties or damage to housing, and only Ukraine\'s Air Force gives the number of missiles and drones. Ukrainian sources in the sample do not report on the cargo ship near Odesa. There are no independent reports in the sample.',
  'On the morning of 19 October the Russian Defence Ministry listed the targets of the overnight massive strike with ground-based precision weapons and attack drones. In Kyiv, it says, it hit the Data Group data centre; the Fire Point logistics hub, which, according to the ministry, produced and stored components for long-range attack drones and engines for FP-5 "Flamingo" cruise missiles; the Khimvolokno plant, which allegedly made components for drone warheads; and a locomotive depot where, according to the ministry, FP-5 "Flamingo" missiles and components for FP-9 ballistic missiles were stored. In the Kyiv region it names the Planeta Plastik plant in Irpin, which, the ministry says, produces polymer materials for the defence industry. The ministry also claimed to have hit a cargo ship carrying military and dual-use goods 130 km south-west of the port of Odesa. RIA Novosti, TASS and Interfax relay the list of targets; Russian sources do not mention casualties or damage to housing.',
  'The head of the Kyiv regional military administration Tymur Tkachenko, quoted by Suspilne and RBC-Ukraine, said Russia struck the Kyiv region overnight in a combined attack with ballistic and cruise missiles and attack drones. In Irpin six people were injured, including three children, and three more are missing and being searched for; according to the first deputy mayor Oleksandr Pashchynskyi, a woman was killed by a direct hit on private houses. In the Bucha district 11 private houses, 6 cars, production and warehouse premises and an educational facility were damaged, and in the Vyshhorod district a private house, 5 cars and an infrastructure facility. Ukraine\'s Air Force says Russia launched Iskander-M and S-400 ballistic missiles from the Smolensk, Bryansk and Kursk regions, Iskander-K cruise missiles and 269 attack drones; as of 09:00, 247 targets had been shot down or suppressed — 4 cruise missiles and 243 drones — with hits recorded at 25 locations and falling debris at 8. Ukrainian sources in the sample do not specify which enterprises were hit.',
  None])

card('1019-energy-strikes-west-centre', [12329, 12384, 12393, 12434, 12449, 12453, 12442, 12454, 12435],
 'Удары по энергетике 19 октября: часть Винницкой области без света и воды, на Волыни без света 66 тыс. абонентов, попадания на Житомирщине и Ровенщине', 'Винницкая, Житомирская, Волынская, Ровенская, Кировоградская, Львовская области', 'ukraine-wide',
 ['умолчание', 'расхождение: формулировки', 'одна из групп не освещает'],
 S('РИА Новости и ТАСС со ссылкой на главу Винницкой областной военной администрации Наталью Заболотную сообщают, что 19 октября часть Винницкой области и областного центра осталась без электро- и водоснабжения; причиной она назвала повреждение энергетической инфраструктуры. ТАСС также пишет, что из-за повреждения инфраструктуры без света осталась часть Ровенской области, где ночью и утром несколько раз объявлялась воздушная тревога. Что именно повредило инфраструктуру, российские агентства не уточняют; об ударах по энергетике других областей российские источники в выборке не сообщают.',
   (12329, 'В части Винницкой области и областного центра сейчас отсутствует электроснабжение и водоснабжение'),
   (12329, 'По ее словам, это связано с повреждением энергетической инфраструктуры.'),
   (12384, 'причиной является повреждение энергетической инфраструктуры'),
   (12393, 'В части Ровненской области нет света из-за повреждения инфраструктуры. Ночью и утром в области несколько раз объявлялась воздушная тревога')),
 S('«Общественное» со ссылкой на местные власти сообщает об ударах по энергетике в нескольких областях. Начальник Житомирской ОВА Виталий Бунечко написал, что объекты энергетики области второй день подряд под ударом, погибших и пострадавших нет; в Бердичевской громаде о попадании беспилотника в объект энергетической инфраструктуры стало известно в 3:20, возник пожар, город готовит водоканал, теплосеть и больницу к работе в условиях отключений. На Волыни, по данным и. о. начальника ОВА Романа Романюка, дроны были направлены на Ковель, Маневичи и Луцк, без электроснабжения остались около 66 тысяч абонентов, в Ковельской громаде есть попадания в объекты энергетики. На Ровенщине зафиксировано попадание в Острожской громаде, а глава ОВА Александр Коваль пишет, что новые атаки усложняют восстановление энергоснабжения. В Компанеевской громаде на Кировоградщине после попадания в объект инфраструктуры нет света. Под Львовом около 08:50 ПВО сбила беспилотник, в селе Зубра повреждены шесть жилых домов и шесть автомобилей.',
   (12434, 'Наразі інформації про загиблих та постраждалих внаслідок ударів не надходило.'),
   (12434, 'стало відомо 19 жовтня о 3:20. На місці виникла пожежа.'),
   (12449, 'без електропостачання залишилися орієнтовно 66 тисяч абонентів'),
   (12442, 'Маємо приліт. Працюють всі екстеренні служби на місці прильоту.'),
   (12453, 'Нові атаки ускладнюють роботу енергетиків з відновлення'),
   (12454, 'Через пошкодження електромереж наразі відсутнє електропостачання.'),
   (12435, 'у селі Зубра Львівського району пошкоджені шість житлових будинків та шість автівок')),
 None,
 'Российские агентства сообщают об отключениях света и воды в Винницкой и Ровенской областях со ссылкой на украинские власти, но пишут лишь о «повреждении инфраструктуры», не связывая его с ударами. Украинские источники описывают атаки беспилотников и попадания по энергетике на Житомирщине, Волыни, Ровенщине и Кировоградщине и сбитый под Львовом дрон; об этих ударах российские источники в выборке не пишут. Об отключениях в Винницкой области, напротив, в выборке сообщают только российские агентства, пересказывая главу ОВА. Независимых сообщений в выборке нет.',
 'medium', 'Данные предварительные: причина отключений в Винницкой области в выборке не уточняется, последствия атак на Волыни и Ровенщине уточняются.', False,
 ['Удари по енергетиці 19 жовтня: частина Вінницької області без світла і води, на Волині без світла 66 тис. абонентів, влучання на Житомирщині та Рівненщині', 'Вінницька, Житомирська, Волинська, Рівненська, Кіровоградська, Львівська області',
  'Російські агентства повідомляють про відключення світла і води у Вінницькій та Рівненській областях з посиланням на українську владу, але пишуть лише про «пошкодження інфраструктури», не пов’язуючи його з ударами. Українські джерела описують атаки безпілотників і влучання по енергетиці на Житомирщині, Волині, Рівненщині та Кіровоградщині і збитий під Львовом дрон; про ці удари російські джерела у вибірці не пишуть. Про відключення у Вінницькій області, навпаки, у вибірці повідомляють лише російські агентства, переказуючи голову ОВА. Незалежних повідомлень у вибірці немає.',
  'РИА Новости і ТАСС з посиланням на голову Вінницької обласної військової адміністрації Наталю Заболотну повідомляють, що 19 жовтня частина Вінницької області та обласного центру залишилася без електро- і водопостачання; причиною вона назвала пошкодження енергетичної інфраструктури. ТАСС також пише, що через пошкодження інфраструктури без світла залишилася частина Рівненської області, де вночі та вранці кілька разів оголошували повітряну тривогу. Що саме пошкодило інфраструктуру, російські агентства не уточнюють; про удари по енергетиці інших областей російські джерела у вибірці не повідомляють.',
  '«Суспільне» з посиланням на місцеву владу повідомляє про удари по енергетиці в кількох областях. Начальник Житомирської ОВА Віталій Бунечко написав, що об’єкти енергетики області другий день поспіль під ударом, загиблих і постраждалих немає; у Бердичівській громаді про влучання безпілотника в об’єкт енергетичної інфраструктури стало відомо о 3:20, виникла пожежа, місто готує водоканал, тепломережу і лікарню до роботи в умовах відключень. На Волині, за даними в. о. начальника ОВА Романа Романюка, дрони були спрямовані на Ковель, Маневичі та Луцьк, без електропостачання залишилися близько 66 тисяч абонентів, у Ковельській громаді є влучання в об’єкти енергетики. На Рівненщині зафіксовано влучання в Острозькій громаді, а голова ОВА Олександр Коваль пише, що нові атаки ускладнюють відновлення енергопостачання. У Компаніївській громаді на Кіровоградщині після влучання в об’єкт інфраструктури немає світла. Під Львовом близько 08:50 ППО збила безпілотник, у селі Зубра пошкоджено шість житлових будинків і шість автомобілів.',
  None],
 ['Strikes on energy facilities on 19 October: part of the Vinnytsia region without power and water, 66 thousand customers without power in Volyn, hits in the Zhytomyr and Rivne regions', 'Vinnytsia, Zhytomyr, Volyn, Rivne, Kirovohrad, Lviv regions',
  'Russian agencies report power and water outages in the Vinnytsia and Rivne regions, citing Ukrainian officials, but speak only of "damage to infrastructure" without linking it to strikes. Ukrainian sources describe drone attacks and hits on energy facilities in the Zhytomyr, Volyn, Rivne and Kirovohrad regions and a drone shot down near Lviv; Russian sources in the sample do not mention these strikes. Conversely, only Russian agencies in the sample report the outages in the Vinnytsia region, relaying the regional governor. There are no independent reports in the sample.',
  'RIA Novosti and TASS, citing the head of the Vinnytsia regional military administration Nataliia Zabolotna, report that on 19 October part of the Vinnytsia region and the regional centre was left without electricity and water; she named damage to energy infrastructure as the cause. TASS also writes that part of the Rivne region was left without power because of damage to infrastructure, with several air-raid alerts there overnight and in the morning. The Russian agencies do not specify what damaged the infrastructure; Russian sources in the sample do not report strikes on energy facilities in other regions.',
  'Suspilne, citing local officials, reports strikes on energy facilities in several regions. The head of the Zhytomyr regional military administration Vitalii Bunechko wrote that the region\'s energy facilities had been under attack for the second day in a row, with no one killed or injured; in the Berdychiv community a drone hit on an energy facility became known at 3:20 and caused a fire, and the town is preparing its water utility, heating company and hospital to work during outages. In Volyn, according to acting regional administration head Roman Romaniuk, drones were aimed at Kovel, Manevychi and Lutsk, about 66 thousand customers were left without power, and there were hits on energy facilities in the Kovel community. In the Rivne region a hit was recorded in the Ostroh community, and regional administration head Oleksandr Koval writes that new attacks are complicating the restoration of power. In the Kompaniivka community of the Kirovohrad region an infrastructure facility was hit and there is no power. Near Lviv air defence shot down a drone at about 08:50, damaging six houses and six cars in the village of Zubra.',
  None])

# ---- extensions

@ext('1019-kyiv-ballistic-night', [12464, 12468])
def _(c):
    # Sport RBC 12468 (ice arena on Shalett Street damaged) - id only, card at the length limit
    rep(c, ('ua', 'summary'), '; со ссылкой на CNN издание пишет, что у Украины снова закончились ракеты к Patriot.', '.')
    rep(c, ('uk', 'ua'), '; з посиланням на CNN видання пише, що в Україні знову закінчилися ракети до Patriot.', '.')
    rep(c, ('en', 'ua'), '; citing CNN, the outlet writes that Ukraine has again run out of Patriot missiles.', '.')
    c['ua']['quotes'] = [q for q in c['ua']['quotes'] if 'CNN' not in q['text']]
    rep(c, ('ua', 'summary'), '; на автобусные маршруты добавлены машины.', '.')
    rep(c, ('uk', 'ua'), '; на автобусні маршрути додано машини.', '.')
    rep(c, ('en', 'ua'), '; extra buses were added.', '.')
    add(c, 'ua', 'Утром РБК-Украина со ссылкой на ГСЧС сообщила, что всего за ночь в Киеве погиб один человек и восемь пострадали; в Соломенском районе, по словам Кличко, пострадавших уже пятеро, одного госпитализировали.',
        'Уранці РБК-Україна з посиланням на ДСНС повідомила, що загалом за ніч у Києві загинула одна людина і вісім постраждали; у Солом’янському районі, за словами Кличка, постраждалих уже п’ятеро, одного госпіталізували.',
        'In the morning RBC-Ukraine, citing the State Emergency Service, reported one person killed and eight injured in Kyiv overnight in total; in the Solomianskyi district, Klitschko said, five were injured, one hospitalised.',
        [(12464, 'Загалом, за даними ДСНС, внаслідок нічного удару загинула людина і ще вісім постраждали.'),
         (12464, 'Одного пораненого госпіталізували.')])
    rep(c, ('uncertainty_reason',), 'о пострадавших при второй атаке известно только из «Общественного»,', 'число пострадавших растет (по данным ГСЧС, за ночь в Киеве один погибший и восемь пострадавших),')

@ext('1019-strikes-regions-rivne-dnipro', [12421, 12437])
def _(c):
    # SUS 12437: Dnipro resident's account of the 5 a.m. guided-bomb strike (same event) - id only
    add(c, 'ru', 'Позже ТАСС сообщило о взрыве в Кривом Роге на фоне воздушной тревоги в Днепропетровской области.',
        'Пізніше ТАСС повідомило про вибух у Кривому Розі на тлі повітряної тривоги в Дніпропетровській області.',
        'Later TASS reported an explosion in Kryvyi Rih amid an air-raid alert in the Dnipropetrovsk region.',
        [(12421, 'В Кривом Роге произошел взрыв. В Днепропетровской области объявлена воздушная тревога')])
    for path, old, new in [
        (('diverge',), 'о взрывах в Ровно и Днепре и о том', 'о взрывах в Ровно, Днепре и Кривом Роге и о том'),
        (('uk', 'd'), 'про вибухи в Рівному і Дніпрі та про те', 'про вибухи в Рівному, Дніпрі та Кривому Розі і про те'),
        (('en', 'd'), 'report only explosions in Rivne and Dnipro and that', 'report only explosions in Rivne, Dnipro and Kryvyi Rih and that')]:
        rep(c, path, old, new)

@ext('1019-rubio-intel-sanctions-apec', [12318, 12323, 12370, 12379, 12469, 12459])
def _(c):
    # RIA 12323, TASS EN 12370, 12379: same Rubio quotes (focus on settlement, "everything we can", 60 days) - ids only
    add(c, 'ru', 'РИА Новости также приводит отказ Рубио обсуждать на пресс-конференции желание Киева расширить использование Starshield для атак за пределами Украины; систему, по его словам, контролирует Пентагон, и Киев продолжает обсуждать этот вопрос с ведомством.',
        'РИА Новости також наводить відмову Рубіо обговорювати на пресконференції бажання Києва розширити використання Starshield для атак за межами України; систему, за його словами, контролює Пентагон, і Київ продовжує обговорювати це питання з відомством.',
        'RIA Novosti also reports Rubio\'s refusal to discuss at the press conference Kyiv\'s wish to expand the use of Starshield for attacks beyond Ukraine; the system, he said, is controlled by the Pentagon, and Kyiv is still discussing the issue with it.',
        [(12318, 'это не то, что я собираюсь обсуждать на пресс-конференции'),
         (12318, 'систему Starshield контролирует Пентагон и Киев продолжает обсуждать этот вопрос с ведомством')])
    add(c, 'ua', 'Представитель Воздушных сил Юрий Игнат, слова которого передает РБК-Украина, сказал, что ночью баллистикой по Киеву били дважды, в 23:00 и в три часа ночи: перед первым ударом предупреждения от партнеров не было, а в три часа информация от них уже поступила; специалисты вместе с партнерами разбираются в ситуации, поскольку такой случай не первый.',
        'Речник Повітряних сил Юрій Ігнат, слова якого передає РБК-Україна, сказав, що вночі балістикою по Києву били двічі, о 23:00 і о третій ночі: перед першим ударом попередження від партнерів не було, а о третій інформація від них уже надійшла; фахівці разом із партнерами розбираються в ситуації, бо такий випадок не перший.',
        'Air Force spokesman Yurii Ihnat, quoted by RBC-Ukraine, said ballistic missiles were fired at Kyiv twice overnight, at 23:00 and at three in the morning: there was no warning from partners before the first strike, while at three the information from them did arrive; specialists and the partners are looking into the situation, as this is not the first such case.',
        [(12469, 'Першого разу попередження не надійшло з певних причин.'),
         (12469, 'О третій ночі інформація від партнерів уже була.'),
         (12469, 'Фахівці разом із партнерами розбираються в ситуації, бо такий випадок не перший.')])
    add(c, 'ind', 'Meduza в заметке об ударе по Киеву, где, по словам Кличко, погибла 21-летняя девушка, пишет со ссылкой на журналиста «Радио Свобода» Алекса Рауфоглу, что Украину вновь не предупредили о баллистическом ударе, и приводит ответ Рубио: он не знает, что произошло прошлой ночью, а несколько ночей назад возникла программная проблема с системой раннего предупреждения Украины, которую изучает EUCOM; от дальнейших комментариев, по данным издания, Рубио воздержался.',
        'Meduza у замітці про удар по Києву, де, за словами Кличка, загинула 21-річна дівчина, пише з посиланням на журналіста «Радіо Свобода» Алекса Рауфоглу, що Україну знову не попередили про балістичний удар, і наводить відповідь Рубіо: він не знає, що сталося минулої ночі, а кілька ночей тому виникла програмна проблема із системою раннього попередження України, яку вивчає EUCOM; від подальших коментарів, за даними видання, Рубіо утримався.',
        'Meduza, in a report on the strike on Kyiv in which, according to Klitschko, a 21-year-old woman was killed, writes, citing Radio Liberty journalist Alex Raufoglu, that Ukraine was again not warned of the ballistic strike, and quotes Rubio\'s answer: he does not know what happened last night, while a few nights ago there was a software problem with Ukraine\'s early warning system, which EUCOM is looking into; according to the outlet, Rubio declined to comment further.',
        [(12459, 'Украина вновь не была предупреждена о баллистическом ударе по Киеву'),
         (12459, 'Я не знаю, что произошло прошлой ночью. Несколько ночей назад возникла программная проблема, связанная с системой раннего предупреждения Украины.'),
         (12459, 'от дальнейших комментариев Рубио воздержался')])
    for path, old, new in [
        (('diverge',), 'Независимых сообщений в выборке нет.', 'Meduza приводит ту же цитату Рубио, что и РБК-Украина, и связывает ее с ночным ударом по Киеву. Представитель Воздушных сил Игнат уточняет, что предупреждения от партнеров не было только перед первым из двух ночных ударов; российские источники в выборке об этом не пишут.'),
        (('uk', 'd'), 'Незалежних повідомлень у вибірці немає.', 'Meduza наводить ту саму цитату Рубіо, що й РБК-Україна, і пов’язує її з нічним ударом по Києву. Речник Повітряних сил Ігнат уточнює, що попередження від партнерів не було лише перед першим із двох нічних ударів; російські джерела у вибірці про це не пишуть.'),
        (('en', 'd'), 'There are no independent reports in the sample.', 'Meduza quotes the same Rubio remark as RBC-Ukraine and links it to the overnight strike on Kyiv. Air Force spokesman Ihnat specifies that there was no warning from partners only before the first of the two overnight strikes; Russian sources in the sample do not mention this.')]:
        rep(c, path, old, new)
    c['tags'] = [t for t in c['tags'] if t != 'одна из групп не освещает']

@ext('1019-peskov-trilateral-meeting', [12461])
def _(c):
    # DWr 12462 is a duplicate of 12461 (SKIPPED.md)
    add(c, 'ind', 'DW со ссылкой на The Wall Street Journal и ее источники пишет, что Путин предложил провести встречу с Трампом и Си Цзиньпином, чтобы договориться об окончании четырехлетней войны в Украине на условиях Москвы, на полях саммита АТЭС, который пройдет 18 и 19 ноября в китайском Шэньчжэне; идею Кремль выдвинул в телефонном разговоре с Трампом 9 октября, когда договорились и о поставках российского дизельного топлива в США. DW приводит ту же цитату Пескова и слова высокопоставленного представителя администрации США: Трамп пока не согласился на саммит, но может отнестись к идее благосклонно.',
        'DW з посиланням на The Wall Street Journal та її джерела пише, що Путін запропонував провести зустріч із Трампом і Сі Цзіньпіном, щоб домовитися про закінчення чотирирічної війни в Україні на умовах Москви, на полях саміту АТЕС, який відбудеться 18 і 19 листопада в китайському Шеньчжені; ідею Кремль висунув у телефонній розмові з Трампом 9 жовтня, коли домовилися і про постачання російського дизельного пального до США. DW наводить ту саму цитату Пєскова і слова високопосадовця адміністрації США: Трамп поки не погодився на саміт, але може поставитися до ідеї прихильно.',
        'DW, citing The Wall Street Journal and its sources, writes that Putin proposed a meeting with Trump and Xi Jinping to agree on ending the four-year war in Ukraine on Moscow\'s terms, on the sidelines of the APEC summit to be held on 18 and 19 November in Shenzhen, China; the Kremlin put forward the idea in a phone call with Trump on 9 October, when supplies of Russian diesel fuel to the US were also agreed. DW quotes the same Peskov remark and a senior US administration official: Trump has not yet agreed to the summit but may look favourably on the idea.',
        [(12461, 'чтобы договориться об окончании четырехлетней войны в Украине на условиях Москвы'),
         (12461, 'Кремль предложил провести переговоры на полях саммита Азиатско-Тихоокеанского экономического сотрудничества (АТЭС)'),
         (12461, 'глава Белого дома пока не согласился на проведение такого саммита, но может благосклонно отнестись к этой идее')])
    for path, old, new in [
        (('diverge',), 'Независимых сообщений в выборке нет. ', 'DW со ссылкой на WSJ также пишет, что цель предложенной встречи — договориться об окончании войны на условиях Москвы: эта формулировка восходит к источникам газеты, а не к цитате Пескова. '),
        (('uk', 'd'), 'Незалежних повідомлень у вибірці немає. ', 'DW з посиланням на WSJ також пише, що мета запропонованої зустрічі — домовитися про закінчення війни на умовах Москви: це формулювання походить від джерел газети, а не з цитати Пєскова. '),
        (('en', 'd'), 'There are no independent reports in the sample. ', 'DW, citing the WSJ, also writes that the purpose of the proposed meeting is to agree on ending the war on Moscow\'s terms: this wording comes from the paper\'s sources, not from Peskov\'s quote. ')]:
        rep(c, path, old, new)
    c['uncertainty_reason'] = 'О цели саммита — завершить войну на условиях Москвы — РБК-Украина и DW пишут со ссылкой на источники WSJ; то, что Зеленского не позовут, в выборке не подкреплено цитатой, а сам Песков говорит, что повестки пока нет.'
    c['tags'] = [t for t in c['tags'] if t != 'одна из групп не освещает']

@ext('1019-front-claims', [12425, 12431, 12458])
def _(c):
    # TASSr 12425 (MoD: shelters and a drone control point destroyed in the "DPR") - id only
    rep(c, ('ua', 'summary'), ' О ситуации в Сумской и Харьковской областях украинские источники в выборке 19 октября не сообщают.', '')
    rep(c, ('uk', 'ua'), ' Про ситуацію в Сумській та Харківській областях українські джерела у вибірці 19 жовтня не повідомляють.', '')
    rep(c, ('en', 'ua'), ' Ukrainian sources in the sample on 19 October do not report on the situation in the Sumy and Kharkiv regions.', '')
    add(c, 'ua', 'Всего, по данным Генштаба, за сутки произошло 204 боевых столкновения: больше всего атак на Покровском направлении — 30, в том числе в сторону Доброполья, на Константиновском — 21, на Купянском — 11; на Северо-Слобожанском и Курском направлениях было три штурмовых действия, на Южно-Слобожанском отбиты две атаки. Российская армия, по данным Генштаба, нанесла 82 авиаудара, сбросив 273 управляемые авиабомбы, и применила 9154 дрона-камикадзе.',
        'Загалом, за даними Генштабу, за добу відбулося 204 бойові зіткнення: найбільше атак на Покровському напрямку — 30, зокрема в бік Добропілля, на Костянтинівському — 21, на Куп’янському — 11; на Північно-Слобожанському і Курському напрямках було три штурмові дії, на Південно-Слобожанському відбито дві атаки. Російська армія, за даними Генштабу, завдала 82 авіаударів, скинувши 273 керовані авіабомби, і застосувала 9154 дрони-камікадзе.',
        'In total, according to the General Staff, there were 204 combat clashes in a day: most attacks in the Pokrovsk direction — 30, including towards Dobropillia — 21 in the Kostiantynivka direction and 11 in the Kupiansk direction; there were three assaults in the North Slobozhanskyi and Kursk directions, and two attacks were repelled in the South Slobozhanskyi direction. The Russian army, according to the General Staff, carried out 82 air strikes, dropping 273 guided bombs, and used 9154 kamikaze drones.',
        [(12431, 'На Покровському напрямку росіяни атакували 30 разів'),
         (12431, 'На Костянтинівському напрямку зафіксовано 21 атаку.'),
         (12431, 'На Південно-Слобожанському напрямку українські підрозділи відбили дві атаки росіян.'),
         (12431, 'здійснили 82 авіаційні удари, під час яких скинули 273 керовані авіабомби')])
    add(c, 'ind', 'Kyiv Independent передает данные Генштаба ВСУ: с начала полномасштабного вторжения Россия потеряла 1 567 160 военных, из них 2100 — за последние сутки. Издание отмечает, что Генштаб не раскрывает собственные потери Украины, и приводит оценку CSIS, по которой соотношение потерь составляет «примерно 2,5:1 или 2:1»; по январскому докладу CSIS, Украина с февраля 2022 по декабрь 2025 года, вероятно, потеряла от 500 000 до 600 000 человек убитыми и ранеными.',
        'Kyiv Independent передає дані Генштабу ЗСУ: від початку повномасштабного вторгнення Росія втратила 1 567 160 військових, з них 2100 — за останню добу. Видання зазначає, що Генштаб не розкриває власних втрат України, і наводить оцінку CSIS, за якою співвідношення втрат становить «приблизно 2,5:1 або 2:1»; за січневою доповіддю CSIS, Україна з лютого 2022 по грудень 2025 року, ймовірно, втратила від 500 000 до 600 000 осіб убитими й пораненими.',
        'The Kyiv Independent relays the Ukrainian General Staff\'s figures: since the start of the full-scale invasion Russia has lost 1 567 160 troops, 2100 of them in the past day. The outlet notes that the General Staff does not disclose Ukraine\'s own losses and cites a CSIS estimate putting the casualty ratio at "roughly 2.5:1 or 2:1"; according to a January CSIS report, Ukraine likely suffered between 500 000 and 600 000 killed and wounded from February 2022 to December 2025.',
        [(12458, 'Ukraine\'s General Staff has not revealed its own losses during the full-scale invasion, citing operational secrecy.'),
         (12458, 'roughly 2.5:1 or 2:1.'),
         (12458, 'Ukraine has likely suffered between 500,000 and 600,000 casualties from February 2022 to December 2025')])
    setd(c,
        'Российские источники пишут о продвижении и потерях ВСУ в Сумской и Харьковской областях: Марочко говорит о 12 населенных пунктах и около 100 кв. км за неделю, бойцы «Севера» — о завершении ликвидации окруженных подразделений ВСУ на северо-востоке Харьковской области. Генштаб ВСУ сообщает о 204 боестолкновениях за сутки, больше всего — на Покровском, Константиновском и Купянском направлениях, а на северных направлениях — лишь о нескольких штурмах и отбитых атаках; заявления о потере населенных пунктов украинские источники в выборке не комментируют. Потери каждая сторона приводит только для противника (Марочко — 9 тыс. за неделю, Генштаб ВСУ — 2100 за сутки). Kyiv Independent добавляет, что Генштаб не раскрывает потери Украины, и приводит оценку CSIS о значительно более высоких потерях России; независимо данные сторон не проверяются.',
        'Російські джерела пишуть про просування і втрати ЗСУ в Сумській та Харківській областях: Марочко говорить про 12 населених пунктів і близько 100 кв. км за тиждень, бійці «Севера» — про завершення ліквідації оточених підрозділів ЗСУ на північному сході Харківської області. Генштаб ЗСУ повідомляє про 204 боєзіткнення за добу, найбільше — на Покровському, Костянтинівському та Куп’янському напрямках, а на північних напрямках — лише про кілька штурмів і відбиті атаки; заяви про втрату населених пунктів українські джерела у вибірці не коментують. Втрати кожна сторона наводить лише для противника (Марочко — 9 тис. за тиждень, Генштаб ЗСУ — 2100 за добу). Kyiv Independent додає, що Генштаб не розкриває втрат України, і наводить оцінку CSIS про значно вищі втрати Росії; незалежно дані сторін не перевіряються.',
        'Russian sources write about advances and Ukrainian losses in the Sumy and Kharkiv regions: Marochko speaks of 12 settlements and about 100 sq km in a week, "Sever" soldiers of having finished eliminating encircled Ukrainian units in the north-east of the Kharkiv region. Ukraine\'s General Staff reports 204 clashes in a day, most of them in the Pokrovsk, Kostiantynivka and Kupiansk directions, and only a few assaults and repelled attacks in the northern directions; Ukrainian sources in the sample do not comment on the claims of settlements lost. Each side gives losses only for the enemy (Marochko: 9 thousand in a week; Ukraine\'s General Staff: 2100 in a day). The Kyiv Independent adds that the General Staff does not disclose Ukraine\'s losses and cites a CSIS estimate of much higher Russian losses; the figures of both sides are not independently verified.')
    c['tags'] = [t for t in c['tags'] if t != 'одна из групп не освещает']
    c['uncertainty_reason'] = 'Заявления о продвижении и потерях противника не проверены независимо; Генштаб ВСУ не подтверждает и не опровергает заявления о населенных пунктах.'

@ext('1018-st-petersburg-drone-attack', [12350, 12415])
def _(c):
    add(c, 'ru', 'Утром 19 октября комитет по ТЭК Ленобласти сообщил, что в Янино все потребители снова подключены к электроснабжению; по данным РИА Новости, отключение затрагивало 50 многоквартирных домов, около 20 тысяч человек, ТАСС пишет о 50 тыс. человек.',
        'Уранці 19 жовтня комітет з ПЕК Ленобласті повідомив, що в Яніно всіх споживачів знову підключено до електропостачання; за даними РИА Новости, відключення стосувалося 50 багатоквартирних будинків, близько 20 тисяч людей, ТАСС пише про 50 тис. людей.',
        'On the morning of 19 October the Leningrad region\'s fuel and energy committee said all consumers in Yanino had been reconnected to the power supply; according to RIA Novosti, the outage affected 50 apartment blocks and about 20 thousand people, while TASS writes of 50 thousand people.',
        [(12350, 'все потребители и организации в Янино полностью подключены к электроснабжению'),
         (12415, 'Электричество было отключено у 50 тыс. человек')])
    for path, old, new in [
        (('diverge',), 'по подсчету Meduza.', 'по подсчету Meduza. Число отключенных от света в Янино российские агентства приводят по-разному: РИА — около 20 тысяч человек, ТАСС — 50 тысяч.'),
        (('uk', 'd'), 'за підрахунком Meduza.', 'за підрахунком Meduza. Кількість відключених від світла в Яніно російські агентства наводять по-різному: РИА — близько 20 тисяч людей, ТАСС — 50 тисяч.'),
        (('en', 'd'), 'per Meduza\'s count.', 'per Meduza\'s count. Russian agencies give different numbers for those cut off from power in Yanino: RIA about 20 thousand people, TASS 50 thousand.')]:
        rep(c, path, old, new)

@ext('1018-moldova-border-guards-returned', [12332])
def _(c):
    add(c, 'ru', '19 октября РИА Новости со ссылкой на Пограничную полицию Молдовы сообщило, что Коваль, поступивший в больницу в Сороках с сотрясением мозга, попросил убежища в Молдове; агентство пишет, что он восемь месяцев пытался оспорить аннулирование освобождения от службы по здоровью, и связывает историю с «силовой мобилизацией» на Украине.',
        '19 жовтня РИА Новости з посиланням на Прикордонну поліцію Молдови повідомило, що Коваль, який потрапив до лікарні в Сороках зі струсом мозку, попросив притулку в Молдові; агентство пише, що він вісім місяців намагався оскаржити анулювання звільнення від служби за станом здоров’я, і пов’язує історію з «силовою мобілізацією» в Україні.',
        'On 19 October RIA Novosti, citing the Moldovan Border Police, reported that Koval, who was taken to hospital in Soroca with a concussion, had asked for asylum in Moldova; the agency writes that he had spent eight months trying to challenge the cancellation of his medical exemption from service and links the story to "forced mobilisation" in Ukraine.',
        [(12332, 'попросил о предоставлении убежища в Республике Молдова'),
         (12332, 'На Украине на фоне нехватки личного состава в ВСУ продолжается силовая мобилизация')])
    for path, old, new in [
        (('diverge',), 'а не сотрудниками военкомата.', 'а не сотрудниками военкомата. О просьбе спасенного об убежище в выборке сообщает только РИА Новости.'),
        (('uk', 'd'), 'а не працівниками військкомату.', 'а не працівниками військкомату. Про прохання врятованого про притулок у вибірці повідомляє лише РИА Новости.'),
        (('en', 'd'), 'not enlistment office staff.', 'not enlistment office staff. Only RIA Novosti in the sample reports the rescued man\'s asylum request.')]:
        rep(c, path, old, new)

@ext('1018-trump-truth-social-zelensky', [12465, 12363])
def _(c):
    # TASSr 12363 (Marochko: Trump's remarks partly driven by the midterms) - in diverge, no quote
    add(c, 'ua', 'В аналитическом материале РБК-Украина со ссылкой на собеседника в украинской власти пишет, что в США считают, будто уступками можно склонить Россию к переговорам и в итоге добиться перемирия или мирного соглашения, а Дмитриев «активно соблазняет» американцев историями о богатствах Арктики; еще одним объяснением курса Трампа издание называет промежуточные выборы в Конгресс 3 ноября.',
        'В аналітичному матеріалі РБК-Україна з посиланням на співрозмовника в українській владі пише, що в США вважають, ніби поступками можна схилити Росію до переговорів і зрештою домогтися перемир’я або мирної угоди, а Дмітрієв «активно спокушає» американців історіями про багатства Арктики; ще одним поясненням курсу Трампа видання називає проміжні вибори до Конгресу 3 листопада.',
        'In an analysis piece RBC-Ukraine, citing a source in the Ukrainian government, writes that Washington believes concessions can bring Russia to the table and eventually achieve a ceasefire or a peace deal, while Dmitriev is "actively tempting" the Americans with stories about the riches of the Arctic; the outlet names the midterm elections to Congress on November 3 as another explanation of Trump\'s course.',
        [(12465, 'американська сторона вважає, що поступками можна схилити Росію до переговорів'),
         (12465, 'Плюс Дмітрієв їх активно спокушає усілякими історіями, як про багатства Арктики'),
         (12465, 'Ще одним поясненням дій Трампа може бути наближення проміжних виборів до Конгресу США, запланованих на 3 листопада.')])
    for path, old, new in [
        (('diverge',), 'France 24 связывает обвинения с выборами в США 3 ноября.', 'France 24 связывает обвинения с выборами в США 3 ноября. С выборами связывают курс Трампа также РБК-Украина и цитируемый ТАСС военный эксперт Андрей Марочко.'),
        (('uk', 'd'), 'France 24 пов’язує звинувачення з виборами в США 3 листопада.', 'France 24 пов’язує звинувачення з виборами в США 3 листопада. З виборами пов’язують курс Трампа також РБК-Україна і цитований ТАСС військовий експерт Андрій Марочко.'),
        (('en', 'd'), 'France 24 ties the accusations to the US election on November 3.', 'France 24 ties the accusations to the US election on November 3. RBC-Ukraine and military expert Andrei Marochko, quoted by TASS, also link Trump\'s course to the elections.')]:
        rep(c, path, old, new)

