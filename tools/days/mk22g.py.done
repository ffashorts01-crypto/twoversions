sys.path.insert(0, "/workspace/compare-site-v2/tools/days")
from lib import S, C
OUT = "/workspace/compare-site-v2/tools/days/out/"
cards = []
card = lambda *a: cards.append(C(*a))
# ---------------- hourly run 22 Oct 05:04 (backlog Oct 20) ----------------
card('1020-zelensky-rubio-early-warning', [14859, 14386, 15136, 14570, 14492, 14674, 14593, 14500],
 'Зеленский и Рубио обсудили перехватчики, раннее предупреждение о баллистике и Starlink; Рубио отрицает отказ Украине, Зеленский — «теперь работает»',
 'Киев, Вашингтон, Осло', 'ukraine-wide',
 ['расхождение: подтверждение', 'умолчание'],
 S("«Интерфакс» передает слова госсекретаря США Марко Рубио журналистам в Индии: Вашингтон не отклонял запросы Украины о поставках зенитных ракет, не вводил ограничений на работу Starlink и не прекращал снабжать Киев разведданными; утверждения украинской стороны об обратном он назвал инсинуациями. О разговоре Зеленского с Рубио и о последующих словах Зеленского, что предупреждения снова поступают, агентство в выборке не сообщает.",
   (15136, 'Мы не принимали решений об отказе от запросов Украины'),
   (15136, 'Утверждения украинской стороны об обратном госсекретарь США назвал не соответствующими действительности инсинуациями.')),
 S("РБК-Украина и «Украинская правда» передают пост Зеленского о «предметном» разговоре с Рубио: обсуждали перехватчики против баллистики, раннее предупреждение о российских баллистических атаках и ситуацию со Starlink/Starshield, которую нужно восстановить; Зеленский поблагодарил за готовность помочь, стороны договорились вскоре снова связаться.",
   (14859, 'Друге раннє попередження про російські атаки балістикою, що є життєво важливим.'),
   (14386, 'Зеленський та Рубіо домовились, що невдовзі знову сконтактують щодо цих питань.')),
 S("The Kyiv Independent пишет, что Украина в последние дни сталкивалась со сбоями в системе раннего предупреждения, зависящей от разведданных США: американские чиновники объясняли их плохой погодой, Рубио — программным сбоем. Би-би-си приводит слова Рубио, назвавшего «скандальными» обвинения, что украинцы гибнут из-за удержания разведданных, и слова советника Сергея Бескрестнова: предупреждения то приходят, то нет. После переговоров в Осло Зеленский, по данным The Guardian, The Kyiv Independent и Би-би-си, сказал, что предупреждения о баллистических ракетах снова поступают и «теперь это работает».",
   (14570, 'American officials have attributed previous outages to "bad weather conditions," while Rubio has cited a software malfunction.'),
   (14492, 'US Secretary of State Marco Rubio earlier rejected as "scandalous" accusations that Ukrainians were dying because the US was withholding intelligence from Kyiv.'),
   (14492, 'Sometimes we receive this information before the attack, another time we [do] not.'),
   (14674, 'He said Ukraine was again receiving advance warnings of ballistic missile attacks, which were seemingly suspended last week by the White House.'),
   (14593, 'Therefore, this morning began with positive signals from the American side')),
 "Российский источник передает только опровержение Рубио: США ничего не прекращали, а украинские утверждения — инсинуации. Украинские издания передают перечень тем разговора со слов Зеленского, но не приводят отрицание Рубио. Независимые издания ставят рядом обе версии: Рубио отрицает удержание разведданных, а Зеленский после Осло говорит, что предупреждения снова поступают, что The Guardian трактует как возобновление передачи данных, по всей видимости приостановленной Белым домом.",
 'medium', 'Был ли перерыв в передаче разведданных намеренным, не подтверждено: США отрицают, Киев говорит о пропущенных предупреждениях, американские чиновники ссылаются на погоду и программный сбой.', True,
 ('Зеленський і Рубіо обговорили перехоплювачі, раннє попередження про балістику та Starlink; Рубіо заперечує відмову Україні, Зеленський — «тепер працює»',
  'Київ, Вашингтон, Осло',
  'Російське джерело передає лише спростування Рубіо: США нічого не припиняли, а українські твердження — інсинуації. Українські видання передають перелік тем розмови зі слів Зеленського, але не наводять заперечення Рубіо. Незалежні видання ставлять поруч обидві версії: Рубіо заперечує утримання розвідданих, а Зеленський після Осло каже, що попередження знову надходять, що The Guardian трактує як відновлення передачі даних, яку, вочевидь, призупинив Білий дім.',
  '«Інтерфакс» передає слова держсекретаря США Марко Рубіо журналістам в Індії: Вашингтон не відхиляв запитів України про постачання зенітних ракет, не запроваджував обмежень на роботу Starlink і не припиняв постачати Києву розвіддані; твердження української сторони про протилежне він назвав інсинуаціями. Про розмову Зеленського з Рубіо та про подальші слова Зеленського, що попередження знову надходять, агентство в добірці не повідомляє.',
  'РБК-Україна та «Українська правда» передають допис Зеленського про «предметну» розмову з Рубіо: обговорювали перехоплювачі проти балістики, раннє попередження про російські балістичні атаки та ситуацію зі Starlink/Starshield, яку треба відновити; Зеленський подякував за готовність допомогти, сторони домовилися невдовзі знову сконтактувати.',
  'The Kyiv Independent пише, що Україна останніми днями стикалася зі збоями в системі раннього попередження, яка залежить від розвідданих США: американські посадовці пояснювали їх поганою погодою, Рубіо — програмним збоєм. Бі-бі-сі наводить слова Рубіо, який назвав «скандальними» звинувачення, що українці гинуть через утримання розвідданих, і слова радника Сергія Бескрестнова: попередження то надходять, то ні. Після переговорів в Осло Зеленський, за даними The Guardian, The Kyiv Independent і Бі-бі-сі, сказав, що попередження про балістичні ракети знову надходять і «тепер це працює».'),
 ('Zelensky and Rubio discuss interceptors, early warning of ballistic missiles and Starlink; Rubio denies refusing Ukraine, Zelensky says "now it works"',
  'Kyiv, Washington, Oslo',
  'The Russian source relays only Rubio\'s denial: the US stopped nothing, and Ukrainian claims are insinuations. Ukrainian outlets relay the list of topics from Zelensky\'s words but do not quote Rubio\'s denial. Independent outlets put both versions side by side: Rubio denies withholding intelligence, while Zelensky says after Oslo that warnings are coming in again, which The Guardian reads as a resumption of data sharing apparently suspended by the White House.',
  'Interfax relays US Secretary of State Marco Rubio\'s words to reporters in India: Washington has not rejected Ukraine\'s requests for air defence missiles, has not restricted Starlink and has not stopped supplying Kyiv with intelligence; he called Ukrainian claims to the contrary insinuations. The agency in the selection does not report Zelensky\'s call with Rubio or Zelensky\'s later words that warnings are coming in again.',
  'RBC-Ukraine and Ukrainska Pravda relay Zelensky\'s post on a "substantive" conversation with Rubio: they discussed interceptors against ballistic missiles, early warning of Russian ballistic attacks and the Starlink/Starshield situation, which needs to be restored; Zelensky thanked him for his readiness to help, and the two agreed to be in touch again soon.',
  'The Kyiv Independent writes that Ukraine has recently had disruptions to its early warning system, which relies on US intelligence: US officials blamed bad weather, Rubio a software malfunction. The BBC quotes Rubio calling "scandalous" the accusations that Ukrainians are dying because intelligence is withheld, and adviser Serhii Beskrestnov saying warnings sometimes come and sometimes do not. After the Oslo talks Zelensky, according to The Guardian, The Kyiv Independent and the BBC, said ballistic missile warnings are coming in again and "now it works".'))

card('1020-kyiv-strazhesko-institute-drone', [14918, 14708, 14582],
 'Дрон попал в операционную Института кардиологии Стражеско в Киеве: ранен пациент; в городе 12 пострадавших',
 'Киев', 'kyiv',
 ['одна из групп не освещает', 'расхождение: числа пострадавших'],
 None,
 S("РБК-Украина со ссылкой на премьер-министра Сергея Корецкого сообщает, что российский удар 20 октября пришелся на операционную Института кардиологии имени Стражеско в Киеве — по словам Корецкого, по этой больнице бьют уже второй раз; погибших нет, один пациент ранен, ему оказана помощь.",
   (14918, 'Цього разу - по операційній Інституту Стражеска Національної академії медичних наук у Києві'),
   (14918, 'На щастя, обійшлося без загиблих. Один пацієнт дістав поранення')),
 S("DW передает те же слова Корецкого и Кличко о попадании дрона в верхний этаж института и частично поврежденной крыше и приводит сводку ГСЧС об ударах по другим регионам в тот день. The Kyiv Independent пишет, что российские дроны несколько раз атаковали Киев днем 20 октября, повредив больницу в Соломенском районе и еще одно медучреждение в Голосеевском; число пострадавших росло по мере поступления данных — от двух у Кличко до пяти у КГВА и 12 по данным полиции и ГСЧС.",
   (14708, 'Это уже второй раз.'),
   (14708, 'повреждена операционная Института кардиологии имени Николая Стражеско, один пациент получил ранение'),
   (14582, "Ukraine's National Police later reported that a total of 12 people were injured in the city, according to the State Emergency Service (DSNS).")),
 "Удар по институту описывают только украинские и независимые издания, ссылаясь на премьер-министра Корецкого; российские источники в выборке его не упоминают. Украинский источник и DW говорят об одном раненом пациенте института, The Kyiv Independent приводит общее число пострадавших в городе, которое менялось в течение дня.",
 'low', 'Сведения о попадании дал премьер-министр Украины, фото опубликованы; разные числа пострадавших относятся к разным масштабам — институт и весь город.', False,
 ('Дрон влучив в операційну Інституту кардіології Стражеска в Києві: поранено пацієнта; у місті 12 постраждалих',
  'Київ',
  'Удар по інституту описують лише українські та незалежні видання, посилаючись на прем\u2019єр-міністра Корецького; російські джерела в добірці його не згадують. Українське джерело і DW говорять про одного пораненого пацієнта інституту, The Kyiv Independent наводить загальну кількість постраждалих у місті, яка змінювалася протягом дня.',
  None,
  'РБК-Україна з посиланням на прем\u2019єр-міністра Сергія Корецького повідомляє, що російський удар 20 жовтня припав на операційну Інституту кардіології імені Стражеска в Києві — за словами Корецького, по цій лікарні б\u2019ють уже вдруге; загиблих немає, один пацієнт поранений, йому надано допомогу.',
  'DW передає ті самі слова Корецького та Кличка про влучання дрона у верхній поверх інституту й частково пошкоджений дах і наводить зведення ДСНС про удари по інших регіонах того дня. The Kyiv Independent пише, що російські дрони кілька разів атакували Київ удень 20 жовтня, пошкодивши лікарню в Солом\u2019янському районі та ще один медзаклад у Голосіївському; кількість постраждалих зростала в міру надходження даних — від двох у Кличка до п\u2019яти в КМВА і 12 за даними поліції та ДСНС.'),
 ('Drone hits the operating theatre of the Strazhesko Institute of Cardiology in Kyiv: a patient injured; 12 injured across the city',
  'Kyiv',
  'Only Ukrainian and independent outlets describe the strike on the institute, citing Prime Minister Koretskyi; Russian sources in the selection do not mention it. The Ukrainian source and DW speak of one injured patient at the institute, while The Kyiv Independent gives the total number of injured in the city, which changed during the day.',
  None,
  'RBC-Ukraine, citing Prime Minister Serhii Koretskyi, reports that a Russian strike on 20 October hit the operating theatre of the Strazhesko Institute of Cardiology in Kyiv — according to Koretskyi, the hospital has been hit for the second time; no one was killed, one patient was injured and received help.',
  'DW relays the same words of Koretskyi and Klitschko about a drone hitting the institute\'s upper floor and partly damaging the roof, and gives the State Emergency Service round-up of strikes on other regions that day. The Kyiv Independent writes that Russian drones attacked Kyiv several times during the day on 20 October, damaging a hospital in Solomianskyi district and another medical facility in Holosiivskyi; the number of injured rose as data came in — from two per Klitschko to five per the city military administration and 12 per the police and emergency service.'))

card('1020-rubio-india-russian-oil', [15113, 15135, 14704, 14768],
 'Визит Рубио в Индию: в МИД РФ надеются, что он не скажется на энергосотрудничестве; независимые СМИ — российская нефть остается рычагом давления США',
 'Мумбаи, Джамнагар', 'ukraine-wide',
 ['одна из групп не освещает', 'расхождение: формулировки'],
 S("«Интерфакс» приводит слова замглавы МИД России Андрея Руденко: Москва не собирается комментировать визит госсекретаря США Марко Рубио в Индию, поскольку Индия проводит суверенную политику, и надеется, что он не повлияет на энергетическое сотрудничество двух стран. Позже агентство передало слова Рубио журналистам в Индии: США расстраивает отсутствие прогресса на переговорах по Украине, контакты нужны с обеими сторонами, а риск эскалации и распространения конфликта сохраняется.",
   (15113, 'Индия - независимая страна и проводит свою суверенную внешнюю политику, поэтому мы никоим образом не собираемся комментировать визит Рубио в Индию.'),
   (15135, 'Нас расстраивает отсутствие прогресса на переговорах')),
 None,
 S("DW пишет, что визит Рубио, начавшийся в Мумбаи и продолжающийся посещением нефтезавода Reliance в Джамнагаре, проходит на фоне затянувшихся торговых переговоров и неопределенности с возможными штрафными мерами США за закупки Индией российской нефти; Reliance активно закупает российскую нефть сорта Urals. Al Jazeera называет компанию центральной для усилий Вашингтона наказать покупателей российских энергоносителей и одновременно сдержать цены на топливо на фоне войны с Ираном.",
   (14704, 'Кроме того, предприятие активно закупает российскую нефть сорта Urals, играя тем самым значимую роль в энергетических отношениях Индии с Россией.'),
   (14768, 'The conglomerate is central to Washington’s efforts to punish Russian energy buyers')),
 "Российский источник подает визит через заверения МИД, что Индия сама определяет политику, и через слова Рубио о разочаровании отсутствием прогресса по Украине. Независимые издания описывают визит как часть давления США на покупателей российской нефти и напоминают о возможных штрафных мерах. Украинские издания в выборке визит не освещают.",
 'low', 'Сообщения основаны на публичных заявлениях и общедоступных сведениях о визите; расхождение касается акцентов.', False,
 ('Візит Рубіо до Індії: у МЗС РФ сподіваються, що він не вплине на енергоспівпрацю; незалежні ЗМІ — російська нафта залишається важелем тиску США',
  'Мумбаї, Джамнагар',
  'Російське джерело подає візит через запевнення МЗС, що Індія сама визначає політику, і через слова Рубіо про розчарування відсутністю прогресу щодо України. Незалежні видання описують візит як частину тиску США на покупців російської нафти й нагадують про можливі штрафні заходи. Українські видання в добірці візит не висвітлюють.',
  '«Інтерфакс» наводить слова заступника голови МЗС Росії Андрія Руденка: Москва не збирається коментувати візит держсекретаря США Марко Рубіо до Індії, оскільки Індія проводить суверенну політику, і сподівається, що він не вплине на енергетичну співпрацю двох країн. Пізніше агентство передало слова Рубіо журналістам в Індії: США засмучує відсутність прогресу на переговорах щодо України, контакти потрібні з обома сторонами, а ризик ескалації та поширення конфлікту зберігається.',
  None,
  'DW пише, що візит Рубіо, який почався в Мумбаї й продовжується відвідуванням нафтопереробного заводу Reliance у Джамнагарі, відбувається на тлі затяжних торговельних переговорів і невизначеності з можливими штрафними заходами США за закупівлі Індією російської нафти; Reliance активно закуповує російську нафту сорту Urals. Al Jazeera називає компанію центральною для зусиль Вашингтона покарати покупців російських енергоносіїв і водночас стримати ціни на пальне на тлі війни з Іраном.'),
 ('Rubio\'s visit to India: Russia\'s Foreign Ministry hopes it will not affect energy cooperation; independent media say Russian oil remains a US lever of pressure',
  'Mumbai, Jamnagar',
  'The Russian source frames the visit through Foreign Ministry assurances that India sets its own policy and through Rubio\'s words of frustration at the lack of progress on Ukraine. Independent outlets describe the visit as part of US pressure on buyers of Russian oil and recall possible punitive measures. Ukrainian outlets in the selection do not cover the visit.',
  'Interfax quotes Russian Deputy Foreign Minister Andrei Rudenko: Moscow does not intend to comment on US Secretary of State Marco Rubio\'s visit to India, since India pursues a sovereign policy, and hopes it will not affect the two countries\' energy cooperation. Later the agency relayed Rubio\'s words to reporters in India: the US is frustrated by the lack of progress in talks on Ukraine, contacts with both sides are needed, and the risk of escalation and of the conflict spreading remains.',
  None,
  'DW writes that Rubio\'s visit, which began in Mumbai and continues with a visit to the Reliance refinery in Jamnagar, comes amid protracted trade talks and uncertainty over possible US punitive measures for India\'s purchases of Russian oil; Reliance actively buys Russian Urals crude. Al Jazeera calls the company central to Washington\'s efforts to punish buyers of Russian energy while also containing fuel prices amid the war on Iran.'))
json.dump(cards, open(OUT + 'c20e.json', 'w'), ensure_ascii=False, indent=1)
print('c20e', len(cards))
