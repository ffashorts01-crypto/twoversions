    c['ids'] += [11110, 11112, 11322, 11398, 11423, 11391]
    c['title'] = 'Минобороны РФ — продвижение и бои за Доброполье; Зеленский: Доброполье и Константиновка под контролем Украины, до Запорожья 20 км, а не пять'
    c['uk']['t'] = 'Міноборони РФ — просування та бої за Добропілля; Зеленський: Добропілля і Костянтинівка під контролем України, до Запоріжжя 20 км, а не п’ять'
    c['en']['t'] = 'Russian MoD claims advances and fighting for Dobropillia; Zelensky: Dobropillia and Kostiantynivka under Ukrainian control, the front is 20 km from Zaporizhzhia, not five'
    add(c, 'ru', 'РИА со ссылкой на российского офицера утверждает, что украинское командование при отступлении из Доброполья бросило разрозненные группы солдат без связи.',
        'РИА з посиланням на російського офіцера стверджує, що українське командування під час відступу з Добропілля кинуло розрізнені групи солдатів без зв’язку.',
        'RIA, citing a Russian officer, claims that the Ukrainian command abandoned scattered groups of soldiers without communications while retreating from Dobropillia.',
        [(11110, 'Украинское командование бросило разрозненные группы своих солдат на произвол судьбы в Доброполье')])
    add(c, 'ua', 'Вечером Зеленский после доклада главнокомандующего Михаила Драпатого заявил, что Доброполье, Константиновка, Алексеево-Дружковка, Орехов, Новопавловка, Новоандреевка и Великомихайловка под контролем Украины, попытки штурмов и инфильтрации в Доброполье отражаются, а российские войска уничтожают в 20 км от Запорожья, а не в пяти, как докладывают Путину.',
        'Увечері Зеленський після доповіді головнокомандувача Михайла Драпатого заявив, що Добропілля, Костянтинівка, Олексієво-Дружківка, Оріхів, Новопавлівка, Новоандріївка та Великомихайлівка під контролем України, спроби штурмів та інфільтрації в Добропіллі відбиваються, а російські війська знищують за 20 км від Запоріжжя, а не за п’ять, як доповідають Путіну.',
        'In the evening, after a report by Commander-in-Chief Mykhailo Drapatyi, Zelensky said Dobropillia, Kostiantynivka, Oleksiievo-Druzhkivka, Orikhiv, Novopavlivka, Novoandriivka and Velykomykhailivka are under Ukrainian control, assault and infiltration attempts in Dobropillia are being repelled, and Russian troops are being destroyed 20 km from Zaporizhzhia, not five as Putin is told.',
        [(11398, 'Ситуація у Добропіллі: знищуємо там спроби росіян штурмувати нас, знищуємо інфільтрації.')])
    c['diverge'] += ' Зеленский прямо опровергает доклад Герасимова о взятии Доброполья и о расстоянии до Запорожья.'
    c['uk']['d'] += ' Зеленський прямо спростовує доповідь Герасимова про взяття Добропілля та про відстань до Запоріжжя.'
    c['en']['d'] += ' Zelensky directly refutes Gerasimov\'s report on the capture of Dobropillia and on the distance to Zaporizhzhia.'

