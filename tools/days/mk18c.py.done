import re
NEW_IDS = {}
src = open(__file__).read()
for k, body in re.findall(r"@ext\('([^']+)'\)\ndef _\(c\):\n    c\['ids'\] \+= \[([0-9, ]+)\]", src):
    NEW_IDS[k] = {int(x) for x in body.split(',')}
assert len(NEW_IDS) == len(EXT), (len(NEW_IDS), len(EXT))
n = 0
for f in ('c18a.json', 'c18b.json'):
    a = json.load(open(OUT + f))
    for c in a:
        if c['key'] in EXT and not (set(c['ids']) & NEW_IDS[c['key']]):
            EXT[c['key']](c); n += 1
    json.dump(a, open(OUT + f, 'w'), ensure_ascii=False, indent=1)
print('extended', n, 'of', len(EXT))
