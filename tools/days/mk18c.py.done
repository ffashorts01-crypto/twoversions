json.dump(cards, open(OUT + 'c18c.json', 'w'), ensure_ascii=False, indent=1)
print('new cards', len(cards))

# ---------------- extensions of earlier 2026-10-18 cards (c18a / c18b) ----------------
def q(i, t): return {'id': i, 'text': t}
def add(c, side, ru, uk, en, quotes=()):
    if c[side] is None:
        c[side] = {'summary': ru, 'quotes': [q(*x) for x in quotes]}; c['uk'][side] = uk; c['en'][side] = en
    else:
        c[side]['summary'] += ' ' + ru; c[side]['quotes'] += [q(*x) for x in quotes]
        c['uk'][side] += ' ' + uk; c['en'][side] += ' ' + en
EXT = {}
def ext(key): 
    def deco(f): EXT[key] = f; return f
    return deco

@ext('1018-rubio-starshield-intel')
def _(c):
    c['ids'] += [11409]
    add(c, 'ind', 'DW приводит слова Рубио о том, что никто в Белом доме не давал указаний замедлять интернет, и отмечает, что данные об инициаторе ограничений Starshield противоречивы.',
        'DW наводить слова Рубіо про те, що ніхто в Білому домі не давав вказівок сповільнювати інтернет, і зазначає, що дані про ініціатора обмежень Starshield суперечливі.',
        'DW quotes Rubio as saying that no one in the White House gave instructions to slow down the internet and notes that information on who initiated the Starshield restrictions is contradictory.',
        [(11409, 'Никто в Белом доме не давал указаний замедлять интернет или снижать скорость передачи данных')])

@ext('1018-lithuania-drone-from-poland')
def _(c):
    c['ids'] += [11429, 11394, 11411]
    c['title'] = 'В Литве упал дрон: Каунас предполагал залет из Польши, Варшава это не подтверждает; МИД Украины выразил сожаление, допустив увод дрона российской РЭБ'
    c['uk']['t'] = 'У Литві впав дрон: Каунас припускав заліт із Польщі, Варшава цього не підтверджує; МЗС України висловило жаль, припустивши відведення дрона російським РЕБ'
    c['en']['t'] = 'Drone crashes in Lithuania: Kaunas suggested it came from Poland, Warsaw does not confirm; Ukraine\'s foreign ministry expresses regret, citing possible Russian jamming'
    c['tags'] = ['расхождение: атрибуция', 'расхождение: формулировки']
    add(c, 'ru', '«Интерфакс» передает, что пресс-секретарь польского Минобороны Януш Сеймей заявил: данные польских радаров пересечение границы из Польши в Литву не подтверждают.',
        '«Інтерфакс» передає, що речник польського Міноборони Януш Сеймей заявив: дані польських радарів перетин кордону з Польщі до Литви не підтверджують.',
        'Interfax reports that Polish Defence Ministry spokesman Janusz Sejmej said Polish radar data do not confirm a border crossing from Poland into Lithuania.',
        [(11429, 'На литовском направлении не подтверждается (по данным наших радиолокационных систем) пересечения границы из Польши в Литву')])
    add(c, 'ua', 'Позже спикер МИД Украины Георгий Тихий выразил сожаление в связи с инцидентом и заявил, что он, вероятно, стал следствием российской РЭБ, менявшей курс беспилотников во время операции против военных целей в России; Украина извинилась и обещала передать Литве всю информацию.',
        'Пізніше речник МЗС України Георгій Тихий висловив жаль у зв’язку з інцидентом і заявив, що він, імовірно, став наслідком російського РЕБ, яке змінювало курс безпілотників під час операції проти військових цілей у Росії; Україна перепросила й пообіцяла передати Литві всю інформацію.',
        'Later Ukrainian Foreign Ministry spokesman Heorhii Tykhyi expressed regret over the incident and said it was probably the result of Russian electronic warfare that changed the course of drones during an operation against military targets in Russia; Ukraine apologised and promised to give Lithuania all the information.',
        [(11394, 'Ми перепрошуємо за будь-які незручності, ризики та занепокоєння, які це могло спричинити')])
    add(c, 'ind', 'DW пишет, что Украина принесла извинения; на перехват поднимались итальянские Eurofighter под командованием НАТО, обломки повредили движущийся автомобиль, никто не пострадал.',
        'DW пише, що Україна перепросила; на перехоплення піднімалися італійські Eurofighter під командуванням НАТО, уламки пошкодили автомобіль, що рухався, ніхто не постраждав.',
        'DW writes that Ukraine apologised; Italian Eurofighters under NATO command were scrambled, debris damaged a moving car, and no one was hurt.',
        [(11411, 'Ukraine apologized Sunday after a suspected drone crashed in northern Lithuania')])
    c['diverge'] = 'Литва предполагала залет дрона из Польши, Польша это не подтверждает; МИД Украины, извинившись, фактически допустил, что дрон был украинским и сбился с курса из-за российской РЭБ, — российские источники в выборке это заявление не освещают. РИА подает действия польских ВВС как реакцию «якобы» на активность России.'
    c['uk']['d'] = 'Литва припускала заліт дрона з Польщі, Польща цього не підтверджує; МЗС України, перепросивши, фактично припустило, що дрон був українським і збився з курсу через російське РЕБ, — російські джерела у вибірці цю заяву не висвітлюють. РИА подає дії польських ВПС як реакцію «нібито» на активність Росії.'
    c['en']['d'] = 'Lithuania suggested the drone came from Poland, which Poland does not confirm; Ukraine\'s foreign ministry, by apologising, effectively acknowledged the drone may have been Ukrainian and veered off course because of Russian jamming; Russian sources in the sample do not cover this statement. RIA presents the Polish air force\'s actions as a reaction "supposedly" to Russian activity.'
    c['uncertainty'] = 'medium'

@ext('1018-lithuania-starlink-arson')
def _(c):
    c['ids'] += [11404]
    add(c, 'ind', 'Kyiv Independent пишет, что на месте нашли зажигательные жидкости и канистры, а Синкявичюс назвал инцидент частью гибридной войны России и сказал, что заказчик, вероятно, уже ясен — российская сторона.',
        'Kyiv Independent пише, що на місці знайшли запалювальні рідини та каністри, а Сінкявічюс назвав інцидент частиною гібридної війни Росії й сказав, що замовник, імовірно, уже зрозумілий — російська сторона.',
        'Kyiv Independent writes that incendiary liquids and containers were found at the scene, and Sinkevicius called the incident part of Russia\'s hybrid war, saying the client was probably already clear: the Russian side.',
        [(11404, 'It is likely that it is already clear who commissioned it — the Russian side')])
    c['diverge'] = 'Фактических расхождений нет; литовский премьер связывает попытку поджога с Россией, ТАСС эту оценку не приводит.'
    c['uk']['d'] = 'Фактичних розбіжностей немає; литовський прем’єр пов’язує спробу підпалу з Росією, ТАСС цієї оцінки не наводить.'
    c['en']['d'] = 'There are no factual discrepancies; the Lithuanian prime minister links the arson attempt to Russia, while TASS does not cite this assessment.'
    c['tags'] = ['умолчание']

@ext('1018-black-sea-ship-romania-drones')
def _(c):
    c['ids'] += [11321, 11433, 11149, 11251]
    c['title'] = 'Минобороны РФ: у Одессы поражены два сухогруза — ночью и днем; Румыния уточнила, что сбитые над ее водами дроны были реактивными «Геранями»'
    c['uk']['t'] = 'Міноборони РФ: біля Одеси уражено два суховантажі — вночі та вдень; Румунія уточнила, що збиті над її водами дрони були реактивними «Геранями»'
    c['en']['t'] = 'Russian MoD: two cargo ships hit off Odesa, overnight and in the daytime; Romania says drones downed over its waters were jet-powered Gerans'
    add(c, 'ru', 'Днем ведомство сообщило о поражении еще одного сухогруза в 50 км юго-западнее порта Одесса; по данным министерства, с 10 по 16 октября поражены 15 сухогрузов.',
        'Удень відомство повідомило про ураження ще одного суховантажу за 50 км на південний захід від порту Одеса; за даними міністерства, з 10 по 16 жовтня уражено 15 суховантажів.',
        'In the daytime the ministry reported hitting another cargo ship 50 km south-west of the port of Odesa; according to the ministry, 15 cargo ships were hit between October 10 and 16.',
        [(11321, 'В результате удара в 50 км юго-западнее порта Одесса при переходе морем поражено морское судно типа «сухогруз»')])
    c['diverge'] = 'Удары по двум сухогрузам у Одессы известны только со слов Минобороны РФ; Румыния описывает тип дронов, но не называет страну их принадлежности.'
    c['uk']['d'] = 'Удари по двох суховантажах біля Одеси відомі лише зі слів Міноборони РФ; Румунія описує тип дронів, але не називає країну їхньої належності.'
    c['en']['d'] = 'The strikes on the two cargo ships off Odesa are known only from the Russian MoD; Romania describes the type of drones but does not name the country they belong to.'

@ext('1018-front-claims')
