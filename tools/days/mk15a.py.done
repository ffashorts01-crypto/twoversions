import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1015-refinery-pause-lifted-ryazan', [10805, 10813, 4833, 6596, 6024, 10799, 6592, 4838, 7181, 8106, 8597, 9424, 9415, 9416, 8310, 9617, 9439],
 'Зеленский снял запрет на удары по российским НПЗ; ночью атакован Рязанский НПЗ — Минобороны РФ сообщает о сбитых ракетах «Фламинго»', 'Рязань', 'russia-other',
 ['расхождение: оценка ситуации'],
 S('Губернатор Рязанской области Павел Малков сообщил о массированной атаке дронов, пожаре на территории НПЗ и повреждениях на другом предприятии, пострадавших, по его данным, нет; в части Рязани отменены занятия в школах и детсадах. Минобороны РФ заявило, что с 4:00 до 7:00 Украина пыталась массированно атаковать завод, сбиты 4 крылатые ракеты «Фламинго» и 69 дронов, а пожар возник из-за падения обломков; всего за ночь ведомство сообщило о 166 сбитых беспилотниках, за сутки — о 342.',
   (10805, 'На территории нефтеперерабатывающего завода произошло возгорание.'),
   (10813, 'перехвачены и уничтожены 4 крылатые ракеты большой дальности "Фламинго" и 69 БПЛА самолетного типа')),
 S('Зеленский в интервью Financial Times заявил, что снял ограничения на удары по российским НПЗ после того, как Россия вновь убила мирных жителей, в том числе в Луцке; по его словам, Украина три дня воздерживалась от таких атак ради объявленного Трампом перемирия.',
   (7181, 'Обмеження знято. Сьогодні ввечері я сказав своїм військовим.')),
 S('BBC, DW, Al Jazeera и Kyiv Independent приводят слова Зеленского «Запрет снят. С нас хватит»; DW со ссылкой на него пишет, что за последнюю неделю российские удары по энергетике убили более 100 мирных жителей, и сообщает о закрытии 14 школ и 25 детсадов в Рязани.',
   (8597, 'The block (on attacking refineries) is out. We’re done'),
   (9415, 'в результате чего за последнюю неделю погибло более 100 мирных жителей')),
 'Российская сторона говорит о попытке атаки, отраженной ПВО, с пожаром от обломков; украинская — о вынужденном возобновлении ударов в ответ на российские атаки на энергетику. Масштаб ущерба НПЗ независимо не установлен.',
 'low', '', True,
 ['Зеленський зняв заборону на удари по російських НПЗ; вночі атаковано Рязанський НПЗ — Міноборони РФ повідомляє про збиті ракети «Фламінго»', 'Рязань',
  'Російська сторона говорить про спробу атаки, відбиту ППО, з пожежею від уламків; українська — про вимушене відновлення ударів у відповідь на російські атаки на енергетику. Масштаб шкоди НПЗ незалежно не встановлено.',
  'Губернатор Рязанської області Павло Малков повідомив про масовану атаку дронів, пожежу на території НПЗ і пошкодження на іншому підприємстві, постраждалих, за його даними, немає; у частині Рязані скасовано заняття в школах і садочках. Міноборони РФ заявило, що з 4:00 до 7:00 Україна намагалася масовано атакувати завод, збито 4 крилаті ракети «Фламінго» і 69 дронів, а пожежа виникла через падіння уламків; загалом за ніч відомство повідомило про 166 збитих безпілотників, за добу — про 342.',
  'Зеленський в інтерв’ю Financial Times заявив, що зняв обмеження на удари по російських НПЗ після того, як Росія знову вбила мирних жителів, зокрема в Луцьку; за його словами, Україна три дні утримувалася від таких атак заради оголошеного Трампом перемир’я.',
  'BBC, DW, Al Jazeera і Kyiv Independent наводять слова Зеленського «Заборону знято. З нас досить»; DW з посиланням на нього пише, що за останній тиждень російські удари по енергетиці вбили понад 100 мирних жителів, і повідомляє про закриття 14 шкіл і 25 садочків у Рязані.'],
 ['Zelensky lifts ban on strikes on Russian refineries; Ryazan refinery attacked overnight, Russia reports downing Flamingo missiles', 'Ryazan',
  'The Russian side speaks of an attempted attack repelled by air defence, with a fire caused by debris; the Ukrainian side of a forced resumption of strikes in response to Russian attacks on energy. The extent of damage to the refinery is not independently established.',
  'Ryazan Governor Pavel Malkov reported a massive drone attack, a fire at the refinery and damage at another enterprise, with no casualties according to him; classes at schools and kindergartens in part of Ryazan were cancelled. The Russian Defence Ministry said that from 4:00 to 7:00 Ukraine tried to mount a massive attack on the plant, 4 Flamingo cruise missiles and 69 drones were downed, and the fire was caused by falling debris; overall it reported 166 drones downed overnight and 342 over the day.',
  'Zelensky told the Financial Times he had lifted restrictions on strikes on Russian refineries after Russia again killed civilians, including in Lutsk; he said Ukraine had held off such attacks for three days for the sake of the truce announced by Trump.',
  'The BBC, DW, Al Jazeera and Kyiv Independent quote Zelensky: "The block is out. We\'re done"; DW, citing him, writes that Russian strikes on energy killed more than 100 civilians over the past week, and reports 14 schools and 25 kindergartens closed in Ryazan.'])

card('1015-refinery-strikes-reactions', [10856, 6076, 10829, 6059, 6041, 10808, 6058, 8140, 7224, 8826, 8111, 8120, 9418],
 'Путин пригрозил ответом на удары по НПЗ («они это начали»), Лавров назвал позицию Зеленского «грубым вызовом» Трампу; Каллас: удары законны', 'Москва, Брюссель', 'ukraine-wide',
 ['расхождение: оценка ситуации'],
 S('Путин заявил, что Киев «кое-куда попал» по НПЗ, но без существенного ущерба, и пригрозил ответом, сравнив удары с атаками на маркетплейсы: «они сделали первый шаг, мы начали отвечать». Лавров назвал заявления Зеленского о продолжении ударов прямым и грубым вызовом Трампу, поддержавшему дизельную сделку, и добавил, что Россия не приостановит СВО. Интерфакс и ТАСС со ссылкой на WSJ пишут, что с сентября США шесть раз просили Украину прекратить удары по энергетике и что Трампа раздражает их влияние на американских потребителей.',
   (6076, 'They took the first step. We began responding.'),
   (10829, 'Это такой прямой вызов, причем грубый, в адрес президента Трампа')),
 S('Украинские СМИ пересказывают угрозы Путина как игнорирование объявленного Трампом перемирия. Глава дипломатии ЕС Кая Каллас поддержала возобновление ударов, заявив, что нефтяные доходы России финансируют войну, а премьер Эстонии Кристен Михал сказал, что чем быстрее российские НПЗ будут уничтожены, тем лучше.',
   (8140, 'Ось вони зробили перший крок.'),
   (8111, 'чим швидше всі російські нафтопереробні заводи')),
 S('DW приводит слова Каллас в интервью Euronews о том, что по международному праву такие удары являются для Украины формой обороны.',
   (9418, 'Если обратиться к международному праву, очевидно, что для Украины это форма обороны')),
 'Россия представляет свои удары как ответ на украинские атаки, Украина и ЕС — удары по НПЗ как законную самооборону и способ лишить Россию доходов. Сведения WSJ о давлении США основаны на анонимных источниках.',
 'medium', 'Сведения о позиции Трампа — из анонимных источников.', True,
 ['Путін пригрозив відповіддю на удари по НПЗ («вони це почали»), Лавров назвав позицію Зеленського «грубим викликом» Трампу; Каллас: удари законні', 'Москва, Брюссель',
  'Росія подає свої удари як відповідь на українські атаки, Україна та ЄС — удари по НПЗ як законну самооборону і спосіб позбавити Росію доходів. Відомості WSJ про тиск США ґрунтуються на анонімних джерелах.',
  'Путін заявив, що Київ «де-не-де влучив» по НПЗ, але без суттєвої шкоди, і пригрозив відповіддю, порівнявши удари з атаками на маркетплейси: «вони зробили перший крок, ми почали відповідати». Лавров назвав заяви Зеленського про продовження ударів прямим і грубим викликом Трампу, який підтримав дизельну угоду, і додав, що Росія не призупинить війну. Інтерфакс і ТАСС з посиланням на WSJ пишуть, що з вересня США шість разів просили Україну припинити удари по енергетиці і що Трампа дратує їхній вплив на американських споживачів.',
  'Українські ЗМІ переказують погрози Путіна як ігнорування оголошеного Трампом перемир’я. Очільниця дипломатії ЄС Кая Каллас підтримала відновлення ударів, заявивши, що нафтові доходи Росії фінансують війну, а прем’єр Естонії Крістен Міхал сказав, що чим швидше російські НПЗ будуть знищені, тим краще.',
  'DW наводить слова Каллас в інтерв’ю Euronews про те, що за міжнародним правом такі удари є для України формою оборони.'],
 ['Putin threatens a response to refinery strikes ("they started it"), Lavrov calls Zelensky\'s stance a "crude challenge" to Trump; Kallas says strikes are legal', 'Moscow, Brussels',
  'Russia presents its strikes as a response to Ukrainian attacks; Ukraine and the EU present refinery strikes as lawful self-defence and a way to deprive Russia of revenue. The WSJ report on US pressure rests on anonymous sources.',
  'Putin said Kyiv had "hit some places" at refineries, but without significant damage, and threatened a response, comparing the strikes to attacks on online marketplaces: "they took the first step, we began responding". Lavrov called Zelensky\'s statements about continuing strikes a direct and crude challenge to Trump, who backed the diesel deal, and added that Russia will not pause its military operation. Interfax and TASS, citing the WSJ, write that since September the US has asked Ukraine six times to stop strikes on energy and that Trump is irritated by their effect on American consumers.',
  'Ukrainian media relay Putin\'s threats as ignoring the truce Trump announced. EU foreign policy chief Kaja Kallas backed the resumption of strikes, saying Russia\'s oil revenues fund the war, and Estonian Prime Minister Kristen Michal said the sooner Russian refineries are destroyed the better.',
  'DW quotes Kallas telling Euronews that under international law such strikes are a form of defence for Ukraine.'])

card('1015-black-sea-tankers-romania', [10798, 10804, 10797, 6013, 4825, 10852, 10853, 6590, 6605, 10854, 7184, 7197, 8114, 8136, 8311, 8771, 8607, 8730, 9440],
 'Черное море: у Румынии горят два танкера, семь моряков пропали; НАТО созывает спецзаседание; Минобороны РФ — удары по Измаилу, Южному и сухогрузам', 'Черное море, Сулина, Одесская область', 'odesa',
 ['расхождение: ответственность', 'расхождение: характер целей'],
 S('Минобороны РФ заявило, что дроны поразили портовую инфраструктуру Измаила, объект транспортной инфраструктуры в порту Южный, а также сухогрузы в акватории Бугского лимана, в порту Черноморск и в море, которые, по версии ведомства, везли в Одессу военные грузы. Интерфакс со ссылкой на Politico приводит слова президента Румынии Никушора Дана, что пока «слишком рано» утверждать, что за атаками на танкеры стоит Россия.',
   (10797, 'поражена портовая инфраструктура порта Измаил, используемая для разгрузки и хранения грузов военного и двойного назначения'),
   (10804, 'Расчетами БпЛА "Герань-4" были поражены два судна типа сухогруз в акватории Бугского Лимана и в порту Черноморск')),
 S('Дан и президент Болгарии Илияна Йотова договорились о сотрудничестве против дронов в Черном море. Премьер Болгарии Румен Радев предложил мораторий на атаки на гражданские суда и сказал, что твердых доказательств причастности России нет, хотя логика указывает на нее; глава МИД Румынии Оана Цою заявила, что Россия превращает Черное море в опасную зону.',
   (8114, 'Зрештою, це просто нелогічно, щоб Україна атакувала кораблі з власним зерном')),
 S('BBC, DW, Guardian и Kyiv Independent сообщают, что химический танкер Wine Trader загорелся у Сулины и семь из 12 членов экипажа пропали, а накануне был поражен танкер Yara J; источник в НАТО сказал Reuters, что дроны были российского происхождения. Дан объявил о специальном заседании Совета НАТО.',
   (8730, 'The drones that caused ⁠the fires on board two tankers inside Romanian territorial waters were of Russian origin')),
 'Российская сторона сообщает об ударах по судам с «военными грузами» и не комментирует танкеры у Румынии; источник в НАТО называет дроны российскими, румынский президент и болгарский премьер пока осторожны в оценках. Груз пораженных Россией судов независимо не подтвержден.',
 'medium', 'Принадлежность дронов официально не установлена.', True,
 ['Чорне море: біля Румунії горять два танкери, сім моряків зникли; НАТО скликає спецзасідання; Міноборони РФ — удари по Ізмаїлу, Південному і суховантажах', 'Чорне море, Суліна, Одещина',
  'Російська сторона повідомляє про удари по суднах із «військовими вантажами» і не коментує танкери біля Румунії; джерело в НАТО називає дрони російськими, румунський президент і болгарський прем’єр поки обережні в оцінках. Вантаж уражених Росією суден незалежно не підтверджено.',
  'Міноборони РФ заявило, що дрони уразили портову інфраструктуру Ізмаїла, об’єкт транспортної інфраструктури в порту Південний, а також суховантажі в акваторії Бузького лиману, в порту Чорноморськ і в морі, які, за версією відомства, везли до Одеси військові вантажі. Інтерфакс із посиланням на Politico наводить слова президента Румунії Нікушора Дана, що поки «зарано» стверджувати, що за атаками на танкери стоїть Росія.',
  'Дан і президентка Болгарії Іліяна Йотова домовилися про співпрацю проти дронів у Чорному морі. Прем’єр Болгарії Румен Радев запропонував мораторій на атаки на цивільні судна і сказав, що твердих доказів причетності Росії немає, хоча логіка вказує на неї; очільниця МЗС Румунії Оана Цою заявила, що Росія перетворює Чорне море на небезпечну зону.',
  'BBC, DW, Guardian і Kyiv Independent повідомляють, що хімічний танкер Wine Trader загорівся біля Суліни і семеро з 12 членів екіпажу зникли, а напередодні було уражено танкер Yara J; джерело в НАТО сказало Reuters, що дрони були російського походження. Дан оголосив про спеціальне засідання Ради НАТО.'],
 ['Black Sea: two tankers ablaze off Romania, seven sailors missing; NATO calls a special meeting; Russia claims strikes on Izmail, Pivdennyi and cargo ships', 'Black Sea, Sulina, Odesa region',
  'The Russian side reports strikes on ships with "military cargo" and does not comment on the tankers off Romania; a NATO source calls the drones Russian, while Romania\'s president and Bulgaria\'s prime minister remain cautious. The cargo of the ships Russia struck is not independently confirmed.',
  'The Russian Defence Ministry said drones hit port infrastructure in Izmail, a transport facility in the port of Pivdennyi, and cargo ships in the Bug estuary, in the port of Chornomorsk and at sea that it says were carrying military cargo to Odesa. Interfax, citing Politico, quotes Romanian President Nicușor Dan as saying it is "too early" to assert that Russia is behind the tanker attacks.',
  'Dan and Bulgarian President Iliana Iotova agreed to cooperate against drones in the Black Sea. Bulgarian Prime Minister Rumen Radev proposed a moratorium on attacks on civilian ships and said there is no firm evidence of Russian involvement, although logic points to it; Romanian Foreign Minister Oana Țoiu said Russia is turning the Black Sea into a danger zone.',
  'The BBC, DW, the Guardian and Kyiv Independent report that the chemical tanker Wine Trader caught fire off Sulina and seven of its 12 crew are missing, while the tanker Yara J was hit the day before; a NATO source told Reuters the drones were of Russian origin. Dan announced a special meeting of the NATO Council.'])

card('1015-night-attack-580-drones', [6015, 4839, 8101, 7180, 8100, 8096, 8099, 8103, 8102, 7195, 7194, 8593, 9414, 8594, 8610],
 'Ночная атака 580 дронов и 2 ракет: в Кропивницком трое погибших, на Днепропетровщине двое; Минобороны РФ — удары по транспортной инфраструктуре', 'Кировоградская, Днепропетровская, Полтавская, Тернопольская области', 'ukraine-wide',
 ['расхождение: характер целей'],
 S('Минобороны РФ сообщило о поражении транспортной инфраструктуры, используемой ВСУ, цехов производства дронов и мест их хранения. ТАСС по сводкам Минобороны подсчитал, что с начала года российские войска поразили не менее десяти украинских ТЭС, ТЭЦ и ГЭС, «используемых в военных целях».',
   (4839, 'нанесено поражение транспортной инфраструктуре, используемой в интересах ВСУ')),
 S('Воздушные силы сообщили, что с вечера 14 октября Россия запустила 2 ракеты Х-59 и 580 дронов, 536 сбиты или подавлены, попадания на 31 локации. Кировоградская область больше 10 часов была под атакой: в Кропивницком трое погибших и шестеро раненых, удары по предприятиям, логистике и жилым домам; на Днепропетровщине погибли двое, в Чорткове пострадали 5 человек, на Полтавщине поражены два предприятия. Зеленский сказал, что за полтора суток Россия запустила более 850 «шахедов»; Укрэнерго сообщило о новых отключениях в пяти областях.',
   (8101, 'Зафіксовано влучання засобів повітряного нападу противника на 31 локації'),
   (8100, 'Кіровоградщина понад 10 годин перебувала під масованою атакою ворожих БпЛА: троє загиблих та шестеро травмованих')),
 S('Kyiv Independent пишет, что Кировоградская область пережила самую массированную атаку с начала вторжения, а за сутки по Украине погибли не менее 10 и ранены 66 человек; DW со ссылкой на главу ОВА Андрея Райковича — об ударах по логистике, транспортным и промышленным предприятиям.',
   (8610, 'At least 10 people were killed and 66 others injured across Ukraine over the past day')),
 'Россия заявляет о военных и транспортных целях, украинские власти — о погибших мирных жителях и попаданиях в жилые дома. Военное назначение пораженных объектов независимо не подтверждено.',
 'low', '', True,
 ['Нічна атака 580 дронів і 2 ракет: у Кропивницькому троє загиблих, на Дніпропетровщині двоє; Міноборони РФ — удари по транспортній інфраструктурі', 'Кіровоградська, Дніпропетровська, Полтавська, Тернопільська області',
  'Росія заявляє про військові й транспортні цілі, українська влада — про загиблих мирних жителів і влучання в житлові будинки. Військове призначення уражених об’єктів незалежно не підтверджено.',
  'Міноборони РФ повідомило про ураження транспортної інфраструктури, що використовується ЗСУ, цехів виробництва дронів і місць їх зберігання. ТАСС за зведеннями Міноборони підрахував, що з початку року російські війська уразили щонайменше десять українських ТЕС, ТЕЦ і ГЕС, «що використовуються у військових цілях».',
  'Повітряні сили повідомили, що з вечора 14 жовтня Росія запустила 2 ракети Х-59 і 580 дронів, 536 збито або подавлено, влучання на 31 локації. Кіровоградщина понад 10 годин була під атакою: у Кропивницькому троє загиблих і шестеро поранених, удари по підприємствах, логістиці та житлових будинках; на Дніпропетровщині загинули двоє, у Чорткові постраждали 5 людей, на Полтавщині уражено два підприємства. Зеленський сказав, що за півтори доби Росія запустила понад 850 «шахедів»; Укренерго повідомило про нові знеструмлення в п’яти областях.',
  'Kyiv Independent пише, що Кіровоградщина пережила наймасованішу атаку від початку вторгнення, а за добу в Україні загинули щонайменше 10 і поранено 66 людей; DW з посиланням на голову ОВА Андрія Райковича — про удари по логістиці, транспортних і промислових підприємствах.'],
