c22 = []
c22.append(C('1022-zelensky-diary-of-a-ceo-podcast', [16587, 16589, 16642, 16778, 16782, 16784, 16794, 16803],
 'Зеленский в подкасте The Diary Of A CEO: Трамп мог бы легко посадить Путина за стол переговоров, уход из Славянска и Краматорска открыл бы России путь дальше',
 'Киев', 'ukraine-wide',
 ['расхождение: формулировки', 'умолчание'],
 S("РИА Новости пересказывает интервью под заголовком «Зеленский набросился на Трампа с обвинениями»: по версии агентства, он пожаловался, что президент США не дал ему того, чего он требовал, — ракет, хотя их финансируют европейцы. Агентство напоминает, что, по данным CNN, у Украины закончились ракеты-перехватчики для Patriot, и добавляет позицию Москвы: поставки оружия Киеву мешают урегулированию. Другие темы интервью в материале не упоминаются.",
   (16642, 'Европейцы все это финансируют. Есть договоренность, но нам их не дают')),
 S("РБК-Украина, «Украинская правда» и «Общественное» подробно передают интервью Стивену Бартлетту. Зеленский говорит, что Трамп «очень легко» мог бы привести Путина к столу переговоров, если бы перенес на него риторику, которую применяет к Зеленскому, и ввел санкции, уже одобренные Конгрессом; обвинения в росте цен на дизель в США он называет несправедливыми и «полной неправдой». Если отдать России Славянск и Краматорск, война может пойти дальше — на Днепропетровщину, к Павлограду и Днепру, а гарантий никто не дает; перемирие он называет и так самым большим компромиссом. На слова Трампа о «генерале-неудачнике» Зеленский отвечает, что российские войска не взяли Киев не из-за одного генерала, а потому что не ожидали сопротивления. Применить ядерное оружие Путин, по его мнению, не рискнет, иначе Россия лишится всех союзников.",
   (16589, 'Трамп дуже легко може привести Путіна до столу переговорів, бо йому це потрібно.'),
   (16587, 'Якщо ми віддамо їм ці наші міста, ризик величезний.'),
   (16784, 'Це цілковита неправда.'),
   (16803, 'Справа не в тому, що якийсь генерал був ідіотом'),
   (16782, 'Але я не думаю, що вони ризикнуть застосувати ядерну зброю.')),
 S("«Медуза» пересказывает проверку «Русской службы Би-би-си» истории Трампа о «глупом генерале», который завел танки в грязь: наступлением на Киев со стороны Беларуси командовал генерал-полковник Александр Чайко, но провал не был связан с его решением свернуть с дороги. Наступление остановили украинские военные: они подорвали мост через Ирпень и Козаровицкую дамбу и уничтожили колонну бронетехники в Буче. Само интервью Зеленского независимые издания в подборке не пересказывают.",
   (16794, 'Наступление на Киев остановили украинские военные.')),
 "РИА Новости сводит интервью к жалобе на то, что Трамп не дает ракет, и подает его как «нападки» на американского президента; о призыве давить на Путина санкциями, о Славянске и Краматорске и о ядерном оружии агентство не пишет. Украинские издания выносят в заголовки именно эти темы и не называют слова Зеленского обвинениями. Независимая проверка Би-би-си, которую пересказывает «Медуза», совпадает с ответом Зеленского Трампу: наступление на Киев сорвало сопротивление украинских военных, а не ошибка одного генерала.",
 'low', 'Слова Зеленского записаны в интервью и одинаково цитируются; расходятся только выбор тем и подача.', False,
 ('Зеленський у подкасті The Diary Of A CEO: Трамп міг би легко посадити Путіна за стіл переговорів, вихід зі Словʼянська і Краматорська відкрив би Росії шлях далі',
  'Київ',
  "РИА Новости зводить інтерв’ю до скарги на те, що Трамп не дає ракет, і подає його як «напади» на американського президента; про заклик тиснути на Путіна санкціями, про Словʼянськ і Краматорськ та про ядерну зброю агентство не пише. Українські видання виносять у заголовки саме ці теми й не називають слова Зеленського звинуваченнями. Незалежна перевірка Бі-бі-сі, яку переказує «Медуза», збігається з відповіддю Зеленського Трампу: наступ на Київ зірвав опір українських військових, а не помилка одного генерала.",
  "РИА Новости переказує інтерв’ю під заголовком «Зеленський накинувся на Трампа зі звинуваченнями»: за версією агентства, він поскаржився, що президент США не дав йому того, чого він вимагав, — ракет, хоча їх фінансують європейці. Агентство нагадує, що, за даними CNN, в України закінчилися ракети-перехоплювачі для Patriot, і додає позицію Москви: постачання зброї Києву заважають врегулюванню. Інші теми інтерв’ю в матеріалі не згадуються.",
  "РБК-Україна, «Українська правда» і «Суспільне» докладно передають інтерв’ю Стівену Бартлетту. Зеленський каже, що Трамп «дуже легко» міг би привести Путіна до столу переговорів, якби переніс на нього риторику, яку застосовує до Зеленського, і запровадив санкції, вже схвалені Конгресом; звинувачення у зростанні цін на дизель у США він називає несправедливими і «цілковитою неправдою». Якщо віддати Росії Словʼянськ і Краматорськ, війна може піти далі — на Дніпропетровщину, до Павлограда і Дніпра, а гарантій ніхто не дає; перемир’я він називає і так найбільшим компромісом. На слова Трампа про «генерала-невдаху» Зеленський відповідає, що російські війська не взяли Київ не через одного генерала, а тому що не очікували опору. Застосувати ядерну зброю Путін, на його думку, не ризикне, інакше Росія втратить усіх союзників.",
  "«Медуза» переказує перевірку «Російської служби Бі-бі-сі» історії Трампа про «дурного генерала», який завів танки в багнюку: наступом на Київ з боку Білорусі командував генерал-полковник Олександр Чайко, але провал не був пов’язаний з його рішенням звернути з дороги. Наступ зупинили українські військові: вони підірвали міст через Ірпінь і Козаровицьку дамбу та знищили колону бронетехніки в Бучі. Саме інтерв’ю Зеленського незалежні видання в добірці не переказують."),
 ('Zelensky on The Diary Of A CEO podcast: Trump could easily bring Putin to the negotiating table; giving up Sloviansk and Kramatorsk would open the way further for Russia',
  'Kyiv',
  "RIA Novosti reduces the interview to a complaint that Trump is not supplying missiles and presents it as an \"attack\" on the US president; it does not mention the call to pressure Putin with sanctions, Sloviansk and Kramatorsk or nuclear weapons. Ukrainian outlets headline exactly these topics and do not call Zelensky's words accusations. The independent BBC fact-check relayed by Meduza matches Zelensky's reply to Trump: the offensive on Kyiv was derailed by the resistance of Ukrainian troops, not by one general's mistake.",
  "RIA Novosti covers the interview under the headline \"Zelensky lashed out at Trump with accusations\": in the agency's version he complained that the US president had not given him what he demanded, missiles, even though Europeans pay for them. The agency recalls that, according to CNN, Ukraine has run out of Patriot interceptor missiles and adds Moscow's position that arms supplies to Kyiv hinder a settlement. Other topics of the interview are not mentioned.",
  "RBC-Ukraine, Ukrainska Pravda and Suspilne give a detailed account of the interview with Steven Bartlett. Zelensky says Trump could \"very easily\" bring Putin to the negotiating table if he turned on him the rhetoric he uses against Zelensky and imposed the sanctions already approved by Congress; he calls the blame for rising diesel prices in the US unfair and \"completely untrue\". If Russia were given Sloviansk and Kramatorsk, the war could move further, into Dnipropetrovsk region towards Pavlohrad and Dnipro, and nobody offers guarantees; he calls a ceasefire the biggest compromise as it is. Answering Trump's words about a \"loser general\", Zelensky says Russian troops failed to take Kyiv not because of one general but because they did not expect resistance. In his view Putin will not risk using nuclear weapons, or Russia would lose all its allies.",
  "Meduza relays a BBC Russian Service fact-check of Trump's story about a \"stupid general\" who drove tanks into the mud: the offensive on Kyiv from Belarus was commanded by Colonel General Alexander Chaiko, but its failure was not linked to any decision of his to turn off the road. The offensive was stopped by Ukrainian troops, who blew up the bridge over the Irpin and the Kozarovychi dam and destroyed an armoured column in Bucha. Independent outlets in the selection do not retell Zelensky's interview itself.")))

json.dump(c22, open(OUT + 'c22e.json', 'w'), ensure_ascii=False, indent=1)
