card('1013-front-claims', [10653, 10654, 10655, 4714, 7074, 8015],
 'Фронт: Минобороны РФ — 286 зданий в Доброполье за сутки и «кольцо» на Харьковщине; Генштаб ВСУ — 203 боя', 'Донецкая, Харьковская, Запорожская области', 'donetsk',
 ['расхождение: оценка ситуации', 'не проверено независимо'],
 S('Минобороны РФ заявило, что в Доброполье штурмовые группы наступали в центральной и северо-западной частях города и за сутки взяли под контроль 286 зданий, что группировка «Север» сжимает кольцо окружения в Харьковской области, а «Восток» продвигается в глубину обороны в Днепропетровской и Запорожской областях.',
   (10654, 'за сутки под контроль перешли 286 зданий'),
   (10655, 'Российские войска в Харьковской области сжимают кольцо окружения противника и расширяют внешнюю зону контроля')),
 S('Генштаб ВСУ сообщил о 203 боевых столкновениях за прошедшие сутки, 90 авиаударах и 301 управляемой авиабомбе, а к 22:00 13 октября — о 206 боях.',
   (7074, 'Вчора противник завдав 90 авіаційних ударів, під час яких скинув 301 керовану авіабомбу.'),
   (8015, 'Від початку доби 13 жовтня на фронті зафіксували 206 бойових зіткнень.')),
 None,
 'Российская сторона сообщает о продвижении и окружении, украинская — о числе боев и ударов, не подтверждая российских успехов. Заявления сторон независимо не проверены.',
 'medium', 'Фронтовые заявления сторон независимо не проверены.', True,
 ['Фронт: Міноборони РФ — 286 будівель у Добропіллі за добу і «кільце» на Харківщині; Генштаб ЗСУ — 203 бої', 'Донецька, Харківська, Запорізька області',
  'Російська сторона повідомляє про просування та оточення, українська — про кількість боїв і ударів, не підтверджуючи російських успіхів. Заяви сторін незалежно не перевірені.',
  'Міноборони РФ заявило, що в Добропіллі штурмові групи наступали в центральній і північно-західній частинах міста і за добу взяли під контроль 286 будівель, що угруповання «Північ» стискає кільце оточення в Харківській області, а «Схід» просувається вглиб оборони на Дніпропетровщині та Запоріжжі.',
  'Генштаб ЗСУ повідомив про 203 бойові зіткнення за минулу добу, 90 авіаударів і 301 керовану авіабомбу, а до 22:00 13 жовтня — про 206 боїв.',
  None],
 ['Front: Russia claims 286 buildings in Dobropillia in a day and a "ring" in Kharkiv region; Ukraine\'s General Staff reports 203 clashes', 'Donetsk, Kharkiv and Zaporizhzhia regions',
  'The Russian side reports advances and an encirclement; the Ukrainian side reports the number of clashes and strikes without confirming Russian gains. The claims have not been independently verified.',
  'The Russian Defence Ministry said assault groups advanced in the central and north-western parts of Dobropillia, taking 286 buildings in a day, that its North group was tightening the encirclement in Kharkiv region and its East group was advancing deeper into the defences in Dnipropetrovsk and Zaporizhzhia regions.',
  'Ukraine\'s General Staff reported 203 combat clashes over the past day, 90 air strikes and 301 guided bombs, and by 22:00 on 13 October 206 clashes.',
  None])

card('1013-donetsk-sloviansk-kramatorsk', [8004, 7987, 7080],
 'Удары по Славянску и Краматорску: один погибший, 11 раненых; с 1 ноября на Донетчине комендантский час 19 часов в сутки', 'Славянск, Краматорск', 'donetsk',
 ['одна из групп не освещает'],
 None,
 S('Глава Донецкой ОВА Вадим Филашкин сообщил, что два удара по Славянску убили по меньшей мере одного человека и ранили восемь, повреждены пять многоэтажек; в Краматорске, по словам Александра Гончаренко, российские войска трижды ударили по пункту набора воды, ранены трое. С 1 ноября почти на всей подконтрольной Украине части Донетчины комендантский час продлится с 16:00 до 11:00. Суспільне пишет, что фронт находится в 8 километрах от Краматорска.',
   (8004, 'Щонайменше 1 людина загинула і 8 поранені внаслідок сьогоднішніх двох ударів по Слов\'янську.'),
   (7987, 'комендантська година триватиме з 16:00 до 11:00')),
 None,
 'Событие освещают только украинские источники.',
 'low', '', False,
 ['Удари по Слов’янську і Краматорську: один загиблий, 11 поранених; з 1 листопада на Донеччині комендантська година 19 годин на добу', 'Слов’янськ, Краматорськ',
  'Подію висвітлюють лише українські джерела.',
  None,
  'Голова Донецької ОВА Вадим Філашкін повідомив, що два удари по Слов’янську вбили щонайменше одну людину і поранили вісьмох, пошкоджено п’ять багатоповерхівок; у Краматорську, за словами Олександра Гончаренка, російські війська тричі вдарили по пункту набору води, поранено трьох. З 1 листопада майже на всій підконтрольній Україні частині Донеччини комендантська година триватиме з 16:00 до 11:00. Суспільне пише, що фронт за 8 кілометрів від Краматорська.',
  None],
 ['Strikes on Sloviansk and Kramatorsk: one dead, 11 injured; from 1 November a 19-hour daily curfew in Donetsk region', 'Sloviansk, Kramatorsk',
  'Only Ukrainian sources cover the event.',
  None,
  'Donetsk governor Vadym Filashkin said two strikes on Sloviansk killed at least one person and injured eight, damaging five apartment blocks; in Kramatorsk, according to Oleksandr Honcharenko, Russian forces struck a water collection point three times, injuring three. From 1 November the curfew across almost all Ukrainian-held Donetsk region will run from 16:00 to 11:00. Suspilne writes that the front is 8 kilometres from Kramatorsk.',
  None])

card('1013-kupiansk-human-shields', [7991, 8549],
 '«Хартия»: российские военные вывели гражданских к газопроводу у Купянска как «живой щит», затем обстреляли их', 'Купянск', 'kharkiv',
 ['одна из групп не освещает', 'атрибуция', 'не проверено независимо'],
 None,
 S('Корпус Нацгвардии «Хартия» сообщил, что российские военные вели группу гражданских — двух женщин, ребенка и нескольких мужчин — к трубе газопровода «Шебелинка — Острогожск», прикрываясь ими, а затем сами обстреляли группу из минометов и артиллерии; по видео дронов, среди людей есть жертвы, украинские военные огонь не открывали.',
   (7991, 'У Купʼянську росіяни прикривалися мирними жителями, виводячи їх до труби газогону, й самі ж накрили групу мінометним та артилерійським вогнем.')),
 S('Kyiv Independent пересказывает заявление «Хартии» и видео; корпус предупредил, что российские СМИ могут использовать кадры, чтобы обвинить Украину, и передаст материалы для расследования военных преступлений.',
   (8549, 'Drone footage recorded by Ukrainian reconnaissance units showed casualties among the civilians')),
 'Сведения исходят от украинских военных; российские источники в выборке инцидент не освещают, независимой проверки нет.',
 'medium', 'Заявление одной стороны.', False,
 ['«Хартія»: російські військові вивели цивільних до газогону біля Куп’янська як «живий щит», потім обстріляли їх', 'Куп’янськ',
  'Відомості походять від українських військових; російські джерела у вибірці інцидент не висвітлюють, незалежної перевірки немає.',
  None,
  'Корпус Нацгвардії «Хартія» повідомив, що російські військові вели групу цивільних — двох жінок, дитину і кількох чоловіків — до труби газогону «Шебелинка — Острогожськ», прикриваючись ними, а потім самі обстріляли групу з мінометів і артилерії; за відео дронів, серед людей є жертви, українські військові вогонь не відкривали.',
  'Kyiv Independent переказує заяву «Хартії» і відео; корпус попередив, що російські ЗМІ можуть використати кадри, щоб звинуватити Україну, і передасть матеріали для розслідування воєнних злочинів.'],
 ['Khartia: Russian troops led civilians to a gas pipeline near Kupiansk as a "human shield", then fired on them', 'Kupiansk',
  'The information comes from Ukrainian military; Russian sources in the sample do not cover the incident, and there is no independent verification.',
  None,
  'The National Guard\'s Khartia corps said Russian troops led a group of civilians — two women, a child and several men — to the Shebelynka–Ostrogozhsk gas pipeline, shielding themselves with them, and then fired on the group with mortars and artillery; drone video shows casualties, and Ukrainian troops did not open fire.',
  'Kyiv Independent relays Khartia\'s statement and video; the corps warned that Russian media could use the footage to blame Ukraine and said it would hand the materials to war crimes investigators.'])

card('1013-night-attack-regions', [6543, 10652, 10630, 10674, 5834, 7965, 7958, 7998, 8006, 8011, 8013, 7961, 8542],
 'Ночная атака: 5 баллистических ракет и 108 дронов; удары по Львовщине, Павлограду, Луцку и железной дороге; Минобороны РФ — по ВПК и логистике', 'Украина', 'ukraine-wide',
 ['расхождение: характер целей'],
 S('Минобороны РФ заявило о групповых ударах высокоточным оружием и беспилотниками по предприятиям ВПК, логистическим центрам, железнодорожной и портовой инфраструктуре, в том числе по логистическому центру «Новая почта» в Терновке и складу «Микуличи» в Киевской области, где, по версии ведомства, хранились ударные дроны.',
   (10674, 'поражен логистический склад Микуличи, используемый для хранения ударных беспилотных летательных аппаратов ВСУ')),
 S('Воздушные силы сообщили, что с 18:00 12 октября Россия выпустила 5 баллистических ракет, 9 боеприпасов «Бандероль» и 108 дронов, 88 сбиты. В селе Мурованое на Львовщине горели три дома и машины, в Малехове пострадали трое; дроны убили человека в центре Павлограда; обломки «Шахеда» упали на развлекательный центр в Луцке; поврежден объект железной дороги в Жмеринском районе.',
   (7965, 'У ніч на 13 жовтня Росія атакувала Україну 5 балістичними ракетами, 9 баражуючими боєприпасами та 108 безпілотниками, з яких сили ППО збили 88.'),
   (8006, 'Ворог атакував Павлоград безпілотниками. Одна людина загинула, двоє дістали поранень.')),
 S('Kyiv Independent со ссылкой на региональные власти пишет, что за сутки российские атаки убили не менее 10 и ранили 80 человек по всей Украине.',
   (8542, 'At least 10 people were killed and 80 others injured across Ukraine over the past day')),
 'Минобороны РФ сообщает о военных целях, украинские власти — о попаданиях в жилые дома, развлекательный центр и гражданскую инфраструктуру. Военный характер названных Россией объектов независимо не подтвержден.',
 'medium', 'Характер целей описывается сторонами по-разному.', True,
 ['Нічна атака: 5 балістичних ракет і 108 дронів; удари по Львівщині, Павлограду, Луцьку та залізниці; Міноборони РФ — по ВПК і логістиці', 'Україна',
  'Міноборони РФ повідомляє про військові цілі, українська влада — про влучання в житлові будинки, розважальний центр і цивільну інфраструктуру. Військовий характер названих Росією об’єктів незалежно не підтверджено.',
  'Міноборони РФ заявило про групові удари високоточною зброєю і безпілотниками по підприємствах ВПК, логістичних центрах, залізничній і портовій інфраструктурі, зокрема по логістичному центру «Нової пошти» в Терновому і складу «Микуличі» на Київщині, де, за версією відомства, зберігалися ударні дрони.',
  'Повітряні сили повідомили, що з 18:00 12 жовтня Росія випустила 5 балістичних ракет, 9 боєприпасів «Бандероль» і 108 дронів, 88 збито. У селі Муроване на Львівщині горіли три будинки та авто, у Малехові постраждали троє; дрони вбили людину в центрі Павлограда; уламки «Шахеда» впали на розважальний центр у Луцьку; пошкоджено об’єкт залізниці в Жмеринському районі.',
  'Kyiv Independent з посиланням на регіональну владу пише, що за добу російські атаки вбили щонайменше 10 і поранили 80 людей по всій Україні.'],
 ['Overnight attack: 5 ballistic missiles and 108 drones; strikes on Lviv region, Pavlohrad, Lutsk and the railway; Russia claims defence industry and logistics targets', 'Ukraine',
  'The Russian Defence Ministry reports military targets; Ukrainian authorities report hits on homes, an entertainment centre and civilian infrastructure. The military nature of the sites named by Russia has not been independently confirmed.',
  'The Russian Defence Ministry reported group strikes with precision weapons and drones on defence plants, logistics centres and rail and port infrastructure, including the Nova Poshta logistics centre in Ternovka and the Mykulychi depot in Kyiv region, where, it said, strike drones were stored.',
  'The Air Force said that from 18:00 on 12 October Russia launched 5 ballistic missiles, 9 Banderol munitions and 108 drones, 88 of which were shot down. In the village of Murovane in Lviv region three houses and cars burned, and three people were hurt in Malekhiv; drones killed a person in central Pavlohrad; Shahed debris fell on an entertainment centre in Lutsk; a railway facility was damaged in Zhmerynka district.',
  'Kyiv Independent, citing regional authorities, writes that over the day Russian attacks killed at least 10 and injured 80 people across Ukraine.'])

card('1013-syrskyi-bbc-interview', [7082, 7974, 7973],
 'Сырский в интервью BBC: разногласия с Федоровым касались закупок дронов; Курская операция была необходимостью', 'Украина', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Бывший главнокомандующий ВСУ Александр Сырский рассказал BBC, что его противоречия с тогдашним министром обороны Михаилом Федоровым касались распределения оборонного бюджета: министр, по его словам, отдавал предпочтение определенным видам дронов, «игнорируя потребности армии». Курскую операцию Сырский назвал успешным маневром и необходимостью.',
   (7082, 'віддавав перевагу певним видам цих дронів, ігноруючи потреби армії, які надавались Генеральним штабом'),
   (7973, 'Ви ж розумієте, ця операція була необхідністю.')),
 None,
 'Интервью пересказывают только украинские СМИ; позиция Федорова в выборке не приводится.',
 'low', '', False,
 ['Сирський в інтерв’ю BBC: розбіжності з Федоровим стосувалися закупівель дронів; Курська операція була необхідністю', 'Україна',
  'Інтерв’ю переказують лише українські ЗМІ; позиція Федорова у вибірці не наводиться.',
  None,
  'Колишній головнокомандувач ЗСУ Олександр Сирський розповів BBC, що його суперечності з тодішнім міністром оборони Михайлом Федоровим стосувалися розподілу оборонного бюджету: міністр, за його словами, віддавав перевагу певним видам дронів, «ігноруючи потреби армії». Курську операцію Сирський назвав успішним маневром і необхідністю.',
  None],
 ['Syrskyi tells the BBC his disagreements with Fedorov were over drone procurement; the Kursk operation was a necessity', 'Ukraine',
  'Only Ukrainian media relay the interview; Fedorov\'s position is not given in the sample.',
  None,
  'Former Commander-in-Chief Oleksandr Syrskyi told the BBC that his disputes with then Defence Minister Mykhailo Fedorov concerned the allocation of the defence budget: the minister, he said, favoured certain types of drones, "ignoring the needs of the army". Syrskyi called the Kursk operation a successful manoeuvre and a necessity.',
  None])

card('1013-kellogg-strikes', [7072, 7956],
 'Келлог: Украина вправе бить по целям в России, заявления Трампа — «шум»', 'США', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Бывший спецпосланник Трампа Кит Келлог в интервью Bloomberg заявил, что в конфликте нельзя оставлять противнику «безопасных зон» и что Украина вправе наносить удары по целям в России, поскольку Москва уже атаковала украинскую энергетику; высказывания Трампа о смене Зеленского он назвал «шумом».',
   (7072, 'Нехай українці роблять те, що в них дуже добре виходить...Росія не перемагає у війні, а лише затягує її')),
 None,
 'Интервью пересказывают только украинские СМИ; позиция Келлога расходится с недавним призывом Трампа прекратить удары по НПЗ.',
 'low', '', False,
 ['Келлог: Україна має право бити по цілях у Росії, заяви Трампа — «шум»', 'США',
  'Інтерв’ю переказують лише українські ЗМІ; позиція Келлога розходиться з нещодавнім закликом Трампа припинити удари по НПЗ.',
  None,
  'Колишній спецпосланець Трампа Кіт Келлог в інтерв’ю Bloomberg заявив, що в конфлікті не можна залишати противнику «безпечних зон» і що Україна має право завдавати ударів по цілях у Росії, оскільки Москва вже атакувала українську енергетику; висловлювання Трампа про зміну Зеленського він назвав «шумом».',
  None],
 ['Kellogg: Ukraine has the right to strike targets in Russia; Trump\'s statements are "noise"', 'USA',
  'Only Ukrainian media relay the interview; Kellogg\'s position diverges from Trump\'s recent call to stop refinery strikes.',
  None,
  'Former Trump envoy Keith Kellogg told Bloomberg that no "safe zones" should be left to the enemy and that Ukraine has the right to strike targets in Russia, since Moscow has already attacked Ukrainian energy; he called Trump\'s remarks about replacing Zelensky "noise".',
  None])

card('1013-zakharova-black-sea-corridor', [10679, 5889],
 'Захарова: Киев прикрывает заботой о продовольственной безопасности канал морских поставок оружия', 'Москва', 'odesa',
 ['единственный источник'],
 S('Официальный представитель МИД РФ Мария Захарова заявила, что Украина и ее партнеры под предлогом заботы о глобальной продовольственной безопасности стремятся обеспечить защищенный морской канал снабжения ВСУ оружием.',
   (10679, 'Их цель очевидна - под формальным предлогом заботы о глобальной продовольственной безопасности обеспечить защищённый морской канал снабжения ВСУ оружием')),
 None, None,
