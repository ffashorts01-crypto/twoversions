# ---------------- hourly run 22 Oct 05:59 (backlog Oct 19/20) ----------------
c19 = []
c19.append(C('1019-foreigners-russian-army', [14028, 14791, 14403, 14588],
 'Коордштаб: почти 46 тысяч иностранцев из 151 страны подписали контракты с армией РФ, за девять месяцев 2026 года — больше, чем за весь 2025-й',
 'Киев', 'ukraine-wide',
 ['одна из групп не освещает', 'не проверено'],
 None,
 S("«Общественное» и РБК-Украина передают выступление секретаря Координационного штаба по вопросам обращения с военнопленными Дмитрия Усова на конференции Crimea Global: установлены личности почти 46 тысяч иностранцев из 151 страны, подписавших контракты с вооруженными силами РФ; план Минобороны РФ на год — 18 500 контрактов, подписано уже 16 168. Позже «Украинская правда» приводит обновленные данные проекта «Хочу жить»: 45 959 иностранцев, Россия вербует около 1 800 человек в месяц, больше всего — в Узбекистане, Таджикистане и Беларуси.",
   (14791, 'Сьогодні ми маємо вже цифру майже 46 тисяч іноземців , які підписали контракти, і це вже 151 країна світу'),
   (14028, 'В плані Міноборони РФ було підписати (контакти — ред.) з 18 500 іноземцями, то вже підписано 16 168.'),
   (14403, 'Наразі Росія вербує близько 1 800 іноземців щомісяця.')),
 S("The Kyiv Independent со ссылкой на Координационный штаб пишет о 45 959 иностранцах из 151 страны и непризнанных территорий; по оценке ведомства, при нынешних темпах число новых контрактников к концу года может достичь около 21 500. Издание приводит также данные опроса: 46,7% завербованных подписали контракт ради российского гражданства, 28% не знали, что их отправят в бой.",
   (14588, 'A total of 45,959 foreigners have signed contracts with the Russian Armed Forces since the beginning of the full-scale invasion in 2022'),
   (14588, "Further survey findings revealed that 46.7% of recruits signed the contract to obtain Russian citizenship, while 28% were unaware they would be sent into combat.")),
 "Данные приводит только украинская сторона — Координационный штаб; The Kyiv Independent пересказывает их со ссылкой на ведомство и добавляет данные опроса пленных. Российские источники в выборке эти цифры не упоминают и не комментируют.",
 'medium', 'Цифры основаны на данных украинского государственного ведомства; независимой проверки в выборке нет.', False,
 ('Коордштаб: майже 46 тисяч іноземців зі 151 країни підписали контракти з армією РФ, за дев’ять місяців 2026 року — більше, ніж за весь 2025-й',
  'Київ',
  'Дані наводить лише українська сторона — Координаційний штаб; The Kyiv Independent переказує їх із посиланням на відомство й додає дані опитування полонених. Російські джерела в добірці ці цифри не згадують і не коментують.',
  None,
  '«Суспільне» та РБК-Україна передають виступ секретаря Координаційного штабу з питань поводження з військовополоненими Дмитра Усова на конференції Crimea Global: встановлено особи майже 46 тисяч іноземців зі 151 країни, які підписали контракти зі збройними силами РФ; план Міноборони РФ на рік — 18 500 контрактів, підписано вже 16 168. Пізніше «Українська правда» наводить оновлені дані проєкту «Хочу жить»: 45 959 іноземців, Росія вербує близько 1 800 осіб на місяць, найбільше — в Узбекистані, Таджикистані та Білорусі.',
  'The Kyiv Independent із посиланням на Координаційний штаб пише про 45 959 іноземців зі 151 країни та невизнаних територій; за оцінкою відомства, за нинішніх темпів кількість нових контрактників до кінця року може сягнути близько 21 500. Видання наводить також дані опитування: 46,7% завербованих підписали контракт заради російського громадянства, 28% не знали, що їх відправлять у бій.'),
 ('Coordination HQ: almost 46 thousand foreigners from 151 countries have signed contracts with the Russian army, more in nine months of 2026 than in all of 2025',
  'Kyiv',
  'The figures come only from the Ukrainian side, the Coordination Headquarters; The Kyiv Independent retells them citing the agency and adds survey data from prisoners. Russian sources in the selection neither mention nor comment on these figures.',
  None,
  'Suspilne and RBC-Ukraine relay a speech by Dmytro Usov, secretary of the Coordination Headquarters for the Treatment of Prisoners of War, at the Crimea Global conference: the identities of almost 46 thousand foreigners from 151 countries who signed contracts with the Russian armed forces have been established; the Russian Defence Ministry plans 18 500 contracts this year, and 16 168 have already been signed. Later Ukrainska Pravda gives updated data from the "I Want to Live" project: 45 959 foreigners, Russia recruits about 1 800 people a month, most of them in Uzbekistan, Tajikistan and Belarus.',
  'The Kyiv Independent, citing the Coordination Headquarters, writes of 45 959 foreigners from 151 countries and unrecognised territories; at the current pace, the agency estimates, the number of new contract soldiers could reach about 21 500 by the end of the year. The outlet also cites survey data: 46.7% of recruits signed the contract to obtain Russian citizenship, and 28% did not know they would be sent into combat.')))
json.dump(c19, open(OUT + 'c19o.json', 'w'), ensure_ascii=False, indent=1)

c20 = []
c20.append(C('1020-hur-sumy-operation-29-captured', [14408, 14585],
 'ГУР: в ходе семинедельной операции на Сумщине взяты в плен 29 российских военных, 108 убиты; данные не проверены',
 'Сумская область', 'sumy',
 ['одна из групп не освещает', 'не проверено'],
 None,
 S("«Украинская правда» передает заявление Департамента активных действий ГУР Минобороны Украины: подразделение GROUP 10 в ходе рейда на Сумщине взяло в плен 29 российских военных, еще 108 убиты и 157 ранены; всего поражено более 1100 целей. Операция длилась около семи недель в два этапа, в ней участвовали 40 спецназовцев, от российских войск очищено более 600 га леса.",
   (14408, 'Підрозділ GROUP 10 Департаменту активних дій ГУР МО взяв в полон 29 окупантів під час рейду на Сумщині.'),
   (14408, 'Операція тривала близько 7 тижнів та проходила в два етапи.')),
 S("The Kyiv Independent пересказывает те же данные ГУР — 108 убитых, 29 пленных, более 1100 пораженных целей за семь недель — и добавляет, что ГУР не уточнило точное место и время операции, а само издание не смогло независимо проверить эти утверждения.",
   (14585, 'HUR did not specify the exact location of the operation or when it took place.'),
   (14585, 'The Kyiv Independent could not independently verify these claims.')),
 "Обе версии основаны на одном заявлении ГУР. Украинский источник передает его без оговорок, The Kyiv Independent подчеркивает, что место и время операции не названы, а данные не проверены. Российские источники в выборке об операции не сообщают.",
 'medium', 'Единственный источник — заявление ГУР; место и сроки операции не названы, независимой проверки нет.', False,
 ('ГУР: під час семитижневої операції на Сумщині взято в полон 29 російських військових, 108 убито; дані не перевірені',
  'Сумська область',
  'Обидві версії ґрунтуються на одній заяві ГУР. Українське джерело передає її без застережень, The Kyiv Independent наголошує, що місце й час операції не названо, а дані не перевірені. Російські джерела в добірці про операцію не повідомляють.',
  None,
  '«Українська правда» передає заяву Департаменту активних дій ГУР Міноборони України: підрозділ GROUP 10 під час рейду на Сумщині взяв у полон 29 російських військових, ще 108 убито і 157 поранено; загалом уражено понад 1100 цілей. Операція тривала близько семи тижнів у два етапи, у ній брали участь 40 спецпризначенців, від російських військ зачищено понад 600 га лісу.',
  'The Kyiv Independent переказує ті самі дані ГУР — 108 убитих, 29 полонених, понад 1100 уражених цілей за сім тижнів — і додає, що ГУР не уточнило точне місце й час операції, а саме видання не змогло незалежно перевірити ці твердження.'),
 ('HUR: 29 Russian soldiers captured and 108 killed in a seven-week operation in Sumy region; claims unverified',
  'Sumy region',
  'Both versions rest on a single HUR statement. The Ukrainian source relays it without caveats, while The Kyiv Independent stresses that the place and time of the operation were not given and the figures are unverified. Russian sources in the selection do not report the operation.',
  None,
  'Ukrainska Pravda relays a statement by the Active Operations Department of Ukraine\'s military intelligence (HUR): the GROUP 10 unit captured 29 Russian soldiers during a raid in Sumy region, while 108 were killed and 157 wounded; in total more than 1100 targets were hit. The operation lasted about seven weeks in two stages, 40 special forces took part, and more than 600 hectares of forest were cleared of Russian troops.',
  'The Kyiv Independent retells the same HUR figures, 108 killed, 29 captured and more than 1100 targets hit over seven weeks, and adds that HUR did not specify the exact place and time of the operation and that the outlet itself could not independently verify the claims.')))
json.dump(c20, open(OUT + 'c20f.json', 'w'), ensure_ascii=False, indent=1)
c21 = []
c21.append(C('1021-denmark-fire-point-loan-guarantee', [14610, 15737],
 'Дания гарантирует кредит на 750 млн крон датской «дочке» украинского производителя ракет Fire Point',
 'Копенгаген, Скрюдструп', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S("«Украинская правда» со ссылкой на Reuters и пресс-релиз Министерства предпринимательства Дании сообщает, что правительство Дании предоставит гарантию по кредиту в 750 миллионов датских крон (112,6 миллиона долларов) датской дочерней компании украинского производителя ракет и беспилотников Fire Point; финансирование пойдет через Экспортно-инвестиционный фонд EIFO. Завод твердого ракетного топлива строят в Южной Ютландии у авиабазы Скрюдструп, он должен заработать до конца 2027 года. Министр обороны Еппе Бруус подчеркивает, что производство за рубежом защищено от российских ударов.",
   (15737, 'Ця позика забезпечена державною гарантією Данії, оскільки війна в Україні ускладнює для Fire Point можливість отримати кредит у Данії на стандартних комерційних умовах'),
   (15737, 'Завод із випуску твердого ракетного палива будують у Південній Ютландії поблизу авіабази Скридструп.')),
 S("The Kyiv Independent пишет о той же гарантии на 750 миллионов крон (113 миллионов долларов), объявленной правительством Дании 21 октября, и называет ее примером того, как Дания помогает Украине выносить оборонное производство за границу, пока российские удары угрожают предприятиям в самой Украине. Издание приводит слова министра обороны Брууса и главы EIFO Педера Лундквиста: фонд участвует почти в 40 проектах поддержки Украины.",
   (14610, 'The loan is backed by the Danish state as Russia’s war against Ukraine prevents the company from borrowing on ordinary terms in Denmark.'),
   (14610, 'EIFO CEO Peder Lundqvist said the fund is currently involved in almost 40 projects supporting Ukraine and cooperation between Ukrainian and Danish companies.')),
 "Украинский и независимый источники передают решение одинаково, со ссылкой на датское правительство; The Kyiv Independent дает больше контекста о партнерствах Fire Point в Европе. Российские источники в выборке о гарантии не сообщают.",
 'low', 'Сведения основаны на официальном пресс-релизе правительства Дании.', False,
 ('Данія гарантує кредит на 750 млн крон данській «доньці» українського виробника ракет Fire Point',
  'Копенгаген, Скридструп',
  'Українське та незалежне джерела передають рішення однаково, з посиланням на данський уряд; The Kyiv Independent дає більше контексту про партнерства Fire Point у Європі. Російські джерела в добірці про гарантію не повідомляють.',
  None,
  '«Українська правда» з посиланням на Reuters і пресреліз Міністерства підприємництва Данії повідомляє, що уряд Данії надасть гарантію на кредит у 750 мільйонів данських крон (112,6 мільйона доларів) данській дочірній компанії українського виробника ракет і безпілотників Fire Point; фінансування піде через Експортно-інвестиційний фонд EIFO. Завод твердого ракетного палива будують у Південній Ютландії біля авіабази Скридструп, він має запрацювати до кінця 2027 року. Міністр оборони Єппе Бруус наголошує, що виробництво за кордоном захищене від російських ударів.',
  'The Kyiv Independent пише про ту саму гарантію на 750 мільйонів крон (113 мільйонів доларів), оголошену урядом Данії 21 жовтня, і називає її прикладом того, як Данія допомагає Україні виносити оборонне виробництво за кордон, поки російські удари загрожують підприємствам у самій Україні. Видання наводить слова міністра оборони Брууса та голови EIFO Педера Лундквіста: фонд бере участь майже в 40 проєктах підтримки України.'),
 ('Denmark guarantees a 750 million krone loan to the Danish subsidiary of Ukrainian missile maker Fire Point',
  'Copenhagen, Skrydstrup',
  'The Ukrainian and independent sources report the decision in the same way, citing the Danish government; The Kyiv Independent gives more context on Fire Point\'s partnerships in Europe. Russian sources in the selection do not report the guarantee.',
  None,
  'Ukrainska Pravda, citing Reuters and a press release from Denmark\'s Ministry of Industry, reports that the Danish government will guarantee a loan of 750 million Danish kroner (112.6 million dollars) to the Danish subsidiary of Ukrainian missile and drone maker Fire Point; the financing will go through the Export and Investment Fund EIFO. A solid rocket fuel plant is being built in South Jutland near Skrydstrup air base and is due to start operating by the end of 2027. Defence Minister Jeppe Bruus stresses that production abroad is protected from Russian strikes.',
  'The Kyiv Independent writes about the same 750 million krone (113 million dollar) guarantee, announced by the Danish government on 21 October, and calls it an example of how Denmark helps Ukraine move defence production abroad while Russian strikes threaten plants in Ukraine itself. It quotes Defence Minister Bruus and EIFO chief Peder Lundqvist, who says the fund is involved in almost 40 projects supporting Ukraine.')))
json.dump(c21, open(OUT + 'c21j.json', 'w'), ensure_ascii=False, indent=1)
print('c19o', len(c19), 'c20f', len(c20), 'c21j', len(c21))
