    add(c, 'ru', 'ТАСС на английском со ссылкой на Bloomberg передает слова Рубио в Индии, сказанные в ответ на вопрос о публикации WSJ: без помощи США, в том числе при Трампе, Украины как суверенного государства не существовало бы.',
        'ТАСС англійською з посиланням на Bloomberg передає слова Рубіо в Індії, сказані у відповідь на запитання про публікацію WSJ: без допомоги США, зокрема за Трампа, України як суверенної держави не існувало б.',
        'TASS in English, citing Bloomberg, relays Rubio\'s words in India in reply to a question about the WSJ report: without US help, including under Trump, Ukraine would not exist as a sovereign state.',
        [(13766, 'Ukraine as a sovereign state would not exist')])
    add(c, 'ua', '«Украинская правда» и РБК-Украина приводят те же слова Рубио; «Украинская правда» добавляет его похвалу украинским военным, которые «очень смело» защищаются от значительно большей страны.',
        '«Українська правда» і РБК-Україна наводять ті самі слова Рубіо; «Українська правда» додає його похвалу українським військовим, які «дуже сміливо» захищаються від значно більшої країни.',
        'Ukrainska Pravda and RBC-Ukraine quote the same words of Rubio; Ukrainska Pravda adds his praise for Ukrainian troops, who are defending themselves "very bravely" against a much larger country.',
        [(14445, 'Вони дуже сміливо захищаються в боротьбі проти значно більшої країни')])

@ext('1021-poland-upa-year-dispute', [16227, 16298, 13894, 13922, 13627, 14453, 14303, 14475, 14461, 14998, 15010, 14337])
def _(c):
    add(c, 'ru', 'ТАСС также сообщает о запрете на въезд Шеремете и о внесении в Сейм очередного законопроекта о криминализации «бандеровской идеологии». Утром 22 октября ТАСС передал опровержение представителя Минобороны Польши Януша Сеймея — не упоминая само сообщение о приостановке — и слова министра-координатора спецслужб Томаша Семоняка, назвавшего решение облсовета «неприемлемым» и «фатальным».',
        'ТАСС також повідомляє про заборону на в’їзд Шереметі та про внесення до Сейму чергового законопроєкту про криміналізацію «бандерівської ідеології». Уранці 22 жовтня ТАСС передав спростування речника Міноборони Польщі Януша Сеймея — не згадуючи саме повідомлення про призупинення — і слова міністра-координатора спецслужб Томаша Сємоняка, який назвав рішення облради «неприйнятним» і «фатальним».',
        'TASS also reports the entry ban on Sheremeta and the submission to the Sejm of another bill criminalising "Banderite ideology". On the morning of 22 October TASS relayed the denial by Polish Defence Ministry spokesman Janusz Sejmej, without mentioning the suspension report itself, and the words of special services coordinator Tomasz Siemoniak, who called the council\'s decision "unacceptable" and "fatal".',
        [(13922, 'В нижней палате парламента республики на рассмотрении уже находятся два аналогичных законопроекта'),
         (16227, 'Пресс-секретарь польского Министерства национальной обороны Януш Сеймей назвал эту информацию ложной'),
         (16298, 'назвал решение львовского облсовета "неприемлемым" и "фатальным"')])
    add(c, 'ua', '«Украинская правда» приводит и слова премьера Польши Дональда Туска: это «неразумное решение», которое прежде всего вредит самой Украине.',
        '«Українська правда» наводить і слова прем’єра Польщі Дональда Туска: це «нерозумне рішення», яке насамперед шкодить самій Україні.',
        'Ukrainska Pravda also quotes Polish Prime Minister Donald Tusk: it is an "unwise decision" that above all harms Ukraine itself.',
        [(14453, 'яке насамперед шкодить самій Україні')])
    rep(c, ['diverge'], 'РИА Новости пишет только о запрете на въезд депутату',
        'РИА Новости пишет только о запрете на въезд депутату, ТАСС позже — об опровержении Минобороны Польши, не упоминая само сообщение,')
    rep(c, ['uk', 'd'], 'РИА Новости пише лише про заборону на в’їзд депутату',
        'РИА Новости пише лише про заборону на в’їзд депутату, ТАСС пізніше — про спростування Міноборони Польщі, не згадуючи саме повідомлення,')
    rep(c, ['en', 'd'], 'RIA Novosti writes only about the entry ban on the deputy',
        'RIA Novosti writes only about the entry ban on the deputy, and TASS later about the Polish Defence Ministry\'s denial without mentioning the report itself,')

@ext('1021-russian-diesel-first-tanker-us', [16222, 15312, 14630])
