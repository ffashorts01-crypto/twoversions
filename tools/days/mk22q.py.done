import sys, glob, os
sys.path.insert(0, "/workspace/compare-site-v2/tools/days")
from extlib import ext, add, setd, apply, q
# ---------------- hourly run 22 Oct 10:04: extensions (new ids + backlog) ----------------
def rep(c, path, old, new):
    d = c
    for k in path[:-1]: d = d[k]
    assert old in d[path[-1]], (c['key'], path, old[:40]); d[path[-1]] = d[path[-1]].replace(old, new)
def noop(c): pass

@ext('1022-mod-massive-strike-vpk-energy', [16173, 16230, 16288, 16345, 16347, 16350, 13882])
def _(c):
    rep(c, ['ru', 'summary'], 'РИА Новости, ТАСС и «Интерфакс» передают сводку без сведений о пострадавших; РИА Новости добавляет привычную формулировку о том, что удары наносятся для снижения военно-экономического потенциала противника.',
        'Агентства передают сводку без сведений о пострадавших; РИА Новости добавляет, что удары наносятся для снижения военно-экономического потенциала противника.')
    rep(c, ['uk', 'ru'], 'РИА Новости, ТАСС та «Інтерфакс» передають зведення без відомостей про постраждалих; РИА Новости додає звичне формулювання про те, що удари завдаються для зниження військово-економічного потенціалу противника.',
        'Агентства передають зведення без відомостей про постраждалих; РИА Новости додає, що удари завдаються для зниження військово-економічного потенціалу противника.')
    rep(c, ['en', 'ru'], "RIA Novosti, TASS and Interfax relay the summary without information on casualties; RIA Novosti adds the usual line that the strikes aim to reduce the enemy's military and economic potential.",
        "The agencies relay the summary without casualty figures; RIA Novosti adds that the strikes aim to reduce the enemy's military and economic potential.")
    add(c, 'ru', 'РИА Новости пишет, что ВВС Украины «признали», что не сбили ни одной баллистической и противокорабельной ракеты; ТАСС — что в Киеве и восьми областях частично нет света из-за повреждения энергообъектов.',
        'РИА Новости пише, що ВПС України «визнали», що не збили жодної балістичної та протикорабельної ракети; ТАСС — що в Києві та восьми областях частково немає світла через пошкодження енергооб’єктів.',
        'RIA Novosti writes that the Ukrainian Air Force "admitted" it did not shoot down a single ballistic or anti-ship missile; TASS that Kyiv and eight regions are partly without power because of damaged energy facilities.',
        [(16173, 'Воздушные силы ВСУ признали, что не смогли сбить ни одной баллистической и противокорабельной ракеты за ночь.'),
         (16288, 'В Киеве и восьми областях Украины частично нет света. Причиной стало повреждение энергообъектов')])
    c['ua']['summary'] = ("РБК-Украина приводит слова главы МИД Андрея Сибиги, отсылающего к словам Уиткоффа о Путине-«гуманисте»: ночью киевляне услышали, как на самом деле звучит российский «гуманизм» — удар десятками баллистических ракет по энергетике, медучреждениям, торговым центрам и жилым районам; мир, по его словам, принесет только сила. "
        "Воздушные силы сообщили, что атака началась в 18:00 21 октября: применены ракеты «Искандер-М», С-400, «Циркон» и «Оникс» и 210 беспилотников, главным направлением был Киев; сбит или подавлен 181 дрон, попадания — на 32 локациях; о сбитых ракетах не говорится. "
        "«Украинская правда» приводит слова Зеленского о трех волнах баллистических ударов и 21 ракете по Киеву: повреждены дома, энергетика, инфраструктура вокзала и метро, торговые центры, предприятия и монастырь; под ударом были 12 областей, ранены 34 человека, в том числе пятеро детей, двое погибли; удар сразу после переговоров он назвал показательным. "
        "В Винницкой области повреждены промышленные объекты, энергетика и частные дома; в Кременчуге дрон попал в здание телерадиокомпании «Визит» (никто не пострадал), в Килии горело админздание пищевого предприятия «Титан».")
    c['uk']['ua'] = ("РБК-Україна наводить слова очільника МЗС Андрія Сибіги, який відсилає до слів Віткоффа про Путіна-«гуманіста»: вночі кияни почули, як насправді звучить російський «гуманізм» — удар десятками балістичних ракет по енергетиці, медзакладах, торговельних центрах і житлових районах; мир, за його словами, принесе лише сила. "
        "Повітряні сили повідомили, що атака почалася о 18:00 21 жовтня: застосовано ракети «Іскандер-М», С-400, «Циркон» і «Онікс» та 210 безпілотників, головним напрямком був Київ; збито або подавлено 181 дрон, влучання — на 32 локаціях; про збиті ракети не йдеться. "
        "«Українська правда» наводить слова Зеленського про три хвилі балістичних ударів і 21 ракету по Києву: пошкоджено будинки, енергетику, інфраструктуру вокзалу й метро, торговельні центри, підприємства та монастир; під ударом були 12 областей, поранено 34 людини, серед них п’ятеро дітей, двоє загинули; удар одразу після переговорів він назвав показовим. "
        "На Вінниччині пошкоджено промислові об’єкти, енергетику та приватні будинки; у Кременчуці дрон влучив у будівлю телерадіокомпанії «Візит» (ніхто не постраждав), у Кілії горіла адмінбудівля харчового підприємства «Титан».")
    c['en']['ua'] = ("RBC-Ukraine quotes Foreign Minister Andrii Sybiha, alluding to Witkoff calling Putin a \"humanist\": overnight Kyiv residents heard what Russian \"humanism\" really sounds like, a strike with dozens of ballistic missiles on energy, medical facilities, shopping centres and residential areas; only strength, he says, will bring peace. "
        "The Air Force said the attack began at 18:00 on 21 October with Iskander-M, S-400, Zircon and Oniks missiles and 210 drones, Kyiv being the main target; 181 drones were shot down or suppressed, with hits at 32 locations; nothing is said about missiles shot down. "
        "Ukrainska Pravda quotes Zelensky on three waves of ballistic strikes and 21 missiles at Kyiv: homes, energy, the infrastructure of a railway station and the metro, shopping centres, businesses and a monastery were damaged; 12 regions came under attack, 34 people were injured, including five children, and two were killed; he called it a demonstrative strike right after the talks. "
        "In Vinnytsia region industrial facilities, energy and private houses were damaged; in Kremenchuk a drone hit the Vizit TV company building (no one was hurt), and in Kiliia the administrative building of the Titan food company burned.")
    c['ua']['quotes'] += [q(16345, 'Три хвилі балістичних ударів випустили російські "гуманісти" по Києву з вечора. Застосували 21 ракету.'),
                          q(16345, 'Станом на зараз відомо про двох загиблих')]
    add(c, 'ind', 'The Kyiv Independent со ссылкой на Воздушные силы пишет о ракетах «Искандер-М», С-400, «Циркон» и «Оникс» и 210 дронах, из них 110 реактивных; сбит 181 дрон, попадания — на 32 локациях. По данным местных властей, за сутки по всей Украине погибли не менее девяти человек и ранены 56 (в заголовке — 57), в том числе в Харьковской, Сумской, Донецкой, Запорожской и Черниговской областях. «Медуза» приводит формулировку Минобороны России о поражении предприятий ВПК и транспортной инфраструктуры рядом с данными ГСЧС о пострадавших в Киеве и сообщением «Общественного» о пожаре на пищевом предприятии в Одесской области, где никто не пострадал.',
        'The Kyiv Independent з посиланням на Повітряні сили пише про ракети «Іскандер-М», С-400, «Циркон» і «Онікс» та 210 дронів, із них 110 реактивних; збито 181 дрон, влучання — на 32 локаціях. За даними місцевої влади, за добу по всій Україні загинули щонайменше дев’ятеро людей і поранено 56 (у заголовку — 57), зокрема в Харківській, Сумській, Донецькій, Запорізькій і Чернігівській областях. «Медуза» наводить формулювання Міноборони Росії про ураження підприємств ВПК і транспортної інфраструктури поруч із даними ДСНС про постраждалих у Києві та повідомленням «Суспільного» про пожежу на харчовому підприємстві в Одеській області, де ніхто не постраждав.',
        'The Kyiv Independent, citing the Air Force, reports Iskander-M, S-400, Zircon and Oniks missiles and 210 drones, 110 of them jet-powered; 181 drones were shot down and hits were recorded at 32 locations. According to local authorities, at least nine people were killed and 56 injured (57 in the headline) across Ukraine over the past day, including in Kharkiv, Sumy, Donetsk, Zaporizhzhia and Chernihiv regions. Meduza gives the Russian Defence Ministry\'s wording about hitting defence plants and transport infrastructure alongside emergency service data on casualties in Kyiv and a Suspilne report of a fire at a food company in Odesa region in which no one was hurt.',
        [(16347, 'Russian attacks have killed at least nine people and injured 56 others across Ukraine over the past day'),
         (16347, 'Strikes were recorded at 32 locations, while debris from intercepted targets fell at eight others.'),
         (16350, 'A fire broke out, destroying the administrative building. No one was injured.')])
    rep(c, ['diverge'], 'Независимые источники в подборке заявление Минобороны не проверяли.',
        'Зеленский называет удар показательным ответом на переговоры, российские агентства переговоры с ударом не связывают. Независимые издания приводят формулировку Минобороны рядом с украинскими данными о жертвах, но названные цели не проверяли.')
    rep(c, ['uk', 'd'], 'Незалежні джерела в добірці заяву Міноборони не перевіряли.',
        'Зеленський називає удар показовою відповіддю на переговори, російські агентства переговори з ударом не пов’язують. Незалежні видання наводять формулювання Міноборони поруч з українськими даними про жертви, але названих цілей не перевіряли.')
    rep(c, ['en', 'd'], 'Independent sources in the selection have not checked the MoD statement.',
        'Zelensky calls the strike a demonstrative response to the talks; Russian agencies do not link the strike to the talks. Independent outlets give the MoD wording alongside Ukrainian casualty data but have not checked the named targets.')
    c['tags'] = [t for t in c['tags'] if t != 'одна из групп не освещает']

@ext('1021-kyiv-ballistic-evening-strike', [16335, 16360, 14479, 13852, 13874, 13923])
def _(c):
    c['ua']['summary'] = ("РБК-Украина, «Украинская правда» и «Общественное» со ссылкой на Воздушные силы, КГВА и мэра Виталия Кличко пишут, что Россия атаковала Киев баллистическими ракетами. Вечером в Днепровском районе были попадания в здание СТО и частный дом, повреждена АЗС, позже — объект транспортной инфраструктуры в Дарницком районе; пострадали шестеро. «Общественное» подает удар в одном заголовке с согласием Украины на трехстороннюю встречу команд. "
        "Ночью Россия второй раз выпустила по Киеву баллистические ракеты. Утром Кличко сообщил о 15 пострадавших, затем, по данным ГСЧС и полиции, — удары по шести районам, в Днепровском погиб 48-летний мужчина, ранены 22 человека, в том числе четверо детей; поврежден Южный мост, метро с левого берега идет только до «Осокорков», где скопились толпы. "
        "По данным Печерской РГА, в районе повреждены 18 жилых домов на пяти улицах, админздания, станция и шесть машин скорой помощи и Свято-Введенский монастырь, для жителей открыт штаб помощи. РБК-Украина показывает последствия на Почайной в Оболонском районе: гипермаркет «Эпицентр» почти полностью уничтожен огнем, в Retail Park разрушен магазин JYSK, у «Ашана» повреждены фасад и вход.")
    c['uk']['ua'] = ("РБК-Україна, «Українська правда» і «Суспільне» з посиланням на Повітряні сили, КМВА та мера Віталія Кличка пишуть, що Росія атакувала Київ балістичними ракетами. Увечері в Дніпровському районі були влучання в будівлю СТО та приватний будинок, пошкоджено АЗС, пізніше — об’єкт транспортної інфраструктури в Дарницькому районі; постраждали шестеро. «Суспільне» подає удар в одному заголовку зі згодою України на тристоронню зустріч команд. "
        "Вночі Росія вдруге випустила по Києву балістичні ракети. Уранці Кличко повідомив про 15 постраждалих, потім, за даними ДСНС і поліції, — удари по шести районах, у Дніпровському загинув 48-річний чоловік, поранено 22 людини, серед них четверо дітей; пошкоджено Південний міст, метро з лівого берега йде лише до «Осокорків», де зібралися натовпи. "
        "За даними Печерської РДА, у районі пошкоджено 18 житлових будинків на п’яти вулицях, адмінбудівлі, станцію та шість машин швидкої допомоги і Свято-Введенський монастир, для мешканців відкрито штаб допомоги. РБК-Україна показує наслідки на Почайній в Оболонському районі: гіпермаркет «Епіцентр» майже повністю знищено вогнем, у Retail Park зруйновано магазин JYSK, в «Ашана» пошкоджено фасад і вхід.")
    c['en']['ua'] = ("RBC-Ukraine, Ukrainska Pravda and Suspilne, citing the Air Force, the city administration and Mayor Vitali Klitschko, write that Russia attacked Kyiv with ballistic missiles. In the evening a car repair shop and a private house in Dniprovskyi district were hit and a petrol station damaged, later a transport infrastructure site in Darnytskyi district; six people were hurt. Suspilne runs the strike in one headline with Ukraine's consent to a trilateral meeting of teams. "
        "Overnight Russia fired ballistic missiles at Kyiv a second time. In the morning Klitschko reported 15 injured; then, according to the emergency service and police, six districts were hit, a 48-year-old man was killed in Dniprovskyi and 22 people were injured, including four children; the Southern Bridge was damaged and the metro from the left bank only runs to Osokorky, where crowds gathered. "
        "According to the Pecherskyi district administration, 18 residential buildings on five streets, administrative buildings, an ambulance station and six ambulances and the Holy Vvedensky Monastery were damaged; an aid centre has opened for residents. RBC-Ukraine shows the aftermath at Pochaina in Obolonskyi district: the Epicentr hypermarket was almost completely destroyed by fire, a JYSK store in Retail Park was wrecked, and Auchan's facade and entrance were damaged.")
    c['ua']['quotes'] += [q(16335, 'у Печерському районі попередньо пошкоджено 18 житлових будинків на 5 вулицях'),
                          q(16360, 'будівлю практично повністю знищено вогнем')]

@ext('1021-hubbard-released', [16363, 15244, 16343])
def _(c):
    add(c, 'ru', '«Интерфакс» приводит пост Трампа: если бы были введены санкции по «закону Грэма», переговоры об освобождении полностью прекратились бы. Утром 22 октября агентство со ссылкой на CBS сообщило, что самолет с Хаббардом приземлился на военной базе в Сан-Антонио.',
        '«Інтерфакс» наводить допис Трампа: якби було запроваджено санкції за «законом Грема», переговори про звільнення повністю припинилися б. Уранці 22 жовтня агентство з посиланням на CBS повідомило, що літак із Габбардом приземлився на військовій базі в Сан-Антоніо.',
        'Interfax quotes a Trump post: had sanctions under the "Graham law" been imposed, the talks on the release would have stopped completely. On the morning of 22 October the agency, citing CBS, reported that the plane carrying Hubbard had landed at a military base in San Antonio.',
        [(15244, 'Если бы санкции были введены, то, конечно, эти переговоры полностью прекратились бы'),
         (16363, 'Самолет, на котором, предположительно, летел Хаббард, прибыл на территорию военной базы в Сан-Антонио, штат Техас')])
    add(c, 'ua', '«Общественное» со ссылкой на Fox News сообщает, что Хаббард прибыл в Сан-Антонио, где пройдет государственную программу медицинской и психологической реабилитации.',
        '«Суспільне» з посиланням на Fox News повідомляє, що Габбард прибув до Сан-Антоніо, де пройде державну програму медичної та психологічної реабілітації.',
        'Suspilne, citing Fox News, reports that Hubbard has arrived in San Antonio, where he will go through a government medical and psychological rehabilitation programme.',
        [(16343, 'Тепер він візьме участь у стандартній урядовій програмі США')])

@ext('1021-witkoff-putin-humanitarian', [16354, 14663])
def _(c):
    add(c, 'ua', 'Позже РБК-Украина со ссылкой на CBS News привело слова Трампа: в этом конкретном случае, имея в виду освобождение Хаббарда, Путина «можно назвать и так», но сам он оценок давать не хотел бы; издание также цитирует возмущение республиканского сенатора Тома Тиллиса.',
        'Пізніше РБК-Україна з посиланням на CBS News навело слова Трампа: у цьому конкретному випадку, маючи на увазі звільнення Габбарда, Путіна «можна назвати й так», але сам він оцінок давати не хотів би; видання також цитує обурення сенатора-республіканця Тома Тілліса.',
        'Later RBC-Ukraine, citing CBS News, quoted Trump: in this particular case, referring to Hubbard\'s release, Putin "could be called that", but he personally would not want to give any assessment; the outlet also quotes the indignation of Republican Senator Thom Tillis.',
        [(16354, 'Але я особисто не хотів би давати жодних оцінок')])

@ext('1021-putin-witkoff-trilateral-talks', [13798, 15274, 14988, 16352, 16348, 16351, 15264, 15270, 15227, 14643, 16201, 16203,
    13562, 13563, 13569, 13571, 13572, 13762, 13764, 13767, 13769, 13772, 13775, 13780, 13786, 13793, 13796, 13799, 13808, 13814, 13822, 13823, 13825, 13826, 13829, 13831, 13911,
    14118, 14169, 14446, 14452, 14462, 14637, 14640, 14629, 14719, 15029, 15038, 15191, 15192, 15211, 15215, 15218, 15219, 15221, 15222, 15223, 15225, 15228, 15233, 15234, 15238, 15246, 15248, 15255, 15259, 15262, 15265, 15267, 15268, 15271, 15322, 14754, 14311, 15052])
def _(c):
    add(c, 'ru', 'ТАСС приводит слова Уиткоффа, что он привез «некоторые бумаги» с идеями об элементах мирной сделки; по словам Ушакова, на переговоры экспертного уровня может поехать военный и помощник президента Владимир Мединский.',
        'ТАСС наводить слова Віткоффа, що він привіз «деякі папери» з ідеями щодо елементів мирної угоди; за словами Ушакова, на переговори експертного рівня може поїхати військовий і помічник президента Володимир Мединський.',
        'TASS quotes Witkoff as saying he brought "some papers" with ideas on elements of a peace deal; according to Ushakov, a military officer and presidential aide Vladimir Medinsky may go to the expert-level talks.',
        [(13798, 'some ideas about the different elements of some sort of a peace deal between Russia and Ukraine'),
         (15274, 'это, в общем-то, экспертный уровень, как и раньше: военный и помощник президента Мединский')])
    add(c, 'ua', 'РБК-Украина со ссылкой на российские СМИ пишет, что Уиткофф привез Путину документы и заявил о предпосылках для прекращения огня.',
        'РБК-Україна з посиланням на російські ЗМІ пише, що Віткофф привіз Путіну документи й заявив про передумови для припинення вогню.',
        'RBC-Ukraine, citing Russian media, writes that Witkoff brought Putin documents and spoke of prerequisites for a ceasefire.',
        [(14988, 'За його словами, є передумови для припинення вогню в Україні.')])
    add(c, 'ind', 'DW и «Медуза» со ссылкой на Politico пишут, что в ЕС после визита Уиткоффа вновь обсуждают спецпредставителя для переговоров с Путиным; DW приводит слова эксперта RUSI Дэвида Лидингтона, что такой канал связи был бы полезен.',
        'DW і «Медуза» з посиланням на Politico пишуть, що в ЄС після візиту Віткоффа знову обговорюють спецпредставника для переговорів із Путіним; DW наводить слова експерта RUSI Девіда Лідінгтона, що такий канал зв’язку був би корисним.',
        'DW and Meduza, citing Politico, write that after Witkoff\'s visit the EU is again discussing a special envoy for talks with Putin; DW quotes RUSI expert David Lidington as saying such a channel would be useful.',
        [(16352, 'я действительно считаю, что было бы полезно иметь какой-то канал связи с Путиным')])

@ext('1021-musk-starlink-wsj', [13766, 14445, 14974, 15177])
