import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
cards.append(C('1012-energy-ceasefire-disputed', [10577, 7030, 7914, 7941, 7035, 9585, 9338, 8515, 9139, 9137, 8522],
 '«Энергетическое перемирие» Трампа: Зеленский говорит о нарушениях со стороны РФ, Кремлю «пока нечего сказать»', 'Киев, Варшава, Москва', 'ukraine-wide',
 ['расхождение: соблюдение перемирия', 'атрибуция'],
 S('Глава МИД РФ Сергей Лавров заявил, что реакция Зеленского на слова Трампа об энергетическом перемирии отражает его стремление «всеми правдами и неправдами» добиться передышки; Лавров сослался на слова Зеленского о том, что тот не слышал о такой договоренности.',
   (10577, 'для того, чтобы всеми правдами и неправдами продвигать свою заинтересованность в передышке')),
 S('Выступая по видеосвязи на Варшавском форуме безопасности, Зеленский сказал, что сразу после заявления Трампа Россия нанесла целенаправленный удар по электростанции в Харькове, и заметил: «Путин не читает Truth Social». Он заявил, что в Украине лишь один НПЗ, поэтому для нее ключевое — прекращение ударов по энергосистеме; в интервью Fox News — что прошлой ночью Украина не атаковала ни одного энергообъекта в России. Глава МИД Андрей Сибига перечислил удары по ТЭС в Харькове, газовой инфраструктуре области и подстанции в Житомирской области.',
   (7914, 'в Україні є лише один НПЗ'),
   (7941, 'Минулої ночі ми не атакували жодного енергетичного об\'єкта на території Росії'),
   (7035, 'Ніхто не повинен вірити словам Путіна. Краще дивіться на його дії')),
 S('Al Jazeera, DW и Guardian пишут, что Трамп объявил о перемирии в одностороннем порядке, подтверждения из Москвы не было, а Зеленский пообещал ответить, если удары по энергосистеме продолжатся. Kyiv Independent со ссылкой на ТАСС приводит слова Пескова: «Контакты продолжаются», сказать по этому поводу пока нечего.',
   (9139, 'If Russia does not agree to an energy ceasefire this winter, we will respond.'),
   (8522, 'Contacts are ongoing. As soon as we have anything to say on the matter, we will be sure to let you know')),
 'Российская сторона перемирие не подтверждает и представляет позицию Киева как стремление к «передышке»; украинская — обвиняет Россию в ударах по энергетике сразу после заявления Трампа и заявляет, что сама воздержалась от ударов по российским энергообъектам. Независимые СМИ подчеркивают, что перемирие объявлено односторонне.',
 'medium', 'Статус перемирия неясен, стороны дают противоречащие заявления.', True,
 ['«Енергетичне перемир’я» Трампа: Зеленський говорить про порушення з боку РФ, Кремлю «поки нічого сказати»', 'Київ, Варшава, Москва',
  'Російська сторона перемир’я не підтверджує і подає позицію Києва як прагнення до «перепочинку»; українська — звинувачує Росію в ударах по енергетиці одразу після заяви Трампа і заявляє, що сама утрималася від ударів по російських енергооб’єктах. Незалежні ЗМІ наголошують, що перемир’я оголошено односторонньо.',
  'Глава МЗС РФ Сергій Лавров заявив, що реакція Зеленського на слова Трампа про енергетичне перемир’я відображає його прагнення «всіма правдами і неправдами» домогтися перепочинку; Лавров послався на слова Зеленського про те, що той не чув про таку домовленість.',
  'Виступаючи по відеозв’язку на Варшавському безпековому форумі, Зеленський сказав, що одразу після заяви Трампа Росія завдала цілеспрямованого удару по електростанції в Харкові, і зауважив: «Путін не читає Truth Social». Він заявив, що в Україні лише один НПЗ, тому для неї ключове — припинення ударів по енергосистемі; в інтерв’ю Fox News — що минулої ночі Україна не атакувала жодного енергооб’єкта в Росії. Глава МЗС Андрій Сибіга перелічив удари по ТЕС у Харкові, газовій інфраструктурі області та підстанції в Житомирській області.',
  'Al Jazeera, DW і Guardian пишуть, що Трамп оголосив перемир’я в односторонньому порядку, підтвердження з Москви не було, а Зеленський пообіцяв відповісти, якщо удари по енергосистемі триватимуть. Kyiv Independent з посиланням на ТАСС наводить слова Пєскова: «Контакти тривають», сказати з цього приводу поки нічого.'],
 ['Trump\'s "energy ceasefire": Zelensky accuses Russia of violations, the Kremlin has "nothing to say yet"', 'Kyiv, Warsaw, Moscow',
  'The Russian side does not confirm the ceasefire and portrays Kyiv\'s position as a bid for a "breather"; the Ukrainian side accuses Russia of hitting energy targets right after Trump\'s announcement and says it held back from striking Russian energy sites. Independent media stress that the ceasefire was announced unilaterally.',
  'Russian Foreign Minister Sergei Lavrov said Zelensky\'s reaction to Trump\'s words about an energy ceasefire reflected his wish to obtain a breather "by fair means or foul"; Lavrov referred to Zelensky saying he had not heard of such an agreement.',
  'Speaking by video link to the Warsaw Security Forum, Zelensky said that right after Trump\'s announcement Russia carried out a targeted strike on a power plant in Kharkiv, remarking: "Putin does not read Truth Social". He said Ukraine has only one refinery, so what matters most is an end to strikes on the power grid; in a Fox News interview he said that the previous night Ukraine had not attacked a single energy facility in Russia. Foreign Minister Andrii Sybiha listed strikes on a power plant in Kharkiv, gas infrastructure in the region and a substation in Zhytomyr region.',
  'Al Jazeera, DW and the Guardian write that Trump announced the ceasefire unilaterally, there was no confirmation from Moscow, and Zelensky promised to respond if strikes on the power grid continued. Kyiv Independent, citing TASS, quotes Peskov: "Contacts are ongoing", and there is nothing to say yet.']))

cards.append(C('1012-ceasefire-western-reactions', [7023, 7022, 9325],
 'Каллас: энергетическое перемирие может быть выгодно России; Карни и Бёрнем призвали Москву его соблюдать', 'Люксембург, Оттава, Лондон', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Глава дипломатии ЕС Кая Каллас заявила, что ЕС приветствует энергетическое перемирие, если его соблюдают, но пока не видит, что Россия будет его соблюдать, и что перемирие лишь для НПЗ было бы неравным. Премьер Канады Марк Карни призвал Россию уважать договоренность.',
   (7023, 'Ми вітаємо енергетичне перемир\'я, коли воно дотримується. Ми поки не бачимо, що Росія також дотримуватиметься його'),
   (7022, 'Канада закликає Росію поважати цю угоду')),
 S('DW пишет, что британский премьер Энди Бёрнем поддержал призыв Трампа к немедленному устойчивому «энергетическому перемирию» и заявил, что Киев готов к паузе, если Россия прекратит атаки.',
   (9325, 'Это нападение на украинских мирных жителей, ввергающее их в холод и темноту')),
 'Западные политики поддерживают идею перемирия, но возлагают ответственность за его соблюдение на Россию; российские источники в выборке эти реакции не освещают.',
 'low', '', False,
 ['Каллас: енергетичне перемир’я може бути вигідним Росії; Карні та Бернем закликали Москву його дотримуватися', 'Люксембург, Оттава, Лондон',
  'Західні політики підтримують ідею перемир’я, але покладають відповідальність за його дотримання на Росію; російські джерела у вибірці ці реакції не висвітлюють.',
  None,
  'Очільниця дипломатії ЄС Кая Каллас заявила, що ЄС вітає енергетичне перемир’я, якщо його дотримуються, але поки не бачить, що Росія його дотримуватиметься, і що перемир’я лише для НПЗ було б нерівним. Прем’єр Канади Марк Карні закликав Росію поважати домовленість.',
  'DW пише, що британський прем’єр Енді Бернем підтримав заклик Трампа до негайного сталого «енергетичного перемир’я» і заявив, що Київ готовий до паузи, якщо Росія припинить атаки.'],
 ['Kallas: energy ceasefire may benefit Russia; Carney and Burnham urge Moscow to respect it', 'Luxembourg, Ottawa, London',
  'Western politicians back the idea of a ceasefire but place responsibility for observing it on Russia; Russian sources in the sample do not cover these reactions.',
  None,
  'EU foreign policy chief Kaja Kallas said the EU welcomes an energy ceasefire if it is observed, but does not yet see Russia observing it, and that a refinery-only truce would be unequal. Canadian Prime Minister Mark Carney called on Russia to respect the agreement.',
  'DW writes that British Prime Minister Andy Burnham backed Trump\'s call for an immediate lasting "energy ceasefire" and said Kyiv was ready for a pause if Russia stopped its attacks.']))

cards.append(C('1012-election-day-truce', [10580, 5753, 7042, 7922, 7024, 7907],
 'Песков: Путин готов не наносить удары по Украине только в день выборов, а не 60 дней', 'Москва, Люксембург', 'ukraine-wide',
 ['расхождение: условия выборов'],
 S('Пресс-секретарь Кремля Дмитрий Песков заявил, что если в Киеве «реально хотят провести выборы», Путин будет готов дать указание не наносить удары по Украине в день выборов.',
   (10580, 'Президент РФ Владимир Путин будет готов дать указание не наносить удары в день выборов на Украине, если Киев решит их действительно провести')),
 S('Українська правда подчеркивает, что Песков отверг 60-дневное перемирие для проведения выборов: по его словам, в Киеве на самом деле не хотят выборов, а 60 дней нужны, чтобы «собраться с силами». Глава дипломатии ЕС Кая Каллас заявила, что выборы невозможны, пока идет война, и давление нужно направить на Россию.',
   (7922, 'І 60 діб перемир\'я їм потрібні не для виборів, а для того, щоб зібратися з силами, залікувати рани й продовжити війну.'),
   (7907, 'Вибори в Україні не можуть відбутися, доки триває війна')),
 None,
 'Российские агентства подают заявление Пескова как готовность Путина пойти навстречу; украинские СМИ — как отказ от 60-дневного перемирия, предложение лишь одного дня и с оговоркой «якобы». ЕС считает выборы возможными только после прекращения огня.',
 'low', '', False,
 ['Пєсков: Путін готовий не завдавати ударів по Україні лише в день виборів, а не 60 днів', 'Москва, Люксембург',
  'Російські агентства подають заяву Пєскова як готовність Путіна піти назустріч; українські ЗМІ — як відмову від 60-денного перемир’я, пропозицію лише одного дня і з застереженням «начебто». ЄС вважає вибори можливими лише після припинення вогню.',
  'Речник Кремля Дмитро Пєсков заявив, що якщо в Києві «реально хочуть провести вибори», Путін буде готовий дати вказівку не завдавати ударів по Україні в день виборів.',
  'Українська правда наголошує, що Пєсков відкинув 60-денне перемир’я для проведення виборів: за його словами, у Києві насправді не хочуть виборів, а 60 днів потрібні, щоб «зібратися з силами». Очільниця дипломатії ЄС Кая Каллас заявила, що вибори неможливі, доки триває війна, і тиск треба спрямувати на Росію.',
  None],
 ['Peskov: Putin ready to halt strikes on Ukraine only on election day, not for 60 days', 'Moscow, Luxembourg',
  'Russian agencies present Peskov\'s statement as Putin\'s readiness to meet Kyiv halfway; Ukrainian media present it as a rejection of a 60-day truce and an offer of just one day, with the caveat "allegedly". The EU considers elections possible only after a ceasefire.',
  'Kremlin spokesman Dmitry Peskov said that if Kyiv "really wants to hold elections", Putin would be ready to order that no strikes be carried out on Ukraine on election day.',
  'Ukrainska Pravda stresses that Peskov rejected a 60-day ceasefire for holding elections: in his words, Kyiv does not really want elections and needs the 60 days to "regroup". EU foreign policy chief Kaja Kallas said elections cannot take place while the war goes on and pressure must be directed at Russia.',
  None]))

cards.append(C('1012-kyiv-drones-ballistic', [7918, 7947, 7948, 7951, 8533, 8534, 4675],
 'Киев: дроны днем и вечером — двое погибших в Дарницком районе; поздно вечером баллистика ударила до объявления тревоги', 'Киев', 'kyiv',
 ['расхождение: числа пострадавших'],
 S('РИА Новости со ссылкой на украинские СМИ сообщило о повторных взрывах в Киеве на фоне воздушной тревоги, без указания причин и последствий.',
   (4675, 'В Киеве слышно большое количество взрывов')),
 S('Днем, по данным мэра Виталия Кличко, пострадали три человека, обломки упали на частный дом в Дарницком районе. Вечером дрон попал в 25-этажный жилой дом в Дарницком районе на уровне 12–16 этажей; Киевская городская прокуратура сообщила о двух погибших — 59-летней женщине и человеке в машине у дома. Около 22.10, по данным Воздушных сил, по Киеву ударили предварительно 6 баллистических ракет; тревогу не объявили вовремя, поскольку информации о пусках не поступало.',
   (7947, 'У Дарницькому районі влучання БпЛА в 25-поверховий житловий будинок на рівні 12-16 поверхів.'),
   (7947, 'внаслідок удару двоє людей загинули: 59-річна жінка та ще одна людина в авто біля будинку'),
   (7951, 'Інформації щодо пусків з території противника не поступало. Причини встановлюються')),
 S('Kyiv Independent пишет о двух атаках дронов, одной погибшей и не менее 14 раненых по данным городских властей, а также о мощных взрывах в центре Киева до объявления тревоги; Зеленский назвал удар «особенно подлым» и сказал, что раннего предупреждения от партнеров не было.',
   (8534, 'with powerful explosions reported before an air raid alert was issued in the Ukrainian capital'),
   (8534, 'there was no early warning from Ukraine\'s partners about missiles coming')),
 'Число погибших и раненых менялось в течение вечера (одна или две погибших; 7, 11 или 14 раненых). Украинская сторона связывает запоздалую тревогу с отсутствием данных о пусках; РИА сообщает лишь о взрывах.',
 'low', '', False,
 ['Київ: дрони вдень і ввечері — двоє загиблих у Дарницькому районі; пізно ввечері балістика вдарила до оголошення тривоги', 'Київ',
  'Кількість загиблих і поранених змінювалася протягом вечора (одна або дві загиблих; 7, 11 або 14 поранених). Українська сторона пов’язує запізнілу тривогу з відсутністю даних про пуски; РИА повідомляє лише про вибухи.',
  'РИА Новости з посиланням на українські ЗМІ повідомило про повторні вибухи в Києві на тлі повітряної тривоги, без зазначення причин і наслідків.',
  'Удень, за даними мера Віталія Кличка, постраждали троє людей, уламки впали на приватний будинок у Дарницькому районі. Увечері дрон влучив у 25-поверховий житловий будинок у Дарницькому районі на рівні 12–16 поверхів; Київська міська прокуратура повідомила про двох загиблих — 59-річну жінку та людину в авто біля будинку. Близько 22.10, за даними Повітряних сил, по Києву вдарили попередньо 6 балістичних ракет; тривогу не оголосили вчасно, бо інформації про пуски не надходило.',
  'Kyiv Independent пише про дві атаки дронів, одну загиблу і щонайменше 14 поранених за даними міської влади, а також про потужні вибухи в центрі Києва до оголошення тривоги; Зеленський назвав удар «особливо підлим» і сказав, що раннього попередження від партнерів не було.'],
 ['Kyiv: drones by day and evening kill two in Darnytskyi district; late-evening ballistic strike hits before alert', 'Kyiv',
  'Casualty figures changed during the evening (one or two dead; 7, 11 or 14 injured). The Ukrainian side attributes the late alert to a lack of launch data; RIA reports only explosions.',
  'RIA Novosti, citing Ukrainian media, reported repeated explosions in Kyiv amid an air raid alert, without giving causes or consequences.',
  'During the day, according to Mayor Vitali Klitschko, three people were injured and debris fell on a private house in Darnytskyi district. In the evening a drone hit a 25-storey apartment block in Darnytskyi district at the level of floors 12–16; the Kyiv city prosecutor\'s office reported two dead — a 59-year-old woman and a person in a car near the building. At about 22.10, according to the Air Force, Kyiv was hit by a preliminary 6 ballistic missiles; no alert was issued in time because there was no information about launches.',
  'Kyiv Independent reports two drone attacks, one woman killed and at least 14 injured according to city authorities, and powerful explosions in central Kyiv before the alert; Zelensky called the strike "particularly vile" and said there had been no early warning from partners.']))

cards.append(C('1012-kharkiv-multistoreys', [9334, 7905, 7953, 4666],
 'Харьков: «Шахеды» разрушили этажи многоэтажки утром, вечером обрушился подъезд пятиэтажки', 'Харьков', 'kharkiv',
 [],
 S('РИА Новости со ссылкой на «Общественное» сообщило о взрыве в Харькове на фоне воздушной тревоги.',
   (4666, 'Взрыв прогремел в Харькове на Украине на фоне воздушной тревоги')),
 S('Мэр Игорь Терехов сообщил, что утром удар «Шахеда» по многоэтажке разрушил этажи с 7-го по 9-й в одном из подъездов. Вечером, по данным главы ОВА Олега Синегубова, в Холодногорском районе обрушился подъезд пятиэтажки; к полуночи число пострадавших выросло до семи, двое — в тяжелом состоянии.',
   (7905, 'в одному з підʼїздів зруйновано поверхи з 7-го по 9-й'),
   (7953, '6 людей зазнали поранень, зокрема двоє – у важкому стані.')),
 S('DW пишет, что утром дроны атаковали две многоэтажки в Киевском районе, всего пострадали 19 человек, четверо ранены, у остальных — острая реакция на стресс; ночью был поражен газодобывающий объект «Нафтогаза» в области.',
   (9334, 'всего в результате ударов по обеим многоэтажкам пострадали 19 человек')),
 'Украинские и независимые источники совпадают; российские источники сообщают лишь о взрывах без указания целей и последствий.',
 'low', '', False,
 ['Харків: «Шахеди» зруйнували поверхи багатоповерхівки вранці, ввечері склався під’їзд п’ятиповерхівки', 'Харків',
  'Українські та незалежні джерела збігаються; російські джерела повідомляють лише про вибухи без зазначення цілей і наслідків.',
  'РИА Новости з посиланням на «Суспільне» повідомило про вибух у Харкові на тлі повітряної тривоги.',
