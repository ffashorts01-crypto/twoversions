cards = []
cards.append(C('1011-energy-ceasefire-announced', [10515, 5707, 10531, 9968, 9970, 7881, 7888, 7889, 9971, 8759, 9136, 8500, 9577, 8503],
 'Трамп объявил «энергетическое перемирие»; Киев узнал о нем из соцсетей, вскоре удар по ТЭЦ-5 в Харькове', 'Вашингтон, Киев, Харьков', 'ukraine-wide',
 ['расхождение: формулировки', 'атрибуция'],
 S('Интерфакс и ТАСС цитируют пост Трампа в Truth Social: «энергетическое перемирие» вступает в силу немедленно, «обе стороны согласились». Позже Интерфакс со ссылкой на Axios уточнил, что Трамп добивается приостановки ударов не по всей энергетике, а исключительно по НПЗ, и в Белом доме ждут ответа Москвы. Официальной реакции Кремля в выборке нет.',
   (5707, 'Effective immediately, there is an energy ceasefire in the war between Russia and Ukraine. Both parties have agreed.'),
   (10531, 'а исключительно по НПЗ, сообщает портал Axios со ссылкой на источники')),
 S('Зеленский заявил, что Украина готова к полноценному энергетическому перемирию, если Москва действительно на него настроена, но спустя несколько часов после заявления Трампа Россия ударила по ТЭЦ-5 в Харькове. Глава МИД Андрей Сибига заявил, что Россия нарушила перемирие сразу после объявления. Українська правда со ссылкой на Axios пишет, что Белый дом понимает перемирие как прекращение атак только на НПЗ — при том что в Украине лишь один НПЗ, работающий не на полную мощность.',
   (9971, '11 октября Россия атаковала ТЭЦ-5 в Харькове - это произошло спустя несколько часов после того, как президент США Дональд Трамп объявил о начале "энергетического перемирия"'),
   (7888, 'Міністр закордонних справ Андрій Сибіга заявив, що Росія порушила "енергетичне перемир\'я" одразу після його оголошення'),
   (7889, 'Водночас в Україні є лише один НПЗ, який не працює на повну потужність.')),
 S('The Guardian пишет, что Трамп объявил перемирие, по-видимому, не посоветовавшись с Зеленским, назвавшим его «новостью для меня». Kyiv Independent со ссылкой на высокопоставленного украинского чиновника сообщает, что у Киева не было информации о перемирии, и приводит подтверждение Офиса президента об ударе по ТЭЦ-5 после объявления.',
   (9136, 'apparently without consulting Volodymyr Zelenskyy , who said the deal to stop long-range attacks was “news to me”'),
   (8503, 'Ukraine’s Presidential Office confirmed that the attack occurred after U.S. President Donald Trump announced an energy ceasefire')),
 'Российские источники передают заявление Трампа и уточнение о НПЗ без собственной оценки Кремля; украинские и независимые подчеркивают, что Киев не был проинформирован, а Россия нанесла удар по харьковской ТЭЦ после объявления. Суть перемирия различается: «вся энергетика» в посте Трампа и «только НПЗ» по данным Axios.',
 'medium', 'Неясно, на что согласились стороны и согласилась ли Россия.', True,
 ['Трамп оголосив «енергетичне перемир’я»; Київ дізнався про нього із соцмереж, невдовзі удар по ТЕЦ-5 у Харкові', 'Вашингтон, Київ, Харків',
  'Російські джерела передають заяву Трампа й уточнення щодо НПЗ без власної оцінки Кремля; українські й незалежні наголошують, що Київ не поінформували, а Росія завдала удару по харківській ТЕЦ після оголошення. Суть перемир’я різниться: «уся енергетика» в дописі Трампа і «лише НПЗ» за даними Axios.',
  'Інтерфакс і ТАСС цитують допис Трампа в Truth Social: «енергетичне перемир’я» набуває чинності негайно, «обидві сторони погодилися». Пізніше Інтерфакс із посиланням на Axios уточнив, що Трамп домагається призупинення ударів не по всій енергетиці, а виключно по НПЗ, і в Білому домі чекають відповіді Москви. Офіційної реакції Кремля у вибірці немає.',
  'Зеленський заявив, що Україна готова до повноцінного енергетичного перемир’я, якщо Москва справді на нього налаштована, але за кілька годин після заяви Трампа Росія вдарила по ТЕЦ-5 у Харкові. Глава МЗС Андрій Сибіга заявив, що Росія порушила перемир’я одразу після оголошення. Українська правда з посиланням на Axios пише, що Білий дім розуміє перемир’я як припинення атак лише на НПЗ — при тому що в Україні лише один НПЗ, який працює не на повну потужність.',
  'The Guardian пише, що Трамп оголосив перемир’я, схоже, не порадившись із Зеленським, який назвав його «новиною для мене». Kyiv Independent з посиланням на високопосадовця України повідомляє, що Київ не мав інформації про перемир’я, і наводить підтвердження Офісу президента щодо удару по ТЕЦ-5 після оголошення.'],
 ['Trump announces an "energy ceasefire"; Kyiv learns of it from social media, then CHP-5 in Kharkiv is hit', 'Washington, Kyiv, Kharkiv',
  'Russian sources relay Trump\'s statement and the refinery clarification without a Kremlin assessment of their own; Ukrainian and independent ones stress that Kyiv was not informed and that Russia struck the Kharkiv power plant after the announcement. The substance differs: "energy" in Trump\'s post versus "refineries only" according to Axios.',
  'Interfax and TASS quote Trump\'s Truth Social post: the "energy ceasefire" takes effect immediately and "both parties have agreed". Later Interfax, citing Axios, clarified that Trump is seeking a halt to strikes not on all energy infrastructure but only on refineries, and that the White House awaits Moscow\'s answer. There is no official Kremlin reaction in the sample.',
  'Zelensky said Ukraine is ready for a full energy ceasefire if Moscow is genuinely committed to one, but a few hours after Trump\'s statement Russia struck CHP-5 in Kharkiv. Foreign Minister Andrii Sybiha said Russia violated the truce immediately after it was announced. Ukrainska Pravda, citing Axios, writes that the White House understands the truce as an end to attacks on refineries only, although Ukraine has only one refinery, which is not working at full capacity.',
  'The Guardian writes that Trump announced the ceasefire apparently without consulting Zelensky, who called it "news to me". Kyiv Independent, citing a senior Ukrainian official, reports that Kyiv had no information about the ceasefire, and cites the Presidential Office\'s confirmation that CHP-5 was struck after the announcement.']))

cards.append(C('1011-zelensky-refineries-elections', [9960, 7861, 9966, 8495, 9318],
 'Зеленский: удары по НПЗ прекратятся, если Россия перестанет бить по энергетике; выборы — при 60-дневном перемирии', 'Киев', 'ukraine-wide',
 ['одна из групп не освещает'],
 None,
 S('Зеленский написал, что «реальная причина войны в Европе — Россия», и Украина готова прекратить удары по российским НПЗ при условии, что Россия перестанет бить по украинской энергетике. В интервью ABC News, по данным РБК-Украина, он заявил, что Украина проведет выборы, если Путин согласится на 60-дневное перемирие.',
   (7861, 'Реальна причина війни в Європі – Росія, і тільки вона.'),
   (9966, 'Украина готова провести выборы нового президента, если российский диктатор Владимир Путин согласится на 60-дневное перемирие.')),
 S('Kyiv Independent пишет, что Зеленский отверг давление США прекратить удары по НПЗ, потребовав, чтобы Москва сначала перестала атаковать энергетику Украины. DW цитирует его слова в программе This Week: «дайте нам два месяца, 60 дней полного прекращения огня».',
   (8495, 'President Volodymyr Zelensky pushed back against pressure from the U.S. to stop attacking Russian oil refineries'),
   (9318, 'Пожалуйста, передайте Путину: дайте нам два месяца, 60 дней полного пре')),
 'Украинские и независимые источники совпадают; российские источники в выборке эти заявления Зеленского отдельно не освещают.',
 'low', '', False,
 ['Зеленський: удари по НПЗ припиняться, якщо Росія перестане бити по енергетиці; вибори — за 60-денного перемир’я', 'Київ',
  'Українські та незалежні джерела збігаються; російські джерела у вибірці ці заяви Зеленського окремо не висвітлюють.',
  None,
  'Зеленський написав, що «реальна причина війни в Європі — Росія», і Україна готова припинити удари по російських НПЗ за умови, що Росія перестане бити по українській енергетиці. В інтерв’ю ABC News, за даними РБК-Україна, він заявив, що Україна проведе вибори, якщо Путін погодиться на 60-денне перемир’я.',
  'Kyiv Independent пише, що Зеленський відкинув тиск США припинити удари по НПЗ, вимагаючи, щоб Москва спершу перестала атакувати енергетику України. DW цитує його слова в програмі This Week: «дайте нам два місяці, 60 днів повного припинення вогню».'],
 ['Zelensky: refinery strikes will stop if Russia stops hitting energy; elections possible with a 60-day ceasefire', 'Kyiv',
  'Ukrainian and independent sources agree; Russian sources in the sample do not cover these statements by Zelensky separately.',
  None,
  'Zelensky wrote that "the real cause of the war in Europe is Russia" and that Ukraine is ready to stop striking Russian refineries provided Russia stops hitting Ukrainian energy infrastructure. In an interview with ABC News, according to RBC-Ukraine, he said Ukraine will hold elections if Putin agrees to a 60-day ceasefire.',
  'Kyiv Independent writes that Zelensky pushed back against US pressure to stop striking refineries, demanding that Moscow first stop attacking Ukraine\'s energy infrastructure. DW quotes him on This Week: "give us two months, 60 days of a complete ceasefire".']))

cards.append(C('1011-us-threat-purl', [10529, 5718, 4610, 7884, 8505],
 'FT: США угрожают заблокировать закупки оружия для Украины по PURL из-за ударов по энергетике России', 'Вашингтон', 'ukraine-wide',
 ['не проверено независимо'],
 S('Интерфакс, ТАСС и РИА Новости со ссылкой на Financial Times и европейских чиновников пишут, что администрация Трампа угрожает заблокировать поставки оружия через механизм PURL и передачу разведданных, если удары по энергообъектам России продолжатся.',
   (10529, 'угрожает заблокировать поставку через механизм PURL вооружений Киеву в случае продолжения украинских ударов по энергетическим объектам РФ')),
 S('Українська правда со ссылкой на FT сообщает, что администрация Трампа грозит остановить поставки оружия по программе PURL в случае продолжения атак на российские НПЗ.',
   (7884, 'адміністрація президента США Дональда Трампа погрожує зупинити постачання зброї Україні за програмою PURL у разі продовження атак по російських НПЗ')),
 S('Kyiv Independent со ссылкой на FT пишет, что американские чиновники передали предупреждения в звонках в Киев и европейские столицы.',
   (8505, 'U.S. officials conveyed the warnings in calls to Kyiv and European capitals')),
 'Все группы пересказывают одну публикацию FT со ссылкой на анонимных европейских чиновников; официального подтверждения Вашингтона в выборке нет.',
 'medium', 'Единственный первоисточник — анонимные чиновники в FT.', False,
 ['FT: США погрожують заблокувати закупівлі зброї для України за PURL через удари по енергетиці Росії', 'Вашингтон',
  'Усі групи переказують одну публікацію FT із посиланням на анонімних європейських посадовців; офіційного підтвердження Вашингтона у вибірці немає.',
  'Інтерфакс, ТАСС і РІА Новини з посиланням на Financial Times і європейських посадовців пишуть, що адміністрація Трампа погрожує заблокувати постачання зброї через механізм PURL і передачу розвідданих, якщо удари по енергооб’єктах Росії триватимуть.',
  'Українська правда з посиланням на FT повідомляє, що адміністрація Трампа погрожує зупинити постачання зброї за програмою PURL у разі продовження атак на російські НПЗ.',
  'Kyiv Independent з посиланням на FT пише, що американські посадовці передали попередження в дзвінках до Києва та європейських столиць.'],
 ['FT: US threatens to block PURL arms purchases for Ukraine over strikes on Russian energy', 'Washington',
  'All groups relay a single FT report citing anonymous European officials; there is no official confirmation from Washington in the sample.',
  'Interfax, TASS and RIA Novosti, citing the Financial Times and European officials, write that the Trump administration threatens to block weapons deliveries via the PURL mechanism and intelligence sharing if strikes on Russian energy facilities continue.',
  'Ukrainska Pravda, citing the FT, reports that the Trump administration threatens to halt arms supplies to Ukraine under the PURL programme if attacks on Russian refineries continue.',
  'Kyiv Independent, citing the FT, writes that US officials conveyed the warnings in calls to Kyiv and European capitals.']))
