import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
cards.append(C('1013-kharkiv-four-dead', [8536, 9360, 7960, 7978, 7993, 7996],
 'Харьков: число погибших от удара по Холодногорскому району выросло до четырех; днем дрон попал в супермаркет', 'Харьков и область', 'kharkiv',
 ['одна из групп не освещает', 'расхождение: числа пострадавших'],
 None,
 S('ГСЧС сообщила, что ракетный удар разрушил подъезд четырехэтажного дома в Холодногорском районе; утром мэр Игорь Терехов сообщил, что из-под завалов достали четвертое тело. Днем, по данным главы ОВА Олега Синегубова, дрон попал в супермаркет в Шевченковском районе, пострадали двое, в Новобаварском районе ранен ребенок; в области, по данным прокуратуры, FPV-дроны повредили не менее пяти машин, погиб 53-летний водитель.',
   (7978, 'З-під завалів будинку у Холодногірському районі дістали четверте тіло'),
   (7993, 'РФ поцілила безпілотником у супермаркет в Шевченківському районі Харкова'),
   (7996, 'Внаслідок удару загинув 53-річний водій')),
 S('Kyiv Independent со ссылкой на ГСЧС пишет о четырех погибших и не менее 41 раненом, включая спасателя; Синегубов заявил, что Россия применила 10 ракет типа «Бандероль». DW утром приводило данные о трех погибших и 11 раненых.',
   (8536, 'Ukraine\'s State Emergency Service said that 41 people were injured'),
   (8536, 'Syniehubov said Russian forces had used 10 Banderol-type missiles in the attack')),
 'Число раненых сильно различается: 11 в ранних сообщениях и 41 по данным ГСЧС у Kyiv Independent. Российские источники в выборке удар по Харькову не упоминают.',
 'low', '', False,
 ['Харків: кількість загиблих від удару по Холодногірському району зросла до чотирьох; вдень дрон влучив у супермаркет', 'Харків і область',
  'Кількість поранених суттєво різниться: 11 у ранніх повідомленнях і 41 за даними ДСНС у Kyiv Independent. Російські джерела у вибірці удар по Харкову не згадують.',
  None,
  'ДСНС повідомила, що ракетний удар зруйнував під’їзд чотириповерхового будинку в Холодногірському районі; вранці мер Ігор Терехов повідомив, що з-під завалів дістали четверте тіло. Удень, за даними голови ОВА Олега Синєгубова, дрон влучив у супермаркет у Шевченківському районі, постраждали двоє, у Новобаварському районі поранено дитину; в області, за даними прокуратури, FPV-дрони пошкодили щонайменше п’ять авто, загинув 53-річний водій.',
  'Kyiv Independent з посиланням на ДСНС пише про чотирьох загиблих і щонайменше 41 пораненого, зокрема рятувальника; Синєгубов заявив, що Росія застосувала 10 ракет типу «Бандероль». DW вранці наводило дані про трьох загиблих і 11 поранених.'],
 ['Kharkiv: death toll from the strike on Kholodnohirskyi district rises to four; a drone hits a supermarket during the day', 'Kharkiv and region',
  'Injury figures vary widely: 11 in early reports and 41 according to the emergency service cited by Kyiv Independent. Russian sources in the sample do not mention the strike on Kharkiv.',
  None,
  'The State Emergency Service said a missile strike destroyed a stairwell of a four-storey building in Kholodnohirskyi district; in the morning Mayor Ihor Terekhov said a fourth body had been pulled from the rubble. During the day, according to governor Oleh Syniehubov, a drone hit a supermarket in Shevchenkivskyi district, injuring two, and a child was hurt in Novobavarskyi district; in the region, prosecutors said FPV drones damaged at least five cars, killing a 53-year-old driver.',
  'Kyiv Independent, citing the emergency service, reports four dead and at least 41 injured, including a rescuer; Syniehubov said Russia used 10 Banderol-type missiles. DW in the morning reported three dead and 11 injured.']))

cards.append(C('1013-kyiv-ballistic-no-warning', [10631, 4706, 4709, 5837, 7084, 7085, 7982, 7968, 7988, 9364],
 'Удар пятью баллистическими ракетами по Киеву: Зеленский — партнеры не предупредили; Минобороны РФ — поражены депо «Дарница» и цех ракет', 'Киев', 'kyiv',
 ['расхождение: характер целей', 'атрибуция'],
 S('Минобороны РФ заявило, что ночью поражены локомотивное депо «Дарница», ремонтировавшее подвижной состав для перевозки военных грузов, и цех предприятия «Палп Милл Принт», где, по версии ведомства, было организовано производство ракет и дальних беспилотников. ТАСС пишет, что Воздушные силы Украины подтвердили отсутствие своевременных данных о пусках на фоне предположений о приостановке обмена разведданными с США.',
   (4706, 'Армия России в ходе ночных ударов поразила в Киеве локомотивное депо "Дарница"'),
   (4709, 'поражен в Киеве цех предприятия "Палп Милл Принт", в котором было организовано производство ракет и беспилотных летательных аппаратов большой дальности')),
 S('Зеленский заявил, что пять баллистических ракет попали в гражданскую инфраструктуру Киева и что предупреждения от партнеров не было. Представитель Воздушных сил Юрий Игнат объяснил, что взрывы до тревоги случаются и в прифронтовых регионах. По данным Кличко, утром в Деснянском районе разрушено трехэтажное нежилое здание, в Дарницком горел дом, ранена женщина; днем обломки дрона упали в парке в Соломенском районе, пострадали две женщины.',
   (7982, 'п\'ять ракет, які влучили по цивільній інфраструктурі'),
   (7968, 'в Деснянському зруйнована триповерхова нежитлова будівля')),
 S('DW приводит слова Зеленского о том, что разведданные о пусках баллистических ракет помогают спасать жизни и это «один из самых критических вопросов».',
   (9364, 'Украина не получила от партнеров предупреждения и разведданных перед ударами пяти баллистических ракет по инфраструктуре Киева 12 октября')),
 'Минобороны РФ называет цели военными объектами, украинская сторона — гражданской инфраструктурой. ТАСС связывает отсутствие предупреждения с возможной приостановкой обмена разведданными США, Зеленский говорит лишь об отсутствии предупреждения от партнеров.',
 'medium', 'Характер целей и причины отсутствия предупреждения не установлены.', True,
 ['Удар п’ятьма балістичними ракетами по Києву: Зеленський — партнери не попередили; Міноборони РФ — уражено депо «Дарниця» і цех ракет', 'Київ',
  'Міноборони РФ називає цілі військовими об’єктами, українська сторона — цивільною інфраструктурою. ТАСС пов’язує відсутність попередження з можливим призупиненням обміну розвідданими США, Зеленський говорить лише про відсутність попередження від партнерів.',
  'Міноборони РФ заявило, що вночі уражено локомотивне депо «Дарниця», яке ремонтувало рухомий склад для перевезення військових вантажів, і цех підприємства «Палп Мілл Прінт», де, за версією відомства, було організовано виробництво ракет і далекобійних безпілотників. ТАСС пише, що Повітряні сили України підтвердили відсутність своєчасних даних про пуски на тлі припущень про призупинення обміну розвідданими зі США.',
  'Зеленський заявив, що п’ять балістичних ракет влучили в цивільну інфраструктуру Києва і що попередження від партнерів не було. Речник Повітряних сил Юрій Ігнат пояснив, що вибухи до тривоги трапляються і в прифронтових регіонах. За даними Кличка, вранці в Деснянському районі зруйновано триповерхову нежитлову будівлю, у Дарницькому горів будинок, поранено жінку; вдень уламки дрона впали в парку в Солом’янському районі, постраждали дві жінки.',
  'DW наводить слова Зеленського про те, що розвіддані про пуски балістичних ракет допомагають рятувати життя і це «одне з найкритичніших питань».'],
 ['Five ballistic missiles hit Kyiv: Zelensky says partners gave no warning; Russia claims the Darnytsia depot and a missile workshop', 'Kyiv',
  'The Russian Defence Ministry calls the targets military; the Ukrainian side calls them civilian infrastructure. TASS links the lack of warning to a possible suspension of US intelligence sharing, while Zelensky speaks only of the absence of a warning from partners.',
  'The Russian Defence Ministry said it hit the Darnytsia locomotive depot, which repaired rolling stock for military freight, and a workshop of the Pulp Mill Print company where, it claimed, long-range missiles and drones were produced. TASS writes that Ukraine\'s Air Force confirmed it lacked timely launch data amid speculation about a suspension of US intelligence sharing.',
  'Zelensky said five ballistic missiles hit civilian infrastructure in Kyiv and that there had been no warning from partners. Air Force spokesman Yurii Ihnat explained that explosions before an alert also happen in frontline regions. According to Klitschko, in the morning a three-storey non-residential building was destroyed in Desnianskyi district, a house burned in Darnytskyi and a woman was injured; during the day drone debris fell in a park in Solomianskyi district, injuring two women.',
  'DW quotes Zelensky as saying that intelligence on ballistic missile launches helps save lives and is "one of the most critical issues".']))

cards.append(C('1013-kyiv-evening-chp4', [8016, 8017, 8018, 8563, 9145, 4749],
 'Вечерний баллистический удар по Киеву: попадание в ТЭЦ-4 и жилой дом, снова без предупреждения партнеров', 'Киев', 'kyiv',
 ['расхождение: трактовка отсутствия предупреждения'],
 S('РИА Новости приводит мнение кипрского журналиста Алекса Христофору: отсутствие данных от США об ударе по Киеву — «тревожный знак» и, возможно, послание администрации Трампа Зеленскому.',
   (4749, 'Возможно, это послание администрации (Президента США Дональда. — Прим. ред.) Трампа и Белого дома Зеленскому и его европейским покровителям')),
 S('Воздушные силы сообщили, что около 22.40 Россия ударила по Киеву баллистическими ракетами и что, как и накануне, информации от партнеров о пусках не поступало. Зеленский заявил, что основной целью была энергетика — ТЭЦ-4, есть попадание, также поврежден жилой дом.',
   (8017, 'Ситуація схожа із вчорашньою – інформації від партнерів щодо пусків з території противника не надходило.'),
   (8018, 'Основна мішень – енергетика, а саме ТЕЦ-4. На жаль, є влучання.')),
 S('Kyiv Independent со ссылкой на премьера Сергея Корецкого пишет, что атакованы все три ТЭЦ Киева и объекты в области, а число погибших в ночь на 14 октября достигло пяти, раненых — 25. Guardian — что Украина вторую ночь подряд не получила предупреждения от партнеров.',
   (8563, 'all three of the city\'s combined heat and power stations were attacked'),
   (9145, 'Ukraine received no early warning from its partners about a second night of Russian ballistic missile strikes on civilian infrastructure in Kyiv')),
 'Украинские и независимые источники говорят об ударах по энергетике и жилью и отсутствии предупреждения; РИА подает это через версию о «послании» Вашингтона Киеву. Итоговые данные о жертвах относятся к ночи на 14 октября.',
 'low', '', False,
 ['Вечірній балістичний удар по Києву: влучання в ТЕЦ-4 і житловий будинок, знову без попередження партнерів', 'Київ',
  'Українські та незалежні джерела говорять про удари по енергетиці й житлу та відсутність попередження; РИА подає це через версію про «послання» Вашингтона Києву. Підсумкові дані про жертви стосуються ночі на 14 жовтня.',
  'РИА Новости наводить думку кіпрського журналіста Алекса Христофору: відсутність даних від США про удар по Києву — «тривожний знак» і, можливо, послання адміністрації Трампа Зеленському.',
  'Повітряні сили повідомили, що близько 22.40 Росія вдарила по Києву балістичними ракетами і що, як і напередодні, інформації від партнерів про пуски не надходило. Зеленський заявив, що основною ціллю була енергетика — ТЕЦ-4, є влучання, також пошкоджено житловий будинок.',
  'Kyiv Independent з посиланням на прем’єра Сергія Корецького пише, що атаковано всі три ТЕЦ Києва та об’єкти в області, а кількість загиблих у ніч на 14 жовтня сягнула п’яти, поранених — 25. Guardian — що Україна другу ніч поспіль не отримала попередження від партнерів.'],
 ['Evening ballistic strike on Kyiv hits CHP-4 and a residential building, again without warning from partners', 'Kyiv',
  'Ukrainian and independent sources speak of strikes on energy and housing and the lack of warning; RIA frames it through the theory of a "message" from Washington to Kyiv. The final casualty figures refer to the night of 14 October.',
  'RIA Novosti quotes Cypriot journalist Alex Christoforou as saying the lack of US data about the strike on Kyiv is an "alarming sign" and possibly a message from the Trump administration to Zelensky.',
  'The Air Force said that at about 22.40 Russia struck Kyiv with ballistic missiles and that, as the day before, no information on launches had come from partners. Zelensky said the main target was energy, namely CHP-4, which was hit, and a residential building was also damaged.',
  'Kyiv Independent, citing Prime Minister Serhii Koretskyi, writes that all three of Kyiv\'s combined heat and power plants and facilities in the region were attacked, and the death toll overnight into 14 October reached five, with 25 injured. The Guardian writes that Ukraine got no warning from partners for a second night.']))

cards.append(C('1013-us-intel-denial', [10637, 10684, 5877, 10657, 5881, 4731, 7086, 8003, 8547],
 'Трамп: США не прекращали передавать Украине разведданные; Politico — американцы объяснили отсутствие предупреждения погодой', 'Вашингтон, Киев', 'ukraine-wide',
 ['атрибуция', 'расхождение: трактовка'],
 S('Интерфакс со ссылкой на NYT пишет, что американский чиновник отверг угрозу отозвать разведданные, но Трамп «стал столь зол на Украину», что его действия трудно предугадать. Трамп заявил журналистам: «Мы помогаем им, и мы делимся разведданными». Песков сказал, что Кремлю о таких планах «ничего не известно»; ТАСС со ссылкой на Politico — что США объяснили отсутствие предупреждения плохой погодой. Сенатор Владимир Джабаров заявил РИА, что без разведданных Украина «быстро сложит оружие».',
   (10684, 'Мы помогаем им, и мы делимся разведданными. Мы хотим завершения войны'),
   (5881, 'The United States blamed bad weather for not warning Ukraine about the recent missile attacks')),
 S('Глава МИД Андрей Сибига подтвердил, что Украина продолжает получать разведданные от США, а посол США при НАТО Мэтью Уитакер заявил AFP, что поставки по механизму PURL продолжаются и «ничего не изменилось».',
   (7086, 'Так, ми продовжуємо цю співпрацю')),
 S('Kyiv Independent со ссылкой на украинские и американские источники пишет, что, несмотря на сбой системы раннего предупреждения и угрозы, Вашингтон решения прекратить обмен разведданными не принимал.',
   (8547, 'Washington made no such decision')),
 'Обе стороны и независимые СМИ сходятся в том, что обмен разведданными формально не прекращен; российские источники акцентируют гнев Трампа и уязвимость Украины без американских данных.',
 'low', '', False,
 ['Трамп: США не припиняли передавати Україні розвіддані; Politico — американці пояснили відсутність попередження погодою', 'Вашингтон, Київ',
  'Обидві сторони та незалежні ЗМІ сходяться в тому, що обмін розвідданими формально не припинено; російські джерела наголошують на гніві Трампа і вразливості України без американських даних.',
  'Інтерфакс з посиланням на NYT пише, що американський посадовець відкинув загрозу відкликати розвіддані, але Трамп «став настільки злий на Україну», що його дії важко передбачити. Трамп заявив журналістам: «Ми допомагаємо їм, і ми ділимося розвідданими». Пєсков сказав, що Кремлю про такі плани «нічого не відомо»; ТАСС з посиланням на Politico — що США пояснили відсутність попередження поганою погодою. Сенатор Володимир Джабаров заявив РИА, що без розвідданих Україна «швидко складе зброю».',
  'Глава МЗС Андрій Сибіга підтвердив, що Україна продовжує отримувати розвіддані від США, а посол США при НАТО Метью Вітакер заявив AFP, що постачання за механізмом PURL тривають і «нічого не змінилося».',
  'Kyiv Independent з посиланням на українські та американські джерела пише, що, попри збій системи раннього попередження і погрози, Вашингтон рішення припинити обмін розвідданими не ухвалював.'],
 ['Trump says the US has not stopped sharing intelligence with Ukraine; Politico says Americans blamed bad weather for the missing warning', 'Washington, Kyiv',
  'Both sides and independent media agree that intelligence sharing has not formally stopped; Russian sources stress Trump\'s anger and Ukraine\'s vulnerability without US data.',
  'Interfax, citing the NYT, writes that a US official rejected the idea of withdrawing intelligence but said Trump had become so angry with Ukraine that his actions were hard to predict. Trump told reporters: "We are helping them, and we are sharing intel". Peskov said the Kremlin knew "nothing" about such plans; TASS, citing Politico, writes that the US blamed bad weather for the missing warning. Senator Vladimir Dzhabarov told RIA that without intelligence Ukraine would "quickly lay down its arms".',
  'Foreign Minister Andrii Sybiha confirmed that Ukraine continues to receive US intelligence, and US Ambassador to NATO Matthew Whitaker told AFP that PURL deliveries continue and "nothing has changed".',
  'Kyiv Independent, citing Ukrainian and US sources, writes that despite the failure of the early warning system and the threats, Washington made no decision to stop sharing intelligence.']))
json.dump(cards, open('/workspace/compare-site-v2/tools/days/out/c13a.json', 'w'), ensure_ascii=False)
print(len(cards))
