@ext('1017-kherson-air-strikes', [11698])
def _(c):
    add(c, 'ua', '18 октября глава Херсонской ОВА Александр Прокудин сообщил, что в больнице умер 58-летний мужчина, тяжело раненный при авиаударах по Корабельному району; всего в результате этой атаки погибли двое, 35 человек ранены.',
        '18 жовтня голова Херсонської ОВА Олександр Прокудін повідомив, що в лікарні помер 58-річний чоловік, тяжко поранений під час авіаударів по Корабельному району; загалом унаслідок цієї атаки загинули двоє, 35 людей поранені.',
        'On 18 October the head of the Kherson regional administration, Oleksandr Prokudin, said that a 58-year-old man seriously injured in the air strikes on the Korabelnyi district had died in hospital; in total two people were killed and 35 injured in this attack.',
        [(11698, 'Медики до останнього боролися за життя 58-річного чоловіка, однак травми виявилися смертельними'),
         (11698, 'загалом унаслідок цієї терористичної російської атаки на житлові будинки загинули двоє людей, ще 35 осіб дістали поранення')])

