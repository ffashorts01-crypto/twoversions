import json, sys
sys.path.insert(0, '/workspace/compare-site-v2/tools/days')
from lib import S, C
cards = []
card = lambda *a: cards.append(C(*a))

card('1018-rubio-starshield-intel', [11079, 9034, 7369, 8277, 9069, 8796, 8793],
 'Рубио: Starshield Украине пока недоступен, запрос обсуждается; Зеленский — США возобновили обмен разведданными', 'Вашингтон, Киев', 'ukraine-wide',
 ['одна из групп не освещает'],
 S('«Интерфакс» передает слова Марко Рубио о том, что США ведут переговоры с Украиной, чтобы понять, целесообразно ли предоставлять Киеву доступ к военной спутниковой системе Starshield.',
   (11079, 'Сейчас мы обсуждаем, как именно они хотели бы это использовать')),
 S('Украинские СМИ приводят слова Рубио: Украина просила доступ к Starshield для дальнобойных ударов вглубь России, но пока его не имеет; причастность Белого дома к сбоям Starlink он отрицал. РБК-Украина со ссылкой на Bloomberg пишет, что, по словам Зеленского, США возобновили обмен разведданными после блокировки на «определенный период».',
   (7369, 'Українці просили надати їм такий доступ, щоб завдавати далекобійних ударів углиб Росії. Наразі вони не мають доступу до цієї системи'),
   (9069, 'Процес обміну розвідувальними даними між США та Україною знову відновився.')),
 S('Al Jazeera подчеркивает, что Рубио разграничил Starshield и гражданский Starlink; DW разбирает, насколько ВСУ зависят от Starlink в связи, разведке и работе дронов.',
   (8796, 'a request from Kyiv to access the system for attacks deep inside Russia is “under discussion”')),
 'Расхождений в фактах нет; российские источники освещают только сам факт переговоров, без заявления Зеленского о разведданных.',
 'low', '', False,
 ['Рубіо: Starshield Україні поки недоступний, запит обговорюється; Зеленський — США відновили обмін розвідданими', 'Вашингтон, Київ',
  'Розбіжностей у фактах немає; російські джерела висвітлюють лише сам факт переговорів, без заяви Зеленського про розвіддані.',
  '«Інтерфакс» передає слова Марко Рубіо про те, що США ведуть переговори з Україною, щоб зрозуміти, чи доцільно надавати Києву доступ до військової супутникової системи Starshield.',
  'Українські ЗМІ наводять слова Рубіо: Україна просила доступ до Starshield для далекобійних ударів углиб Росії, але поки його не має; причетність Білого дому до збоїв Starlink він заперечив. РБК-Україна з посиланням на Bloomberg пише, що, за словами Зеленського, США відновили обмін розвідданими після блокування на «певний період».',
  'Al Jazeera підкреслює, що Рубіо розмежував Starshield і цивільний Starlink; DW розбирає, наскільки ЗСУ залежать від Starlink у зв’язку, розвідці та роботі дронів.'],
 ['Rubio: Starshield not yet available to Ukraine, request under discussion; Zelensky says US resumed intelligence sharing', 'Washington, Kyiv',
  'There are no factual discrepancies; Russian sources cover only the talks themselves, not Zelensky\'s statement on intelligence.',
  'Interfax relays Marco Rubio\'s words that the US is in talks with Ukraine to understand whether it makes sense to give Kyiv access to the military satellite system Starshield.',
  'Ukrainian media quote Rubio: Ukraine asked for Starshield access for long-range strikes deep into Russia but does not have it yet; he denied White House involvement in Starlink disruptions. RBC-Ukraine, citing Bloomberg, writes that according to Zelensky the US resumed intelligence sharing after it was blocked "for a certain period".',
  'Al Jazeera stresses that Rubio distinguished Starshield from the civilian Starlink; DW examines how far Ukraine\'s forces rely on Starlink for communications, reconnaissance and drone operations.'])

card('1018-lithuania-drone-from-poland', [9076, 9075, 5041, 5087, 6283, 9048, 7438, 7467, 8282, 8293, 8791],
 'В Литве упал неопознанный дрон, предположительно залетевший из Польши; Польша поднимала авиацию и ищет объект под Люблином', 'Литва, Польша', 'ukraine-wide',
 ['расхождение: формулировки'],
 S('Министр обороны Литвы Робертас Каунас заявил, что объект, предварительно, вошел в воздушное пространство Литвы с территории Польши, и попросил Варшаву о совместном расследовании; Гитанас Науседа написал, что военные действия России против Украины перемещаются на восточный фланг НАТО. РИА пишет, что Польша подняла авиацию «якобы» из-за активности России.',
   (9076, 'Предварительно установлено, что объект вошел в воздушное пространство Литвы с территории Польши.'),
   (5041, 'Польские военные подняли в воздух авиацию якобы из-за активности России на Украине')),
 S('Суспильне и РБК-Украина со ссылкой на LRT сообщают, что обломки дрона нашли в незаселенной местности села Юоджонис, дрон повредил гражданский автомобиль; под Люблином польская территориальная оборона ищет объект, который мог залететь в ночь на воскресенье.',
   (9048, 'Уламки знайшли в незаселеній місцевості'),
   (8282, 'Невідомий об\'єкт міг порушити повітряний простір Польщі в ніч проти неділі')),
 S('DW пишет, что в Паневежском и Шяуляйском округах объявляли красный уровень воздушной тревоги из-за неопознанного объекта, вероятно дрона, двигавшегося на север.',
   (8791, 'был объявлен красный уровень воздушной тревоги из-за замеченного в воздушном пространстве неопознанного объекта')),
 'Факты совпадают; РИА подает действия польских ВВС как реакцию «якобы» на активность России, тогда как литовские власти прямо связывают угрозу с войной России против Украины. Принадлежность дрона не установлена.',
 'medium', 'Происхождение и принадлежность дрона официально не установлены.', False,
 ['У Литві впав невідомий дрон, імовірно, що залетів із Польщі; Польща піднімала авіацію і шукає об’єкт біля Любліна', 'Литва, Польща',
  'Факти збігаються; РИА подає дії польських ВПС як реакцію «нібито» на активність Росії, тоді як литовська влада прямо пов’язує загрозу з війною Росії проти України. Належність дрона не встановлено.',
  'Міністр оборони Литви Робертас Каунас заявив, що об’єкт, попередньо, увійшов у повітряний простір Литви з території Польщі, і попросив Варшаву про спільне розслідування; Гітанас Науседа написав, що військові дії Росії проти України переміщуються на східний фланг НАТО. РИА пише, що Польща підняла авіацію «нібито» через активність Росії.',
  'Суспільне і РБК-Україна з посиланням на LRT повідомляють, що уламки дрона знайшли в незаселеній місцевості села Юоджоніс, дрон пошкодив цивільний автомобіль; біля Любліна польська територіальна оборона шукає об’єкт, який міг залетіти в ніч на неділю.',
  'DW пише, що в Паневежиському та Шяуляйському округах оголошували червоний рівень повітряної тривоги через невідомий об’єкт, імовірно дрон, що рухався на північ.'],
 ['Unidentified drone crashes in Lithuania, apparently from Poland; Poland scrambled jets and searches for an object near Lublin', 'Lithuania, Poland',
  'The facts agree; RIA presents the Polish air force activity as a response to "alleged" Russian activity, while Lithuanian authorities directly link the threat to Russia\'s war against Ukraine. The drone\'s owner has not been established.',
  'Lithuanian Defence Minister Robertas Kaunas said the object had preliminarily entered Lithuanian airspace from Polish territory and asked Warsaw for a joint investigation; Gitanas Nauseda wrote that Russia\'s military actions against Ukraine are moving to NATO\'s eastern flank. RIA writes that Poland scrambled aircraft "allegedly" because of Russian activity.',
  'Suspilne and RBC-Ukraine, citing LRT, report that drone debris was found in an uninhabited area near the village of Juodonys and that the drone damaged a civilian car; near Lublin Polish territorial defence forces are searching for an object that may have entered overnight.',
  'DW writes that a red air-raid alert was declared in the Panevezys and Siauliai districts because of an unidentified object, probably a drone, moving north.'])

card('1018-lithuania-starlink-arson', [6328, 7507, 8289],
 'В Литве пресекли попытку поджога компании, хранящей оборудование Starlink; премьер созывает комиссию по нацбезопасности', 'Литва', 'ukraine-wide',
 ['одна из групп не освещает'],
 S('ТАСС со ссылкой на министра обороны Литвы Робертаса Каунаса сообщает, что попытку поджечь предприятие, где хранилось оборудование для Starlink, удалось пресечь.',
   (6328, 'Инцидент удалось пресечь, сообщил министр обороны Робертас Каунас')),
 S('Премьер Литвы Миндаугас Синкявичюс сообщил о неудачной попытке поджога компании, хранящей оборудование Starlink, и созвал на 19 октября заседание комиссии по национальной безопасности — также из-за вторжения неизвестного дрона.',
   (7507, 'Сінкявічюс заявив, що 19 жовтня скликає засідання Комісії з питань національної безпеки')),
 None,
 'Расхождений нет; независимые источники в выборке инцидент не освещают, исполнители не названы.',
 'low', '', False,
 ['У Литві запобігли спробі підпалу компанії, яка зберігає обладнання Starlink; прем’єр скликає комісію з нацбезпеки', 'Литва',
  'Розбіжностей немає; незалежні джерела у вибірці інцидент не висвітлюють, виконавців не названо.',
  'ТАСС із посиланням на міністра оборони Литви Робертаса Каунаса повідомляє, що спробу підпалити підприємство, де зберігалося обладнання для Starlink, вдалося зупинити.',
  'Прем’єр Литви Міндаугас Сінкявічюс повідомив про невдалу спробу підпалу компанії, яка зберігає обладнання Starlink, і скликав на 19 жовтня засідання комісії з питань національної безпеки — також через вторгнення невідомого дрона.',
  None],
 ['Lithuania foils attempted arson at a company storing Starlink equipment; prime minister convenes national security commission', 'Lithuania',
  'There are no discrepancies; independent sources in the sample do not cover the incident, and no perpetrators have been named.',
  'TASS, citing Lithuanian Defence Minister Robertas Kaunas, reports that an attempt to set fire to a company storing Starlink equipment was stopped.',
  'Lithuanian Prime Minister Mindaugas Sinkevicius reported a failed arson attempt at a company storing Starlink equipment and convened a national security commission meeting for October 19, also over the incursion of an unidentified drone.',
  None])

card('1018-front-claims', [6677, 9080, 5017, 5067, 5068, 5069, 5070, 5071, 5072, 6287, 6336, 6240, 6248, 6313, 6352, 9071, 5079, 5018, 5019, 5020,
  8279, 7419, 8288, 7469, 7453, 7423, 7374, 8674],
 'Минобороны РФ — продвижение всех группировок и бои в шахтах Доброполья; Генштаб ВСУ — 250 боестолкновений и удар по ремонтной базе в Луганской области', 'Донецкая, Запорожская, Луганская, Харьковская области', 'donetsk',
 ['расхождение: кто контролирует населённые пункты', 'расхождение: числа'],
 S('Минобороны РФ заявило, что группировки «Центр» и «Север» заняли более выгодные рубежи, «Восток» продвинулся вглубь обороны, а также о поражении транспортной инфраструктуры и мест запуска дронов дальнего действия. ТАСС со ссылкой на российских командиров пишет, что в Доброполье уничтожено подразделение ВСУ численностью около двух тысяч человек, а часть боев шла в шахтах.',
   (9080, 'Подразделения группировки войск "Центр" заняли более выгодные рубежи и позиции'),
   (6240, 'A Ukrainian military unit numbering around 2,000 troops has been destroyed in Dobropolye after the entire force became trapped in the city')),
 S('Генштаб ВСУ сообщил о 250 боевых столкновениях за сутки, 327 управляемых авиабомбах со стороны РФ и 19 атаках на Гуляйпольском направлении. ВСУ заявили о поражении места запуска ударных БПЛА в районе Донецка и ремонтной базы группировки «Юг» у Суходольска.',
   (7419, 'Вчора російські війська завдали 2 ракетних та 93 авіаційних ударів, скинувши 327 керованих авіабомб.'),
   (7469, 'атакували ремонтну базу автомобільної техніки та бойових броньованих машин угруповання військ «Юг» в районі міста Суходільськ')),
 S('Kyiv Independent передает данные Генштаба ВСУ о потерях российской армии с начала вторжения.',
   (8674, 'the General Staff of the Armed Forces of Ukraine reported on Oct. 18')),
 'Заявления российских командиров об окружении и уничтожении крупного подразделения ВСУ в Доброполье украинская сторона и независимые источники не подтверждают; данные о потерях противника стороны приводят каждая со своей стороны и не проверяются.',
 'medium', 'Заявления о продвижении и потерях не проверены независимо; контроль над Добропольем оспаривается.', True,
 ['Міноборони РФ — просування всіх угруповань і бої в шахтах Добропілля; Генштаб ЗСУ — 250 боєзіткнень і удар по ремонтній базі на Луганщині', 'Донецька, Запорізька, Луганська, Харківська області',
  'Заяви російських командирів про оточення і знищення великого підрозділу ЗСУ в Добропіллі українська сторона та незалежні джерела не підтверджують; дані про втрати противника сторони наводять кожна від себе, і вони не перевіряються.',
  'Міноборони РФ заявило, що угруповання «Центр» і «Север» зайняли вигідніші рубежі, «Восток» просунувся вглиб оборони, а також про ураження транспортної інфраструктури та місць запуску дронів великої дальності. ТАСС із посиланням на російських командирів пише, що в Добропіллі знищено підрозділ ЗСУ чисельністю близько двох тисяч осіб, а частина боїв ішла в шахтах.',
  'Генштаб ЗСУ повідомив про 250 боєзіткнень за добу, 327 керованих авіабомб із боку РФ і 19 атак на Гуляйпільському напрямку. ЗСУ заявили про ураження місця запуску ударних БпЛА в районі Донецька та ремонтної бази угруповання «Юг» біля Суходільська.',
  'Kyiv Independent передає дані Генштабу ЗСУ про втрати російської армії від початку вторгнення.'],
 ['Russian MoD: all groupings advance, fighting in Dobropillia\'s mines; Ukrainian General Staff: 250 clashes and a strike on a repair base in Luhansk region', 'Donetsk, Zaporizhzhia, Luhansk, Kharkiv regions',
  'Russian commanders\' claims to have encircled and destroyed a large Ukrainian unit in Dobropillia are not confirmed by the Ukrainian side or independent sources; each side reports enemy losses on its own, and these are not verified.',
  'The Russian MoD said the Centre and North groupings took more favourable lines, the East grouping advanced deeper into the defences, and transport infrastructure and long-range drone launch sites were hit. TASS, citing Russian commanders, writes that a Ukrainian unit of about two thousand troops was destroyed in Dobropillia and that some of the fighting took place in mines.',
  'The Ukrainian General Staff reported 250 clashes over the day, 327 guided aerial bombs dropped by Russia and 19 attacks on the Huliaipole axis. Ukrainian forces said they hit a strike-drone launch site near Donetsk and a repair base of the Russian South grouping near Sukhodilsk.',
  'Kyiv Independent relays the Ukrainian General Staff\'s figures on Russian losses since the start of the invasion.'])

card('1018-russian-side-casualties', [9082, 5076, 6306, 6316, 11096, 11099, 11109, 9097, 5101, 7409],
 'Пасечник: трое погибших в Луганской области; Белгородская область — 111 атак за сутки; часть Донецкой области обесточена, в Крыму перебои со светом', 'Луганская, Донецкая, Белгородская области, Крым', 'russia-other',
 ['одна из групп не освещает', 'не проверено'],
 S('Глава ЛНР Леонид Пасечник сообщил, что при ударах ВСУ погибли трое мирных жителей, в том числе пожилая женщина в Северодонецке, еще трое ранены; ПВО за сутки сбила около 50 воздушных целей. Губернатор Белгородской области сообщил о 111 атаках за сутки, ТАСС — об обесточивании части Донецкой области после атаки на энергетику. На Запорожской ТЭС, по данным ЗАЭС, ремонт займет не менее недели.',
   (5076, 'В Северодонецке в результате атаки вражеского БПЛА погибла пожилая женщина.'),
   (11096, 'Губернатор Белгородской области Александр Шуваев сообщил о 111 атаках с украинской стороны по территории региона за прошедшие сутки.')),
 S('Суспильне со ссылкой на оккупационное «Крымэнерго» пишет, что на всей территории Крыма действует режим ограничения потребления электроэнергии.',
   (7409, 'На всій території Республіки Крим діє режим обмеження споживання електроенергії.')),
 None,
 'Данные о жертвах исходят только от российских и назначенных Россией властей; украинские источники в выборке пишут лишь о перебоях со светом в Крыму, не комментируя жертвы.',
 'medium', 'Сведения о жертвах — от российских властей, независимо не проверены.', False,
 ['Пасічник: троє загиблих у Луганській області; Бєлгородщина — 111 атак за добу; частину Донеччини знеструмлено, у Криму перебої зі світлом', 'Луганська, Донецька, Бєлгородська області, Крим',
  'Дані про жертви надходять лише від російської та призначеної Росією влади; українські джерела у вибірці пишуть лише про перебої зі світлом у Криму, не коментуючи жертв.',
  'Очільник «ЛНР» Леонід Пасічник повідомив, що внаслідок ударів ЗСУ загинули троє цивільних, зокрема літня жінка в Сєвєродонецьку, ще троє поранені; ППО за добу збила близько 50 повітряних цілей. Губернатор Бєлгородської області повідомив про 111 атак за добу, ТАСС — про знеструмлення частини Донецької області після атаки на енергетику. На Запорізькій ТЕС, за даними ЗАЕС, ремонт триватиме щонайменше тиждень.',
  'Суспільне з посиланням на окупаційне «Крименерго» пише, що на всій території Криму діє режим обмеження споживання електроенергії.',
  None],
 ['Pasechnik: three killed in Luhansk region; Belgorod region reports 111 attacks in a day; part of Donetsk region without power, outages in Crimea', 'Luhansk, Donetsk, Belgorod regions, Crimea',
  'Casualty data come only from Russian and Russian-installed authorities; Ukrainian sources in the sample only report power outages in Crimea and do not comment on casualties.',
