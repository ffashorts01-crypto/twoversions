import json
def S(summary, *quotes): return {"summary": summary, "quotes": [{"id": i, "text": t} for i, t in quotes]}
def C(key, ids, title, place, region, tags, ru, ua, ind, diverge, unc, unc_r, contra, uk, en):
    return dict(key=key, ids=ids, title=title, place=place, region=region, tags=tags, ru=ru, ua=ua, ind=ind,
                diverge=diverge, figures=[], contradiction=contra, uncertainty=unc, uncertainty_reason=unc_r,
                uk=dict(zip(['t','p','d','ru','ua','ind'], uk)), en=dict(zip(['t','p','d','ru','ua','ind'], en)))
cards = []
cards.append(C('1007-massive-strike', [6413, 4348, 6786, 7643, 6793, 7641, 9519, 9240],
 'Массированный ракетно-дроновый удар России по Украине в ночь на 7 октября', 'Киев и ряд областей Украины', 'ukraine-wide',
 ['расхождение: цель удара', 'расхождение: числа погибших'],
 S('Минобороны РФ заявило, что ночью «массированным ударом» высокоточным оружием и беспилотниками поражены предприятия ВПК Украины, работавшие на компанию «Файер Пойнт» для производства и хранения крылатых ракет «Фламинго» и дронов большой и средней дальности, в Киеве и шести областях, а также портовая инфраструктура в Одесской области и суда, «задействованные в интересах ВСУ». По данным РИА Новости, ведомство прокомментировало удар словами «звучит ракетная сюита».',
   (6413, 'поражены предприятия военно-промышленного комплекса Украины, задействованные в интересах компании «Файер Пойнт» для производства и хранения крылатых ракет «Фламинго»'),
   (4348, 'Минобороны России прокомментировало ночной массированный удар по военно-промышленному комплексу Украины словами "звучит ракетная сюита".')),
 S('Воздушные силы ВСУ, по данным Суспільне, сообщили о 161 сбитой или подавленной цели и о попаданиях ракет и дронов на 18 локациях; основными направлениями удара были Киевщина, Харьковщина, Полтавщина и Днепропетровщина. Глава МВД Иван Выговский к середине дня говорил о 12 погибших и более чем 40 раненых. Зеленский назвал атаку на Киев и двенадцать областей одной из «самых подлых» и связал ее с днем рождения Путина.',
   (6786, 'внаслідок атаки зафіксовано влучання ракет й ударних БпЛА на 18 локаціях'),
   (7643, 'Цей комбінований терористичний удар по українських містах убив 12 людей.'),
   (6793, 'Зеленський назвав цю чергову атаку однією із «найбільш підлих»')),
 S('Al Jazeera со ссылкой на Воздушные силы Украины пишет о 130 дронах, 48 крылатых ракетах и неуказанном числе баллистических; Зеленский говорил о 70 ракетах. DW к утру 8 октября сообщает о 32 погибших и ударах по 13 регионам Украины.',
   (9519, 'Ukraine’s air force said on Wednesday that Russia launched 130 drones, 48 cruise missiles, and an unspecified number of ballistic missiles in the overnight attack.'),
   (9240, 'В результате массированных российских обстрелов 7 октября в Украине погибли 32 человек, сообщили местные власти.')),
 'Минобороны РФ говорит только о военно-промышленных и портовых целях и судах; украинская сторона и независимые СМИ — о погибших мирных жителях и разрушенных жилых домах. Данные о составе удара расходятся: 130 дронов и 48 крылатых ракет (Воздушные силы в пересказе Al Jazeera), 70 ракет (Зеленский). Число погибших росло в течение суток — от 12 (Выговский) до 32 (DW).',
 'medium', 'Число погибших уточнялось в течение суток; российская сторона жертвы не комментирует.', True,
 ['Масований ракетно-дроновий удар Росії по Україні в ніч на 7 жовтня', 'Київ і низка областей України',
  'Міноборони РФ говорить лише про військово-промислові й портові цілі та судна; українська сторона і незалежні ЗМІ — про загиблих цивільних і зруйновані житлові будинки. Дані про склад удару різняться: 130 дронів і 48 крилатих ракет (Повітряні сили в переказі Al Jazeera), 70 ракет (Зеленський). Кількість загиблих зростала протягом доби — від 12 (Вигівський) до 32 (DW).',
  'Міноборони РФ заявило, що вночі «масованим ударом» високоточною зброєю та безпілотниками уражено підприємства ОПК України, які працювали на компанію «Fire Point» для виробництва і зберігання крилатих ракет «Фламінго» та дронів великої і середньої дальності, у Києві та шести областях, а також портову інфраструктуру в Одеській області й судна, «задіяні в інтересах ЗСУ». За даними РІА Новини, відомство прокоментувало удар словами «звучить ракетна сюїта».',
  'Повітряні сили ЗСУ, за даними Суспільного, повідомили про 161 збиту або подавлену ціль і про влучання ракет і дронів на 18 локаціях; основними напрямками удару були Київщина, Харківщина, Полтавщина і Дніпропетровщина. Глава МВС Іван Вигівський до середини дня говорив про 12 загиблих і понад 40 поранених. Зеленський назвав атаку на Київ і дванадцять областей однією з «найбільш підлих» і пов’язав її з днем народження Путіна.',
  'Al Jazeera з посиланням на Повітряні сили України пише про 130 дронів, 48 крилатих ракет і невказану кількість балістичних; Зеленський говорив про 70 ракет. DW на ранок 8 жовтня повідомляє про 32 загиблих і удари по 13 регіонах України.'],
 ['Massive Russian missile and drone strike on Ukraine on the night of 7 October', 'Kyiv and several Ukrainian regions',
  'The Russian Defence Ministry speaks only of defence-industry and port targets and ships; the Ukrainian side and independent media speak of civilians killed and residential buildings destroyed. Figures on the scale of the strike differ: 130 drones and 48 cruise missiles (the Air Force as reported by Al Jazeera), 70 missiles (Zelensky). The death toll rose through the day, from 12 (Vyhivskyi) to 32 (DW).',
  'The Russian Defence Ministry said that overnight a "massive strike" with precision weapons and drones hit Ukrainian defence-industry enterprises working for the company Fire Point to make and store Flamingo cruise missiles and long- and medium-range drones in Kyiv and six regions, as well as port infrastructure in Odesa region and ships "used in the interests of the Ukrainian armed forces". According to RIA Novosti, the ministry commented on the strike with the words "the missile suite is playing".',
  'Ukraine\'s Air Force, according to Suspilne, reported 161 targets shot down or suppressed and missile and drone hits at 18 locations; the main directions of the strike were Kyiv, Kharkiv, Poltava and Dnipropetrovsk regions. Interior Minister Ivan Vyhivskyi spoke of 12 dead and more than 40 injured by midday. Zelensky called the attack on Kyiv and twelve regions one of the "most despicable" and linked it to Putin\'s birthday.',
  'Al Jazeera, citing Ukraine\'s Air Force, reports 130 drones, 48 cruise missiles and an unspecified number of ballistic missiles; Zelensky spoke of 70 missiles. DW reports 32 dead and strikes on 13 Ukrainian regions as of the morning of 8 October.']))

cards.append(C('1007-pryluky', [9764, 9784, 7675, 7649, 7639, 9228, 8423, 8411, 9117, 8418, 8424],
 'Ракетный удар по жилой пятиэтажке в Прилуках', 'Прилуки, Черниговская область', 'ukraine-wide',
 ['одна из групп не освещает', 'умолчание'],
 None,
 S('По данным главы Черниговской ОВА Вячеслава Чауса (РБК-Украина), утром 7 октября ракета попала в жилую многоэтажку в Прилуках, когда жильцы еще находились в квартирах. Число погибших росло в течение дня: 18, среди них четверо детей (РБК-Украина), затем 20, из них 5 детей, и 55 раненых (Українська правда со ссылкой на Зеленского и полицию).',
   (9764, 'Удар случился утром, когда жильцы дома еще находились в своих квартирах.'),
   (7675, 'Кількість загиблих від удару російської ракети по житловому будинку в Прилуках 7 жовтня зросла до 20, 5 з них діти.')),
 S('DW со ссылкой на ГСЧС пишет о попадании крылатой ракеты в пятиэтажку и 18 погибших, Kyiv Independent позже — не менее чем о 22 погибших, среди них пятеро детей, и 54 раненых. The Guardian пишет, что на видео в пятиэтажку попадает баллистическая ракета, и приводит слова Зеленского о том, что россияне «хотели ударить больно и показательно».',
   (9228, 'при попадании в пятиэтажку погибли 18 человек, четверо из которых дети'),
   (8411, 'a Russian cruise missile hit a residential building, killing at least 22 people, including five children, and wounding at least 54, including seven children'),
   (9117, 'Video showed a ballistic missile slamming into a five-storey apartment block in the town of Pryluky in the northern Chernihiv region.')),
 'Тип ракеты описан по-разному: DW и Kyiv Independent пишут о крылатой ракете, The Guardian — о баллистической. Число погибших уточнялось: 18, затем 20 и не менее 22 к следующему утру. Российские источники в выборке удар по Прилукам не упоминают; Минобороны РФ лишь называет среди целей ночного удара предприятия ВПК в Черниговской области.',
 'low', '', False,
 ['Ракетний удар по житловій п’ятиповерхівці в Прилуках', 'Прилуки, Чернігівська область',
  'Тип ракети описано по-різному: DW і Kyiv Independent пишуть про крилату ракету, The Guardian — про балістичну. Кількість загиблих уточнювалася: 18, потім 20 і щонайменше 22 до наступного ранку. Російські джерела у вибірці удар по Прилуках не згадують; Міноборони РФ лише називає серед цілей нічного удару підприємства ОПК у Чернігівській області.',
  None,
  'За даними голови Чернігівської ОВА В’ячеслава Чауса (РБК-Україна), вранці 7 жовтня ракета влучила в житлову багатоповерхівку в Прилуках, коли мешканці ще були у квартирах. Кількість загиблих зростала протягом дня: 18, серед них четверо дітей (РБК-Україна), потім 20, з них 5 дітей, і 55 поранених (Українська правда з посиланням на Зеленського та поліцію).',
  'DW з посиланням на ДСНС пише про влучання крилатої ракети в п’ятиповерхівку і 18 загиблих, Kyiv Independent пізніше — щонайменше про 22 загиблих, серед них п’ятеро дітей, і 54 поранених. The Guardian пише, що на відео в п’ятиповерхівку влучає балістична ракета, і наводить слова Зеленського про те, що росіяни «хотіли вдарити боляче й показово».'],
 ['Missile strike on a five-storey apartment block in Pryluky', 'Pryluky, Chernihiv Oblast',
  'The missile type is described differently: DW and Kyiv Independent write of a cruise missile, The Guardian of a ballistic one. The death toll was revised: 18, then 20 and at least 22 by the next morning. Russian sources in the sample do not mention the strike on Pryluky; the Russian Defence Ministry only lists defence-industry enterprises in Chernihiv region among the targets of the night strike.',
  None,
  'According to Chernihiv governor Viacheslav Chaus (RBC-Ukraine), on the morning of 7 October a missile hit a residential high-rise in Pryluky while residents were still in their flats. The death toll rose during the day: 18, including four children (RBC-Ukraine), then 20, including 5 children, and 55 injured (Ukrainska Pravda, citing Zelensky and the police).',
  'DW, citing the State Emergency Service, reports a cruise missile hitting the five-storey building and 18 dead; Kyiv Independent later reports at least 22 dead, including five children, and 54 injured. The Guardian writes that video shows a ballistic missile hitting the building and quotes Zelensky as saying the Russians "wanted to strike painfully and demonstratively".']))

cards.append(C('1007-kyiv-night-ballistic', [4341, 9757, 7630, 9773, 9788, 9223],
 'Ночной удар баллистическими ракетами по Киеву', 'Киев: Дарницкий, Оболонский, Шевченковский и Подольский районы', 'kyiv',
 ['расхождение: характер объекта'],
 S('Минобороны РФ, по данным РИА Новости, заявило, что в Киеве поражено промышленное предприятие, где собирали и хранили крылатые ракеты FP-5 «Фламинго», оперативно-тактические ракеты FP-9 и комплектующие к ним. Название предприятия не приводится.',
   (4341, 'Вооруженные силы РФ поразили в Киеве промышленное предприятие, где осуществлялась сборка и хранение крылатых ракет FP-5 "Фламинго", оперативно-тактических ракет FP-9, а также комплектующих к ним')),
 S('КГВА и мэр Виталий Кличко сообщили о попаданиях баллистических ракет в Оболонском и Шевченковском районах на территории нежилой застройки и в складские помещения в Подольском районе; в Дарницком районе погибли два человека. По данным РБК-Украина, Киев атаковали баллистикой около 03:23 и повторно около пяти утра. Полиция разминировала в Дарницком районе неразорвавшуюся баллистическую ракету, найденную среди жилых домов. Издательство «Книголав» сообщило, что ракета попала в его новый склад и уничтожены десятки тысяч книг.',
   (7630, 'За даними міського голови, в Оболонському та Шевченківському районах зафіксовані влучання на території нежитлової забудови, а в Подільському – у складські приміщення.'),
   (9757, 'В результате ночной атаки на Киев 7 октября в Дарницком районе погибли два человека.'),
   (9773, 'В Дарницком районе полиция и ГСЧС проводят сложное разминирование недетонированной баллистической ракеты, обнаруженной среди жилых домов')),
 S('DW со ссылкой на КГВА пишет о попаданиях в нескольких районах Киева и двух погибших; под обстрел, по данным местных властей, попали также объекты в Днепре, Запорожье и Кременчуге.',
   (9223, 'В Киеве зафиксированы попадания в нескольких районах, погибли два человека')),
 'Минобороны РФ говорит о поражении в Киеве предприятия по сборке ракет, не называя его; украинские власти сообщают о попаданиях на территории нежилой застройки и складов, о двух погибших и о неразорвавшейся ракете среди жилых домов. Соотнести заявление Минобороны с конкретным объектом по материалам нельзя.',
 'medium', 'Объект, о котором говорит Минобороны РФ, не назван; независимой проверки нет.', False,
 ['Нічний удар балістичними ракетами по Києву', 'Київ: Дарницький, Оболонський, Шевченківський і Подільський райони',
  'Міноборони РФ говорить про ураження в Києві підприємства зі складання ракет, не називаючи його; українська влада повідомляє про влучання на території нежитлової забудови і складів, про двох загиблих і про нерозірвану ракету серед житлових будинків. Зіставити заяву Міноборони з конкретним об’єктом за матеріалами неможливо.',
  'Міноборони РФ, за даними РІА Новини, заявило, що в Києві уражено промислове підприємство, де складали і зберігали крилаті ракети FP-5 «Фламінго», оперативно-тактичні ракети FP-9 і комплектуючі до них. Назву підприємства не наведено.',
  'КМВА і мер Віталій Кличко повідомили про влучання балістичних ракет в Оболонському і Шевченківському районах на території нежитлової забудови та у складські приміщення в Подільському районі; у Дарницькому районі загинули двоє людей. За даними РБК-Україна, Київ атакували балістикою близько 03:23 і повторно близько п’ятої ранку. Поліція розміновувала в Дарницькому районі нерозірвану балістичну ракету, знайдену серед житлових будинків. Видавництво «Книголав» повідомило, що ракета влучила в його новий склад і знищено десятки тисяч книжок.',
  'DW з посиланням на КМВА пише про влучання в кількох районах Києва і двох загиблих; під обстріл, за даними місцевої влади, потрапили також об’єкти в Дніпрі, Запоріжжі та Кременчуці.'],
 ['Overnight ballistic missile strike on Kyiv', 'Kyiv: Darnytskyi, Obolonskyi, Shevchenkivskyi and Podilskyi districts',
  'The Russian Defence Ministry speaks of hitting a missile assembly enterprise in Kyiv without naming it; Ukrainian authorities report hits on non-residential areas and warehouses, two dead and an unexploded missile among residential buildings. The materials do not allow the ministry\'s claim to be matched to a specific site.',
  'The Russian Defence Ministry, according to RIA Novosti, said an industrial enterprise in Kyiv where FP-5 Flamingo cruise missiles, FP-9 operational-tactical missiles and their components were assembled and stored had been hit. The enterprise is not named.',
  'The Kyiv city military administration and Mayor Vitali Klitschko reported ballistic missile hits on non-residential areas in Obolonskyi and Shevchenkivskyi districts and on warehouses in Podilskyi district; two people were killed in Darnytskyi district. According to RBC-Ukraine, Kyiv was attacked with ballistic missiles at about 03:23 and again at about five in the morning. Police defused an unexploded ballistic missile found among residential buildings in Darnytskyi district. The Knyholav publishing house said a missile hit its new warehouse, destroying tens of thousands of books.',
  'DW, citing the city military administration, reports hits in several Kyiv districts and two dead; according to local authorities, sites in Dnipro, Zaporizhzhia and Kremenchuk were also hit.']))

cards.append(C('1007-obukhov-mill', [5404, 9792],
 'Удар по Киевскому картонно-бумажному комбинату в Обухове', 'Обухов, Киевская область', 'kyiv',
 ['расхождение: характер объекта'],
 S('ТАСС пишет, что Киевский картонно-бумажный комбинат, который, по данным Минобороны РФ, участвовал в производстве ракет «Фламинго», после удара остановил работу, и цитирует заявление предприятия о серьезных повреждениях производственных и складских помещений.',
   (5404, 'PJSC Kiev Cardboard and Paper Mill, which is involved in the production of Flamingo missiles, as Russia’s Defense Ministry previously reported, halted production after being bombed by the Russian military')),
 S('РБК-Украина со ссылкой на пресс-службу комбината пишет, что предприятие в Обухове атаковано ракетами уже в третий раз за полгода; производственные и складские помещения серьезно разрушены, оборудование повреждено, производство приостановлено.',
   (9792, 'Киевский картонно-бумажный комбинат уже в третий раз за последние полгода был атакован вражескими ракетами.')),
 None,
 'ТАСС, ссылаясь на Минобороны РФ, называет комбинат участником производства ракет «Фламинго»; в заявлении самого комбината, которое цитирует РБК-Украина, такая связь не упоминается. Обе стороны подтверждают остановку производства.',
 'medium', 'Утверждение о военном назначении предприятия исходит только от Минобороны РФ.', False,
 ['Удар по Київському картонно-паперовому комбінату в Обухові', 'Обухів, Київська область',
  'ТАСС, посилаючись на Міноборони РФ, називає комбінат учасником виробництва ракет «Фламінго»; у заяві самого комбінату, яку цитує РБК-Україна, такий зв’язок не згадується. Обидві сторони підтверджують зупинку виробництва.',
  'ТАСС пише, що Київський картонно-паперовий комбінат, який, за даними Міноборони РФ, брав участь у виробництві ракет «Фламінго», після удару зупинив роботу, і цитує заяву підприємства про серйозні пошкодження виробничих і складських приміщень.',
  'РБК-Україна з посиланням на пресслужбу комбінату пише, що підприємство в Обухові атаковано ракетами вже втретє за пів року; виробничі й складські приміщення серйозно зруйновані, обладнання пошкоджене, виробництво призупинено.',
  None],
 ['Strike on the Kyiv Cardboard and Paper Mill in Obukhiv', 'Obukhiv, Kyiv Oblast',
  'TASS, citing the Russian Defence Ministry, describes the mill as involved in producing Flamingo missiles; the mill\'s own statement, quoted by RBC-Ukraine, makes no mention of such a link. Both sides confirm that production has stopped.',
  'TASS writes that the Kyiv Cardboard and Paper Mill, which according to the Russian Defence Ministry was involved in producing Flamingo missiles, stopped work after the strike, and quotes the company\'s statement about serious damage to production and storage facilities.',
  'RBC-Ukraine, citing the mill\'s press service, writes that the plant in Obukhiv has been hit by missiles for the third time in six months; production and storage buildings were badly damaged, equipment was damaged and production has been suspended.',
  None]))

cards.append(C('1007-kremenchuk', [4342, 9760, 7648, 7667],
 'Удар по Кременчугу: повреждены жилые кварталы', 'Кременчуг, Полтавская область', 'ukraine-wide',
 ['расхождение: характер объекта', 'умолчание'],
 S('РИА Новости со ссылкой на Минобороны РФ сообщает, что одной из целей ночного удара стала табачная фабрика «JTI Украина» в Кременчуге, где, по утверждению ведомства, «организовали выпуск боеприпасов для стрелкового оружия». О жертвах и повреждениях жилья не сообщается.',
   (4342, 'Еще одной целью армии стала табачная фабрика "JTI Украина" в Кременчуге, где организовали выпуск боеприпасов для стрелкового оружия.')),
 S('Мэр Кременчуга Виталий Малецкий (РБК-Украина) назвал повреждения жилья одними из самых масштабных в городе с начала полномасштабного вторжения: пострадали многоэтажки и частные дома. По данным главы Полтавской ОВА Виталия Дякивнича, погибли два человека, к вечеру число раненых выросло до 47, среди них двое детей; повреждены 5 многоквартирных домов (431 квартира) и 35 частных.',
   (9760, 'Это одни из самых масштабных разрушений жилья в городе с начала полномасштабного вторжения.'),
   (7667, 'Станом на 18:50 відомо про 47 травмованих, серед яких двоє дітей. Двоє людей загинули')),
 None,
 'Минобороны РФ называет целью табачную фабрику, по его словам перепрофилированную под выпуск боеприпасов; украинские источники пишут о разрушенных жилых кварталах, погибших и раненых и о фабрике не сообщают. Утверждение о выпуске боеприпасов независимо не проверено.',
 'medium', 'Военное назначение фабрики заявлено только российской стороной.', False,
 ['Удар по Кременчуку: пошкоджено житлові квартали', 'Кременчук, Полтавська область',
  'Міноборони РФ називає ціллю тютюнову фабрику, за його словами перепрофільовану під випуск боєприпасів; українські джерела пишуть про зруйновані житлові квартали, загиблих і поранених і про фабрику не повідомляють. Твердження про випуск боєприпасів незалежно не перевірене.',
  'РІА Новини з посиланням на Міноборони РФ повідомляє, що однією з цілей нічного удару стала тютюнова фабрика «JTI Україна» в Кременчуці, де, за твердженням відомства, «організували випуск боєприпасів для стрілецької зброї». Про жертви і пошкодження житла не повідомляється.',
  'Мер Кременчука Віталій Малецький (РБК-Україна) назвав пошкодження житла одними з наймасштабніших у місті від початку повномасштабного вторгнення: постраждали багатоповерхівки та приватні будинки. За даними голови Полтавської ОВА Віталія Дяківнича, загинули двоє людей, до вечора кількість поранених зросла до 47, серед них двоє дітей; пошкоджено 5 багатоквартирних будинків (431 квартира) і 35 приватних.',
  None],
 ['Strike on Kremenchuk damages residential areas', 'Kremenchuk, Poltava Oblast',
  'The Russian Defence Ministry names a tobacco factory as the target, saying it had been converted to make ammunition; Ukrainian sources write about destroyed residential areas, dead and injured, and do not mention the factory. The ammunition claim has not been independently verified.',
  'RIA Novosti, citing the Russian Defence Ministry, reports that one of the targets of the night strike was the JTI Ukraine tobacco factory in Kremenchuk, where, the ministry claims, "production of small-arms ammunition was organised". No casualties or damage to housing are mentioned.',
  'Kremenchuk Mayor Vitalii Maletskyi (RBC-Ukraine) called the damage to housing among the most extensive in the city since the start of the full-scale invasion: high-rises and private houses were hit. According to Poltava governor Vitalii Diakivnych, two people were killed and by evening the number of injured had risen to 47, including two children; 5 apartment blocks (431 flats) and 35 private houses were damaged.',
  None]))

cards.append(C('1007-oleksandriia', [4345, 9763, 7634],
 'Удар по Александрии Кировоградской области', 'Александрия, Кировоградская область', 'ukraine-wide',
 ['расхождение: характер объекта'],
 S('Минобороны РФ, по данным РИА Новости, заявило о поражении в Кировоградской области цеха по производству комплектующих для дронов большой и средней дальности, в том числе самолетного типа; город не назван.',
   (4345, 'Вооруженные силы России ночью поразили цех по производству комплектующих для дронов большой и средней дальности, в том числе самолетного типа, в Кировоградской области')),
 S('Глава Александрийской общины Сергей Кузьменко сообщил о массированной утренней атаке на Александрию и ударе по критической инфраструктуре города, есть раненые; Українська правда со ссылкой на местные власти сообщает о двух погибших.',
   (7634, 'Під час ранкової масованої атаки ворог атакував критичну інфраструктуру Олександрії. Є поранені.'),
   (9763, 'Россия совершила масштабное воздушное нападение на Александрию Кировоградской области.')),
 None,
 'Минобороны РФ называет целью цех по выпуску комплектующих для дронов, не указывая город; местные власти говорят об ударе по критической инфраструктуре Александрии и о погибших. Совпадают ли эти объекты, по материалам установить нельзя.',
 'medium', 'Неясно, об одном ли объекте говорят стороны.', False,
 ['Удар по Олександрії Кіровоградської області', 'Олександрія, Кіровоградська область',
  'Міноборони РФ називає ціллю цех із випуску комплектуючих для дронів, не вказуючи міста; місцева влада говорить про удар по критичній інфраструктурі Олександрії та про загиблих. Чи збігаються ці об’єкти, за матеріалами встановити неможливо.',
  'Міноборони РФ, за даними РІА Новини, заявило про ураження в Кіровоградській області цеху з виробництва комплектуючих для дронів великої і середньої дальності, зокрема літакового типу; місто не назване.',
  'Голова Олександрійської громади Сергій Кузьменко повідомив про масовану ранкову атаку на Олександрію і удар по критичній інфраструктурі міста, є поранені; Українська правда з посиланням на місцеву владу повідомляє про двох загиблих.',
  None],
 ['Strike on Oleksandriia, Kirovohrad region', 'Oleksandriia, Kirovohrad Oblast',
  'The Russian Defence Ministry names a workshop making drone components as the target, without naming the town; local authorities speak of a strike on Oleksandriia\'s critical infrastructure and of deaths. Whether these are the same site cannot be established from the materials.',
  'The Russian Defence Ministry, according to RIA Novosti, said it had hit a workshop in Kirovohrad region making components for long- and medium-range drones, including fixed-wing ones; the town is not named.',
  'The head of the Oleksandriia community, Serhii Kuzmenko, reported a massive morning attack on Oleksandriia and a strike on the town\'s critical infrastructure, with people injured; Ukrainska Pravda, citing local authorities, reports two dead.',
  None]))

cards.append(C('1007-dnipro-enterprise', [4343, 9755, 7625],
 'Ночной удар по промышленному предприятию в Днепре', 'Днепр', 'dnipro',
 ['расхождение: характер объекта', 'не проверено'],
 S('Минобороны РФ, по данным РИА Новости, заявило о поражении в Днепре Южного машиностроительного завода, где, по версии ведомства, производили, хранили и поставляли ВСУ крылатые ракеты FP-5 «Фламинго», а также беспилотники большой и средней дальности.',
   (4343, 'Вооруженные силы РФ поразили в Днепре Южный машиностроительный завод, на котором производили, хранили и осуществляли поставку ВСУ крылатых ракет FP-5 "Фламинго"')),
 S('Глава Днепропетровской ОВА Александр Ганжа ночью сообщил об ударе по промышленному предприятию в Днепре, не называя его; сведения о пострадавших уточнялись.',
   (7625, 'Ворог завдав удару по промисловому підприємству у Дніпрі. Інформацію про постраждалих уточнюємо'),
   (9755, 'Удар пришелся на промышленное предприятие.')),
 None,
 'Российская сторона называет конкретный объект — Южмаш — и его военное назначение; украинские власти говорят лишь о «промышленном предприятии» без названия. Независимого подтверждения того, какой объект поражен, в материалах нет.',
 'medium', 'Название объекта известно только из заявления Минобороны РФ.', False,
 ['Нічний удар по промисловому підприємству в Дніпрі', 'Дніпро',
  'Російська сторона називає конкретний об’єкт — Південмаш — і його військове призначення; українська влада говорить лише про «промислове підприємство» без назви. Незалежного підтвердження того, який об’єкт уражено, у матеріалах немає.',
  'Міноборони РФ, за даними РІА Новини, заявило про ураження в Дніпрі Південного машинобудівного заводу, де, за версією відомства, виробляли, зберігали й постачали ЗСУ крилаті ракети FP-5 «Фламінго», а також безпілотники великої і середньої дальності.',
  'Начальник Дніпропетровської ОВА Олександр Ганжа вночі повідомив про удар по промисловому підприємству в Дніпрі, не називаючи його; відомості про постраждалих уточнювалися.',
  None],
 ['Overnight strike on an industrial enterprise in Dnipro', 'Dnipro',
  'The Russian side names a specific site, Pivdenmash (Yuzhmash), and its military purpose; Ukrainian authorities speak only of an unnamed "industrial enterprise". The materials contain no independent confirmation of which site was hit.',
  'The Russian Defence Ministry, according to RIA Novosti, said it had hit the Pivdenmash (Southern Machine-Building) plant in Dnipro, where, it claims, FP-5 Flamingo cruise missiles and long- and medium-range drones were made, stored and supplied to the Ukrainian armed forces.',
  'Dnipropetrovsk governor Oleksandr Hanzha reported overnight a strike on an industrial enterprise in Dnipro without naming it; information on casualties was being clarified.',
  None]))
