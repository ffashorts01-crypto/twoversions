import json, sys
sys.path.insert(0, "/workspace/compare-site-v2/tools/days")
from lib import S, C
OUT = "/workspace/compare-site-v2/tools/days/out/"
cards = []
card = lambda *a: cards.append(C(*a))
# ---------------- backlog run 21-22 Oct (ids 13431-15322), second batch ----------------
card('1020-tambov-oil-station-drone-attack', [15110, 14844, 14065, 14571, 15301, 14696],
 'Атака дронов на Тамбовскую область: губернатор сообщил о пожаре на предприятии, OSINT-каналы называют станцию «Никольское» нефтепровода «Дружба»',
 'Мичуринский округ, Тамбовская область', 'russia-other',
 ['расхождение: характер объекта', 'не проверено', 'умолчание'],
 S('«Интерфакс» со ссылкой на губернатора Тамбовской области Евгения Первышова сообщает, что в Мичуринском округе после атаки беспилотников начался пожар на одном из предприятий; пострадавших нет, к тушению привлечены все необходимые силы. Ночью и утром над регионом, по данным властей, сбиты четыре беспилотника. Какое предприятие пострадало, в сообщении не уточняется.',
   (15110, 'В Мичуринском округе Тамбовской области на одном из предприятий после атаки БПЛА начался пожар'),
   (15110, 'Ночью и утром 20 октября над регионом были сбиты четыре беспилотника.')),
 S('РБК-Украина и «Общественное» со ссылкой на OSINT- и местные телеграм-каналы пишут, что под удар попала линейная производственно-диспетчерская станция «Никольское» под Мичуринском — крупный узел нефтепроводной инфраструктуры, где, по словам очевидцев, загорелся резервуар с дизелем. РБК-Украина отмечает, что изначально было неясно, применялись дроны или ракеты, поскольку официальные источники объект не называли; «Общественное» добавляет, что губернатор подтвердил атаку и пожар, не назвав предприятие, и что станция является ключевым узлом нефтепровода «Дружба».',
   (14844, 'зазнала атаки в ніч проти 20 жовтня'),
   (14065, 'там загорівся резервуар із дизелем')),
 S('The Kyiv Independent, The Moscow Times и DW передают слова губернатора о пожаре на неназванном предприятии без пострадавших и со ссылкой на OSINT-анализ издания ASTRA связывают пожар со станцией «Никольское» компании «Транснефть» — узлом нефтепровода «Дружба». The Kyiv Independent подчеркивает, что украинские власти атаку не подтверждали, а само издание пожар на станции независимо проверить не смогло. The Moscow Times ставит удар в контекст объявленной Трампом сделки с Кремлем об увеличении экспорта российского дизеля.',
   (14571, 'Ukrainian authorities did not yet confirm an attack.'),
   (15301, 'a key transit node along the Druzhba oil pipeline'),
   (14696, 'Какое именно предприятие пострадало, он не уточняет.')),
 'Российский источник передает только слова губернатора о пожаре на неназванном предприятии и о сбитых беспилотниках. Украинские и независимые издания со ссылкой на OSINT-каналы называют объект — станцию «Никольское» нефтепровода «Дружба»; официально это не подтверждено ни российскими, ни украинскими властями. Независимые издания прямо оговаривают, что не могут проверить сведения о пожаре на станции.',
 'medium', 'Объект удара установлен только по видео очевидцев и OSINT-анализу; официального подтверждения нет.', False,
 ('Атака дронів на Тамбовську область: губернатор повідомив про пожежу на підприємстві, OSINT-канали називають станцію «Нікольське» нафтопроводу «Дружба»',
  'Мічурінський округ, Тамбовська область',
  'Російське джерело передає лише слова губернатора про пожежу на неназваному підприємстві та про збиті безпілотники. Українські та незалежні видання з посиланням на OSINT-канали називають об’єкт — станцію «Нікольське» нафтопроводу «Дружба»; офіційно це не підтверджено ні російською, ні українською владою. Незалежні видання прямо застерігають, що не можуть перевірити відомості про пожежу на станції.',
  '«Интерфакс» із посиланням на губернатора Тамбовської області Євгена Первишова повідомляє, що в Мічурінському окрузі після атаки безпілотників почалася пожежа на одному з підприємств; постраждалих немає, до гасіння залучено всі необхідні сили. Уночі та вранці над регіоном, за даними влади, збито чотири безпілотники. Яке підприємство постраждало, у повідомленні не уточнюється.',
  'РБК-Україна і «Суспільне» з посиланням на OSINT- та місцеві телеграм-канали пишуть, що під удар потрапила лінійна виробничо-диспетчерська станція «Нікольське» під Мічурінськом — великий вузол нафтопровідної інфраструктури, де, за словами очевидців, загорівся резервуар із дизелем. РБК-Україна зазначає, що спочатку було неясно, застосовували дрони чи ракети, оскільки офіційні джерела об’єкт не називали; «Суспільне» додає, що губернатор підтвердив атаку і пожежу, не назвавши підприємство, і що станція є ключовим вузлом нафтопроводу «Дружба».',
  'The Kyiv Independent, The Moscow Times і DW передають слова губернатора про пожежу на неназваному підприємстві без постраждалих і з посиланням на OSINT-аналіз видання ASTRA пов’язують пожежу зі станцією «Нікольське» компанії «Транснафта» — вузлом нафтопроводу «Дружба». The Kyiv Independent наголошує, що українська влада атаку не підтверджувала, а саме видання пожежу на станції незалежно перевірити не змогло. The Moscow Times ставить удар у контекст оголошеної Трампом угоди з Кремлем про збільшення експорту російського дизеля.'),
 ('Drone attack on Tambov region: governor reports a fire at an enterprise, OSINT channels name the Nikolskoye station of the Druzhba oil pipeline',
  'Michurinsk district, Tambov region',
  'The Russian source relays only the governor\'s words about a fire at an unnamed enterprise and the drones shot down. Ukrainian and independent outlets, citing OSINT channels, name the facility as the Nikolskoye station of the Druzhba oil pipeline; this has not been officially confirmed by either Russian or Ukrainian authorities. Independent outlets explicitly say they cannot verify the reports of a fire at the station.',
  'Interfax, citing Tambov regional governor Yevgeny Pervyshov, reports that a fire broke out at one of the enterprises in Michurinsk district after a drone attack; there were no casualties and all necessary forces were deployed to put it out. According to the authorities, four drones were shot down over the region overnight and in the morning. Which enterprise was hit is not specified.',
  'RBC-Ukraine and Suspilne, citing OSINT and local Telegram channels, write that the Nikolskoye linear production and dispatch station near Michurinsk, a large node of oil pipeline infrastructure, was hit and that, according to eyewitnesses, a diesel tank caught fire. RBC-Ukraine notes that it was initially unclear whether drones or missiles were used, as official sources did not name the facility; Suspilne adds that the governor confirmed the attack and the fire without naming the enterprise, and that the station is a key node of the Druzhba pipeline.',
  'The Kyiv Independent, The Moscow Times and DW relay the governor\'s words about a fire at an unnamed enterprise with no casualties and, citing an OSINT analysis by the outlet ASTRA, link the fire to Transneft\'s Nikolskoye station, a node of the Druzhba oil pipeline. The Kyiv Independent stresses that Ukrainian authorities had not confirmed an attack and that it could not independently verify a fire at the station. The Moscow Times places the strike in the context of the deal Trump announced with the Kremlin to increase Russian diesel exports.'))

card('1020-trump-ukraine-must-want-deal', [15133, 15168, 14105, 14940, 14706],
 'Трамп: Украина должна хотеть заключить сделку, иначе станет хуже; NYT пишет о его решимости навязать Зеленскому соглашение',
 'Вашингтон', 'ukraine-wide',
 ['расхождение: формулировки', 'умолчание'],
 S('«Интерфакс» пересказывает The New York Times: Трамп настроен давить на Киев ради соглашения и говорил Зеленскому, что продолжать оборону еще не подконтрольных России территорий Донбасса «того не стоит»; это послание Уиткофф и Кушнер должны были передать Зеленскому в Осло. Вечером агентство привело слова самого Трампа журналистам: Украина должна хотеть заключить соглашение, США и Европа потратили на нее целое состояние, Европа от нее устала, а без сделки ситуация станет хуже; Россия, по его словам, располагает большими ресурсами, а Вашингтон много дал Киеву и ничего не получил взамен.',
   (15133, 'Трамп говорил Зеленскому, что продолжение обороны территорий в Донбассе, которые еще не находятся под контролем России'),
   (15168, 'Украина должна хотеть заключить соглашение.'),
   (15168, 'И Европа устала от нее.')),
 S('«Общественное» и РБК-Украина приводят слова Трампа в Белом доме после встречи Зеленского с Уиткоффом: Россия — «большая машина», которая продвигается вперед и захватывает все больше земли, у Украины ограниченные людские ресурсы, поэтому пора заключать сделку, а иначе, по его мнению, последствия будут очень плохими. РБК-Украина подчеркивает, что США «продолжают склонять» Украину к соглашению с Россией, и приводит слова Трампа о том, что взамен колоссальной помощи США не получили ничего, кроме высоких цен на дизельное топливо.',
   (14105, 'Росія — велика машина, яка сунеться уперед.'),
   (14105, 'В України обмежені людські ресурси. Час укладати угоду'),
   (14940, 'Натомість ми не отримали нічого, окрім високих цін на дизельне пальне')),
 S('DW выносит в заголовок вывод The New York Times о том, что Трамп хочет навязать Зеленскому мир на условиях России: по оценке газеты, пренебрежительное отношение Трампа к Зеленскому и его желание верить Путину не новость, новой является усилившаяся решимость навязать Зеленскому сделку. Издание описывает это как фон переговоров Зеленского с Уиткоффом и Кушнером в Осло.',
   (14706, 'новой является усилившаяся решимость Трампа навязать Зеленскому сделку')),
 'Заявления Трампа все три группы передают со ссылкой на его слова и на The New York Times. «Интерфакс» описывает публикацию NYT как готовность Трампа «надавить на Киев» и опускает его слова о высоких ценах на дизель; украинские источники выносят на первый план образ России как «большой машины» и слова об ограниченных людских ресурсах Украины. Независимый источник (DW) прямо называет предлагаемую сделку миром на условиях России.',
 'low', 'Сведения о том, что именно Трамп говорил Зеленскому, известны из публикации NYT со ссылкой на неназванные источники.', False,
 ('Трамп: Україна має хотіти укласти угоду, інакше стане гірше; NYT пише про його рішучість нав’язати Зеленському угоду',
  'Вашингтон',
  'Заяви Трампа всі три групи передають із посиланням на його слова та на The New York Times. «Интерфакс» описує публікацію NYT як готовність Трампа «натиснути на Київ» і опускає його слова про високі ціни на дизель; українські джерела висувають на перший план образ Росії як «великої машини» і слова про обмежені людські ресурси України. Незалежне джерело (DW) прямо називає пропоновану угоду миром на умовах Росії.',
  '«Интерфакс» переказує The New York Times: Трамп налаштований тиснути на Київ заради угоди і казав Зеленському, що продовжувати оборону ще не підконтрольних Росії територій Донбасу «не варто»; це послання Віткофф і Кушнер мали передати Зеленському в Осло. Увечері агентство навело слова самого Трампа журналістам: Україна має хотіти укласти угоду, США і Європа витратили на неї цілий статок, Європа від неї втомилася, а без угоди ситуація погіршиться; Росія, за його словами, має більші ресурси, а Вашингтон багато дав Києву і нічого не отримав навзамін.',
  '«Суспільне» і РБК-Україна наводять слова Трампа в Білому домі після зустрічі Зеленського з Віткоффом: Росія — «велика машина», яка просувається вперед і захоплює дедалі більше землі, в України обмежені людські ресурси, тому час укладати угоду, а інакше, на його думку, наслідки будуть дуже поганими. РБК-Україна наголошує, що США «продовжують схиляти» Україну до угоди з Росією, і наводить слова Трампа про те, що навзамін колосальної допомоги США не отримали нічого, крім високих цін на дизельне пальне.',
  'DW виносить у заголовок висновок The New York Times про те, що Трамп хоче нав’язати Зеленському мир на умовах Росії: за оцінкою газети, зневажливе ставлення Трампа до Зеленського і його бажання вірити Путіну не новина, новою є посилена рішучість нав’язати Зеленському угоду. Видання описує це як тло переговорів Зеленського з Віткоффом і Кушнером в Осло.'),
 ('Trump: Ukraine must want to make a deal or things will get worse; NYT writes of his determination to force a deal on Zelensky',
  'Washington',
  'All three groups relay Trump\'s statements citing his words and The New York Times. Interfax describes the NYT report as Trump\'s readiness to "pressure Kyiv" and omits his remark about high diesel prices; Ukrainian sources foreground the image of Russia as a "big machine" and the words about Ukraine\'s limited manpower. The independent source (DW) explicitly calls the proposed deal a peace on Russia\'s terms.',
  'Interfax retells The New York Times: Trump is set on pressuring Kyiv for a deal and told Zelensky that continuing to defend the parts of Donbas not yet under Russian control "is not worth it"; Witkoff and Kushner were to deliver this message to Zelensky in Oslo. In the evening the agency quoted Trump himself telling reporters that Ukraine should want to make a deal, the US and Europe have spent a fortune on it, Europe is tired of it, and without a deal things will get worse; Russia, he said, has greater resources, and Washington has given Kyiv a lot and got nothing in return.',
  'Suspilne and RBC-Ukraine quote Trump at the White House after Zelensky\'s meeting with Witkoff: Russia is a "big machine" that keeps moving forward and seizing more and more land, Ukraine has limited manpower, so it is time to make a deal, and otherwise, in his view, the consequences will be very bad. RBC-Ukraine stresses that the US "continues to push" Ukraine towards a deal with Russia and quotes Trump saying that in return for colossal aid the US got nothing but high diesel prices.',
  'DW headlines The New York Times\' conclusion that Trump wants to force on Zelensky a peace on Russia\'s terms: in the paper\'s assessment, Trump\'s dismissive attitude to Zelensky and his wish to believe Putin are not news, but his increased determination to force a deal on Zelensky is. The outlet describes this as the backdrop to Zelensky\'s talks with Witkoff and Kushner in Oslo.'))

json.dump(cards, open(OUT + 'c20b.json', 'w'), ensure_ascii=False, indent=1)
print('c20b', len(cards))
