# Example GitHub Actions workflow (rename to .github/workflows/update.yml). Not active: this repo is not on GitHub yet.
# Secrets needed: DASHSCOPE_API_KEY (Qwen, default) or OPENAI_API_KEY with variable LLM_PROVIDER=openai. Optional repository variables: BASE_URL, CONTACT_EMAIL, LLM_BUDGET_USD.
name: update
on:
  schedule: [{cron: '17 */3 * * *'}]     # every 3 hours
  workflow_dispatch: {}
concurrency: update
jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: '3.12', cache: pip}
      - run: pip install -r requirements.txt
      - name: restore state (data/articles.db is the persistent store; keep it in a cache/artifact/branch)
        uses: actions/cache@v4
        with: {path: data, key: data-${{ github.run_id }}, restore-keys: data-}
      - run: python update.py
        env:
          LLM_PROVIDER: ${{ vars.LLM_PROVIDER || 'qwen' }}
          DASHSCOPE_API_KEY: ${{ secrets.DASHSCOPE_API_KEY }}
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          BASE_URL: ${{ vars.BASE_URL }}
          CONTACT_EMAIL: ${{ vars.CONTACT_EMAIL }}
          LLM_BUDGET_USD: ${{ vars.LLM_BUDGET_USD || '1000' }}
          LLM_DAILY_BUDGET_USD: ${{ vars.LLM_DAILY_BUDGET_USD || '1' }}
          LLM_RUN_BUDGET_USD: ${{ vars.LLM_RUN_BUDGET_USD || '0.45' }}
      - uses: actions/upload-pages-artifact@v3
        with: {path: public}
